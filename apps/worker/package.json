{
  "name": "@lyrashield/worker",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "node --env-file=../../.env --import tsx --watch src/index.ts",
    "start": "tsx src/index.ts",
    "verify:launch-assurance": "node --env-file-if-exists=../../.env --import tsx src/operations/verify-launch-assurance.ts",
    "verify:retained-evidence": "node --env-file-if-exists=../../.env --import tsx src/operations/verify-retained-evidence.ts",
    "verify:queue-orphan-fixture": "node --env-file-if-exists=../../.env --import tsx src/operations/verify-queue-orphan-fixture.ts",
    "review:terminal-cost-disposition": "node --env-file-if-exists=../../.env --import tsx src/operations/review-terminal-cost-disposition.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1121.0",
    "@lyrashield/affiliate": "workspace:*",
    "@lyrashield/billing": "workspace:*",
    "@lyrashield/config": "workspace:*",
    "@lyrashield/db": "workspace:*",
    "@lyrashield/evidence-storage": "workspace:*",
    "@lyrashield/fix": "workspace:*",
    "@lyrashield/integrations": "workspace:*",
    "@lyrashield/logger": "workspace:*",
    "@lyrashield/security": "workspace:*",
    "@lyrashield/types": "workspace:*",
    "@sentry/node": "^10.72.0",
    "bullmq": "6.3.2",
    "ioredis": "^5.11.1",
    "tsx": "^4.23.13",
    "yaml": "^2.9.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^6.0.0"
  }
}
