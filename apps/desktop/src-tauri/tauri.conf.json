{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LyraShield",
  "version": "0.1.1",
  "identifier": "ai.lyrashield.desktop",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm --filter @lyrashield/desktop-frontend dev",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "LyraShield",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["resources/license-signing-public-key.pem"],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": null
    },
    "windows": {
      "certificateThumbprint": null,
      "nsis": {
        "installMode": "perMachine"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI5Rjg2OTUwQ0NCRTc1MkIKUldRcmRiN01VR240dWRHcUFRY3pZd1Y4UUdWUTk3c2NCc0dHdzlBaEljaVlzNFE1Z0xDL09jVWMK",
      "endpoints": [
        "https://github.com/ecryptoguru/lyrashield-ai/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    },
    "sql": {
      "preload": ["sqlite:lyrashield.db"]
    }
  }
}
