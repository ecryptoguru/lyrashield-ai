# Next.js app local environment template
# Copy to .env and adjust for your local setup

NEXT_PUBLIC_APP_URL="http://localhost:3001"
PLATFORM_ADMIN_EMAILS="ecryptoguru@gmail.com,ankit@lyrashieldai.com"
NEXT_PUBLIC_MARKETING_URL="http://localhost:4321"
PORT=3001
# Cloudflare Turnstile secret key (server-side). Used by /api/lite-scan.
TURNSTILE_SECRET_KEY=""

# Myra support agent (docs/myra-spec.md) — every gate defaults OFF; routes
# fail closed to 404 while the owning capability is disabled.
# Marketing surface + public (anonymous) sessions.
MYRA_PUBLIC_ENABLED="0"
# Dashboard surface + authenticated-user principals.
MYRA_DASHBOARD_ENABLED="0"
MYRA_ALLOWED_EMAILS=""
# Model generation inside the support workflow.
MYRA_GENERATION_ENABLED="0"
# Confirmed writes: proposal confirm, case replies, booking manage.
MYRA_WRITES_ENABLED="0"
# Platform-operator support inbox routes.
MYRA_OPERATOR_ENABLED="0"
# Calendar provider adapter: "mock" (default, no real calendar) or "google".
MYRA_CALENDAR_PROVIDER="mock"
# Azure OpenAI/Foundry deployment names (optional until generation is enabled).
MYRA_PROVIDER="mock"
MYRA_AZURE_OPENAI_ENDPOINT=""
MYRA_AZURE_OPENAI_API_KEY=""
MYRA_MODEL_FAST=""
MYRA_MODEL_DEEP=""
MYRA_EMBED_MODEL=""
# Server-enforced monthly generation spend cap in USD (optional).
MYRA_MONTHLY_BUDGET_USD=""
MYRA_COST_PER_1K_INPUT_USD=""
MYRA_COST_PER_1K_OUTPUT_USD=""
MYRA_DEEP_COST_PER_1K_INPUT_USD=""
MYRA_DEEP_COST_PER_1K_OUTPUT_USD=""
# Mock-calendar fault injection for tests/dev only. Never enable in production.
MYRA_MOCK_CALENDAR_TIMEOUT_ON_INSERT="0"
MYRA_MOCK_CALENDAR_PENDING_CONFERENCE="0"
MYRA_MOCK_CALENDAR_EXTERNAL_CONFLICT="0"
# Founder-only Google Calendar OAuth for ankit@lyrashieldai.com.
MYRA_GOOGLE_CLIENT_ID=""
MYRA_GOOGLE_CLIENT_SECRET=""
MYRA_GOOGLE_REFRESH_TOKEN=""
MYRA_GOOGLE_TOKEN_JSON=""
# Destination for support-case notifications. Best-effort only — no SLA.
MYRA_SUPPORT_NOTIFY_EMAIL=""
