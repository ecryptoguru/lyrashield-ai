---
import { getCollection } from "astro:content"
import { PHP2SHELL_GUIDE_SLUGS } from "../lib/php2shell-guides"
import { isNotAfterBuildDate } from "../lib/blog-publishing"
const currentSlug = Astro.url.pathname.split("/").filter(Boolean).at(-1)
const posts = await getCollection("blog", (post) => !post.data.draft && isNotAfterBuildDate(post.data) && PHP2SHELL_GUIDE_SLUGS.includes(post.id) && post.id !== currentSlug)
const ordered = PHP2SHELL_GUIDE_SLUGS.flatMap((slug) => posts.filter((post) => post.id === slug))
---
<nav aria-labelledby="php-guides-heading" class="mt-10 rounded-xl border border-border bg-bg-raised p-5" data-testid="php2shell-cluster">
  <h2 id="php-guides-heading" class="text-xl font-semibold text-text">PHP2Shell response guides</h2>
  <p class="mt-3 text-sm leading-6 text-text-muted">Follow the step that matches your situation: identify the runtime, deploy a fix, resolve vendor uncertainty or investigate earlier activity.</p>
  <ul class="mt-4 grid gap-3 sm:grid-cols-2">
    {ordered.map((post) => <li><a href={`/blog/${post.id}`} class="flex min-h-11 items-center rounded-lg border border-border px-3 py-3 text-sm font-medium text-text no-underline hover:border-accent focus:outline-none focus-visible:ring-2 focus-visible:ring-accent">{post.data.title}</a></li>)}
  </ul>
  {currentSlug !== "php2shell-checker" && <a href="/tools/php2shell-checker" class="mt-4 inline-flex min-h-11 items-center text-sm font-medium text-accent underline">Open the free PHP2Shell checker</a>}
</nav>
