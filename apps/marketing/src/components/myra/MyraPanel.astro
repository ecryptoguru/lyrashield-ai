---
import { MYRA_COPY } from "@lyrashield/myra"
---

<button
  type="button"
  id="myra-launcher"
  aria-expanded="false"
  aria-controls="myra-panel"
  class="fixed bottom-5 right-5 z-40 inline-flex min-h-11 items-center gap-2 rounded-lg border border-border bg-bg-raised px-4 font-mono text-xs font-semibold tracking-[.12em] text-text shadow-lg hover:border-accent hover:text-accent focus:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-bg"
  style="margin-bottom: env(safe-area-inset-bottom)"
>
  <svg aria-hidden="true" viewBox="0 0 16 16" class="size-4" fill="none" stroke="currentColor" stroke-width="1.5">
    <path d="M14 9.5a1.5 1.5 0 0 1-1.5 1.5H5l-3 3V3.5A1.5 1.5 0 0 1 3.5 2h9A1.5 1.5 0 0 1 14 3.5Z" stroke-linejoin="round" />
  </svg>
  Help
</button>

<!-- Keep the challenge host outside the hidden panel. A queued token attempt
     can start after the panel closes, and interaction-only challenges must
     remain visible and reachable. Empty when nothing needs verifying. -->
<div data-myra-turnstile class="fixed bottom-20 right-5 z-50 empty:hidden"></div>

<section
  id="myra-panel"
  hidden
  role="dialog"
  aria-modal="false"
  aria-label="Myra support"
  class="fixed inset-0 z-50 flex flex-col bg-bg sm:inset-auto sm:bottom-6 sm:right-6 sm:z-40 sm:h-[min(560px,calc(100dvh-3rem))] sm:w-[min(400px,calc(100vw-2rem))] sm:rounded-xl sm:border sm:border-border sm:bg-bg-raised sm:shadow-lg"
>
  <header class="flex items-center gap-2 border-b border-border px-4 py-3" style="padding-top: max(0.75rem, env(safe-area-inset-top))">
    <h2 class="font-mono text-xs font-semibold tracking-[.14em] text-text uppercase">
      {MYRA_COPY.header}
    </h2>
    <div class="ml-auto flex items-center gap-1">
      <button
        type="button"
        id="myra-talk"
        class="inline-flex min-h-11 items-center rounded-lg px-3 text-xs font-medium text-accent hover:underline focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
      >
        {MYRA_COPY.talkToPerson}
      </button>
      <button
        type="button"
        id="myra-close"
        aria-label="Close Myra"
        class="inline-flex size-11 items-center justify-center rounded-lg text-text-muted hover:text-text focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
      >
        <svg aria-hidden="true" viewBox="0 0 16 16" class="size-4" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="m3 3 10 10M13 3 3 13" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </header>

  <p id="myra-disclosure" hidden class="border-b border-border px-4 py-2 text-xs leading-5 text-text-muted"></p>

  <div
    id="myra-log"
    role="log"
    aria-label="Conversation with Myra"
    class="min-h-0 flex-1 overflow-y-auto px-4 py-4"
  >
    <div id="myra-empty" class="myra-turn">
      <div class="myra-msg myra-msg-assistant">
        <div class="myra-answer">
          <p class="myra-p">{MYRA_COPY.opener}</p>
        </div>
      </div>
      <div id="myra-starters" class="mt-3 flex flex-wrap gap-2" aria-label="Suggested starting points">
        <button type="button" data-myra-send="Compare plans" class="myra-chip-btn">Compare plans</button>
        <a href="/scan" class="myra-chip-btn">Try a free check</a>
        <a href="/demo" class="myra-chip-btn">Book a demo</a>
      </div>
    </div>
  </div>

  <p id="myra-activity" hidden class="px-4 pb-1 font-mono text-xs text-text-muted" aria-live="off"></p>

  <form id="myra-form" class="border-t border-border p-3" style="padding-bottom: max(0.75rem, env(safe-area-inset-bottom))">
    <div class="relative">
      <label for="myra-input" class="sr-only">Message Myra</label>
      <textarea
        id="myra-input"
        rows="2"
        maxlength="4000"
        placeholder="Ask about plans, setup or results…"
        autocomplete="off"
        aria-autocomplete="list"
        aria-controls="myra-suggest"
        class="w-full resize-none rounded-lg border border-border bg-bg px-3 py-2 text-sm text-text placeholder:text-text-muted focus:border-accent focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
      ></textarea>
      <ul
        id="myra-suggest"
        role="listbox"
        aria-label="Instant answers"
        hidden
        class="absolute inset-x-0 bottom-full mb-1 max-h-48 overflow-y-auto rounded-lg border border-border bg-bg-raised shadow-lg"
      ></ul>
    </div>
    <div class="mt-2 flex items-center justify-between gap-2">
      <p class="text-xs text-text-muted">Enter to send · Shift+Enter for a new line</p>
      <div class="flex gap-2">
        <button
          type="button"
          id="myra-stop"
          hidden
          class="inline-flex min-h-11 items-center rounded-lg border border-border px-4 text-sm font-medium text-text hover:border-accent focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
        >
          Stop
        </button>
        <button
          type="submit"
          id="myra-send"
          class="inline-flex min-h-11 items-center rounded-lg bg-accent px-4 text-sm font-semibold text-bg hover:opacity-90 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-bg-raised"
        >
          Send
        </button>
      </div>
    </div>
  </form>

  <p id="myra-status" role="status" aria-live="polite" class="sr-only"></p>
</section>

<script>
  const launcher = document.getElementById("myra-launcher")
  let pending: Promise<{ open: () => void }> | null = null

  async function loadAndOpen() {
    pending ??= import("./myra-panel.client").then((mod) => mod.initMyraPanel())
    try {
      const panel = await pending
      panel.open()
    } catch {
      pending = null
      launcher?.removeAttribute("aria-busy")
    }
  }

  launcher?.addEventListener("click", () => {
    launcher.setAttribute("aria-busy", "true")
    void loadAndOpen().finally(() => launcher?.removeAttribute("aria-busy"))
  })
</script>

<style is:global>
  /* The panel DOM is built by the lazy client module, so these rules must not
     be Astro-scoped — scoped selectors would never match runtime elements. */
  #myra-panel[hidden],
  #myra-launcher[hidden] {
    display: none;
  }

  .myra-turn {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .myra-msg {
    max-width: 100%;
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .myra-msg-user {
    align-self: flex-end;
    max-width: 85%;
    border-radius: var(--radius-lg);
    background: var(--accent-dim);
    color: var(--text);
    padding: 0.5rem 0.75rem;
    overflow-wrap: anywhere;
    white-space: pre-wrap;
  }

  .myra-msg-assistant {
    align-self: stretch;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .myra-answer .myra-p + .myra-p {
    margin-top: 0.5rem;
  }

  .myra-list {
    margin: 0.375rem 0;
    padding-left: 1.25rem;
    list-style: disc;
  }

  .myra-list li + li {
    margin-top: 0.25rem;
  }

  .myra-inline-code,
  .myra-code {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
  }

  .myra-inline-code {
    padding: 0 0.25rem;
  }

  .myra-code {
    padding: 0.625rem 0.75rem;
    overflow-x: auto;
    white-space: pre;
    margin: 0.375rem 0;
  }

  .myra-link {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
    overflow-wrap: anywhere;
  }

  .myra-link:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }

  .myra-card {
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--bg);
    padding: 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    min-width: 0;
  }

  .myra-card-confirm {
    border-color: var(--accent);
  }

  .myra-card-title {
    font-weight: 600;
    font-size: 0.875rem;
  }

  .myra-meta,
  .myra-trace {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    color: var(--text-muted);
  }

  .myra-trace {
    opacity: 0.7;
  }

  .myra-note {
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  .myra-note-error {
    color: var(--danger);
  }

  .myra-note-ok {
    color: var(--accent);
  }

  .myra-pre {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .myra-case-subject {
    font-weight: 600;
    font-size: 0.875rem;
  }

  .myra-card-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.25rem;
  }

  .myra-btn {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0 0.875rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--border);
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--text);
    background: transparent;
    cursor: pointer;
  }

  .myra-btn:hover {
    border-color: var(--accent);
  }

  .myra-btn:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .myra-btn:disabled {
    opacity: 0.55;
    cursor: not-allowed;
  }

  .myra-btn-primary {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--bg);
    font-weight: 600;
  }

  .myra-btn-primary:hover {
    opacity: 0.9;
  }

  .myra-btn-link {
    border-color: transparent;
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .myra-chip {
    display: inline-flex;
    align-items: center;
    border-radius: 999px;
    padding: 0.0625rem 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    background: var(--bg-raised);
    border: 1px solid var(--border);
    color: var(--text-muted);
  }

  .myra-chip-pass {
    color: var(--accent);
    border-color: var(--accent);
  }

  .myra-chip-fail {
    color: var(--danger);
    border-color: var(--danger);
  }

  .myra-checks,
  .myra-steps {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .myra-checks li,
  .myra-steps li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.375rem;
    font-size: 0.8125rem;
  }

  .myra-checks li .myra-note,
  .myra-steps li .myra-note {
    flex-basis: 100%;
  }

  .myra-check-label {
    color: var(--text);
  }

  .myra-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.75rem;
  }

  .myra-table th {
    text-align: left;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
    padding: 0.25rem 0.375rem;
    border-bottom: 1px solid var(--border);
  }

  .myra-table td {
    padding: 0.375rem;
    border-bottom: 1px solid var(--border);
    vertical-align: top;
  }

  .myra-slots {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(9rem, 1fr));
    gap: 0.375rem;
  }

  .myra-kv {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.125rem 0.75rem;
    font-size: 0.75rem;
  }

  .myra-kv dt {
    font-family: var(--font-mono);
    color: var(--text-muted);
  }

  .myra-kv dd {
    overflow-wrap: anywhere;
  }

  .myra-field {
    width: 100%;
    border-radius: var(--radius-md);
    border: 1px solid var(--border);
    background: var(--bg-raised);
    padding: 0.5rem 0.75rem;
    font-size: 0.875rem;
    color: var(--text);
  }

  .myra-field:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
    border-color: var(--accent);
  }

  .myra-check {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  .myra-check input {
    accent-color: var(--accent);
    min-width: 1rem;
    min-height: 1rem;
  }

  .myra-verify {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  .myra-verify .myra-field {
    flex: 1 1 9rem;
  }

  .myra-suggest-item {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    padding: 0.5rem 0.75rem;
    cursor: pointer;
  }

  .myra-suggest-item[aria-selected="true"],
  .myra-suggest-item:hover {
    background: var(--accent-dim);
  }

  .myra-suggest-title {
    font-size: 0.8125rem;
    font-weight: 500;
  }

  .myra-suggest-snippet {
    font-size: 0.75rem;
    color: var(--text-muted);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .myra-chip-btn {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    padding: 0 0.875rem;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--text);
    background: var(--bg-raised);
  }

  .myra-chip-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .myra-chip-btn:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .myra-capability {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .myra-capability summary {
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
  }

  .myra-capability summary:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }

  .myra-capability .myra-checks {
    margin-top: 0.375rem;
  }

  .myra-result-head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .myra-srclink {
    font-size: 0.8125rem;
  }

  @media (prefers-reduced-motion: no-preference) {
    #myra-panel {
      transition: opacity 150ms ease-out, transform 150ms ease-out;
    }
  }
</style>
