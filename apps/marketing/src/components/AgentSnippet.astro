---
import { getAgent, renderConfig, renderEntry } from "@lyrashield/agent-registry"
import type { AgentEntry, InstallOptions, Transport } from "@lyrashield/agent-registry"

interface Props {
  agentId: string
  transport?: Transport
  secretMode?: InstallOptions["secretMode"]
  apiKey?: string
  /**
   * Set on additional snippets for the same agent (e.g. the remote-HTTP block
   * below a stdio block). The one-line install command and the gotchas list
   * describe the agent, not the transport, so they render only once per page.
   */
  secondary?: boolean
}

const appOrigin = (import.meta.env.PUBLIC_APP_URL as string | undefined)?.replace(/\/$/, "")
// Fallback must stay in sync with DEFAULT_API_URL in packages/credentials/src/index.ts
// (marketing deliberately has no dependency edge on that package).
const API_URL = appOrigin || "https://app.lyrashieldai.com"
const MCP_REMOTE_URL = `${API_URL}/api/mcp`
const SERVER_NAME = "lyrashield"
const DEFAULT_API_KEY = "<LYRASHIELD_API_KEY>"

const {
  agentId,
  transport,
  secretMode,
  apiKey = DEFAULT_API_KEY,
  secondary = false,
} = Astro.props
const agent = getAgent(agentId)
if (!agent) {
  throw new Error(`Unknown agent: ${agentId}`)
}

const safeAgent = agent as AgentEntry

const effectiveTransport: Transport =
  transport && safeAgent.transports.includes(transport) ? transport : (safeAgent.transports[0] ?? "stdio")

const defaultSecretMode: InstallOptions["secretMode"] =
  effectiveTransport === "stdio" ? "shell" : safeAgent.forceInlineEnv ? "inline" : "interpolated"

const effectiveSecretMode: InstallOptions["secretMode"] = secretMode ?? defaultSecretMode

function buildKeyNote(snippet: string): string {
  if (snippet.includes("<LYRASHIELD_API_KEY>")) {
    return "Replace <LYRASHIELD_API_KEY> with your workspace API key."
  }
  if (snippet.includes("{env:LYRASHIELD_API_KEY}")) {
    return "Make sure LYRASHIELD_API_KEY is exported in your shell or .env file."
  }
  return "Recommended: run npx lyrashield login --oauth once; the local MCP server reads the selected workspace credential from ~/.lyrashield/credentials.json."
}

function buildManualCommand(): string {
  return `LYRASHIELD_API_KEY=${apiKey} LYRASHIELD_API_URL=${API_URL} npx -y @lyrashield/mcp`
}

function buildRemoteManualCommand(agent: AgentEntry): string {
  const remoteFields = agent.transportFields?.["remote-http"]
  if (!remoteFields) {
    return buildManualCommand()
  }

  const entry: Record<string, unknown> = {}
  for (const [key, value] of Object.entries(remoteFields)) {
    entry[key] = value === "<apiUrl>" ? MCP_REMOTE_URL : value
  }
  entry.headers = {
    Authorization: `Bearer ${apiKey}`,
  }

  return JSON.stringify({ mcpServers: { [SERVER_NAME]: entry } }, null, 2)
}

function buildVendorCommand(agent: AgentEntry): string {
  const command = [agent.vendorCli?.command, ...(agent.vendorCli?.args ?? [])]
    .filter(Boolean)
    .join(" ")
  return `LYRASHIELD_API_KEY=${apiKey} LYRASHIELD_API_URL=${API_URL} ${command}`
}

const strategyNotes: Record<string, string> = {
  jetbrains:
    "JetBrains AI & Junie: UI-only. Open Settings → Tools → AI Assistant → MCP Servers and add a new server using the values below.",
  amp: "Amp: export the variables in the shell where Amp runs, then add the server with the CLI command below.",
  cline: "Cline: add the server from the MCP settings panel; Cline manages the configuration file.",
  picode:
    "PiCode: manual. The exact config file path is not documented; use the command below as a reference and verify with PiCode's docs.",
  openclaw:
    "OpenClaw: add the server in Settings → MCP or with openclaw mcp, then verify it with openclaw mcp doctor --probe.",
}

let snippet = ""
let note = ""
let notePrefix: "config" | "remote" | "manual" | "none" = "none"
let notePath = ""
let strategyNote = ""

if (safeAgent.installStrategy === "config-file") {
  const { rootKey, entryKey, value } = renderEntry(safeAgent, {
    transport: effectiveTransport,
    apiUrl: API_URL,
    serverName: SERVER_NAME,
    secretMode: effectiveSecretMode,
    apiKey,
  })

  if (safeAgent.format === "jsonc") {
    // The CLI uses jsonc-parser to preserve comments when merging into an existing file.
    // For copy-paste we render a plain JSON snippet that is also valid JSONC.
    snippet = JSON.stringify({ [rootKey]: { [entryKey]: value } }, null, 2)
  } else {
    const { content } = renderConfig(safeAgent, {
      transport: effectiveTransport,
      apiUrl: API_URL,
      serverName: SERVER_NAME,
      secretMode: effectiveSecretMode,
      apiKey,
    })
    snippet = content
  }

  const primaryLocation =
    safeAgent.locations.find((loc) => loc.sharedByConvention) ?? safeAgent.locations[0]
  notePath = primaryLocation?.path ?? "your agent's config file"
  notePrefix = "config"
  note = buildKeyNote(snippet)
} else if (safeAgent.installStrategy === "vendor-cli") {
  snippet = buildVendorCommand(safeAgent)
  note = buildKeyNote(snippet)
  notePrefix = "none"
  strategyNote =
    strategyNotes[safeAgent.id] ??
    `${safeAgent.displayName}: configured through its vendor CLI.`
} else {
  // guided-manual
  if (effectiveTransport === "remote-http" && safeAgent.transportFields?.["remote-http"]) {
    snippet = buildRemoteManualCommand(safeAgent)
    notePrefix = "remote"
    note = buildKeyNote(snippet)
  } else {
    snippet = buildManualCommand()
    notePrefix = "manual"
    note = buildKeyNote(snippet)
  }
  strategyNote =
    strategyNotes[safeAgent.id] ?? `${safeAgent.displayName}: requires manual configuration.`
}
---

{strategyNote && (
  <div class="callout callout--warn">
    <strong>Install type:</strong> {strategyNote}
  </div>
)}

{note && (
  <p class="callout">
    {notePrefix === "config" && (
      <>Add the following to <code>{notePath}</code>.{" "}</>
    )}
    {notePrefix === "remote" && <>Remote Streamable-HTTP setup.{" "}</>}
    {notePrefix === "manual" && (
      <>Use this command in a terminal, or enter the same values in the agent's MCP settings UI.{" "}</>
    )}
    {note}
  </p>
)}

<pre><code>{snippet}</code></pre>

{!secondary && (
  <div class="callout">
    <strong>One-line install:</strong>
    {safeAgent.installStrategy === "config-file"
      ? " the CLI writes exactly the configuration above."
      : safeAgent.installStrategy === "vendor-cli"
        ? " the CLI delegates this setup to the agent's own installer."
        : " the CLI prints these connection values; add them in the agent's own settings UI."}
    <pre><code>npx lyrashield install {agentId}</code></pre>
  </div>
)}

{!secondary && safeAgent.gotchas.length > 0 && (
  <>
    <h3>Important gotchas</h3>
    <ul>
      {safeAgent.gotchas.map((g) => (
        <li>{g}</li>
      ))}
    </ul>
  </>
)}
