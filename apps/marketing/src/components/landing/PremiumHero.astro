---
import premiumHeroAvif from "../../assets/premium-hero.avif"
import premiumHeroJpeg from "../../assets/premium-hero.jpg"
import premiumHeroWebp from "../../assets/premium-hero.webp"
---

<section class="premium-hero">
  <picture class="premium-hero__poster">
    <source srcset={premiumHeroAvif.src} type="image/avif" />
    <source srcset={premiumHeroWebp.src} type="image/webp" />
    <img
      src={premiumHeroJpeg.src}
      width={premiumHeroJpeg.width}
      height={premiumHeroJpeg.height}
      alt=""
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
  </picture>
  <div class="premium-hero__veil" aria-hidden="true"></div>
  <div class="premium-hero__content">
    <p class="premium-hero__eyebrow">
      Open beta · Live with open registration · Security that runs where you build
    </p>
    <h1 id="premium-hero-title">Ship AI-built apps with evidence, not hope.</h1>
    <p class="premium-hero__lede">
      LyraShield is release assurance for AI-built apps: one reviewable record that shows what you
      checked, what you found, what you fixed, and what a fresh retest actually confirmed before you
      shipped. You get a clear answer to "did we check it properly?" without claiming there are no
      issues.
    </p>
    <p class="premium-hero__audience">
      Built for vibe coders, solo builders, indie devs, and small teams shipping AI-built apps.
      Useful as a second pair of eyes for CTOs and security engineers reviewing that code.
    </p>
    <p class="premium-hero__difference">
      Install once in Cursor, Claude Code, VS Code + Copilot, Windsurf, and more (MCP), and get
      checks, fix proposals to review, and a shareable report without leaving your coding agent.
    </p>
    <div class="premium-hero__actions">
      <a class="premium-hero__primary" href="#free-scan" data-cta-id="premium-hero-lite-check">
        Run free Lite Check <span class="premium-hero__cta-reason">30 sec, no signup</span>
      </a>
      <a
        class="premium-hero__secondary"
        href="https://app.lyrashieldai.com/sign-up"
        data-cta-id="premium-hero-create-account"
      >
        Create free account <span class="premium-hero__cta-reason">full target → report loop</span>
      </a>
    </div>
    <p class="premium-hero__boundary">
      Passive + read-only. No codebase stored. No guarantee of no issues, just honest evidence.
      We're in open beta.
    </p>
  </div>

  <div class="premium-hero__artifact hidden lg:block" aria-hidden="true">
    <div class="premium-hero__artifact-card">
      <div class="premium-hero__artifact-header">
        <span class="premium-hero__artifact-dot"></span>
        <span class="premium-hero__artifact-status">Verified finding</span>
      </div>
      <p class="premium-hero__artifact-title">Server credential referenced by client build</p>
      <p class="premium-hero__artifact-meta">Target: mock-app.example</p>
      <p class="premium-hero__artifact-meta">Evidence: independent verification</p>
    </div>
  </div>

  <div class="premium-hero__rail" aria-hidden="true"><span>01</span><i></i><span>07</span></div>
</section>

<style>
  .premium-hero {
    --hero-cyan: #54d6df;
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
    min-height: min(720px, calc(100svh - 3.5rem));
    overflow: hidden;
    isolation: isolate;
    color: #edf6fb;
    background: #08111c;
  }

  @media (min-width: 1024px) {
    .premium-hero {
      grid-template-columns: 1fr minmax(18rem, 22rem);
      align-items: center;
      padding-inline: max(1rem, calc((100% - 1280px) / 2));
    }
  }

  .premium-hero__poster,
  .premium-hero__poster img,
  .premium-hero__veil {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .premium-hero__poster {
    z-index: -2;
  }

  .premium-hero__poster img {
    display: block;
    object-fit: cover;
    object-position: 68% 50%;
    filter: saturate(0.88) contrast(1.08);
  }

  .premium-hero__veil {
    z-index: -1;
    background:
      linear-gradient(90deg, rgba(8, 17, 28, 0.98) 0%, rgba(8, 17, 28, 0.89) 42%, rgba(8, 17, 28, 0.18) 78%),
      linear-gradient(180deg, rgba(8, 17, 28, 0.16), rgba(8, 17, 28, 0.88));
  }

  .premium-hero__content {
    align-self: center;
    width: min(100% - 2rem, 1280px);
    margin-inline: auto;
    padding-block: clamp(4rem, 8vh, 6.5rem) clamp(2.5rem, 5vh, 3.5rem);
  }

  @media (min-width: 1024px) {
    .premium-hero__content {
      width: auto;
      margin-inline: 0;
      max-width: none;
    }
  }

  .premium-hero__eyebrow,
  .premium-hero__boundary {
    font-family: "JetBrains Mono Variable", monospace;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .premium-hero__eyebrow {
    margin: 0 0 0.85rem;
    color: var(--hero-cyan);
    font-size: clamp(0.78rem, 1vw, 0.95rem);
    font-weight: 650;
  }

  h1 {
    max-width: 820px;
    margin: 0;
    font-family: "Bricolage Grotesque Variable", sans-serif;
    font-size: clamp(3.8rem, 7.4vw, 7.4rem);
    font-weight: 800;
    line-height: 0.9;
    letter-spacing: -0.055em;
    text-wrap: balance;
  }

  .premium-hero__lede {
    max-width: 640px;
    margin: 1rem 0 0;
    color: #b7cad8;
    font-size: clamp(1.05rem, 1.45vw, 1.28rem);
    line-height: 1.65;
  }

  /* Who-it's-for and the MCP differentiator sit below the lede at a step down in
     size, so the hero still reads as one block rather than four competing ones. */
  .premium-hero__audience,
  .premium-hero__difference {
    max-width: 640px;
    margin: 0.75rem 0 0;
    color: #91a7b8;
    font-size: clamp(0.94rem, 1.1vw, 1.02rem);
    line-height: 1.6;
  }

  .premium-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 1.35rem;
  }

  .premium-hero__actions a {
    display: inline-flex;
    min-height: 3.25rem;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(84, 214, 223, 0.42);
    border-radius: 0.25rem;
    padding: 0.85rem 1.25rem;
    font-weight: 750;
    text-decoration: none;
    transition: transform 160ms ease, background-color 160ms ease, border-color 160ms ease;
  }

  .premium-hero__actions a:hover {
    transform: translateY(-2px);
  }

  .premium-hero__actions a:focus-visible {
    outline: 3px solid #f5b84b;
    outline-offset: 4px;
  }

  .premium-hero__primary {
    color: #08111c;
    background: var(--hero-cyan);
    box-shadow: 0 0 38px rgba(84, 214, 223, 0.18);
  }

  .premium-hero__secondary {
    gap: 1.5rem;
    color: #edf6fb;
    background: rgba(8, 17, 28, 0.62);
  }

  /* The reason-to-click rides inside the button, one step down and dimmer, so the
     label stays the thing you read first. */
  .premium-hero__cta-reason {
    display: block;
    margin-top: 0.15rem;
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    text-transform: none;
    opacity: 0.75;
  }

  .premium-hero__boundary {
    margin: 0.9rem 0 0;
    color: #91a7b8;
    font-size: 0.69rem;
    line-height: 1.6;
  }

  .premium-hero__rail {
    position: absolute;
    right: clamp(1rem, 3vw, 3rem);
    bottom: 2.25rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: #91a7b8;
    font: 600 0.66rem/1 "JetBrains Mono Variable", monospace;
  }

  .premium-hero__rail i {
    display: block;
    width: min(10vw, 7rem);
    height: 1px;
    background: linear-gradient(90deg, var(--hero-cyan), rgba(84, 214, 223, 0.15));
  }

  /* Mobile tightening (visual QA found both CTAs below the fold at 390px).
     Desktop is untouched: this query only applies under 480px, well below the
     1024px breakpoint that switches the hero to its two-column layout.
     Strategy: shrink the H1 and line spacing so less height is spent before
     any text, then reflow with flex order so the primary CTA renders right
     after the lede instead of after two more paragraphs. The who-it's-for and
     MCP-differentiator lines still exist in the DOM in their original reading
     order (unchanged for screen readers and SEO); only their painted position
     moves below the buttons on small screens. */
  @media (max-width: 480px) {
    .premium-hero__content {
      display: flex;
      flex-direction: column;
      padding-block: clamp(3rem, 8vh, 4rem) clamp(1.75rem, 5vh, 2.5rem);
    }

    .premium-hero__eyebrow {
      order: 0;
      font-size: 0.68rem;
    }

    h1 {
      order: 1;
      font-size: clamp(2.35rem, 10.5vw, 2.9rem);
      line-height: 1.02;
      letter-spacing: -0.035em;
    }

    .premium-hero__lede {
      order: 2;
      margin-top: 0.75rem;
      font-size: 0.98rem;
      line-height: 1.55;
    }

    .premium-hero__actions {
      order: 3;
      margin-top: 1.1rem;
    }

    .premium-hero__actions a {
      min-height: 2.9rem;
      padding: 0.7rem 1.05rem;
    }

    .premium-hero__audience {
      order: 4;
      margin-top: 1.1rem;
      font-size: 0.85rem;
    }

    .premium-hero__difference {
      order: 5;
      font-size: 0.85rem;
    }

    .premium-hero__boundary {
      order: 6;
    }
  }

  .premium-hero__artifact {
    align-self: center;
    justify-self: end;
    width: 100%;
    padding-right: clamp(0.5rem, 2vw, 1.5rem);
    z-index: 2;
  }

  .premium-hero__artifact-card {
    width: 100%;
    max-width: 22rem;
    border: 1px solid rgba(84, 214, 223, 0.24);
    border-radius: 0.35rem;
    padding: 1.1rem 1.25rem;
    background: rgba(8, 17, 28, 0.82);
    box-shadow: 0 1rem 3rem rgba(0, 0, 0, 0.28);
    backdrop-filter: blur(8px);
  }

  .premium-hero__artifact-header {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.75rem;
  }

  .premium-hero__artifact-dot {
    display: block;
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--hero-cyan);
    box-shadow: 0 0 14px var(--hero-cyan);
  }

  .premium-hero__artifact-status {
    color: var(--hero-cyan);
    font: 600 0.7rem/1 "JetBrains Mono Variable", monospace;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .premium-hero__artifact-title {
    margin: 0;
    color: #edf6fb;
    font-size: clamp(1rem, 1.35vw, 1.15rem);
    font-weight: 650;
    line-height: 1.35;
  }

  .premium-hero__artifact-meta {
    margin: 0.4rem 0 0;
    color: #91a7b8;
    font: 500 0.75rem/1.5 "JetBrains Mono Variable", monospace;
  }

  @media (max-width: 1023px) {
    .premium-hero__artifact {
      display: none;
    }
  }

  @media (max-width: 720px) {
    .premium-hero {
      min-height: calc(100svh - 3.5rem);
    }

    .premium-hero__poster img {
      object-position: 58% 50%;
    }

    .premium-hero__veil {
      background: linear-gradient(180deg, rgba(8, 17, 28, 0.72) 0%, rgba(8, 17, 28, 0.98) 68%);
    }

    .premium-hero__content {
      align-self: end;
      padding-block: 9rem 5.5rem;
    }

    h1 {
      font-size: clamp(3.25rem, 15vw, 5.2rem);
    }

    .premium-hero__actions {
      display: grid;
    }

    .premium-hero__rail {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .premium-hero__actions a {
      transition: none;
    }
  }
</style>
