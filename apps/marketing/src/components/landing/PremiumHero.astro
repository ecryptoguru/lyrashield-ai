---
import { CTA_LABEL, TRIAL_LINE } from "../../lib/site-copy"

// Same flag the Lite Check section uses: with no scanner configured the field
// is disabled and shows the same status line, so the hero never offers a
// control that cannot work.
const scannerAvailable = Boolean(__MARKETING_SCANNER_URL__.replace(/\/$/, ""))
import premiumHeroAvif from "../../assets/premium-hero.avif"
import premiumHeroJpeg from "../../assets/premium-hero.jpg"
import premiumHeroWebp from "../../assets/premium-hero.webp"
---

<section class="premium-hero">
  <picture class="premium-hero__poster">
    <source srcset={premiumHeroAvif.src} type="image/avif" />
    <source srcset={premiumHeroWebp.src} type="image/webp" />
    <img
      src={premiumHeroJpeg.src}
      width={premiumHeroJpeg.width}
      height={premiumHeroJpeg.height}
      alt="Abstract 3D scene of glowing cyan rails and geometric shapes on a dark navy background, behind the LyraShield hero headline"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
  </picture>
  <div class="premium-hero__veil" aria-hidden="true"></div>
  <div class="premium-hero__content">
    <p class="premium-hero__eyebrow">
      Open beta · Security review for AI-built apps
    </p>
    <h1 id="premium-hero-title">The launch gate for AI-built apps.</h1>
    <p class="premium-hero__lede">
      Point LyraShield at a repository, URL or API you are authorized to test. It reviews what
      your coding agents shipped and returns one verdict: ready, not ready or insufficient
      evidence.
    </p>
    <ul class="premium-hero__proof">
      <li>Every finding shows its evidence</li>
      <li>Fixes are proposals you approve</li>
      <li>A fresh retest confirms each fix</li>
    </ul>

    <div class="premium-hero__actions">
      <a
        class="premium-hero__primary"
        href="https://app.lyrashieldai.com/sign-up?source=landing_hero&cta=start_trial"
        data-cta-id="premium-hero-primary"
      >
        {CTA_LABEL.signUp}
      </a>
      <a
        class="premium-hero__secondary"
        href="#free-scan" data-cta-id="premium-hero-lite-check"
      >
        Run the free Lite Check
      </a>
    </div>

    <form id="hero-lite-form" class="premium-hero__field" action="/scan" method="get" novalidate>
      <label class="premium-hero__field-label" for="hero-scan-url">Public app URL</label>
      <div class="premium-hero__field-row">
        <input
          id="hero-scan-url"
          type="text"
          inputmode="url"
          autocomplete="url"
          maxlength="2048"
          placeholder="example.com or https://your-app.com"
          disabled={!scannerAvailable}
          class="premium-hero__field-input"
        />
        <button
          type="submit"
          disabled={!scannerAvailable}
          data-cta-id="hero_lite_check_submit"
          class="premium-hero__field-button"
        >
          Run Lite Check
        </button>
      </div>
      <label class="premium-hero__field-consent">
        <input
          id="hero-scan-authorized"
          type="checkbox"
          disabled={!scannerAvailable}
          class="premium-hero__field-check"
        />
        <span
          >I own this app or have permission to test it. The check is passive and read-only. By
          scanning I agree to the <a href="/terms">Terms</a>.</span
        >
      </label>
      {
        !scannerAvailable && (
          <p class="premium-hero__field-status" role="status">
            The separately protected scanner API is not connected in this environment.
          </p>
        )
      }
      <p id="hero-scan-error" class="premium-hero__field-error hidden" role="alert"></p>
      <noscript>
        <p class="premium-hero__field-status">
          <a href="/scan">Open the free Lite Check</a> to run the check without JavaScript.
        </p>
      </noscript>
    </form>
    <p class="premium-hero__trial-note">{TRIAL_LINE}</p>
    <a
      class="premium-hero__agent-link"
      href="/agents"
      data-cta-id="premium-hero-agent-setup"
    >
      Set up LyraShield in your coding agent →
    </a>
    <p class="premium-hero__boundary">
      Evidence is limited to the authorized scope and the checks that ran. No security guarantee.
    </p>
  </div>

  <figure class="premium-hero__artifact" aria-labelledby="premium-hero-artifact-caption">
    <figcaption id="premium-hero-artifact-caption" class="premium-hero__artifact-sample">
      Sample verdict card
    </figcaption>
    <div class="premium-hero__artifact-card">
      <div class="premium-hero__artifact-header">
        <span class="premium-hero__artifact-dot"></span>
        <span class="premium-hero__artifact-status">Verdict · Insufficient evidence</span>
      </div>
      <ul class="premium-hero__artifact-findings">
        <li>
          <span class="premium-hero__artifact-state">Detected</span>{" "}
          Server credential referenced by client build
        </li>
        <li>
          <span class="premium-hero__artifact-state">Detected</span>{" "}
          Missing rate limit on login route
        </li>
      </ul>
      <p class="premium-hero__artifact-meta">7 controls need your evidence</p>
      <p class="premium-hero__artifact-meta">Evidence: bounded to the checks that ran</p>
    </div>
  </figure>
</section>

<style>
  .premium-hero {
    --hero-cyan: #54d6df;
    position: relative;
    display: grid;
    /* minmax(0, 1fr), not 1fr: a bare fr track keeps an auto minimum equal to
       its items' min-content width, so one long word in the headline grew the
       whole track past the viewport at 200% text. */
    grid-template-columns: minmax(0, 1fr);
    min-height: min(720px, calc(100svh - 3.5rem));
    overflow: hidden;
    isolation: isolate;
    color: #edf6fb;
    background: #08111c;
  }

  @media (min-width: 1024px) {
    .premium-hero {
      grid-template-columns: 1fr minmax(18rem, 22rem);
      align-items: center;
      padding-inline: max(1rem, calc((100% - 1280px) / 2));
    }
  }

  .premium-hero__poster,
  .premium-hero__poster img,
  .premium-hero__veil {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .premium-hero__poster {
    z-index: -2;
  }

  .premium-hero__poster img {
    display: block;
    object-fit: cover;
    object-position: 68% 50%;
    filter: saturate(0.88) contrast(1.08);
  }

  .premium-hero__veil {
    z-index: -1;
    background:
      linear-gradient(90deg, rgba(8, 17, 28, 0.98) 0%, rgba(8, 17, 28, 0.89) 42%, rgba(8, 17, 28, 0.18) 78%),
      linear-gradient(180deg, rgba(8, 17, 28, 0.16), rgba(8, 17, 28, 0.88));
  }

  .premium-hero__content {
    align-self: center;
    min-width: 0;
    width: min(100% - 2rem, 1280px);
    margin-inline: auto;
    padding-block: clamp(4rem, 8vh, 6.5rem) clamp(2.5rem, 5vh, 3.5rem);
  }

  @media (min-width: 1024px) {
    .premium-hero__content {
      width: auto;
      margin-inline: 0;
      max-width: none;
    }
  }

  .premium-hero__eyebrow,
  .premium-hero__boundary {
    font-family: "JetBrains Mono Variable", monospace;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .premium-hero__eyebrow {
    margin: 0 0 0.85rem;
    color: var(--hero-cyan);
    font-size: clamp(0.78rem, 1vw, 0.95rem);
    font-weight: 650;
    overflow-wrap: anywhere;
  }

  h1 {
    max-width: 820px;
    margin: 0;
    font-family: "Bricolage Grotesque Variable", sans-serif;
    font-size: clamp(3.8rem, 7.4vw, 7.4rem);
    font-weight: 800;
    line-height: 0.9;
    letter-spacing: -0.055em;
    text-wrap: balance;
    overflow-wrap: anywhere;
  }

  .premium-hero__lede {
    max-width: 640px;
    margin: 1rem 0 0;
    color: #b7cad8;
    font-size: clamp(1.05rem, 1.45vw, 1.28rem);
    line-height: 1.65;
  }

  .premium-hero__proof {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin: 1rem 0 0;
    padding: 0;
    color: #b7cad8;
    font: 600 0.78rem/1.5 "JetBrains Mono Variable", monospace;
    list-style: none;
  }

  .premium-hero__proof li {
    max-width: 100%;
  }

  .premium-hero__proof li::before {
    margin-right: 0.45rem;
    color: var(--hero-cyan);
    content: "✓";
  }

  .premium-hero__field {
    max-width: 34rem;
    margin-top: 1.35rem;
  }

  .premium-hero__field-label {
    display: block;
    color: #b7cad8;
    font: 600 0.72rem/1.4 "JetBrains Mono Variable", monospace;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .premium-hero__field-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 0.5rem;
  }

  .premium-hero__field-input {
    flex: 1 1 12rem;
    min-width: 0;
    max-width: 100%;
    min-height: 3.25rem;
    border: 1px solid rgba(84, 214, 223, 0.3);
    border-radius: 0.25rem;
    padding: 0.7rem 0.9rem;
    color: #edf6fb;
    background: rgba(8, 17, 28, 0.72);
    font-size: 1rem;
  }

  .premium-hero__field-input::placeholder {
    color: #7d92a4;
  }

  .premium-hero__field-input:focus-visible {
    border-color: var(--hero-cyan);
    outline: 3px solid #f5b84b;
    outline-offset: 2px;
  }

  .premium-hero__field-button {
    flex: 0 1 auto;
    min-height: 3.25rem;
    max-width: 100%;
    border: 1px solid var(--hero-cyan);
    border-radius: 0.25rem;
    padding: 0.7rem 1.15rem;
    color: #08111c;
    background: var(--hero-cyan);
    font-size: 0.95rem;
    font-weight: 750;
    overflow-wrap: anywhere;
    cursor: pointer;
  }

  .premium-hero__field-input:disabled,
  .premium-hero__field-button:disabled {
    cursor: not-allowed;
    opacity: 0.55;
  }

  .premium-hero__field-consent {
    display: flex;
    gap: 0.6rem;
    margin-top: 0.6rem;
    color: #b7cad8;
    font-size: 0.8rem;
    line-height: 1.5;
  }

  .premium-hero__field-consent a {
    color: var(--hero-cyan);
    text-underline-offset: 3px;
  }

  .premium-hero__field-check {
    flex: none;
    margin-top: 0.2rem;
    width: 1rem;
    height: 1rem;
    accent-color: var(--hero-cyan);
  }

  .premium-hero__field-status,
  .premium-hero__field-error {
    margin: 0.6rem 0 0;
    font-size: 0.8rem;
    line-height: 1.5;
  }

  .premium-hero__field-status {
    color: #91a7b8;
  }

  .premium-hero__field-error {
    color: #ff9b93;
  }

  .premium-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 1.35rem;
  }

  .premium-hero__actions a {
    display: inline-flex;
    min-height: 3.25rem;
    /* At 200% root text on a 320px viewport the label plus padding is wider
       than the screen, so the box must be capped and the label allowed to
       wrap. Without this the button clipped off the right edge. */
    max-width: 100%;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(84, 214, 223, 0.42);
    border-radius: 0.25rem;
    padding: 0.85rem 1.25rem;
    font-weight: 750;
    text-decoration: none;
    transition: transform 160ms ease, background-color 160ms ease, border-color 160ms ease;
  }

  .premium-hero__actions a:hover {
    transform: translateY(-2px);
  }

  .premium-hero__actions a:focus-visible {
    outline: 3px solid #f5b84b;
    outline-offset: 4px;
  }

  .premium-hero__primary {
    color: #08111c;
    background: var(--hero-cyan);
    box-shadow: 0 0 38px rgba(84, 214, 223, 0.18);
  }

  .premium-hero__secondary {
    gap: 1.5rem;
    color: #edf6fb;
    background: rgba(8, 17, 28, 0.62);
  }

  .premium-hero__trial-note {
    margin: 0.7rem 0 0;
    color: #b8c9d6;
    font-size: 0.82rem;
    line-height: 1.55;
  }

  .premium-hero__agent-link {
    display: flex;
    width: fit-content;
    margin-top: 0.85rem;
    color: var(--hero-cyan);
    font-size: 0.85rem;
    font-weight: 650;
    text-decoration: underline;
    text-decoration-color: rgba(84, 214, 223, 0.45);
    text-underline-offset: 0.3rem;
  }

  .premium-hero__agent-link:hover,
  .premium-hero__agent-link:focus-visible {
    color: #edf6fb;
  }

  .premium-hero__boundary {
    margin: 0.9rem 0 0;
    color: #91a7b8;
    font-size: 0.69rem;
    line-height: 1.6;
  }

  @media (prefers-reduced-motion: no-preference) {
    .premium-hero__poster img {
      animation: hero-settle 1.6s cubic-bezier(0.22, 1, 0.36, 1) both;
    }

    .premium-hero__eyebrow,
    .premium-hero h1,
    .premium-hero__lede,
    .premium-hero__proof,
    .premium-hero__actions,
    .premium-hero__boundary,
    .premium-hero__artifact {
      animation: hero-rise 0.68s cubic-bezier(0.22, 1, 0.36, 1) both;
    }

    .premium-hero h1 { animation-delay: 70ms; }
    .premium-hero__lede { animation-delay: 130ms; }
    .premium-hero__proof { animation-delay: 190ms; }
    .premium-hero__actions { animation-delay: 250ms; }
    .premium-hero__artifact { animation-delay: 310ms; }
    .premium-hero__boundary { animation-delay: 370ms; }

    @keyframes hero-rise {
      from { opacity: 0; transform: translateY(1rem); }
      to { opacity: 1; transform: none; }
    }

    @keyframes hero-settle {
      from { opacity: 0.72; transform: scale(1.035); }
      to { opacity: 1; transform: scale(1); }
    }
  }

  /* Keep the account action visible in the first mobile viewport. */
  @media (max-width: 480px) {
    .premium-hero__content {
      display: flex;
      flex-direction: column;
      padding-block: clamp(3rem, 8vh, 4rem) clamp(1.75rem, 5vh, 2.5rem);
    }

    .premium-hero__eyebrow {
      order: 0;
      font-size: 0.68rem;
    }

    h1 {
      order: 1;
      font-size: clamp(2.35rem, 10.5vw, 2.9rem);
      line-height: 1.02;
      letter-spacing: -0.035em;
    }

    .premium-hero__lede {
      order: 2;
      margin-top: 0.75rem;
      font-size: 0.98rem;
      line-height: 1.55;
    }

    .premium-hero__proof {
      order: 3;
    }

    /* The field is the primary action on a phone, so it sits above the sign-up
       button and the secondary link. */
    .premium-hero__actions {
      order: 4;
      margin-top: 1.1rem;
    }

    .premium-hero__actions a {
      min-height: 2.9rem;
      padding: 0.7rem 1.05rem;
    }

    .premium-hero__field {
      order: 5;
    }

    .premium-hero__trial-note {
      order: 6;
    }

    .premium-hero__agent-link {
      order: 7;
    }

    .premium-hero__boundary {
      order: 8;
    }
  }

  .premium-hero__artifact {
    align-self: center;
    justify-self: end;
    width: 100%;
    padding-right: clamp(0.5rem, 2vw, 1.5rem);
    z-index: 2;
  }

  .premium-hero__artifact-card {
    width: 100%;
    max-width: 22rem;
    border: 1px solid rgba(84, 214, 223, 0.24);
    border-radius: 0.35rem;
    padding: 1.1rem 1.25rem;
    background: rgba(8, 17, 28, 0.82);
    box-shadow: 0 1rem 3rem rgba(0, 0, 0, 0.28);
    backdrop-filter: blur(8px);
  }

  .premium-hero__artifact-header {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.75rem;
  }

  .premium-hero__artifact-dot {
    display: block;
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--hero-cyan);
    box-shadow: 0 0 14px var(--hero-cyan);
  }

  .premium-hero__artifact-status {
    color: var(--hero-cyan);
    font: 600 0.7rem/1 "JetBrains Mono Variable", monospace;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .premium-hero__artifact-title {
    margin: 0;
    color: #edf6fb;
    font-size: clamp(1rem, 1.35vw, 1.15rem);
    font-weight: 650;
    line-height: 1.35;
  }

  .premium-hero__artifact-meta {
    margin: 0.4rem 0 0;
    color: #91a7b8;
    font: 500 0.75rem/1.5 "JetBrains Mono Variable", monospace;
  }

  .premium-hero__artifact-sample {
    margin: 0 0 0.4rem;
    color: #91a7b8;
    font: 600 0.66rem/1 "JetBrains Mono Variable", monospace;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .premium-hero__artifact-findings {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .premium-hero__artifact-findings li {
    display: grid;
    gap: 0.25rem;
    color: #edf6fb;
    font-size: 0.86rem;
    font-weight: 600;
    line-height: 1.4;
  }

  /* Only Detected is ever shown on this card: the artifact is a synthetic
     sample, so it must never claim a retest-confirmed or verified state. */
  .premium-hero__artifact-state {
    width: fit-content;
    border: 1px solid rgba(84, 214, 223, 0.42);
    border-radius: 0.2rem;
    padding: 0.1rem 0.4rem;
    color: var(--hero-cyan);
    font: 600 0.62rem/1.4 "JetBrains Mono Variable", monospace;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  /* The sample verdict card is part of the promise, so it is shown at every
     width instead of being hidden below the two-column breakpoint. */
  @media (max-width: 1023px) {
    .premium-hero__artifact {
      align-self: start;
      justify-self: stretch;
      padding: 0 1rem 2.5rem;
    }

    .premium-hero__artifact-card {
      max-width: none;
    }
  }

  @media (min-width: 1024px) {
    .premium-hero__artifact-sample {
      margin-bottom: 0.5rem;
      text-align: right;
    }
  }

  @media (max-width: 720px) {
    .premium-hero {
      min-height: calc(100svh - 3.5rem);
    }

    /* Flex would shrink both controls onto one line rather than wrap them, so
       the phone layout is an explicit single column with full-width targets. */
    .premium-hero__field-row {
      display: grid;
    }

    .premium-hero__field-input,
    .premium-hero__field-button {
      width: 100%;
    }

    .premium-hero__poster img {
      object-position: 58% 50%;
    }

    .premium-hero__veil {
      background: linear-gradient(180deg, rgba(8, 17, 28, 0.72) 0%, rgba(8, 17, 28, 0.98) 68%);
    }

    .premium-hero__content {
      align-self: end;
      padding-block: 9rem 5.5rem;
    }

    h1 {
      font-size: clamp(3.25rem, 15vw, 5.2rem);
    }

    .premium-hero__actions {
      display: grid;
    }

  }

  @media (max-width: 480px) {
    .premium-hero__content {
      padding-block: 3.25rem 3rem;
    }

    h1 {
      font-size: clamp(2.35rem, 10.5vw, 2.9rem);
    }

    .premium-hero__proof {
      display: grid;
      gap: 0.25rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .premium-hero__actions a {
      transition: none;
    }
  }
</style>

<style>

  :global(:root[data-theme="light"]) .premium-hero {
    --hero-cyan: #087f78;
    color: #102235;
    background: #eef6fa;
  }

  :global(:root[data-theme="light"]) .premium-hero__poster img {
    opacity: 0.38;
    filter: saturate(0.58) contrast(0.9) brightness(1.2);
  }

  :global(:root[data-theme="light"]) .premium-hero__veil {
    background:
      linear-gradient(90deg, rgba(245, 249, 252, 0.99) 0%, rgba(245, 249, 252, 0.94) 45%, rgba(245, 249, 252, 0.28) 82%),
      linear-gradient(180deg, rgba(245, 249, 252, 0.22), rgba(238, 246, 250, 0.96));
  }

  :global(:root[data-theme="light"]) .premium-hero__lede,
  :global(:root[data-theme="light"]) .premium-hero__proof {
    color: #40596c;
  }

  /* Light theme: the documented light accent (#087f78) only reaches 4.44:1
     against the hero's #eef6fa surface — just under the 4.5:1 AA threshold for
     this 13.6px normal-weight link. #076c66 is the same teal darkened (hue and
     saturation untouched) and reaches 5.74:1. Dark theme keeps #54d6df. */
  :global(:root[data-theme="light"]) .premium-hero__agent-link {
    color: #076c66;
  }

  :global(:root[data-theme="light"]) .premium-hero__agent-link:hover,
  :global(:root[data-theme="light"]) .premium-hero__agent-link:focus-visible {
    color: #102235;
  }

  :global(:root[data-theme="light"]) .premium-hero__boundary,
  :global(:root[data-theme="light"]) .premium-hero__artifact-meta,
  :global(:root[data-theme="light"]) .premium-hero__artifact-sample {
    color: #5f7081;
  }

  :global(:root[data-theme="light"]) .premium-hero__primary {
    color: #ffffff; /* 4.86:1 on #087f78 */
    background: #087f78;
    box-shadow: 0 0.8rem 2.5rem rgba(8, 127, 120, 0.18);
  }

  :global(:root[data-theme="light"]) .premium-hero__secondary {
    color: #102235;
    background: rgba(255, 255, 255, 0.82);
  }

  :global(:root[data-theme="light"]) .premium-hero__trial-note {
    color: #3c5568;
  }

  :global(:root[data-theme="light"]) .premium-hero__artifact-card {
    border-color: rgba(8, 127, 120, 0.25);
    background: rgba(255, 255, 255, 0.88);
    box-shadow: 0 1rem 3rem rgba(39, 75, 94, 0.16);
  }

  :global(:root[data-theme="light"]) .premium-hero__artifact-title {
    color: #102235;
  }

  /* The URL field and the sample-card finding rows carried dark-theme colours
     with no light override, so on the light hero the "Public app URL" label and
     the consent sentence sat near 1.6:1 on #eef6fa, the input stayed a heavy
     dark box and the two finding titles were near-white on the white card.
     Every colour below clears 4.5:1 against the surface it actually renders on. */
  :global(:root[data-theme="light"]) .premium-hero__field-label {
    color: #3c5568; /* 7.13:1 on #eef6fa */
  }

  :global(:root[data-theme="light"]) .premium-hero__field-input {
    border-color: rgba(8, 127, 120, 0.35);
    color: #102235; /* 16.13:1 on #ffffff */
    background: #ffffff;
  }

  :global(:root[data-theme="light"]) .premium-hero__field-input::placeholder {
    color: #5f7081; /* 5.10:1 on #ffffff */
  }

  /* The dark theme's amber focus ring reaches only 1.62:1 on the light hero, so
     the light theme reuses the darkened teal already used for the hero link. */
  :global(:root[data-theme="light"]) .premium-hero__field-input:focus-visible {
    border-color: #087f78;
    outline: 3px solid #076c66;
  }

  :global(:root[data-theme="light"]) .premium-hero__field-consent {
    color: #40596c; /* 6.70:1 on #eef6fa */
  }

  :global(:root[data-theme="light"]) .premium-hero__field-consent a {
    color: #076c66; /* 5.74:1 on #eef6fa */
  }

  :global(:root[data-theme="light"]) .premium-hero__field-status {
    color: #3c5568; /* 7.13:1 on #eef6fa */
  }

  :global(:root[data-theme="light"]) .premium-hero__field-error {
    color: #b42318; /* 6.01:1 on #eef6fa */
  }

  :global(:root[data-theme="light"]) .premium-hero__artifact-findings li {
    color: #102235; /* 15.96:1 on the light card */
  }

  :global(:root[data-theme="light"]) .premium-hero__artifact-state {
    border-color: rgba(8, 127, 120, 0.42);
    color: #087f78;
  }

  @media (max-width: 720px) {
    :global(:root[data-theme="light"]) .premium-hero__veil {
      background: linear-gradient(
        180deg,
        rgba(245, 249, 252, 0.5) 0%,
        rgba(245, 249, 252, 0.97) 62%
      );
    }
  }
</style>

<script>
  import { bindLiteHandoff } from "../../lib/lite-handoff"
  import { sanitizeMarketingProperties } from "../../lib/posthog-privacy"

  // The hero field never fetches anything. It validates, parks the target for
  // /scan and navigates, exactly like the Lite Check section further down.
  //
  // Analytics carry the CTA id and a boolean only. The typed URL is never a
  // property, so it cannot leave this component.
  const capture = (valid: boolean) =>
    window.posthog?.capture(
      "hero_lite_check_submit",
      sanitizeMarketingProperties("hero_lite_check_submit", {
        cta_id: "hero_lite_check_submit",
        valid,
      }) ?? {}
    )

  const error = () => document.querySelector<HTMLElement>("#hero-scan-error")
  bindLiteHandoff({
    formId: "hero-lite-form",
    inputId: "hero-scan-url",
    errorId: "hero-scan-error",
    consentId: "hero-scan-authorized",
    onClear: () => error()?.classList.add("hidden"),
    onError: (message) => {
      const node = error()
      if (!node) return
      node.textContent = message
      node.classList.remove("hidden")
      capture(false)
    },
    onSuccess: () => capture(true),
  })
</script>
