---
import { CTA_LABEL, TRIAL_LINE } from "../../lib/site-copy"
import premiumHeroAvif from "../../assets/premium-hero.avif"
import premiumHeroWebp from "../../assets/premium-hero.webp"
import premiumHeroJpeg from "../../assets/premium-hero.jpg"
interface Props { cinematic?: boolean }
const { cinematic = false } = Astro.props
---
<section class:list={["premium-hero", { "premium-hero--cinematic": cinematic }]}>
  {!cinematic && <picture class="premium-hero__poster">
    <source srcset={premiumHeroAvif.src} type="image/avif" />
    <source srcset={premiumHeroWebp.src} type="image/webp" />
    <img src={premiumHeroJpeg.src} width={premiumHeroJpeg.width} height={premiumHeroJpeg.height} alt="" loading="eager" fetchpriority="high" decoding="async" />
  </picture>}
  <div class="premium-hero__veil" aria-hidden="true"></div>
  <div class="premium-hero__content">
    <h1 id="premium-hero-title">The launch gate<br /> for AI-built apps.</h1>
    <p class="premium-hero__lede">Review your repo, website or API. See the findings, approve proposed fixes, and retest before you ship.</p>
    <div class="premium-hero__actions">
      <a class="premium-hero__primary" href="https://app.lyrashieldai.com/sign-up?source=landing_hero&cta=start_trial" data-cta-id="premium-hero-primary">{CTA_LABEL.signUp}<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M4 12h15m-6-6 6 6-6 6" /></svg></a>
      <a class="premium-hero__secondary" href="#how-it-works" data-cta-id="premium-hero-workflow">Explore the workflow</a>
    </div>
    <p class="premium-hero__trial-note">{TRIAL_LINE}</p>
    <p class="premium-hero__proof">Evidence attached. Fixes need approval.</p>
  </div>
  <div class="premium-hero__scene-space" aria-hidden="true"></div>
  <a class="premium-hero__scroll" href="#how-it-works" aria-label="Explore how LyraShield works"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M12 4v15m-6-6 6 6 6-6" /></svg></a>
</section>
<script>import "./landing-effects"</script>
<style>
  .premium-hero { position: relative; isolation: isolate; overflow: hidden; display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, .8fr); align-items: center; min-height: min(760px, calc(100svh - 4rem)); padding: 5rem max(1.5rem, calc((100% - 1200px) / 2)); color: #edf6fb; background: #08111c; }
  .premium-hero__poster, .premium-hero__poster img, .premium-hero__veil { position: absolute; inset: 0; width: 100%; height: 100%; z-index: -1; }
  .premium-hero__poster img { object-fit: cover; }
  .premium-hero__veil { background: linear-gradient(90deg, rgba(8,17,28,.98), rgba(8,17,28,.9) 36%, rgba(8,17,28,.05) 82%); }
  .premium-hero__content { min-width: 0; max-width: 46rem; }
  h1 { margin: 0; font-family: "Bricolage Grotesque Variable", sans-serif; font-size: clamp(3rem, 6.4vw, 6rem); font-weight: 800; letter-spacing: -.04em; line-height: 1.02; text-wrap: balance; overflow-wrap: anywhere; }
  .premium-hero__lede { max-width: 38ch; margin: 1.5rem 0 0; font-size: clamp(1.05rem, 1.4vw, 1.2rem); line-height: 1.65; color: #c3d8e6; }
  .premium-hero__actions { display: flex; flex-wrap: wrap; align-items: center; gap: .75rem 1.25rem; margin-top: 2rem; }
  .premium-hero__actions a { display: inline-flex; align-items: center; justify-content: center; gap: .75rem; min-height: 52px; padding: .8rem 1.25rem; border-radius: .5rem; font-size: .95rem; font-weight: 650; }
  .premium-hero__primary { background: #89dfeb; color: #08111c; }
  .premium-hero__secondary { border: 1px solid #698393; background: #0e1a28; color: #edf6fb; }
  .premium-hero__primary svg { transition: transform 160ms cubic-bezier(.16,1,.3,1); }
  .premium-hero__primary:hover { background: #bceaf5; transform: translateY(-2px); }
  .premium-hero__primary:hover svg { transform: translateX(3px); }
  .premium-hero__secondary:hover { border-color: #bceaf5; background: #172a3b; }
  a:focus-visible { outline: 3px solid #f5b84b; outline-offset: 4px; }
  .premium-hero__trial-note { margin: .9rem 0 0; color: #c3d8e6; font-size: .8rem; line-height: 1.6; }
  .premium-hero__proof { margin: 2.5rem 0 0; color: #c3d8e6; font-size: .875rem; line-height: 1.6; }
  .premium-hero__scroll { position: absolute; bottom: 1rem; left: max(1.5rem, calc((100% - 1200px) / 2)); display: grid; place-items: center; width: 44px; height: 44px; color: #c3d8e6; border: 1px solid #698393; border-radius: 50%; }
  :global(:root[data-theme="light"]) .premium-hero { color: #102235; }
  :global(:root[data-theme="light"]) .premium-hero__veil { background: linear-gradient(90deg, #f5f9fc, rgba(245,249,252,.97) 36%, rgba(245,249,252,.05) 85%); }
  :global(:root[data-theme="light"]) .premium-hero__lede, :global(:root[data-theme="light"]) .premium-hero__trial-note, :global(:root[data-theme="light"]) .premium-hero__proof, :global(:root[data-theme="light"]) .premium-hero__scroll { color: #415568; }
  :global(:root[data-theme="light"]) .premium-hero__primary { background: #087f78; color: #fff; }
  :global(:root[data-theme="light"]) .premium-hero__primary:hover { background: #066860; }
  :global(:root[data-theme="light"]) .premium-hero__secondary { background: #fff; color: #102235; border-color: #8c9ea9; }
  @media (max-width: 1023px) {
    .premium-hero { display: flex; flex-direction: column; align-items: stretch; justify-content: start; min-height: calc(100svh - 4rem); padding: clamp(4rem, 10svh, 6rem) 1.25rem 0; }
    .premium-hero__content { position: relative; z-index: 1; }
    h1 { font-size: clamp(2.65rem, 7.5vw, 5rem); }
    .premium-hero__lede { margin-top: 1rem; }
    .premium-hero__actions { margin-top: 1.5rem; }
    .premium-hero__proof { margin-top: 1.25rem; }
    .premium-hero__scene-space { min-height: 10rem; flex: 1; }
    .premium-hero__veil { background: linear-gradient(180deg, #08111c 0%, rgba(8,17,28,.97) 38%, rgba(8,17,28,.65) 62%, transparent 85%); }
    :global(:root[data-theme="light"]) .premium-hero__veil { background: linear-gradient(180deg, #f5f9fc 0%, rgba(245,249,252,.98) 38%, rgba(245,249,252,.7) 62%, transparent 85%); }
    .premium-hero__scroll { left: auto; right: 1.25rem; background: #0e1a28; color: #c3d8e6; }
    :global(:root[data-theme="light"]) .premium-hero__scroll { background: #f5f9fc; }
  }
  @media (max-width: 480px) {
    h1 { font-size: clamp(2.5rem, 10.7vw, 3.2rem); }
    .premium-hero__actions { gap: .65rem; }
    .premium-hero__actions a { padding-inline: 1rem; font-size: .875rem; }
  }
  @media (prefers-reduced-motion: reduce) { .premium-hero__primary:hover, .premium-hero__primary:hover svg { transform: none; } }
</style>
