<section aria-labelledby="assurance-heading" class="border-y border-border bg-bg-raised/70 px-4 py-14 sm:px-6 sm:py-16 lg:px-8">
  <div class="mx-auto max-w-6xl">
    <div class="max-w-3xl" data-reveal-group>
      <h2 id="assurance-heading" data-reveal class="text-3xl font-semibold tracking-tight text-text sm:text-4xl">
        One record that shows what you actually checked
      </h2>
      <p data-reveal class="mt-6 text-lg leading-8 text-text-muted">
        The full platform keeps everything in one reviewable record: which targets were in scope, what coverage ran, each finding with its evidence state, fix proposals and whether they were approved, and what the retest proved. If something was limited, blocked, or not applicable, it is listed, not hidden to make the report look good.
      </p>
    </div>

    <figure data-reveal="scale" class="assurance-record__card mt-12 overflow-hidden rounded-2xl border border-border bg-bg text-text shadow-2xl shadow-accent/10">
      <figcaption class="flex flex-wrap items-center justify-between gap-3 border-b border-border px-5 py-4 font-mono text-xs sm:px-7">
        <span class="text-accent">Illustrative product preview · sample data</span>
        <span class="text-text-muted">RELEASE / WEB-042</span>
      </figcaption>

      <div class="px-5 py-7 sm:px-7 sm:py-9">
        <div class="flex flex-wrap items-end justify-between gap-8">
          <div>
            <p class="font-mono text-xs tracking-[.18em] text-text-muted uppercase">Assurance state</p>
            <p class="assurance-record__warning mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">Review required</p>
            <p class="mt-3 max-w-2xl leading-7 text-text-muted">Review required: 2 detected findings still need independent evidence before this sample release can be treated as verified.</p>
          </div>
          <dl class="grid w-full grid-cols-2 gap-x-8 gap-y-4 border-t border-border pt-6 font-mono text-xs sm:w-auto sm:min-w-64 sm:border-t-0 sm:border-l sm:pt-0 sm:pl-6">
            <div><dt class="text-text-muted">TARGET</dt><dd class="mt-1 text-text">authorized repo + URL</dd></div>
            <div><dt class="text-text-muted">MODE</dt><dd class="mt-1 text-text">standard</dd></div>
            <div><dt class="text-text-muted">REPORT</dt><dd class="mt-1 text-text">draft</dd></div>
            <div><dt class="text-text-muted">RETEST</dt><dd class="assurance-record__warning mt-1">1 pending</dd></div>
          </dl>
        </div>

        <div class="mt-9 border-y border-border">
          <div class="flex flex-col gap-3 border-b border-border py-4 sm:flex-row sm:items-center sm:justify-between">
            <p class="font-mono text-xs tracking-[.16em] text-text-muted uppercase">Illustrative evidence ledger</p>
            <p class="text-sm text-text-muted">Detected / independently verified / retest-confirmed / inconclusive. These illustrate the states, not production metrics.</p>
          </div>
          <dl class="grid grid-cols-2 md:grid-cols-4" data-reveal-group>
            <div data-reveal class="border-b border-border py-5 pr-4 md:border-r md:border-b-0"><dt class="text-sm text-text-muted">Detected</dt><dd class="mt-2 font-mono text-2xl text-text" data-countup="4">04</dd></div>
            <div data-reveal class="border-b border-l border-border py-5 pl-4 md:border-r md:border-b-0 md:border-l-0 md:px-4"><dt class="text-sm text-text-muted">Independently verified</dt><dd class="mt-2 font-mono text-2xl text-accent" data-countup="2">02</dd></div>
            <div data-reveal class="py-5 pr-4 md:border-r md:px-4"><dt class="text-sm text-text-muted">Retest-confirmed</dt><dd class="mt-2 font-mono text-2xl text-accent" data-countup="1">01</dd></div>
            <div data-reveal class="border-l border-border py-5 pl-4 md:border-l-0"><dt class="text-sm text-text-muted">Inconclusive</dt><dd class="mt-2 font-mono text-2xl assurance-record__warning" data-countup="1">01</dd></div>
          </dl>
        </div>

        <div class="mt-9">
          <div class="flex flex-wrap items-end justify-between gap-4">
            <div>
              <p class="font-mono text-xs tracking-[.16em] text-text-muted uppercase">Vibe Security 50 registry</p>
              <p class="mt-2 text-sm leading-6 text-text-muted">43 machine-testable + 7 that need human evidence = 50 total controls in the current Vibe Security registry. Scope varies by target.</p>
            </div>
            <dl class="grid w-full grid-cols-3 gap-3 text-center sm:flex sm:w-auto sm:gap-9 sm:text-right" data-reveal-group>
              <div data-reveal><dt class="font-mono text-2xl text-text" data-countup="43">43</dt><dd class="mt-1 text-xs text-text-muted">machine-testable</dd></div>
              <div data-reveal><dt class="font-mono text-2xl text-text" data-countup="7">7</dt><dd class="mt-1 text-xs text-text-muted">evidence-required</dd></div>
              <div data-reveal><dt class="font-mono text-2xl text-accent" data-countup="50">50</dt><dd class="mt-1 text-xs text-text-muted">total controls</dd></div>
            </dl>
          </div>

          <div class="mt-8">
            <ol class="grid grid-cols-2 gap-4 font-mono text-xs text-text-muted sm:flex sm:min-w-max sm:items-center sm:gap-0" aria-label="Full product workflow" data-reveal-group>
              {['Target', 'Scan', 'Evidence state', 'Fix proposal', 'Retest', 'Assurance report'].map((step, index) => (
                <li class="product-step flex items-center" data-product-step={index + 1} data-reveal="left">
                  <span class="flex size-7 items-center justify-center rounded-full border border-border text-accent">{index + 1}</span>
                  <span class="ml-2 whitespace-nowrap">{step}</span>
                  {index < 5 && <span class="mx-3 hidden h-px w-7 bg-border sm:block sm:w-12" aria-hidden="true"></span>}
                </li>
              ))}
            </ol>
          </div>
        </div>
      </div>
    </figure>

    <div class="mt-7 flex flex-wrap gap-5 text-sm font-semibold">
      <a href="/sample-report" data-cta-id="assurance_sample_report" class="inline-flex min-h-11 items-center text-accent underline decoration-accent/40 underline-offset-4 hover:decoration-accent focus:outline-none focus-visible:ring-2 focus-visible:ring-accent">See the sample assurance report</a>
      <a href="/methodology" data-cta-id="assurance_methodology" class="inline-flex min-h-11 items-center text-text-muted underline decoration-border underline-offset-4 hover:text-text focus:outline-none focus-visible:ring-2 focus-visible:ring-accent">Read the evidence methodology</a>
    </div>
  </div>
</section>

<style>
  .assurance-record__card {
    --assurance-warning: hsl(38, 86%, 66%);
  }

  .assurance-record__warning {
    color: var(--assurance-warning);
  }

  .product-step:nth-child(1) span:first-child,
  .product-step:nth-child(2) span:first-child,
  .product-step:nth-child(3) span:first-child {
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 14%, transparent);
  }
</style>
