---
import ProductShot from "@components/landing/ProductShot.astro"
---

<section aria-labelledby="assurance-heading" class="border-y border-border bg-bg-raised/70 px-4 py-14 sm:px-6 sm:py-16 lg:px-8">
  <div class="mx-auto max-w-6xl">
    <div class="max-w-3xl" data-reveal-group>
      <h2 id="assurance-heading" data-reveal class="text-3xl font-semibold tracking-tight text-text sm:text-4xl">
        One record that shows what you actually checked
      </h2>
      <p data-reveal class="mt-6 text-lg leading-8 text-text-muted">
        The full platform keeps everything in one reviewable record: which targets were in scope, what coverage ran, each finding with its evidence state, fix proposals and whether they were approved, and what the retest proved. If something was limited, blocked, or not applicable, it is listed, not hidden to make the report look good.
      </p>
    </div>

    <figure data-reveal="scale" class="assurance-record__card mt-12 overflow-hidden rounded-2xl border border-border bg-bg text-text shadow-2xl shadow-accent/10">
      <figcaption class="flex flex-wrap items-center justify-between gap-3 border-b border-border px-5 py-4 font-mono text-xs sm:px-7">
        <span class="text-accent">Illustrative product preview · sample data</span>
        <span class="text-text-muted">RELEASE / WEB-042</span>
      </figcaption>

      <div class="px-5 py-7 sm:px-7 sm:py-9">
        <div class="flex flex-wrap items-end justify-between gap-8">
          <div>
            <p class="font-mono text-xs tracking-[.18em] text-text-muted uppercase">Assurance state</p>
            <p class="assurance-record__warning mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">Review required</p>
            <p class="mt-3 max-w-2xl leading-7 text-text-muted">Review required: 2 detected findings still need independent evidence before this sample release can be treated as verified.</p>
          </div>
          <dl class="grid w-full grid-cols-2 gap-x-8 gap-y-4 border-t border-border pt-6 font-mono text-xs sm:w-auto sm:min-w-64 sm:border-t-0 sm:border-l sm:pt-0 sm:pl-6">
            <div><dt class="text-text-muted">TARGET</dt><dd class="mt-1 text-text">authorized repo + URL</dd></div>
            <div><dt class="text-text-muted">MODE</dt><dd class="mt-1 text-text">standard</dd></div>
            <div><dt class="text-text-muted">REPORT</dt><dd class="mt-1 text-text">draft</dd></div>
            <div><dt class="text-text-muted">RETEST</dt><dd class="assurance-record__warning mt-1">1 pending</dd></div>
          </dl>
        </div>

        <div class="mt-9 border-y border-border">
          <div class="flex flex-col gap-3 border-b border-border py-4 sm:flex-row sm:items-center sm:justify-between">
            <p class="font-mono text-xs tracking-[.16em] text-text-muted uppercase">Illustrative evidence ledger</p>
            <p class="text-sm text-text-muted">Detected / independently verified / retest-confirmed / inconclusive. These illustrate the states, not production metrics.</p>
          </div>
          <dl class="grid grid-cols-2 md:grid-cols-4" data-reveal-group>
            <div data-reveal class="border-b border-border py-5 pr-4 md:border-r md:border-b-0"><dt class="flex items-center gap-2 text-sm text-text-muted"><i class="ledger-dot is-detected" aria-hidden="true"></i>Detected</dt><dd class="mt-2 font-mono text-2xl text-text" data-countup="4">04</dd></div>
            <div data-reveal class="border-b border-l border-border py-5 pl-4 md:border-r md:border-b-0 md:border-l-0 md:px-4"><dt class="flex items-center gap-2 text-sm text-text-muted"><i class="ledger-dot is-verified" aria-hidden="true"></i>Independently verified</dt><dd class="mt-2 font-mono text-2xl text-accent" data-countup="2">02</dd></div>
            <div data-reveal class="py-5 pr-4 md:border-r md:px-4"><dt class="flex items-center gap-2 text-sm text-text-muted"><i class="ledger-dot is-confirmed" aria-hidden="true"></i>Retest-confirmed</dt><dd class="mt-2 font-mono text-2xl assurance-record__confirmed" data-countup="1">01</dd></div>
            <div data-reveal class="border-l border-border py-5 pl-4 md:border-l-0"><dt class="flex items-center gap-2 text-sm text-text-muted"><i class="ledger-dot is-inconclusive" aria-hidden="true"></i>Inconclusive</dt><dd class="mt-2 font-mono text-2xl assurance-record__inconclusive" data-countup="1">01</dd></div>
          </dl>

          {/* The same four numbers as a proportion of the four detected findings.
              These states are a progression, not a pie: everything starts as
              detected, and only part of it earns independent verification or a
              retest-confirmed fix. The bars fill on scroll; the numbers above
              remain the accessible source of truth, so these are presentational
              and reduced-motion users just see them already full. */}
          <div class="ledger-meter pb-6" data-reveal aria-hidden="true">
            <div class="ledger-meter__row">
              <span class="ledger-meter__label">Detected</span>
              <span class="ledger-meter__track"><i class="ledger-meter__fill is-detected" style="--seg: 100%"></i></span>
            </div>
            <div class="ledger-meter__row">
              <span class="ledger-meter__label">Independently verified</span>
              <span class="ledger-meter__track"><i class="ledger-meter__fill is-verified" style="--seg: 50%"></i></span>
            </div>
            <div class="ledger-meter__row">
              <span class="ledger-meter__label">Retest-confirmed</span>
              <span class="ledger-meter__track"><i class="ledger-meter__fill is-confirmed" style="--seg: 25%"></i></span>
            </div>
            <div class="ledger-meter__row">
              <span class="ledger-meter__label">Inconclusive</span>
              <span class="ledger-meter__track"><i class="ledger-meter__fill is-inconclusive" style="--seg: 25%"></i></span>
            </div>
          </div>
          <p class="pb-6 text-sm leading-6 text-text-muted">
            Four findings detected in this sample. Half earned independent verification, one fix is
            retest-confirmed, and one retest stayed inconclusive — reported as inconclusive, not
            rounded up to a pass.
          </p>
        </div>

        <div class="mt-9">
          <div class="flex flex-wrap items-end justify-between gap-4">
            <div>
              <p class="font-mono text-xs tracking-[.16em] text-text-muted uppercase">Vibe Security 50 registry</p>
              <p class="mt-2 text-sm leading-6 text-text-muted">43 code/URL review + 7 that need human evidence = 50 total controls in the current Vibe Security registry. Scope varies by target.</p>
            </div>
            <dl class="grid w-full grid-cols-3 gap-3 text-center sm:flex sm:w-auto sm:gap-9 sm:text-right" data-reveal-group>
              <div data-reveal><dt class="font-mono text-2xl text-text" data-countup="43">43</dt><dd class="mt-1 text-xs text-text-muted">code/URL review</dd></div>
              <div data-reveal><dt class="font-mono text-2xl text-text" data-countup="7">7</dt><dd class="mt-1 text-xs text-text-muted">evidence-required</dd></div>
              <div data-reveal><dt class="font-mono text-2xl text-accent" data-countup="50">50</dt><dd class="mt-1 text-xs text-text-muted">total controls</dd></div>
            </dl>
          </div>

          <div class="mt-8">
            <ol class="grid grid-cols-2 gap-4 font-mono text-xs text-text-muted sm:flex sm:min-w-max sm:items-center sm:gap-0" aria-label="Full product workflow" data-reveal-group>
              {['Target', 'Scan', 'Evidence state', 'Fix proposal', 'Retest', 'Assurance report'].map((step, index) => (
                <li class="product-step flex items-center" data-product-step={index + 1} data-reveal="left">
                  <span class="flex size-7 items-center justify-center rounded-full border border-border text-accent">{index + 1}</span>
                  <span class="ml-2 whitespace-nowrap">{step}</span>
                  {index < 5 && <span class="mx-3 hidden h-px w-7 bg-border sm:block sm:w-12" aria-hidden="true"></span>}
                </li>
              ))}
            </ol>
          </div>
        </div>
      </div>
    </figure>

    <ProductShot
      class="mt-10"
      src="/product/console-issues.webp"
      alt="The Issues view in the LyraShield console. Findings are listed with a severity, an evidence state, an open status and a CWE and CVSS reference. A side drawer for the selected finding shows tabs for what to do, technical detail and history, a plain-language explanation, and a button to create a fix proposal."
      width={1400}
      height={883}
      chrome="app.lyrashieldai.com/issues"
    >
      <b>The same ledger in the product.</b> Every finding carries a severity, an evidence state —
      both <i>detected</i> and <i>inconclusive</i> appear here — and a CWE reference. The drawer
      opens on what to do next rather than raw scanner output, and a fix proposal is something you
      create and review; nothing auto-merges. Finding titles, file paths and target names are
      blurred.
    </ProductShot>

    <div class="mt-7 flex flex-wrap gap-5 text-sm font-semibold">
      <a href="/sample-report" data-cta-id="assurance_sample_report" class="inline-flex min-h-11 items-center text-accent underline decoration-accent/40 underline-offset-4 hover:decoration-accent focus:outline-none focus-visible:ring-2 focus-visible:ring-accent">See the sample assurance report</a>
      <a href="/methodology" data-cta-id="assurance_methodology" class="inline-flex min-h-11 items-center text-text-muted underline decoration-border underline-offset-4 hover:text-text focus:outline-none focus-visible:ring-2 focus-visible:ring-accent">Read the evidence methodology</a>
    </div>
  </div>
</section>

<style>
  .assurance-record__card {
    --assurance-warning: hsl(38, 86%, 66%);

    /* One palette for the four evidence states, shared with the assurance-loop
       diagram and the Assurance World legend. If these ever drift apart the
       page starts teaching two different colour languages for the same idea. */
    --state-detected: var(--accent);
    --state-verified: #2f8f5b;
    --state-confirmed: #b26a00;
    --state-inconclusive: var(--danger);
  }

  :root[data-theme="dark"] .assurance-record__card {
    --state-verified: #5cdb95;
    --state-confirmed: #f5b84b;
  }

  /* Amber stays reserved for "needs your attention now" — the overall assurance
     state and a pending retest. It is deliberately NOT the inconclusive colour:
     inconclusive is an evidence state and takes the shared state palette below,
     so the ledger reads in one colour language. */
  .assurance-record__warning {
    color: var(--assurance-warning);
  }

  .assurance-record__inconclusive {
    color: var(--state-inconclusive);
  }

  .assurance-record__confirmed {
    color: var(--state-confirmed);
  }

  .ledger-dot {
    width: 0.5rem;
    height: 0.5rem;
    flex: none;
    border-radius: 50%;
    background: currentColor;
  }

  .ledger-meter__row {
    display: grid;
    align-items: center;
    gap: 0.35rem 1rem;
    padding-block: 0.3rem;
  }

  @media (min-width: 640px) {
    .ledger-meter__row {
      grid-template-columns: 12rem 1fr;
    }
  }

  .ledger-meter__label {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .ledger-meter__track {
    display: block;
    height: 0.375rem;
    overflow: hidden;
    border-radius: 999px;
    background: color-mix(in srgb, var(--border) 70%, transparent);
  }

  .ledger-meter__fill {
    display: block;
    width: var(--seg);
    height: 100%;
    border-radius: inherit;
    background: currentColor;
  }

  /* Grow the bars only when the block scrolls into view. `is-revealed` is added
     by the JS reveal helper, which already opts out for reduced-motion and
     Save-Data — those users get the final width with no transition. */
  :global(html.reveal-ready) .ledger-meter:not(.is-revealed) .ledger-meter__fill {
    width: 0;
  }

  :global(html.reveal-ready) .ledger-meter__fill {
    transition: width 900ms cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: 120ms;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html.reveal-ready) .ledger-meter:not(.is-revealed) .ledger-meter__fill {
      width: var(--seg);
    }

    :global(html.reveal-ready) .ledger-meter__fill {
      transition: none;
    }
  }

  .is-detected {
    color: var(--state-detected);
  }

  .is-verified {
    color: var(--state-verified);
  }

  .is-confirmed {
    color: var(--state-confirmed);
  }

  .is-inconclusive {
    color: var(--state-inconclusive);
  }

  .product-step:nth-child(1) span:first-child,
  .product-step:nth-child(2) span:first-child,
  .product-step:nth-child(3) span:first-child {
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 14%, transparent);
  }
</style>
