---
interface Item {
  q: string
  a: string
}

interface Props {
  items: Item[]
}

const { items } = Astro.props

---

<section id="faq" aria-labelledby="faq-heading" class="px-4 py-10 sm:px-6 sm:py-12 lg:px-8">
  <div class="mx-auto max-w-3xl">
    <h2 id="faq-heading" class="text-center text-3xl font-semibold tracking-tight text-text sm:text-4xl">
      Questions
    </h2>
    <div class="mt-8">
      {items.map((item, index) => (
        <details class="group border-b border-border" data-question-id={`question_${index + 1}`}>
          <summary class="min-h-11 cursor-pointer list-none rounded-lg p-4 font-medium text-text focus:outline-none focus-visible:ring-2 focus-visible:ring-accent">
            <span class="flex min-w-0 items-center justify-between gap-4">
              <span class="min-w-0 break-words">{item.q}</span>
              <svg viewBox="0 0 20 20" class="size-5 shrink-0 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="m5 7.5 5 5 5-5" /></svg>
            </span>
          </summary>
          <div class="faq-answer px-4 pb-5 text-text-muted">
            <p class="leading-7">{item.a}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  h2 { font-family: "Bricolage Grotesque Variable", sans-serif; letter-spacing: -.03em; }
  summary::-webkit-details-marker { display: none; }
  summary:hover { color: var(--accent); }
  @media (prefers-reduced-motion: no-preference) {
    details[open] .faq-answer { animation: answer-arrive 180ms cubic-bezier(.16,1,.3,1); }
    @keyframes answer-arrive { from { opacity: .6; transform: translateY(-4px); } to { opacity: 1; transform: none; } }
  }
</style>
