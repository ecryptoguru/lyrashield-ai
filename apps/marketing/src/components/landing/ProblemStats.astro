---
/**
 * Homepage problem framing with two externally sourced statistics.
 *
 * Deliberately a plain static server-rendered section: no motion, no
 * scroll behaviour, no island. The numbers describe the industry
 * condition (AI-authored code shipping without review), not a threat
 * aimed at the reader. Each statement keeps its source and date
 * visible as ordinary text so the citations survive copy, paste and
 * crawl. Wording is fixed — do not round, reword or drop attributions.
 */
interface Stat {
  statement: string
  source: string
}

const stats: Stat[] = [
  {
    statement:
      "Google reported in April 2026 that 75% of new code at the company is AI-generated and approved by engineers, up from 25% in 2024.",
    source: "Source: blog.google, April 2026.",
  },
  {
    statement:
      "An April 2026 preprint measuring seven frontier models found a mean vulnerability rate of 55.8% in AI-generated code.",
    source: "Source: arXiv:2604.05292, April 2026, preprint.",
  },
]
---
<section aria-label="The review gap in AI-built software" class="px-4 py-10 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-7xl">
    <div class="grid gap-6 md:grid-cols-2">
      {
        stats.map((stat) => (
          <figure class="rounded-xl border border-border bg-bg-raised p-6">
            <blockquote class="text-base leading-7 text-text">{stat.statement}</blockquote>
            <figcaption class="mt-3 text-sm text-text-muted">{stat.source}</figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>
