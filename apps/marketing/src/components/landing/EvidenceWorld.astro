---
import type { MotionMediaManifest } from "../../lib/motion-manifest"
interface Props { manifest: MotionMediaManifest }
const { manifest } = Astro.props
const labels = ["Overview", "Target", "Review", "Evidence", "Approval", "Retest", "Report"]
const receipts = [
  "Authorized scope is stated",
  "Target identity stays on record",
  "The checks that ran are recorded",
  "Detected is distinct from proven",
  "A proposal still needs approval",
  "Missing coverage stays inconclusive",
  "Scope and limitations travel with the report",
]
---

<evidence-journey id="assurance-world" aria-labelledby="journey-heading">
  <header class="journey__intro">
    <div><h2 id="journey-heading">From target to verdict.</h2><p>One finding, followed through the loop.</p></div>
    <a href="#product-preview">Skip to the product preview <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M6 18 18 6M6 6h12v12" /></svg></a>
  </header>
  <nav class="journey__nav" aria-label="Evidence journey chapters">
    {manifest.chapters.map((chapter, index) => (
      <a href={`#journey-${chapter.id}`} data-journey-link={index} aria-current={index === 0 ? "step" : undefined}>
        <span class="journey__node" aria-hidden="true">{String(index).padStart(2, "0")}</span>{labels[index]}
      </a>
    ))}
  </nav>
  <div class="journey__layout">
    <div class="journey__chapters">
      {manifest.chapters.map((chapter, index) => (
        <section id={`journey-${chapter.id}`} class="journey__chapter" data-journey-chapter={index} aria-labelledby={`chapter-${chapter.id}`}>
          <h3 id={`chapter-${chapter.id}`}>{chapter.title}</h3>
          <p>{chapter.body}</p>
          {chapter.id === "evidence-state" && <ul class="journey__states"><li><i class="state-detected" />Detected</li><li><i class="state-confirmed" />Retest-confirmed</li><li><i class="state-inconclusive" />Inconclusive</li></ul>}
          <p class="journey__receipt"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M6 3h9l3 3v15H6zM9 10h6M9 14h6M9 18h4" /></svg><span>Example EX-014 · {receipts[index]}</span></p>
          {chapter.supportingCard && <details>
            <summary>{chapter.supportingCard.title}</summary>
            <p>{chapter.supportingCard.body}</p>
            {chapter.supportingCard.items && <ul>{chapter.supportingCard.items.map(item => <li>{item}</li>)}</ul>}
            {chapter.supportingCard.status && <p>{chapter.supportingCard.status}</p>}
            {chapter.supportingCard.primaryCta && <div class="journey__actions"><a href={chapter.supportingCard.primaryCta.href} data-cta-id={chapter.supportingCard.primaryCta.id}>{chapter.supportingCard.primaryCta.label}</a>{chapter.supportingCard.secondaryCta && <a href={chapter.supportingCard.secondaryCta.href} data-cta-id={chapter.supportingCard.secondaryCta.id}>{chapter.supportingCard.secondaryCta.label}</a>}</div>}
          </details>}
        </section>
      ))}
    </div>
    <aside class="journey__scene" aria-label="Illustrative finding and report" data-journey-scene data-stage="0">
      <div class="journey__scene-heading"><span>Illustrative example</span><span data-journey-progress>01 / 07</span></div>
      <div class="journey__track" aria-hidden="true"><i></i><span></span></div>
      <article class="journey__artifact">
        <div class="journey__artifact-top"><span>Finding EX-014</span><span class="journey__badge">Detected</span></div>
        <h3>Missing rate limit on login route</h3>
        <p>An illustrative observation, not a real vulnerability report.</p>
        <dl><div><dt>Target scope</dt><dd>Authorized example route</dd></div><div><dt>Evidence coverage</dt><dd>Bounded to the checks that ran</dd></div><div><dt>Latest evaluated review</dt><dd>Example only</dd></div></dl>
        <div class="journey__receipts">
          <p data-receipt-stage="1"><span>Scope</span>Target identity retained</p>
          <p data-receipt-stage="2"><span>Review</span>Check method recorded</p>
          <p data-receipt-stage="3"><span>Evidence</span>Detected · not independently proven</p>
          <p data-receipt-stage="4"><span>Approval</span>Proposal awaiting review</p>
          <p data-receipt-stage="5"><span>Retest</span>Incomplete coverage · inconclusive</p>
        </div>
      </article>
      <section class="journey__report" aria-labelledby="sample-report-heading">
        <div><h3 id="sample-report-heading">Assurance report</h3><span>Insufficient evidence</span></div>
        <p>Example EX-014 remains on record.</p>
        <ul><li>Authorized scope retained</li><li>Approval required</li><li>Retest coverage incomplete</li></ul>
        <p class="journey__report-limit">Missing proof stays visible. No security guarantee.</p>
      </section>
    </aside>
  </div>
</evidence-journey>

<script>
  import "./evidence-journey"
</script>

<style>
  evidence-journey {
    display: block;
    scroll-margin-top: 4rem;
    background: var(--bg);
    color: var(--text);
    padding: 3rem max(1rem, calc((100% - 1280px) / 2)) 4rem;
  }
  .journey__intro {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 2rem;
  }
  .journey__intro h2 {
    margin: 0;
    font-family: "Bricolage Grotesque Variable", sans-serif;
    font-size: clamp(2rem, 4vw, 3.5rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.05;
  }
  .journey__intro p {
    margin: 0.8rem 0 0;
    color: var(--text-muted);
  }
  a:focus-visible,
  summary:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 3px;
  }
  .journey__intro a {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 44px;
    color: var(--accent);
    font-size: 0.875rem;
  }
  .journey__nav {
    position: sticky;
    top: 4rem;
    z-index: 8;
    display: flex;
    gap: 0.3rem;
    overflow-x: auto;
    padding: 0.65rem 0;
    background: var(--bg);
    border-block: 1px solid var(--border);
    scrollbar-width: thin;
  }
  .journey__nav a {
    display: flex;
    flex: 1 0 auto;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    padding: 0.35rem 0.7rem;
    min-height: 44px;
    color: var(--text-muted);
    border-radius: 0.5rem;
    font-size: 0.8rem;
    font-weight: 600;
    text-decoration: none;
    transition:
      color 160ms,
      background-color 160ms;
  }
  .journey__nav a[aria-current] {
    color: var(--accent);
    background: var(--accent-dim);
  }
  .journey__node {
    font:
      500 0.68rem/1 "JetBrains Mono Variable",
      monospace;
  }
  .journey__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: start;
    gap: clamp(2rem, 5vw, 5rem);
  }
  .journey__chapters {
    min-width: 0;
    width: 100%;
  }
  .journey__chapter:last-child {
    min-height: max(420px, calc(100svh - 9rem));
  }
  .journey__chapter {
    min-height: 420px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-block: 3rem;
    scroll-margin-top: 9rem;
  }
  .journey__chapter h3 {
    margin: 0;
    font-family: "Bricolage Grotesque Variable", sans-serif;
    font-size: clamp(1.8rem, 3vw, 2.8rem);
    line-height: 1.1;
    letter-spacing: -0.03em;
    font-weight: 750;
    text-wrap: balance;
    overflow-wrap: anywhere;
  }
  .journey__chapter > p {
    max-width: 65ch;
    margin: 1.2rem 0 0;
    color: var(--text-muted);
    line-height: 1.7;
  }
  .journey__states {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding: 0;
    margin: 1rem 0 0;
    list-style: none;
    font-size: 0.8rem;
  }
  .journey__states li {
    border: 1px solid var(--border);
    border-radius: 0.25rem;
    padding: 0.3rem 0.5rem;
  }
  .journey__receipt {
    display: flex;
    align-items: start;
    gap: 0.65rem;
    font-size: 0.8rem;
  }
  .journey__receipt svg {
    width: 20px;
    height: 20px;
    flex: none;
    color: var(--accent);
  }
  .journey__chapter details {
    margin-top: 1.5rem;
    border-top: 1px solid var(--border);
    font-size: 0.9rem;
  }
  .journey__chapter summary {
    min-height: 44px;
    padding-block: 0.8rem;
    cursor: pointer;
    font-weight: 600;
  }
  .journey__chapter details p,
  .journey__chapter details ul {
    color: var(--text-muted);
    line-height: 1.7;
  }
  .journey__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .journey__actions a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--accent);
  }
  .journey__scene {
    min-width: 0;
    position: sticky;
    top: 9rem;
    padding-top: 1rem;
    padding-bottom: 1rem;
  }
  .journey__scene-heading {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    color: var(--text-muted);
    font:
      500 0.72rem/1.5 "JetBrains Mono Variable",
      monospace;
  }
  .journey__track {
    position: relative;
    height: 8px;
    margin: 0.8rem 0 1rem;
    overflow: clip;
  }
  .journey__track::before {
    content: "";
    position: absolute;
    inset: 3px 4px auto;
    height: 2px;
    background: var(--border);
  }
  .journey__track i {
    display: block;
    width: calc(100% - 8px);
    height: 2px;
    margin: 3px 4px 0;
    background: var(--accent);
    transform: scaleX(var(--journey-progress, 0.02));
    transform-origin: left;

  }
  .journey__track span {
    position: absolute;
    top: 0;
    left: 4px;
    transform: translateX(calc(var(--journey-progress, 0) * 100%));
    width: calc(100% - 8px);
    height: 8px;
  }
  .journey__track span::after {
    content: "";
    display: block;
    width: 8px;
    height: 8px;
    transform: translateX(-4px);
    border-radius: 50%;
    background: var(--accent);

  }
  .journey__artifact {
    position: relative;
    padding: 1.5rem;
    border-radius: 0.75rem;
    background: var(--bg-raised);
    border: 1px solid var(--border);
    isolation: isolate;
  }
  .journey__artifact-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.7rem;
    font:
      500 0.75rem/1.5 "JetBrains Mono Variable",
      monospace;
  }
  .journey__badge {
    border: 1px solid var(--accent);
    padding: 0.2rem 0.45rem;
    border-radius: 0.25rem;
    color: var(--accent);
  }
  .journey__artifact h3 {
    margin: 1rem 0 0.5rem;
    font-size: 1.3rem;
    line-height: 1.3;
    letter-spacing: -0.02em;
  }
  .journey__artifact > p {
    color: var(--text-muted);
    font-size: 0.82rem;
    line-height: 1.6;
  }
  .journey__artifact dl {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.65rem 1rem;
    margin: 1rem 0;
  }
  .journey__artifact dl > div:last-child { grid-column: 1 / -1; }
  .journey__artifact dt {
    color: var(--text-muted);
    font-size: 0.72rem;
  }
  .journey__artifact dd {
    margin: 0.25rem 0 0;
    font-size: 0.85rem;
  }
  .journey__receipts {
    border-top: 1px solid var(--border);
    padding-top: 0.7rem;
  }
  .journey__receipts p {
    margin: 0;
    padding: 0.35rem 0.5rem;
    border-radius: 0.25rem;
    transition: opacity 280ms, transform 420ms cubic-bezier(0.16, 1, 0.3, 1), background-color 280ms;
    font-size: 0.78rem;
    line-height: 1.5;
  }
  .journey__receipts span {
    color: var(--accent);
    display: inline-block;
    min-width: 5rem;
  }
  .journey__report {
    margin-top: 0.85rem;
    padding: 1rem;
    border: 1px solid var(--border);
    border-radius: 0.75rem;
    background: var(--bg-raised);
  }
  .journey__report > div {
    display: flex;
    gap: 0.8rem;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
  }
  .journey__report h3 {
    margin: 0;
    font-size: 1rem;
  }
  .journey__report > div > span {
    color: #9b6509;
    background: #fff5e2;
    border: 1px solid #ddb977;
    padding: 0.25rem 0.5rem;
    border-radius: 0.25rem;
    font-size: 0.72rem;
  }
  :global(:root[data-theme="dark"]) .journey__report > div > span {
    color: #f3b95f;
    background: #282217;
    border-color: #6b5630;
  }
  .journey__report p,
  .journey__report ul {
    color: var(--text-muted);
    font-size: 0.8rem;
    line-height: 1.7;
  }
  .journey__report ul {
    padding-left: 1.1rem;
  }
  .journey__report-limit {
    margin-bottom: 0;
  }
  /* Reserve the complete record from first paint. Receipt and report reveals
     must never resize the sticky scene or move the document's scroll anchor. */
  evidence-journey.is-enhanced [data-receipt-stage]:not(.is-collected) {
    visibility: hidden;
    opacity: 0;
    transform: translateX(10px);
  }
  evidence-journey.is-enhanced .journey__report:not(.is-assembled) {
    visibility: hidden;
    opacity: 0;
    transform: translateY(12px);
  }
  .journey__report {
    transition: opacity 420ms, transform 600ms cubic-bezier(0.16, 1, 0.3, 1), visibility 420ms;
  }
  .journey__receipts .is-current { background: var(--accent-dim); }
  @media (min-width: 901px) and (prefers-reduced-motion: no-preference) {
    .is-enhanced:not(.is-flow) .is-collected {
      animation: receipt-attach 500ms cubic-bezier(0.16, 1, 0.3, 1);
    }
    .is-enhanced:not(.is-flow) .is-assembled { animation: report-assemble 650ms cubic-bezier(0.16, 1, 0.3, 1); }
    @keyframes receipt-attach {
      from { clip-path: inset(0 100% 0 0); }
      to { clip-path: inset(0); }
    }
    @keyframes report-assemble {
      from { clip-path: inset(0 0 100% 0); opacity: 0.3; transform: translateY(12px); }
      to { clip-path: inset(0); opacity: 1; transform: none; }
    }
  }
  @media (max-width: 900px) {
    .journey__intro {
      align-items: start;
      flex-direction: column;
      gap: 0.6rem;
    }
    .journey__layout {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }
    .journey__scene {
      position: relative;
      top: auto;
      order: -1;
      width: 100%;
      padding-top: 1rem;
    }
    evidence-journey.is-enhanced .journey__scene {
      min-height: 0;
    }
    /* The phone keeps a complete record in view, with a compact chapter navigator.
         It never needs to chase a sticky artifact covering the explanation. */
    evidence-journey.is-enhanced [data-receipt-stage]:not(.is-collected),
    evidence-journey.is-enhanced .journey__report:not(.is-assembled) {
      visibility: visible;
      opacity: 1;
      transform: none;
    }
    .journey__chapter,
    .journey__chapter:last-child {
      min-height: 0;
      padding-block: 2rem;
      border-bottom: 1px solid var(--border);
    }
    .journey__chapter h3 {
      font-size: 1.8rem;
    }
    .journey__nav a {
      justify-content: start;
    }
  }
  evidence-journey.is-flow .journey__scene { position: relative; top: auto; }
  evidence-journey.is-flow [data-receipt-stage]:not(.is-collected),
  evidence-journey.is-flow .journey__report:not(.is-assembled) {
    visibility: visible;
    opacity: 1;
    transform: none;
  }
  @media (max-height: 760px) and (min-width: 901px) {
    .journey__scene { position: relative; top: auto; }
    evidence-journey.is-enhanced [data-receipt-stage]:not(.is-collected),
    evidence-journey.is-enhanced .journey__report:not(.is-assembled) {
      visibility: visible;
      opacity: 1;
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .journey__artifact,
    .journey__track i,
    .journey__track span {
      transition: none;
    }
    .journey__artifact {
      transform: none;
    }
  }
</style>
