---
import type { MotionMediaManifest } from "../../lib/motion-manifest"

interface Props {
  manifest: MotionMediaManifest
}

const { manifest } = Astro.props
---

<evidence-world id="assurance-world" data-manifest={JSON.stringify(manifest)}>
  <div class="evidence-world__stage" aria-hidden="true">
    <div class="evidence-world__media">
      {
        manifest.chapters.map((chapter, index) => (
          <picture class:list={["evidence-world__poster", { "is-active": index === 0 }]} data-poster-index={index}>
            <source media="(max-width: 767px)" srcset={chapter.portraitPoster} />
            <img src={chapter.desktopPoster} data-poster-chapter={chapter.id} alt="" width="1600" height="900" loading={index === 0 ? "eager" : "lazy"} decoding="async" />
          </picture>
        ))
      }
      <video class="evidence-world__video" muted playsinline preload="none" tabindex="-1"></video>
      <div class="evidence-world__media-veil"></div>
    </div>
    <div class="evidence-world__chrome">
      <span data-progress-label>01 / 07</span>
      <i><b data-progress-bar></b></i>
      <span>ASSURANCE WORLD</span>
    </div>
  </div>

  <div class="evidence-world__chapters">
    {
      manifest.chapters.map((chapter, index) => (
        <section class="evidence-world__chapter" data-chapter-index={index} aria-labelledby={`chapter-${chapter.id}`}>
          {[
            { eyebrow: chapter.eyebrow, title: chapter.title, body: chapter.body },
            chapter.supportingCard,
          ].filter(Boolean).map((card, cardIndex) => card && (
            <div
              class:list={["evidence-world__copy", { "is-card-active": cardIndex === 0 }]}
              data-story-card-index={cardIndex}
              data-story-card-id={`${chapter.id}-${cardIndex === 0 ? "primary" : "support"}`}
            >
              <p>{card.eyebrow}</p>
              <h2 id={cardIndex === 0 ? `chapter-${chapter.id}` : undefined}>{card.title}</h2>
              <div class="evidence-world__rule"></div>
              <p>{card.body}</p>
              {cardIndex === 0 && chapter.id === "evidence-state" && (
                <ul>
                  <li><i class="state-detected" />Detected</li>
                  <li><i class="state-verified" />Independently verified</li>
                  <li><i class="state-confirmed" />Retest-confirmed</li>
                  <li><i class="state-inconclusive" />Inconclusive</li>
                </ul>
              )}
              {"items" in card && card.items && (
                <ul class="evidence-world__points">
                  {card.items.map((item) => <li>{item}</li>)}
                </ul>
              )}
              {cardIndex === 0 && chapter.id === "report" && <span class="evidence-world__status">Scope stated · limitations retained</span>}
              {"status" in card && card.status && <span class="evidence-world__status">{card.status}</span>}
              {"primaryCta" in card && card.primaryCta && (
                <div class="evidence-world__actions">
                  <a href={card.primaryCta.href} data-cta-id={card.primaryCta.id}>{card.primaryCta.label}</a>
                  {card.secondaryCta && <a class="is-secondary" href={card.secondaryCta.href} data-cta-id={card.secondaryCta.id}>{card.secondaryCta.label}</a>}
                </div>
              )}
            </div>
          ))}
        </section>
      ))
    }
  </div>
</evidence-world>

<script>
  function bootstrapEvidenceWorld() {
    if (customElements.get("evidence-world")) return
    void import("./evidence-world.ts")
  }

  const el = document.getElementById("assurance-world")
  const connection = (
    navigator as Navigator & {
      connection?: { saveData?: boolean; effectiveType?: string }
    }
  ).connection
  const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches
  const saveData = connection?.saveData === true
  const slowNetwork =
    connection?.effectiveType === "2g" || connection?.effectiveType === "slow-2g"
  if (el && !reduced && !saveData) el.classList.add("is-motion-layout")
  if (el && "IntersectionObserver" in window) {
    const observer = new IntersectionObserver(
      (entries, obs) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            obs.disconnect()
            bootstrapEvidenceWorld()
            break
          }
        }
      },
      { rootMargin: "50% 0px" }
    )
    observer.observe(el)

    // Warm the story in parallel with the rest of the page instead of waiting
    // for the observer above. The timeline is scroll-scrubbed, so arriving at
    // the story with an empty buffer meant the first pass stuttered while the
    // browser range-requested each seek — visible on desktop and mobile alike.
    // Upgrading the element early lets it start fetching (see assignSource);
    // the observer still owns when scroll listeners attach, and whichever path
    // fires first wins because bootstrapEvidenceWorld is idempotent.
    //
    // Deliberately gated: this pulls a multi-megabyte video on a visit that may
    // never reach the story, so skip it when the visitor has asked for less
    // (reduced motion, Save-Data) or is on a 2g-class connection, where the
    // poster fallback is the better experience anyway. It is also scheduled
    // after load and on idle so it never competes with the hero for bandwidth.
    if (!reduced && !saveData && !slowNetwork) {
      const idle = (
        window as unknown as {
          requestIdleCallback?: (cb: () => void, opts?: { timeout: number }) => number
        }
      ).requestIdleCallback
      const schedule = () => {
        if (idle) idle(bootstrapEvidenceWorld, { timeout: 2500 })
        else setTimeout(bootstrapEvidenceWorld, 900)
      }
      if (document.readyState === "complete") schedule()
      else addEventListener("load", schedule, { once: true })
    }
  } else {
    bootstrapEvidenceWorld()
  }
</script>

<style>
  evidence-world {
    --world-cyan: #54d6df;
    position: relative;
    display: block;
    color: #edf6fb;
    background: #08111c;
  }

  .evidence-world__stage {
    position: sticky;
    top: 0;
    z-index: 0;
    height: 100svh;
    overflow: hidden;
  }

  .evidence-world__media,
  .evidence-world__poster,
  .evidence-world__poster img,
  .evidence-world__video,
  .evidence-world__media-veil {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .evidence-world__poster,
  .evidence-world__video {
    opacity: 0;
    transition: opacity 240ms ease-out;
  }

  .evidence-world__poster.is-active,
  .evidence-world__video.is-front {
    opacity: 1;
  }

  .evidence-world__poster img,
  .evidence-world__video {
    object-fit: cover;
  }

  .evidence-world__video {
    z-index: 2;
    backface-visibility: hidden;
    transform: translateZ(0);
    will-change: opacity;
  }

  .evidence-world__poster {
    z-index: 1;
  }

  .evidence-world__media-veil {
    z-index: 3;
    background:
      radial-gradient(circle at 50% 42%, transparent 30%, rgba(8, 17, 28, 0.46) 100%),
      linear-gradient(180deg, rgba(8, 17, 28, 0.12), rgba(8, 17, 28, 0.7));
  }

  .evidence-world__chrome {
    position: absolute;
    right: clamp(1rem, 4vw, 4rem);
    bottom: 2rem;
    left: clamp(1rem, 4vw, 4rem);
    z-index: 4;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1rem;
    color: #91a7b8;
    font: 600 0.68rem/1 "JetBrains Mono Variable", monospace;
    letter-spacing: 0.1em;
  }

  .evidence-world__chrome i {
    height: 1px;
    overflow: hidden;
    background: rgba(145, 167, 184, 0.28);
  }

  .evidence-world__chrome b {
    display: block;
    width: 100%;
    height: 100%;
    transform: scaleX(0.02);
    transform-origin: left;
    background: var(--world-cyan);
  }

  .evidence-world__chapters {
    position: relative;
    z-index: 1;
    margin-top: -100svh;
  }

  .evidence-world__chapter {
    position: relative;
    display: grid;
    min-height: max(840px, 115svh);
    align-items: center;
    padding: 3.25rem max(1rem, calc((100% - 1280px) / 2));
  }

  .evidence-world__chapter:nth-child(even) .evidence-world__copy {
    margin-left: auto;
    text-align: right;
  }

  .evidence-world__copy {
    width: min(36rem, 46%);
    padding: clamp(1.25rem, 3vw, 2.5rem);
    border: 1px solid rgba(84, 214, 223, 0.18);
    border-radius: 0.75rem;
    background: rgba(8, 17, 28, 0.78);
    backdrop-filter: blur(14px);
    box-shadow: 0 1.5rem 5rem rgba(0, 0, 0, 0.24);
  }

  evidence-world.is-motion-layout .evidence-world__copy {
    position: absolute;
    top: 50%;
    left: max(1rem, calc((100% - 1280px) / 2));
    transform: translateY(-50%);
  }

  evidence-world.is-motion-layout .evidence-world__chapter:nth-child(even) .evidence-world__copy {
    right: max(1rem, calc((100% - 1280px) / 2));
    left: auto;
  }

  evidence-world.is-motion-layout:not(.is-enhanced) .evidence-world__copy:not(.is-card-active) {
    visibility: hidden;
    opacity: 0;
  }

  evidence-world.is-enhanced .evidence-world__copy {
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
    transform: translateY(calc(-50% + 1.25rem)) scale(0.985);
    transition:
      opacity 180ms ease-in,
      transform 240ms ease-in,
      visibility 0s linear 240ms;
  }

  evidence-world.is-enhanced .evidence-world__chapter.is-active .evidence-world__copy.is-card-active {
    visibility: visible;
    opacity: 1;
    pointer-events: auto;
    transform: translateY(-50%) scale(1);
    transition:
      opacity 280ms ease-out,
      transform 460ms cubic-bezier(0.22, 1, 0.36, 1),
      visibility 0s;
    will-change: opacity, transform;
  }

  evidence-world.is-enhanced.is-pinned .evidence-world__copy {
    position: fixed;
    top: 50svh;
    right: auto;
    left: max(1rem, calc((100vw - 1280px) / 2));
    z-index: 4;
    transform: translateY(calc(-50% + 1.25rem)) scale(0.985);
  }

  evidence-world.is-enhanced.is-pinned .evidence-world__chapter:nth-child(even) .evidence-world__copy {
    right: max(1rem, calc((100vw - 1280px) / 2));
    left: auto;
  }

  evidence-world.is-enhanced.is-pinned .evidence-world__chapter.is-active .evidence-world__copy.is-card-active {
    transform: translateY(-50%) scale(1);
  }

  .evidence-world__copy > p:first-child,
  .evidence-world__copy > p:last-of-type,
  .evidence-world__status,
  .evidence-world__copy ul {
    font-family: "JetBrains Mono Variable", monospace;
  }

  .evidence-world__points li {
    justify-content: flex-start;
  }

  .evidence-world__points li::before {
    width: 0.35rem;
    height: 0.35rem;
    flex: 0 0 auto;
    border-radius: 50%;
    background: var(--world-cyan);
    content: "";
  }

  .evidence-world__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.35rem;
  }

  .evidence-world__actions a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--world-cyan);
    border-radius: 0.35rem;
    padding: 0.65rem 0.9rem;
    color: #08111c;
    background: var(--world-cyan);
    font-weight: 750;
    text-decoration: none;
  }

  .evidence-world__actions a.is-secondary {
    color: #edf6fb;
    background: rgba(8, 17, 28, 0.62);
  }

  .evidence-world__actions a:focus-visible {
    outline: 3px solid #f5b84b;
    outline-offset: 3px;
  }

  .evidence-world__copy > p:first-child {
    margin: 0 0 1rem;
    color: var(--world-cyan);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .evidence-world__copy h2 {
    margin: 0;
    font-family: "Bricolage Grotesque Variable", sans-serif;
    font-size: clamp(2.5rem, 4.6vw, 5rem);
    font-weight: 800;
    line-height: 0.94;
    letter-spacing: -0.05em;
    text-wrap: balance;
  }

  .evidence-world__copy > p:last-of-type {
    max-width: 44rem;
    margin: 1.25rem 0 0;
    color: #b7cad8;
    font-size: clamp(0.92rem, 1.25vw, 1.08rem);
    line-height: 1.7;
  }

  .evidence-world__rule {
    width: 7rem;
    height: 2px;
    margin-top: 1.5rem;
    background: var(--world-cyan);
    box-shadow: 0 0 24px rgba(84, 214, 223, 0.5);
  }

  .evidence-world__chapter:nth-child(even) .evidence-world__rule {
    margin-left: auto;
  }

  .evidence-world__copy ul {
    display: grid;
    gap: 0.65rem;
    margin: 1.35rem 0 0;
    padding: 0;
    color: #d9e7ef;
    font-size: 0.82rem;
    list-style: none;
  }

  .evidence-world__copy li {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.75rem;
  }

  .evidence-world__copy li i,
  .evidence-world__status::before {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    content: "";
    box-shadow: 0 0 14px currentColor;
  }

  .state-detected { color: #54d6df; background: #54d6df; }
  .state-verified { color: #5cdb95; background: #5cdb95; }
  .state-confirmed { color: #f5b84b; background: #f5b84b; }
  .state-inconclusive { color: #ff7168; background: #ff7168; }

  .evidence-world__status {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1.35rem;
    color: #b7cad8;
    font-size: 0.75rem;
  }

  .evidence-world__status::before {
    color: #5cdb95;
    background: #5cdb95;
  }

  @media (max-width: 767px) {
    .evidence-world__media-veil {
      background:
        radial-gradient(circle at 50% 30%, transparent 22%, rgba(8, 17, 28, 0.24) 72%),
        linear-gradient(180deg, rgba(8, 17, 28, 0.03) 42%, rgba(8, 17, 28, 0.8) 82%);
    }

    .evidence-world__chapter {
      min-height: max(840px, 125svh);
      align-items: end;
      padding: 48svh 1rem calc(1rem + var(--safe-area-inset-bottom));
    }

    .evidence-world__chapter .evidence-world__copy,
    .evidence-world__chapter:nth-child(even) .evidence-world__copy {
      width: 100%;
      margin: 0;
      padding: 0.95rem 1.05rem 1.05rem;
      text-align: left;
      background: rgba(8, 17, 28, 0.9);
      backdrop-filter: none;
    }

    evidence-world.is-motion-layout .evidence-world__chapter .evidence-world__copy,
    evidence-world.is-motion-layout .evidence-world__chapter:nth-child(even) .evidence-world__copy {
      top: auto;
      right: 1rem;
      bottom: calc(1rem + var(--safe-area-inset-bottom));
      left: 1rem;
      width: auto;
      transform: none;
    }

    evidence-world.is-enhanced.is-pinned .evidence-world__chapter .evidence-world__copy,
    evidence-world.is-enhanced.is-pinned .evidence-world__chapter:nth-child(even) .evidence-world__copy {
      right: 1rem;
      left: 1rem;
      top: auto;
      bottom: calc(1rem + var(--safe-area-inset-bottom));
      width: auto;
    }

    evidence-world.is-enhanced .evidence-world__copy,
    evidence-world.is-enhanced.is-pinned .evidence-world__copy {
      transform: translateY(0.75rem) scale(0.99);
    }

    evidence-world.is-enhanced .evidence-world__chapter.is-active .evidence-world__copy.is-card-active,
    evidence-world.is-enhanced.is-pinned .evidence-world__chapter.is-active .evidence-world__copy.is-card-active {
      transform: none;
    }

    .evidence-world__chapter:nth-child(even) .evidence-world__rule {
      margin-left: 0;
    }

    .evidence-world__copy h2 {
      font-size: clamp(1.6rem, 7.4vw, 2.5rem);
      line-height: 1;
    }

    .evidence-world__copy > p:first-child {
      margin-bottom: 0.6rem;
      font-size: 0.65rem;
    }

    .evidence-world__copy > p:last-of-type {
      margin-top: 0.75rem;
      font-size: 0.93rem;
      line-height: 1.55;
    }

    .evidence-world__rule {
      margin-top: 0.85rem;
    }

    .evidence-world__copy ul,
    .evidence-world__status {
      margin-top: 0.75rem;
    }

    .evidence-world__copy li {
      justify-content: flex-start;
    }

    .evidence-world__chrome span:last-child {
      display: none;
    }

    .evidence-world__chrome {
      top: calc(5rem + var(--safe-area-inset-top));
      bottom: auto;
      grid-template-columns: auto 1fr;
    }
  }

  @media (orientation: landscape) and (max-height: 599px) {
    evidence-world.is-enhanced .evidence-world__stage {
      position: relative;
      height: 28rem;
    }

    evidence-world.is-enhanced .evidence-world__chapters {
      margin-top: 0;
    }

    evidence-world.is-enhanced .evidence-world__chapter {
      min-height: auto;
      padding: 1rem;
    }

    evidence-world.is-motion-layout .evidence-world__copy,
    evidence-world.is-motion-layout .evidence-world__chapter:nth-child(even) .evidence-world__copy {
      position: relative;
      inset: auto;
      transform: none;
    }

    evidence-world.is-enhanced.is-pinned .evidence-world__copy {
      position: relative;
      inset: auto;
      transform: none;
    }
  }

  /* No-JS, reduced-motion, and Save-Data fallback. Normal-motion visitors get
     is-motion-layout before the lazy controller loads so the page never jumps. */
  evidence-world:not(.is-motion-layout) .evidence-world__stage {
    position: relative;
    height: auto;
    min-height: 420px;
  }

  evidence-world:not(.is-motion-layout) .evidence-world__chapters {
    margin-top: 0;
  }

  evidence-world:not(.is-motion-layout) .evidence-world__chapter {
    min-height: auto;
    padding-block: 1.75rem;
  }

  evidence-world:not(.is-motion-layout) .evidence-world__media {
    position: relative;
    height: 420px;
  }

  evidence-world:not(.is-motion-layout) .evidence-world__poster {
    opacity: 1;
  }

  evidence-world:not(.is-motion-layout) .evidence-world__poster:not(.is-active) {
    display: none;
  }

  evidence-world:not(.is-motion-layout) .evidence-world__video {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .evidence-world__poster,
    .evidence-world__video,
    evidence-world.is-enhanced .evidence-world__copy,
    evidence-world.is-enhanced .evidence-world__chapter.is-active .evidence-world__copy.is-card-active {
      transition: none;
    }

    evidence-world.is-enhanced .evidence-world__stage {
      position: relative;
      height: auto;
      min-height: 380px;
    }

    evidence-world.is-enhanced .evidence-world__media {
      position: relative;
      height: 380px;
    }

    evidence-world.is-enhanced .evidence-world__chapters {
      margin-top: 0;
    }

    evidence-world.is-enhanced .evidence-world__chapter {
      min-height: auto;
      padding-block: 1.5rem;
    }

    evidence-world.is-enhanced .evidence-world__copy,
    evidence-world.is-enhanced .evidence-world__chapter .evidence-world__copy,
    evidence-world.is-enhanced .evidence-world__chapter:nth-child(even) .evidence-world__copy {
      visibility: visible;
      opacity: 1;
      pointer-events: auto;
      position: relative;
      top: auto;
      right: auto;
      left: auto;
      transform: none;
      width: min(46rem, 100%);
      margin: 0;
    }
  }

</style>
