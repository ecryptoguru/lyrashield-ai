---
import type { MotionMediaManifest } from "../../lib/motion-manifest"

interface Props {
  manifest: MotionMediaManifest
}

const { manifest } = Astro.props
---

<evidence-world id="assurance-world" data-manifest={JSON.stringify(manifest)}>
  <div class="evidence-world__stage" aria-hidden="true">
    <div class="evidence-world__media">
      {
        manifest.chapters.map((chapter, index) => (
          <picture class:list={["evidence-world__poster", { "is-active": index === 0 }]} data-poster-index={index}>
            <source media="(max-width: 767px)" srcset={chapter.portrait.poster} />
            <img src={chapter.desktop.poster} data-poster-chapter={chapter.id} alt="" width="1600" height="900" loading={index === 0 ? "eager" : "lazy"} decoding="async" />
          </picture>
        ))
      }
      <video class="evidence-world__video is-front" muted playsinline preload="none" tabindex="-1"></video>
      <video class="evidence-world__video" muted playsinline preload="none" tabindex="-1"></video>
      <div class="evidence-world__media-veil"></div>
    </div>
    <div class="evidence-world__chrome">
      <span data-progress-label>01 / 07</span>
      <i><b data-progress-bar></b></i>
      <span>ASSURANCE WORLD</span>
    </div>
  </div>

  <div class="evidence-world__chapters">
    {
      manifest.chapters.map((chapter, index) => (
        <section class="evidence-world__chapter" data-chapter-index={index} aria-labelledby={`chapter-${chapter.id}`}>
          <div class="evidence-world__copy">
            <p>{chapter.eyebrow}</p>
            <h2 id={`chapter-${chapter.id}`}>{chapter.title}</h2>
            <div class="evidence-world__rule"></div>
            <p>{chapter.body}</p>
            {chapter.id === "evidence-state" && (
              <ul>
                <li><i class="state-detected" />Detected</li>
                <li><i class="state-verified" />Independently verified</li>
                <li><i class="state-confirmed" />Retest-confirmed</li>
                <li><i class="state-inconclusive" />Inconclusive</li>
              </ul>
            )}
            {chapter.id === "report" && <span class="evidence-world__status">Scope stated · limitations retained</span>}
          </div>
        </section>
      ))
    }
  </div>
</evidence-world>

<script>
  function bootstrapEvidenceWorld() {
    if (customElements.get("evidence-world")) return
    void import("./evidence-world.ts")
  }

  const el = document.getElementById("assurance-world")
  if (el && "IntersectionObserver" in window) {
    const observer = new IntersectionObserver(
      (entries, obs) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            obs.disconnect()
            bootstrapEvidenceWorld()
            break
          }
        }
      },
      { rootMargin: "50% 0px" }
    )
    observer.observe(el)
  } else {
    bootstrapEvidenceWorld()
  }
</script>

<style>
  evidence-world {
    --world-cyan: #54d6df;
    position: relative;
    display: block;
    color: #edf6fb;
    background: #08111c;
  }

  .evidence-world__stage {
    position: sticky;
    top: 0;
    z-index: 0;
    height: 100svh;
    overflow: hidden;
  }

  .evidence-world__media,
  .evidence-world__poster,
  .evidence-world__poster img,
  .evidence-world__video,
  .evidence-world__media-veil {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .evidence-world__poster,
  .evidence-world__video {
    opacity: 0;
    transition: opacity 240ms ease-out;
  }

  .evidence-world__poster.is-active,
  .evidence-world__video.is-front {
    opacity: 1;
  }

  .evidence-world__poster img,
  .evidence-world__video {
    object-fit: cover;
  }

  .evidence-world__video {
    z-index: 2;
    backface-visibility: hidden;
    transform: translateZ(0);
    will-change: opacity;
  }

  .evidence-world__poster {
    z-index: 1;
  }

  .evidence-world__media-veil {
    z-index: 3;
    background:
      radial-gradient(circle at 50% 42%, transparent 30%, rgba(8, 17, 28, 0.46) 100%),
      linear-gradient(180deg, rgba(8, 17, 28, 0.12), rgba(8, 17, 28, 0.7));
  }

  .evidence-world__chrome {
    position: absolute;
    right: clamp(1rem, 4vw, 4rem);
    bottom: 2rem;
    left: clamp(1rem, 4vw, 4rem);
    z-index: 4;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1rem;
    color: #91a7b8;
    font: 600 0.68rem/1 "JetBrains Mono Variable", monospace;
    letter-spacing: 0.1em;
  }

  .evidence-world__chrome i {
    height: 1px;
    overflow: hidden;
    background: rgba(145, 167, 184, 0.28);
  }

  .evidence-world__chrome b {
    display: block;
    width: 100%;
    height: 100%;
    transform: scaleX(0.02);
    transform-origin: left;
    background: var(--world-cyan);
  }

  .evidence-world__chapters {
    position: relative;
    z-index: 1;
    margin-top: -100svh;
  }

  .evidence-world__chapter {
    display: grid;
    min-height: 115svh;
    align-items: center;
    padding: 6rem max(1rem, calc((100% - 1280px) / 2));
  }

  .evidence-world__chapter:nth-child(even) .evidence-world__copy {
    margin-left: auto;
    text-align: right;
  }

  .evidence-world__copy {
    width: min(46rem, 54%);
    padding: clamp(1.25rem, 3vw, 2.5rem);
    border: 1px solid rgba(84, 214, 223, 0.18);
    border-radius: 0.35rem;
    background: rgba(8, 17, 28, 0.9);
    box-shadow: 0 1.5rem 5rem rgba(0, 0, 0, 0.24);
  }

  evidence-world.is-enhanced .evidence-world__copy {
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
    transform: translateY(1.25rem) scale(0.985);
    transition:
      opacity 180ms ease-in,
      transform 240ms ease-in,
      visibility 0s linear 240ms;
    will-change: opacity, transform;
  }

  evidence-world.is-enhanced .evidence-world__chapter.is-active .evidence-world__copy {
    visibility: visible;
    opacity: 1;
    pointer-events: auto;
    transform: scale(1);
    transition:
      opacity 280ms ease-out,
      transform 460ms cubic-bezier(0.22, 1, 0.36, 1),
      visibility 0s;
  }

  evidence-world.is-enhanced.is-pinned .evidence-world__copy {
    position: fixed;
    top: 50svh;
    right: auto;
    left: max(1rem, calc((100vw - 1280px) / 2));
    z-index: 4;
    transform: translateY(calc(-50% + 1.25rem)) scale(0.985);
  }

  evidence-world.is-enhanced.is-pinned .evidence-world__chapter:nth-child(even) .evidence-world__copy {
    right: max(1rem, calc((100vw - 1280px) / 2));
    left: auto;
  }

  evidence-world.is-enhanced.is-pinned .evidence-world__chapter.is-active .evidence-world__copy {
    transform: translateY(-50%) scale(1);
  }

  .evidence-world__copy > p:first-child,
  .evidence-world__copy > p:last-of-type,
  .evidence-world__status,
  .evidence-world__copy ul {
    font-family: "JetBrains Mono Variable", monospace;
  }

  .evidence-world__copy > p:first-child {
    margin: 0 0 1rem;
    color: var(--world-cyan);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .evidence-world__copy h2 {
    margin: 0;
    font-family: "Bricolage Grotesque Variable", sans-serif;
    font-size: clamp(2.6rem, 5.4vw, 5.8rem);
    font-weight: 800;
    line-height: 0.94;
    letter-spacing: -0.05em;
    text-wrap: balance;
  }

  .evidence-world__copy > p:last-of-type {
    max-width: 44rem;
    margin: 1.25rem 0 0;
    color: #b7cad8;
    font-size: clamp(0.92rem, 1.25vw, 1.08rem);
    line-height: 1.7;
  }

  .evidence-world__rule {
    width: 7rem;
    height: 2px;
    margin-top: 1.5rem;
    background: var(--world-cyan);
    box-shadow: 0 0 24px rgba(84, 214, 223, 0.5);
  }

  .evidence-world__chapter:nth-child(even) .evidence-world__rule {
    margin-left: auto;
  }

  .evidence-world__copy ul {
    display: grid;
    gap: 0.65rem;
    margin: 1.35rem 0 0;
    padding: 0;
    color: #d9e7ef;
    font-size: 0.82rem;
    list-style: none;
  }

  .evidence-world__copy li {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.75rem;
  }

  .evidence-world__copy li i,
  .evidence-world__status::before {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    content: "";
    box-shadow: 0 0 14px currentColor;
  }

  .state-detected { color: #54d6df; background: #54d6df; }
  .state-verified { color: #5cdb95; background: #5cdb95; }
  .state-confirmed { color: #f5b84b; background: #f5b84b; }
  .state-inconclusive { color: #ff7168; background: #ff7168; }

  .evidence-world__status {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1.35rem;
    color: #b7cad8;
    font-size: 0.75rem;
  }

  .evidence-world__status::before {
    color: #5cdb95;
    background: #5cdb95;
  }

  @media (max-width: 767px) {
    .evidence-world__chapter {
      min-height: 118svh;
      align-items: center;
      padding: 5rem 1rem;
    }

    .evidence-world__chapter .evidence-world__copy,
    .evidence-world__chapter:nth-child(even) .evidence-world__copy {
      width: 100%;
      margin: 0;
      padding: 1.1rem 1.2rem 1.2rem;
      text-align: left;
      background: rgba(8, 17, 28, 0.94);
    }

    evidence-world.is-enhanced.is-pinned .evidence-world__chapter .evidence-world__copy,
    evidence-world.is-enhanced.is-pinned .evidence-world__chapter:nth-child(even) .evidence-world__copy {
      right: 1rem;
      left: 1rem;
      width: auto;
    }

    .evidence-world__chapter:nth-child(even) .evidence-world__rule {
      margin-left: 0;
    }

    .evidence-world__copy h2 {
      font-size: clamp(2.15rem, 10.5vw, 3.25rem);
      line-height: 0.98;
    }

    .evidence-world__copy > p:first-child {
      margin-bottom: 0.7rem;
      font-size: 0.68rem;
    }

    .evidence-world__copy > p:last-of-type {
      margin-top: 0.9rem;
      font-size: 0.85rem;
      line-height: 1.55;
    }

    .evidence-world__rule {
      margin-top: 1rem;
    }

    .evidence-world__copy ul,
    .evidence-world__status {
      margin-top: 0.9rem;
    }

    .evidence-world__copy li {
      justify-content: flex-start;
    }

    .evidence-world__chrome span:last-child {
      display: none;
    }

    .evidence-world__chrome {
      grid-template-columns: auto 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .evidence-world__poster,
    .evidence-world__video,
    evidence-world.is-enhanced .evidence-world__copy,
    evidence-world.is-enhanced .evidence-world__chapter.is-active .evidence-world__copy {
      transition: none;
    }
  }
</style>
