---
const appOrigin = (import.meta.env.PUBLIC_SCANNER_URL as string | undefined)?.replace(/\/$/, "") || ""
const scannerAvailable = Boolean(appOrigin)
---

<section id="free-scan" aria-labelledby="free-scan-heading" class="overflow-x-clip border-y border-border bg-bg-raised/55 px-4 py-10 sm:px-6 sm:py-12 lg:px-8 lg:py-14">
  <div class="mx-auto grid max-w-6xl gap-10 lg:grid-cols-[.8fr_1.2fr] lg:items-center" data-reveal-group>
    <div class="max-w-xl" data-reveal="left">
      <p class="font-mono text-xs font-semibold tracking-[.2em] text-accent uppercase">Live URL scan · passive and read-only</p>
      <h2 id="free-scan-heading" class="mt-4 text-3xl font-semibold tracking-tight text-text sm:text-4xl">See your app&apos;s gaps in 30 seconds. Free, no signup.</h2>
      <p class="mt-5 text-lg leading-8 text-text-muted">Paste your live app URL for a passive check of exposed secrets, browser protections, frontend data-layer signals, and HTTPS. We fetch only the public URL you authorize. No login or installation.</p>
      <p class="mt-4 text-sm leading-6 text-text-muted">For checks that never leave your browser, use the <a href="/tools/webmcp-security-checker" class="font-semibold text-accent underline decoration-accent/40 underline-offset-4">WebMCP Security Checker</a> or other <a href="/tools" class="font-semibold text-accent underline decoration-accent/40 underline-offset-4">browser-local tools</a>.</p>
      <a href="/scan" class="mt-5 inline-flex min-h-11 items-center text-sm font-semibold text-accent underline decoration-accent/40 underline-offset-4 hover:decoration-accent focus:outline-none focus-visible:ring-2 focus-visible:ring-accent">What it covers / what it cannot prove</a>
      <p class="mt-5 text-sm leading-6 text-text-muted">Want the full repo and target loop? <a href="https://app.lyrashieldai.com/sign-up?source=landing_lite_check&cta=create_account" data-cta-id="home-lite-scan-create-account" class="font-semibold text-accent underline decoration-accent/40 underline-offset-4 hover:decoration-accent focus:outline-none focus-visible:ring-2 focus-visible:ring-accent">Create an account</a>.</p>
    </div>

    <form id="home-lite-scan-form" action="/scan" data-reveal="right" class="border-l-2 border-accent pl-5 sm:pl-8">
      <label for="home-scan-url" class="block text-sm font-semibold text-text">Public app URL</label>
      <div class="mt-2 flex flex-col gap-3 sm:flex-row">
        <input id="home-scan-url" type="text" inputmode="url" autocomplete="url" required maxlength="2048" placeholder="example.com or https://your-app.com" disabled={!scannerAvailable} class="min-h-13 flex-1 rounded-xl border border-border bg-bg px-4 text-base text-text shadow-sm placeholder:text-text-muted focus:border-accent focus:outline-none focus-visible:ring-2 focus-visible:ring-accent disabled:cursor-not-allowed disabled:opacity-60" />
        <button type="submit" data-cta-id="homepage_lite_scan" disabled={!scannerAvailable} class="min-h-13 rounded-xl bg-accent px-6 font-semibold text-bg shadow-sm hover:opacity-90 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent disabled:cursor-not-allowed disabled:opacity-55">{scannerAvailable ? "Scan my app" : "Scanner unavailable"}</button>
      </div>
      <label class="mt-4 flex cursor-pointer items-start gap-3 text-sm leading-6 text-text-muted">
        <input id="home-scan-authorized" type="checkbox" required disabled={!scannerAvailable} class="mt-1 size-4 shrink-0 accent-(--accent)" />
        <span>I own this app or have permission to test it. The check is passive and read-only. By scanning I agree to the <a href="/terms" class="font-medium text-accent underline underline-offset-4">Terms</a>.</span>
      </label>
      {!scannerAvailable && <p class="mt-4 text-sm leading-6 text-text-muted" role="status">The separately protected scanner API is not connected in this environment.</p>}
      <p id="home-scan-error" class="mt-4 hidden text-sm leading-6 text-danger" role="alert"></p>
    </form>
  </div>

  {/* Shows the shape of a Lite Check result before the visitor spends 30 seconds
      on one. Sample values, real check names, and the honest closing line: a
      passive check cannot prove absence. All text, so it stays crawlable. */}
  <figure class="lite-sample mx-auto mt-12 max-w-6xl" data-reveal="scale">
    <figcaption class="lite-sample__head">
      <span class="lite-sample__eyebrow">What a result looks like</span>
      <span class="lite-sample__note">Sample values · your result depends on your app</span>
    </figcaption>
    <ul class="lite-sample__list">
      <li class="lite-sample__row">
        <i class="lite-sample__dot is-warn" aria-hidden="true"></i>
        <span class="lite-sample__name">Security headers</span>
        <span class="lite-sample__verdict is-warn">3 missing</span>
        <span class="lite-sample__detail">No Content-Security-Policy, no HSTS, no X-Content-Type-Options.</span>
      </li>
      <li class="lite-sample__row">
        <i class="lite-sample__dot is-warn" aria-hidden="true"></i>
        <span class="lite-sample__name">Frontend data-layer signals</span>
        <span class="lite-sample__verdict is-warn">1 to review</span>
        <span class="lite-sample__detail">A client bundle references a key-shaped string. Worth a look before launch.</span>
      </li>
      <li class="lite-sample__row">
        <i class="lite-sample__dot is-pass" aria-hidden="true"></i>
        <span class="lite-sample__name">HTTPS and redirects</span>
        <span class="lite-sample__verdict is-pass">Clean</span>
        <span class="lite-sample__detail">Valid certificate, HTTP redirects to HTTPS.</span>
      </li>
      <li class="lite-sample__row">
        <i class="lite-sample__dot is-muted" aria-hidden="true"></i>
        <span class="lite-sample__name">CORS policy</span>
        <span class="lite-sample__verdict is-muted">Not applicable</span>
        <span class="lite-sample__detail">No cross-origin API surface was reachable from the public page.</span>
      </li>
    </ul>
    <p class="lite-sample__foot">
      A passive check reads what your app already exposes publicly. It can show you what is missing;
      it cannot prove nothing is wrong. The deeper questions — auth flows, logic, and whether a fix
      actually held — need the full loop.
      <a href="/scan">What the Lite Check covers, and what it cannot prove</a>
    </p>
  </figure>
</section>

<style>
  .lite-sample {
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 0.75rem;
    background: var(--bg);
  }

  .lite-sample__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    border-bottom: 1px solid var(--border);
    padding: 0.9rem 1.15rem;
    background: color-mix(in srgb, var(--bg-raised) 70%, transparent);
    font-family: "JetBrains Mono Variable", monospace;
    font-size: 0.72rem;
  }

  .lite-sample__eyebrow {
    color: var(--accent);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .lite-sample__note {
    color: var(--text-muted);
  }

  .lite-sample__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .lite-sample__row {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.35rem 0.75rem;
    padding: 0.95rem 1.15rem;
  }

  .lite-sample__row + .lite-sample__row {
    border-top: 1px solid var(--border);
  }

  .lite-sample__dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: currentColor;
  }

  .lite-sample__name {
    color: var(--text);
    font-weight: 600;
  }

  .lite-sample__verdict {
    font-family: "JetBrains Mono Variable", monospace;
    font-size: 0.75rem;
    font-weight: 700;
    text-align: right;
  }

  .lite-sample__detail {
    grid-column: 2 / -1;
    color: var(--text-muted);
    font-size: 0.85rem;
    line-height: 1.55;
  }

  /* Under 480px the name and the right-aligned verdict crowd each other, so the
     verdict drops onto its own line under the check name. */
  @media (max-width: 479px) {
    .lite-sample__row {
      grid-template-columns: auto 1fr;
    }

    .lite-sample__verdict {
      grid-column: 2 / -1;
      text-align: left;
    }
  }

  /* Theme-aware state colours: darker in light mode so the text keeps its
     contrast ratio, brighter on the dark surface. */
  .lite-sample {
    --sample-pass: #1f7a4d;
    --sample-warn: var(--terminal-warning-text);
  }

  :root[data-theme="dark"] .lite-sample {
    --sample-pass: #5cdb95;
    --sample-warn: #f5b84b;
  }

  .is-pass {
    color: var(--sample-pass);
  }

  .is-warn {
    color: var(--sample-warn);
  }

  .is-muted {
    color: var(--text-muted);
  }

  .lite-sample__foot {
    margin: 0;
    border-top: 1px solid var(--border);
    padding: 0.95rem 1.15rem 1.1rem;
    color: var(--text-muted);
    font-size: 0.85rem;
    line-height: 1.6;
  }

  .lite-sample__foot a {
    color: var(--accent);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
</style>

<script>
  import { normalizePublicHttpUrl } from "../../lib/public-url"

  const form = document.querySelector<HTMLFormElement>("#home-lite-scan-form")
  form?.addEventListener("submit", (event) => {
    event.preventDefault()
    const input = document.querySelector<HTMLInputElement>("#home-scan-url")
    const error = document.querySelector<HTMLElement>("#home-scan-error")
    if (!input || !error) return
    error.classList.add("hidden")
    let target = ""
    try {
      target = normalizePublicHttpUrl(input.value)
    } catch {
      error.textContent = "Enter a valid public HTTP or HTTPS URL without credentials."
      error.classList.remove("hidden")
      input.focus()
      return
    }
    try {
      sessionStorage.setItem("lyrashield-lite-target", target)
      location.assign("/scan?start=1")
    } catch {
      error.textContent = "Your browser blocked the private handoff. Open the full Lite Check and paste the URL there."
      error.classList.remove("hidden")
    }
  })
</script>
