---
const scannerAvailable = Boolean(__MARKETING_SCANNER_URL__.replace(/\/$/, ""))
---
<section id="free-scan" aria-labelledby="free-scan-heading" class="lite-entry">
  <div>
    <h2 id="free-scan-heading">Start with a Lite Check.</h2>
    <p class="lite-entry__intro">A free, passive check of your public URL for exposed secrets, browser protections and HTTPS.</p>
    <p class="lite-entry__limit">Surface signals only. It cannot prove your app is secure.</p>
    <a class="lite-entry__link" href="/scan">See coverage and limits<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M4 12h15m-6-6 6 6-6 6" /></svg></a>
  </div>
  <div>
    <form id="hero-lite-form" class="lite-entry__field" action="/scan" method="get" novalidate>
      <label class="lite-entry__field-label" for="hero-scan-url">Public app URL</label>
      <div class="lite-entry__field-row">
        <input
          id="hero-scan-url"
          type="text"
          inputmode="url"
          autocomplete="url"
          maxlength="2048"
          placeholder="example.com or https://your-app.com"
          disabled={!scannerAvailable}
          class="lite-entry__field-input"
        />
        <button
          type="submit"
          disabled={!scannerAvailable}
          data-cta-id="hero_lite_check_submit"
          class="lite-entry__field-button"
        >
          Run Lite Check
        </button>
      </div>
      <label class="lite-entry__field-consent">
        <input
          id="hero-scan-authorized"
          type="checkbox"
          disabled={!scannerAvailable}
          class="lite-entry__field-check"
        />
        <span
          >I own this app or have permission to test it. The check is passive and read-only. By
          scanning I agree to the <a href="/terms">Terms</a>.</span
        >
      </label>
      {
        !scannerAvailable && (
          <p class="lite-entry__field-status" role="status">
            The separately protected scanner API is not connected in this environment.
          </p>
        )
      }
      <p id="hero-scan-error" class="lite-entry__field-error hidden" role="alert"></p>
      <noscript>
        <p class="lite-entry__field-status">
          <a href="/scan">Open the free Lite Check</a> to run the check without JavaScript.
        </p>
      </noscript>
    </form>
  </div>
</section>
<script>
  import { bindLiteHandoff } from "../../lib/lite-handoff"
  import { sanitizeMarketingProperties } from "../../lib/posthog-privacy"

  // The dedicated form never fetches a target. It validates, privately parks
  // the authorized URL for /scan, and navigates through the shared handoff.
  //
  // Analytics carry the CTA id and a boolean only. The typed URL is never a
  // property, so it cannot leave this component.
  const capture = (valid: boolean) =>
    window.posthog?.capture(
      "hero_lite_check_submit",
      sanitizeMarketingProperties("hero_lite_check_submit", {
        cta_id: "hero_lite_check_submit",
        valid,
      }) ?? {}
    )

  const error = () => document.querySelector<HTMLElement>("#hero-scan-error")
  bindLiteHandoff({
    formId: "hero-lite-form",
    inputId: "hero-scan-url",
    errorId: "hero-scan-error",
    consentId: "hero-scan-authorized",
    onClear: () => error()?.classList.add("hidden"),
    onError: (message) => {
      const node = error()
      if (!node) return
      node.textContent = message
      node.classList.remove("hidden")
      capture(false)
    },
    onSuccess: () => capture(true),
  })
</script>

<style>
  .lite-entry { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(2rem, 6vw, 6rem); padding: clamp(3rem, 6vw, 5rem) max(1.25rem, calc((100% - 1200px) / 2)); border-block: 1px solid var(--border); background: var(--bg-raised); scroll-margin-top: 5rem; }
  h2 { margin: 0; font: 750 clamp(2rem, 4vw, 3rem)/1.1 "Bricolage Grotesque Variable", sans-serif; letter-spacing: -.03em; text-wrap: balance; }
  .lite-entry__intro { max-width: 40ch; margin-top: 1rem; color: var(--text-muted); line-height: 1.7; }
  .lite-entry__limit { margin-top: .75rem; font-size: .875rem; color: var(--text-muted); }
  .lite-entry__link { display: inline-flex; align-items: center; gap: .5rem; min-height: 44px; margin-top: .75rem; color: var(--accent); font-size: .875rem; font-weight: 600; }
  .lite-entry__field { margin: 0; min-width: 0; }
  .lite-entry__field-label { display: block; margin-bottom: .6rem; font-weight: 600; font-size: .875rem; }
  .lite-entry__field-row { display: flex; flex-wrap: wrap; gap: .6rem; }
  .lite-entry__field-input { flex: 1 1 12rem; min-width: 0; max-width: 100%; min-height: 52px; padding: .75rem 1rem; border: 1px solid var(--border); border-radius: .5rem; background: var(--bg); color: var(--text); font-size: 1rem; }
  .lite-entry__field-input::placeholder { color: var(--text-muted); opacity: 1; }
  .lite-entry__field-button { min-height: 52px; padding: .75rem 1.1rem; border-radius: .5rem; background: var(--accent); color: var(--bg); font-weight: 650; cursor: pointer; }
  .lite-entry__field-button:disabled { background: var(--bg); color: var(--text-muted); border: 1px solid var(--border); cursor: not-allowed; }
  .lite-entry__field-consent { display: flex; align-items: start; gap: .65rem; margin-top: 1rem; min-height: 44px; font-size: .8rem; line-height: 1.65; color: var(--text-muted); cursor: pointer; }
  .lite-entry__field-check { flex: none; width: 1.1rem; height: 1.1rem; margin-top: .15rem; accent-color: var(--accent); }
  .lite-entry__field-consent a, noscript a { color: var(--accent); text-decoration: underline; text-underline-offset: .2em; }
  .lite-entry__field-status { margin-top: .75rem; color: var(--text-muted); font-size: .8rem; line-height: 1.6; }
  .lite-entry__field-error { margin-top: .5rem; color: var(--terminal-warning-text); font-size: .875rem; line-height: 1.6; }
  input:focus-visible, button:focus-visible, a:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
  @media (max-width: 767px) { .lite-entry { grid-template-columns: minmax(0, 1fr); } }
</style>
