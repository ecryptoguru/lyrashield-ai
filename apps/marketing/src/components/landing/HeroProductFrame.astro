---
/** Founder-supplied captures of the current demo workspace, cropped and
 * redacted in the image files. See public/product/README.md for provenance.
 */
const shots = [
  {
    id: "overview", label: "Overview", title: "Evidence overview", asset: "posture",
    route: "dashboard", width: 1600, height: 597,
    alt: "LyraShield dashboard showing one next action, authorized target scope, partial coverage and an insufficient evidence state. Private review identity is redacted.",
    heading: "Your review, in view.",
    description: "Scope, coverage and evidence together.",
  },
  {
    id: "findings", label: "Findings", title: "Findings", asset: "findings",
    route: "dashboard/findings", width: 960, height: 834,
    alt: "A current finding detail panel with Critical severity, Open status, Inconclusive evidence and actions to review evidence or create a fix proposal. The private finding title is redacted.",
    heading: "Evidence before action.",
    description: "Review findings and proposed fixes.",
  },
  {
    id: "scan", label: "Scan record", title: "Scan record", asset: "scan",
    route: "dashboard/scans", width: 1600, height: 640,
    alt: "A completed, sealed scan record showing its duration, retained findings, a zero-count reserved verification column, coverage state and Create an assurance report action. The target name is redacted.",
    heading: "From review to report.",
    description: "Retain the scope and coverage.",
  },
  {
    id: "readiness", label: "Launch readiness", title: "Launch readiness", asset: "readiness",
    route: "dashboard/launch-readiness", width: 1600, height: 604,
    alt: "Current Launch Readiness view showing insufficient current evidence, a review-findings action and a triage score explicitly labeled as separate from readiness.",
    heading: "Know what is missing.",
    description: "Readiness includes the limits.",
  },
  {
    id: "agents", label: "Coding agents", title: "Coding Agents", asset: "agents",
    route: "dashboard/agents", width: 1600, height: 690,
    alt: "Current Coding Agents view with search, setup methods and Devin, GitHub Copilot and Cline installation cards, each with Set up, Docs and expandable setup details.",
    heading: "Work with your agent.",
    description: "Choose your client and setup.",
  },
]
const primary = shots[0]!
---

<section id="product-preview" class="hero-frame" aria-labelledby="hero-frame-caption">
  <header class="hero-frame__intro">
    <h2 id="hero-frame-caption">See the product.</h2>
  </header>
  <div class="hero-frame__views" role="group" aria-label="Dashboard views" hidden>
    {shots.map((shot) => <button type="button" data-product-select={shot.id} aria-controls={`product-view-${shot.id}`} aria-pressed={shot.id === "overview" ? "true" : "false"}>{shot.label}</button>)}
  </div>
  <div class="hero-frame__gallery" data-evidence-arrival>
    {shots.map((shot) => (
      <figure id={`product-view-${shot.id}`} class="hero-frame__panel" data-product-panel={shot.id}>
        <div class="hero-frame__window">
          <div class="hero-frame__chrome" aria-hidden="true"><p>app.lyrashieldai.com/{shot.route}</p><span>Demo workspace</span></div>
          <div class="hero-frame__stage">
            <img class="hero-frame__img hero-frame__img--dark" src={`/product/current-${shot.asset}-dark.webp`} alt={shot.alt} width={shot.width} height={shot.height} loading="lazy" decoding="async" />
            <img class="hero-frame__img hero-frame__img--light" src={`/product/current-${shot.asset}-light.webp`} alt={`${shot.alt} Light theme.`} width={shot.width} height={shot.height} loading="lazy" decoding="async" />
          </div>
          <button class="hero-frame__expand" type="button" data-product-expand data-product-view={shot.id} data-product-title={shot.title} aria-label={`Expand preview: ${shot.title}`} hidden>Expand preview</button>
        </div>
        <figcaption class="hero-frame__caption"><h3>{shot.heading}</h3><p>{shot.description}</p></figcaption>
      </figure>
    ))}
  </div>
  <p class="hero-frame__provenance">Demo workspace · Captured October 9, 2026 · Private details redacted.</p>
  <dialog class="product-preview" aria-labelledby="product-preview-title">
    <div class="product-preview__toolbar"><h2 id="product-preview-title">Dashboard preview</h2><button type="button" data-product-close>Close preview</button></div>
    <p>Demo workspace capture · Private details redacted</p>
    <p id="product-preview-hint" class="product-preview__hint">Swipe or use the arrow keys to inspect the full screen.</p>
    <div class="product-preview__scroll" tabindex="0" role="region" aria-label="Enlarged product image" aria-describedby="product-preview-hint"><img data-product-image src={`/product/current-${primary.asset}-dark.webp`} alt={primary.alt} width={primary.width} height={primary.height} loading="lazy" /></div>
  </dialog>
</section>
<script>import "./product-preview"</script>

<style>
  .hero-frame { position: relative; scroll-margin-top: 5rem; padding: clamp(2rem, 4vw, 3rem) max(1rem, calc((100% - 1280px) / 2)) clamp(3rem, 6vw, 5rem); background: var(--bg); color: var(--text); }
  .hero-frame__intro { max-width: 65ch; margin-bottom: 1.5rem; }
  .hero-frame__intro h2 { margin: 0 0 .6rem; font-size: clamp(1.6rem, 3vw, 2.5rem); line-height: 1.15; letter-spacing: -.025em; text-wrap: balance; }
  .hero-frame__intro p, .hero-frame__caption p { margin: 0; color: var(--text-muted); }
  .hero-frame__views { display: flex; flex-wrap: wrap; gap: .5rem; margin-bottom: 1rem; }
  .hero-frame__views[hidden], .hero-frame__panel[hidden] { display: none; }
  .hero-frame__views button, .hero-frame__expand, .product-preview button { min-height: 44px; padding: .65rem 1rem; border: 1px solid var(--border); border-radius: .5rem; background: var(--bg-raised); color: var(--text); font-size: .875rem; font-weight: 600; cursor: pointer; }
  .hero-frame__views button[aria-pressed="true"] { background: var(--accent); color: var(--bg); border-color: var(--accent); }
  .hero-frame__views button:hover, .hero-frame__expand:hover, .product-preview button:hover { border-color: var(--accent); }
  button:focus-visible, .product-preview__scroll:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
  .hero-frame__gallery { display: grid; grid-template-columns: minmax(0, 1fr); gap: 2rem; min-width: 0; }
  .hero-frame__panel { min-width: 0; margin: 0; }
  .hero-frame__window { position: relative; overflow: hidden; border: 1px solid var(--border); border-radius: .75rem; background: var(--bg-raised); }
  .hero-frame__chrome { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: .85rem 1rem; border-bottom: 1px solid var(--border); color: var(--text-muted); font-size: .75rem; }
  .hero-frame__chrome p { margin: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .hero-frame__chrome span { flex: none; }
  .hero-frame__stage { display: flex; align-items: center; justify-content: center; height: clamp(260px, 43vw, 560px); padding: clamp(.5rem, 1.5vw, 1.25rem); background: #03070e; }
  .hero-frame__img { display: block; max-width: 100%; max-height: 100%; width: auto; height: auto; }
  .hero-frame__img--light { display: none; }
  .hero-frame__expand { display: block; margin: .75rem .75rem .75rem auto; }
  .hero-frame__expand[hidden] { display: none; }
  .hero-frame__caption { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin: 1.2rem 0 0; }
  .hero-frame__caption h3 { margin: 0; font-size: clamp(1.1rem, 2vw, 1.4rem); line-height: 1.3; text-wrap: balance; }
  .hero-frame__caption p { max-width: 65ch; font-size: .95rem; line-height: 1.65; }
  .hero-frame__provenance { max-width: 80ch; margin: 1.5rem 0 0; font-size: .8rem; line-height: 1.6; color: var(--text-muted); }
  .product-preview { width: min(94vw, 1400px); max-height: 90svh; margin: auto; padding: 1.25rem; color: var(--text); background: var(--bg); border: 1px solid var(--border); border-radius: .75rem; }
  .product-preview::backdrop { background: rgba(8,17,28,.78); }
  .product-preview__toolbar { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .product-preview h2 { font-size: 1.1rem; margin: 0; }
  .product-preview > p { color: var(--text-muted); font-size: .8rem; }
  .product-preview__scroll { overflow: auto; max-height: 70svh; }
  .product-preview img { display: block; width: 100%; height: auto; }
  .product-preview__hint { display: none; }
  :global(:root[data-theme="light"]) .hero-frame__stage { background: #f5faff; }
  :global(:root[data-theme="light"]) .hero-frame__img--dark { display: none; }
  :global(:root[data-theme="light"]) .hero-frame__img--light { display: block; }
  @media (prefers-reduced-motion: no-preference) {
    .is-arrived .hero-frame__window { animation: console-arrive 420ms cubic-bezier(.16,1,.3,1); }
    @keyframes console-arrive { from { opacity: .75; transform: translateY(14px); } to { opacity: 1; transform: none; } }
  }
  @media (max-width: 600px) {
    .hero-frame__views { gap: .4rem; }
    .hero-frame__views button { padding: .6rem .75rem; font-size: .8rem; }
    .hero-frame__chrome span { display: none; }
    .hero-frame__stage { height: auto; }
    .hero-frame__img { width: 100%; max-height: none; }
    .hero-frame__caption { grid-template-columns: 1fr; gap: .5rem; }
    .product-preview__hint { display: block; }
    .product-preview img { width: max(100%, 900px); max-width: none; }
  }
</style>
