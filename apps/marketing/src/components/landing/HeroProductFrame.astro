---
/** Current dashboard component captures, using public synthetic fixtures.
 * Dark/light pairs share content and capture dimensions; no live account data
 * is present. Full provenance and regeneration notes live in public/product/README.md.
 */
interface Shot {
  src: string
  alt: string
  lightSrc: string
  lightAlt: string
  route: string
  width: number
  height: number
  lightWidth: number
  lightHeight: number
}

const primary: Shot = {
  src: "/product/current-posture-dark.webp",
  lightSrc: "/product/current-posture-light.webp",
  alt: "Current LyraShield dashboard evidence panel with illustrative data: insufficient evidence, authorized target scope, partial coverage and incomplete retest coverage.",
  lightAlt: "The same current dashboard evidence panel in light theme, with illustrative data and an insufficient evidence verdict.",
  route: "app.lyrashieldai.com/dashboard",
  width: 1312, height: 544, lightWidth: 1312, lightHeight: 544,
}
const secondary: Shot[] = [
  {
    src: "/product/current-findings-dark.webp", lightSrc: "/product/current-findings-light.webp",
    alt: "Current Findings interface with a synthetic open finding, its severity, evidence filters and scope controls.",
    lightAlt: "Current Findings interface in light theme with the same synthetic open finding and evidence filters.",
    route: "app.lyrashieldai.com/dashboard/findings",
    width: 1312, height: 410, lightWidth: 1312, lightHeight: 410,
  },
  {
    src: "/product/current-agents-dark.webp", lightSrc: "/product/current-agents-light.webp",
    alt: "Current Coding Agents interface with client search, setup guidance and installation commands.",
    lightAlt: "Current Coding Agents interface in light theme with client search, setup guidance and installation commands.",
    route: "app.lyrashieldai.com/dashboard/agents",
    width: 1312, height: 720, lightWidth: 1312, lightHeight: 720,
  },
]
---

<section id="product-preview" class="hero-frame" aria-labelledby="hero-frame-caption">
  <figure class="hero-frame__figure">
    <div class="hero-frame__collage" data-evidence-arrival>
      <div class="hero-frame__window hero-frame__window--primary">
        <button class="hero-frame__expand" type="button" data-product-expand data-product-title="Evidence overview" aria-label="Expand current evidence preview" hidden>Expand preview</button>
        <div class="hero-frame__chrome" aria-hidden="true">
          <span></span><span></span><span></span>
          <p>{primary.route}</p>
        </div>
        <img
          class="hero-frame__img hero-frame__img--dark"
          src={primary.src}
          alt={primary.alt}
          width={primary.width}
          height={primary.height}
          loading="lazy"
          decoding="async"
        />
        <img
          class="hero-frame__img hero-frame__img--light"
          src={primary.lightSrc}
          alt={primary.lightAlt}
          width={primary.lightWidth}
          height={primary.lightHeight}
          loading="lazy"
          decoding="async"
        />
      </div>

      <div class="hero-frame__stack">
        {
          secondary.map((shot) => (
            <div class="hero-frame__window hero-frame__window--thumb">
              <button class="hero-frame__expand" type="button" data-product-expand data-product-title={shot.route.endsWith("findings") ? "Findings" : "Coding Agents"} aria-label={`Expand ${shot.route.endsWith("findings") ? "Findings" : "Coding Agents"} preview`} hidden>Expand preview</button>
              <div class="hero-frame__chrome hero-frame__chrome--thumb" aria-hidden="true">
                <span />
                <p>{shot.route}</p>
              </div>
              <img
                class="hero-frame__img hero-frame__img--dark"
                src={shot.src}
                alt={shot.alt}
                width={shot.width}
                height={shot.height}
                loading="lazy"
                decoding="async"
              />
              <img
                class="hero-frame__img hero-frame__img--light"
                src={shot.lightSrc}
                alt={shot.lightAlt}
                width={shot.lightWidth}
                height={shot.lightHeight}
                loading="lazy"
                decoding="async"
              />
            </div>
          ))
        }
      </div>
    </div>

    <figcaption id="hero-frame-caption" class="hero-frame__caption">
      <b>The current evidence console, three ways.</b> Scope and coverage come before a
      score. Findings keep their evidence state; Coding Agents connects the client you use.
      These are captures of current dashboard components with illustrative data, not live
      account results. Expand a preview to inspect the interface.
    </figcaption>
  </figure>
  <dialog class="product-preview" aria-labelledby="product-preview-title">
    <div class="product-preview__toolbar"><h2 id="product-preview-title">Current dashboard preview</h2><button type="button" data-product-close>Close preview</button></div>
    <p>Current dashboard components · Illustrative data</p>
    <p id="product-preview-hint" class="product-preview__hint">Swipe or use the arrow keys to inspect the full screen.</p>
    <div class="product-preview__scroll" tabindex="0" role="region" aria-label="Enlarged product image" aria-describedby="product-preview-hint"><img data-product-image src={primary.src} alt={primary.alt} width={primary.width} height={primary.height} loading="lazy" /></div>
  </dialog>
</section>
<script>
  import "./product-preview"
</script>

<style>
  .hero-frame {
    scroll-margin-top: 5rem;
  }
  .hero-frame__expand {
    position: relative;
    order: 3;
    align-self: flex-end;
    margin: 0.7rem;
    min-height: 44px;
    padding: 0.6rem 0.9rem;
    color: var(--text);
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    font-size: 0.8rem;
    font-weight: 600;
  }
  .hero-frame__expand:hover {
    color: var(--accent);
  }
  .product-preview {
    width: min(94vw, 1400px);
    max-height: 90svh;
    margin: auto;
    padding: 1.25rem;
    color: var(--text);
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 0.75rem;
  }
  .product-preview::backdrop {
    background: rgba(8, 17, 28, 0.78);
  }
  .product-preview__toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .product-preview h2 {
    font-size: 1.1rem;
    margin: 0;
  }
  .product-preview button {
    min-height: 44px;
    padding: 0.5rem 0.8rem;
    background: var(--bg-raised);
    color: var(--text);
    border: 1px solid var(--border);
    border-radius: 0.5rem;
  }
  .product-preview > p {
    color: var(--text-muted);
    font-size: 0.8rem;
  }
  .product-preview__scroll {
    overflow: auto;
    max-height: 70svh;
  }
  .product-preview img {
    display: block;
    width: 100%;
    height: auto;
  }
  .product-preview__hint { display: none; }
  .product-preview__scroll:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  @media (max-width: 600px) {
    .product-preview__hint { display: block; }
    .product-preview img {
      width: max(100%, 900px);
      max-width: none;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .product-preview[open] {
      animation: preview-expand 250ms cubic-bezier(0.16, 1, 0.3, 1);
    }
    @keyframes preview-expand {
      from {
        opacity: 0.6;
        transform: scale(0.97);
      }
      to {
        opacity: 1;
        transform: none;
      }
    }
  }

  .hero-frame {
    --frame-cyan: #54d6df;
    position: relative;
    padding: clamp(1.5rem, 3vw, 2.5rem) max(1rem, calc((100% - 1280px) / 2))
      clamp(3rem, 6vw, 5rem);
    background: #08111c;
  }

  .hero-frame__figure {
    margin: 0;
  }

  .hero-frame__collage {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(0.65rem, 1.4vw, 1.1rem);
    align-items: start;
  }

  .hero-frame__stack {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: start;
    gap: clamp(0.65rem, 1.4vw, 1.1rem);
  }

  @media (prefers-reduced-motion: no-preference) {
    .is-arrived .hero-frame__window--primary {
      animation: dashboard-arrival 700ms cubic-bezier(.16,1,.3,1);
    }
    .is-arrived .hero-frame__stack {
      animation: dashboard-arrival 700ms cubic-bezier(.16,1,.3,1) 100ms backwards;
    }
    @keyframes dashboard-arrival {
      from { clip-path: inset(0 0 8% 0); opacity: .6; transform: translateY(10px); }
      to { clip-path: inset(0); opacity: 1; transform: none; }
    }
  }
  .hero-frame__window {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid rgba(84, 214, 223, 0.22);
    border-radius: 0.6rem;
    background: #0b1723;
    box-shadow:
      0 2rem 5rem rgba(0, 0, 0, 0.5),
      0 0 0 1px rgba(8, 17, 28, 0.6);
  }

  .hero-frame__window--thumb {
    border-radius: 0.5rem;
    box-shadow:
      0 1rem 2.5rem rgba(0, 0, 0, 0.45),
      0 0 0 1px rgba(8, 17, 28, 0.6);
  }

  .hero-frame__chrome {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    border-bottom: 1px solid rgba(32, 50, 70, 0.9);
    padding: 0.7rem 0.95rem;
    background: #0e1a28;
  }

  .hero-frame__chrome--thumb {
    gap: 0.3rem;
    padding: 0.4rem 0.6rem;
  }

  .hero-frame__chrome span {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: #2b4258;
    flex: none;
  }

  .hero-frame__chrome--thumb span {
    width: 0.4rem;
    height: 0.4rem;
  }

  .hero-frame__chrome p {
    margin: 0 0 0 0.75rem;
    overflow: hidden;
    color: #91a7b8;
    font:
      500 0.72rem/1 "JetBrains Mono Variable",
      monospace;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .hero-frame__chrome--thumb p {
    margin-left: 0.4rem;
    font-size: 0.62rem;
  }

  .hero-frame__img {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Both theme captures are always in the DOM; only one is ever visible.
       See the light-theme override below for the swap. */
  .hero-frame__img--light {
    display: none;
  }

  .hero-frame__caption {
    max-width: 68ch;
    margin: 1rem 0 0;
    color: #91a7b8;
    font-size: 0.86rem;
    line-height: 1.65;
  }

  .hero-frame__caption b {
    color: #b7cad8;
    font-weight: 700;
  }

  @media (max-width: 767px) {
    .hero-frame__collage {
      grid-template-columns: 1fr;
    }

    .hero-frame__stack {
      grid-template-columns: 1fr;
    }

    .hero-frame__window--thumb .hero-frame__img {
      height: auto;
      object-fit: initial;
    }
  }

  /* Light theme: the page goes light AND the windows now frame real
       light-theme captures of the app (see .hero-frame__img--dark/--light
       above for the swap) — so the chrome goes light too, matching what it's
       actually framing. This replaces the earlier "windows always stay dark"
       rule, written back when only dark-theme captures existed: forcing a
       dark toolbar onto a light screenshot would look like a mismatched frame
       now that both variants are real. The caption (which sits on the page,
       not the cards) keeps taking page colours as before. */
  :global(:root[data-theme="light"]) .hero-frame {
    --frame-cyan: #087f78;
    background: var(--bg);
  }

  :global(:root[data-theme="light"]) .hero-frame__img--dark {
    display: none;
  }

  :global(:root[data-theme="light"]) .hero-frame__img--light {
    display: block;
  }

  :global(:root[data-theme="light"]) .hero-frame__window {
    background: #fff;
    border-color: rgba(16, 34, 53, 0.14);
    box-shadow:
      0 2rem 5rem rgba(39, 75, 94, 0.22),
      0 0 0 1px rgba(217, 228, 236, 0.9);
  }

  :global(:root[data-theme="light"]) .hero-frame__window--thumb {
    box-shadow:
      0 1rem 2.5rem rgba(39, 75, 94, 0.18),
      0 0 0 1px rgba(217, 228, 236, 0.9);
  }

  :global(:root[data-theme="light"]) .hero-frame__chrome {
    border-bottom-color: rgba(16, 34, 53, 0.1);
    background: #f4f7fa;
  }

  :global(:root[data-theme="light"]) .hero-frame__chrome span {
    background: #c3d0da;
  }

  :global(:root[data-theme="light"]) .hero-frame__chrome p {
    color: #5f7081;
  }

  :global(:root[data-theme="light"]) .hero-frame__caption {
    color: #5f7081;
  }

  :global(:root[data-theme="light"]) .hero-frame__caption b {
    color: #102235;
  }
</style>
