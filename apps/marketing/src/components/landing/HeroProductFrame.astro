---
/**
 * The hero product-image collage.
 *
 * Renders on the same theme-aware canvas as PremiumHero and rises into it, so
 * it reads as the second half of the hero rather than a separate band.
 *
 * Six REAL captures of the evidence console — one dark-theme and one
 * light-theme shot per frame — redacted before they entered the repo: the
 * account block and any private scan-target names on each were pixelated
 * and blurred destructively, so the original pixels are gone from the file
 * rather than hidden behind a CSS filter. See `public/product/README.md`
 * for the capture-and-scrub rule that governs every product image on this
 * site.
 *
 * Each frame renders BOTH its dark and light capture as separate <img>
 * elements; `:root[data-theme="light"]` toggles which one is visible (see
 * the .hero-frame__img--dark / --light rules below). This is CSS-only, no
 * JS: the browser fetches both images (the light one at low priority via
 * `loading="lazy"`), so the hero's image payload is roughly double a
 * single-theme collage in exchange for the screenshots always matching the
 * page's current theme.
 *
 * Layout: the dashboard view runs large on the left; two more (Issues, Coding
 * Agents) stack on the right, in that order. Trust Runs was cut from the
 * collage on purpose — two taller frames read better than three cramped ones.
 * On narrow viewports all three stack full-width in the same order — small
 * side columns would be illegible at 390px, so this is a genuine reflow, not
 * just a shrink.
 *
 * The two small frames use dedicated `*-thumb.webp` / `*-thumb-light.webp`
 * files with the app sidebar cropped out (see public/product/README.md) —
 * at thumbnail width the sidebar was mostly wasted space, and cropping
 * leaves more of the room for the content that actually makes the point.
 * This is a DIFFERENT crop from the full-width captures the same pages'
 * content uses elsewhere (methodology, docs/integrations): those keep the
 * sidebar, this collage does not. Don't point this component at the
 * non-thumb files, and don't overwrite the shared non-thumb files with a
 * sidebar-cropped version — other pages depend on their current dimensions.
 *
 * console-trust-runs-thumb.webp is intentionally NOT built — nothing
 * references it. If Trust Runs comes back into this collage, regenerate it
 * from console-trust-runs.webp per the crop recipe in the README rather than
 * assuming a stale copy still matches the current sidebar boundary.
 *
 * The large frame deliberately shows an INCONCLUSIVE launch verdict. That is
 * the product's whole argument stated in its own UI: a run completed, nothing
 * could be evaluated, and the verdict says so rather than rounding up to a
 * pass. Do not swap it for a greener, emptier-looking state.
 *
 * console-home.webp runs the full dashboard height (readiness track through
 * "Recent scan activity") by design — it's a stitch of two captures at
 * different scroll positions, joined at a card boundary, with the app's
 * fixed sidebar de-duplicated by flat-filling the second capture's sidebar
 * column before the join. Regenerate BOTH theme variants together from
 * fresh captures if this page's layout changes; don't patch one half.
 */

interface Shot {
  src: string
  alt: string
  lightSrc: string
  lightAlt: string
  route: string
  width: number
  height: number
  lightWidth: number
  lightHeight: number
}

const primary: Shot = {
  src: "/product/console-home.webp",
  alt: 'The LyraShield evidence console home view in dark mode. A launch verdict reads "Inconclusive — nothing was checked", above a four-step readiness track of target ready, evidence captured, blockers cleared and assurance shared. The security score shows as unavailable, and 46 open findings are broken down as 3 critical, 6 high, 37 medium and 0 low.',
  lightSrc: "/product/console-home-light.webp",
  lightAlt: 'The LyraShield evidence console home view in light mode, showing the same "Inconclusive — nothing was checked" launch verdict, readiness track, and 46 open findings broken down as 3 critical, 6 high, 37 medium and 0 low.',
  route: "app.lyrashieldai.com/dashboard",
  width: 1600,
  height: 1587,
  lightWidth: 1600,
  lightHeight: 1584,
}

const secondary: Shot[] = [
  {
    src: "/product/console-issues-thumb.webp",
    alt: "The Issues view in the LyraShield console in dark mode. Findings are listed with a severity, an evidence state, an open status, and a CWE and CVSS reference.",
    lightSrc: "/product/console-issues-thumb-light.webp",
    lightAlt: "The Issues view in the LyraShield console in light mode. Findings are listed with a severity, an evidence state, an open status, and a CWE and CVSS reference.",
    route: "app.lyrashieldai.com/issues",
    width: 1133,
    height: 883,
    lightWidth: 1133,
    lightHeight: 878,
  },
  {
    src: "/product/console-coding-agents-thumb.webp",
    alt: "The Coding Agents page in the LyraShield console in dark mode. Cards for Devin, VS Code, Cline, OpenCode, Kilo Code, Zed and more each show a copyable install command.",
    lightSrc: "/product/console-coding-agents-thumb-light.webp",
    lightAlt: "The Coding Agents page in the LyraShield console in light mode. Cards for Devin, VS Code, Cline, OpenCode, Kilo Code, Zed and more each show a copyable install command.",
    route: "app.lyrashieldai.com/coding-agents",
    width: 1133,
    height: 883,
    lightWidth: 1133,
    lightHeight: 878,
  },
]
---

<section class="hero-frame" aria-labelledby="hero-frame-caption">
  <figure class="hero-frame__figure">
    <div class="hero-frame__collage">
      <div class="hero-frame__window hero-frame__window--primary">
        <div class="hero-frame__chrome" aria-hidden="true">
          <span></span><span></span><span></span>
          <p>{primary.route}</p>
        </div>
        <img
          class="hero-frame__img hero-frame__img--dark"
          src={primary.src}
          alt={primary.alt}
          width={primary.width}
          height={primary.height}
          loading="eager"
          decoding="async"
        />
        <img
          class="hero-frame__img hero-frame__img--light"
          src={primary.lightSrc}
          alt={primary.lightAlt}
          width={primary.lightWidth}
          height={primary.lightHeight}
          loading="lazy"
          decoding="async"
        />
      </div>

      <div class="hero-frame__stack">
        {
          secondary.map((shot) => (
            <div class="hero-frame__window hero-frame__window--thumb">
              <div class="hero-frame__chrome hero-frame__chrome--thumb" aria-hidden="true">
                <span />
                <p>{shot.route}</p>
              </div>
              <img
                class="hero-frame__img hero-frame__img--dark"
                src={shot.src}
                alt={shot.alt}
                width={shot.width}
                height={shot.height}
                loading="lazy"
                decoding="async"
              />
              <img
                class="hero-frame__img hero-frame__img--light"
                src={shot.lightSrc}
                alt={shot.lightAlt}
                width={shot.lightWidth}
                height={shot.lightHeight}
                loading="lazy"
                decoding="async"
              />
            </div>
          ))
        }
      </div>
    </div>

    <figcaption id="hero-frame-caption" class="hero-frame__caption">
      <b>The evidence console, three ways.</b> Dashboard: this run's verdict reads
      <i>inconclusive — nothing was checked</i>, reported honestly instead of rounded up to a
      pass. Issues: findings carried with their evidence state, not just a severity. Coding
      Agents: setup for the client you already use. Account details are blurred throughout.
    </figcaption>
  </figure>
</section>

<style>
  .hero-frame {
    --frame-cyan: #54d6df;
    position: relative;
    padding: clamp(1.5rem, 3vw, 2.5rem) max(1rem, calc((100% - 1280px) / 2))
      clamp(3rem, 6vw, 5rem);
    background: #08111c;
  }

  .hero-frame__figure {
    margin: 0;
  }

  .hero-frame__collage {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: clamp(0.65rem, 1.4vw, 1.1rem);
    align-items: stretch;
  }

  .hero-frame__stack {
    display: grid;
    grid-template-rows: repeat(2, 1fr);
    gap: clamp(0.65rem, 1.4vw, 1.1rem);
  }

  .hero-frame__window {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid rgba(84, 214, 223, 0.22);
    border-radius: 0.6rem;
    background: #0b1723;
    box-shadow:
      0 2rem 5rem rgba(0, 0, 0, 0.5),
      0 0 0 1px rgba(8, 17, 28, 0.6);
  }

  .hero-frame__window--thumb {
    border-radius: 0.5rem;
    box-shadow:
      0 1rem 2.5rem rgba(0, 0, 0, 0.45),
      0 0 0 1px rgba(8, 17, 28, 0.6);
  }

  .hero-frame__chrome {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    border-bottom: 1px solid rgba(32, 50, 70, 0.9);
    padding: 0.7rem 0.95rem;
    background: #0e1a28;
  }

  .hero-frame__chrome--thumb {
    gap: 0.3rem;
    padding: 0.4rem 0.6rem;
  }

  .hero-frame__chrome span {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: #2b4258;
    flex: none;
  }

  .hero-frame__chrome--thumb span {
    width: 0.4rem;
    height: 0.4rem;
  }

  .hero-frame__chrome p {
    margin: 0 0 0 0.75rem;
    overflow: hidden;
    color: #91a7b8;
    font: 500 0.72rem/1 "JetBrains Mono Variable", monospace;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .hero-frame__chrome--thumb p {
    margin-left: 0.4rem;
    font-size: 0.62rem;
  }

  .hero-frame__img {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Both theme captures are always in the DOM; only one is ever visible.
     See the light-theme override below for the swap. */
  .hero-frame__img--light {
    display: none;
  }

  /* The two thumbnails share equal-height rows in .hero-frame__stack; crop
     each capture to fill its row instead of letterboxing at an odd height. */
  .hero-frame__window--thumb {
    flex: 1;
    min-height: 0;
  }

  .hero-frame__window--thumb .hero-frame__img {
    flex: 1;
    min-height: 0;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }

  .hero-frame__caption {
    max-width: 68ch;
    margin: 1rem 0 0;
    color: #91a7b8;
    font-size: 0.86rem;
    line-height: 1.65;
  }

  .hero-frame__caption b {
    color: #b7cad8;
    font-weight: 700;
  }

  @media (max-width: 767px) {
    .hero-frame__collage {
      grid-template-columns: 1fr;
    }

    .hero-frame__stack {
      grid-template-rows: none;
    }

    .hero-frame__window--thumb .hero-frame__img {
      height: auto;
      object-fit: initial;
    }
  }

  /* Light theme: the page goes light AND the windows now frame real
     light-theme captures of the app (see .hero-frame__img--dark/--light
     above for the swap) — so the chrome goes light too, matching what it's
     actually framing. This replaces the earlier "windows always stay dark"
     rule, written back when only dark-theme captures existed: forcing a
     dark toolbar onto a light screenshot would look like a mismatched frame
     now that both variants are real. The caption (which sits on the page,
     not the cards) keeps taking page colours as before. */
  :global(:root[data-theme="light"]) .hero-frame {
    --frame-cyan: #087f78;
    background: var(--bg);
  }

  :global(:root[data-theme="light"]) .hero-frame__img--dark {
    display: none;
  }

  :global(:root[data-theme="light"]) .hero-frame__img--light {
    display: block;
  }

  :global(:root[data-theme="light"]) .hero-frame__window {
    background: #fff;
    border-color: rgba(16, 34, 53, 0.14);
    box-shadow:
      0 2rem 5rem rgba(39, 75, 94, 0.22),
      0 0 0 1px rgba(217, 228, 236, 0.9);
  }

  :global(:root[data-theme="light"]) .hero-frame__window--thumb {
    box-shadow:
      0 1rem 2.5rem rgba(39, 75, 94, 0.18),
      0 0 0 1px rgba(217, 228, 236, 0.9);
  }

  :global(:root[data-theme="light"]) .hero-frame__chrome {
    border-bottom-color: rgba(16, 34, 53, 0.1);
    background: #f4f7fa;
  }

  :global(:root[data-theme="light"]) .hero-frame__chrome span {
    background: #c3d0da;
  }

  :global(:root[data-theme="light"]) .hero-frame__chrome p {
    color: #5f7081;
  }

  :global(:root[data-theme="light"]) .hero-frame__caption {
    color: #5f7081;
  }

  :global(:root[data-theme="light"]) .hero-frame__caption b {
    color: #102235;
  }
</style>
