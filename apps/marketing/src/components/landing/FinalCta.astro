---
import { CTA_LABEL, TRIAL_LINE } from "../../lib/site-copy"
---
<section aria-labelledby="final-cta-heading" class="final-cta">
  <h2 id="final-cta-heading">Make your next release<br />a more informed decision.</h2>
  <a href="https://app.lyrashieldai.com/sign-up?source=landing_final&cta=create_account" data-cta-id="final-cta-create-account">{CTA_LABEL.signUp}</a>
  <p>{TRIAL_LINE}</p>
</section>
<style>
  .final-cta { padding: clamp(3rem, 7vw, 6rem) 1.25rem; text-align: center; background: var(--bg-raised); }
  h2 { margin: 0; font: 750 clamp(2rem, 4.5vw, 3.5rem)/1.1 "Bricolage Grotesque Variable", sans-serif; letter-spacing: -.035em; text-wrap: balance; }
  a { display: inline-flex; min-height: 52px; align-items: center; justify-content: center; margin-top: 1.75rem; padding: .8rem 1.5rem; border-radius: .5rem; background: var(--accent); color: var(--bg); font-weight: 650; }
  a:hover { transform: translateY(-2px); }
  a:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
  p { margin-top: 1rem; color: var(--text-muted); font-size: .8rem; line-height: 1.6; }
  @media (prefers-reduced-motion: reduce) { a:hover { transform: none; } }
</style>
