---
import { CTA_LABEL, TRIAL_LINE } from "../../lib/site-copy"
---
<section aria-labelledby="final-cta-heading" class="final-cta">
  <h2 id="final-cta-heading">Review your next release.</h2>
  <a href="https://app.lyrashieldai.com/sign-up?source=landing_final&cta=create_account" data-cta-id="final-cta-create-account">{CTA_LABEL.signUp}</a>
  <p>{TRIAL_LINE}</p>
</section>
<style>
.final-cta { padding: clamp(4rem, 8vw, 7rem) 1rem; text-align: center; background: var(--bg-raised); }
h2 { margin: 0 0 2rem; color: var(--text); font-size: clamp(2rem, 5vw, 4rem); line-height: 1.1; letter-spacing: -.03em; text-wrap: balance; }
a { display: inline-flex; align-items: center; justify-content: center; min-height: 52px; padding: .85rem 2rem; border-radius: .75rem; background: var(--accent); color: var(--bg); font-weight: 700; transition: transform 160ms; }
a:hover { transform: translateY(-2px); }
a:active { transform: translateY(1px); }
a:focus-visible { outline: 2px solid var(--accent); outline-offset: 5px; }
p { margin: 1.25rem 0 0; color: var(--text-muted); font-size: .875rem; }
@media(prefers-reduced-motion:reduce) { a { transition: none; transform: none; } }
</style>
