---
import WaitlistForm from "@components/WaitlistForm.astro"
interface Props { tags?: string[] }
const { tags = [] } = Astro.props
const path = Astro.url.pathname
const next = path.includes("php2shell") ? { href: "/tools/php2shell-checker", label: "Check your PHP version", description: "Use the browser-local version checker, then follow the relevant remediation guidance." } :
  tags.includes("access-control") ? { href: "/tools/supabase-rls-checker", label: "Review policy SQL locally", description: "Look for policy patterns, then verify isolation with separate accounts." } :
  tags.includes("agent-security") ? { href: "/agents", label: "Connect your coding agent", description: "Find the documented setup for your client and keep approvals in your workflow." } :
  tags.includes("web-security") ? { href: "/tools/security-headers-checker", label: "Review your response headers", description: "Run a focused browser-local check and see its limitations." } :
  { href: "/methodology", label: "See how evidence is assessed", description: "Understand scope, coverage and what a retest result can establish." }
---
<section aria-labelledby="blog-cta-heading" class="mt-16 border-t border-border pt-10">
  <h2 id="blog-cta-heading" class="text-2xl font-semibold tracking-tight text-text">Put this guide to work.</h2>
  <p class="mt-3 max-w-prose leading-7 text-text-muted">{next.description}</p>
  <a href={next.href} class="mt-5 inline-flex min-h-11 items-center rounded-lg bg-accent px-5 py-3 font-semibold text-bg transition-colors hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent">{next.label}<span aria-hidden="true" class="ml-2">→</span></a>
  <nav aria-label="Explore LyraShield" class="mt-5 flex flex-wrap gap-x-6 gap-y-2 text-sm text-accent">
    <a class="inline-flex min-h-11 items-center underline underline-offset-4" href="/pricing">Cloud plans and trial</a>
    <a class="inline-flex min-h-11 items-center underline underline-offset-4" href="/agents">Coding agent setup</a>
    <a class="inline-flex min-h-11 items-center underline underline-offset-4" href="/scan">Free Lite Check</a>
  </nav>
  <details class="mt-8 border-t border-border pt-4">
    <summary class="flex min-h-11 cursor-pointer items-center text-sm font-semibold text-text">Get occasional product updates</summary>
    <div class="mt-4"><WaitlistForm /></div>
  </details>
</section>
