---
/**
 * Site footer — also the site map.
 *
 * This is deliberately a full multi-column footer rather than the single row it
 * used to be. Several real pages were reachable only by typing the URL:
 * /ai-safety, /evidence-vault, /vibe-security-50, /compare,
 * /about and /privacy all rendered fine but were linked from
 * nowhere. That is a discoverability bug, not a content gap — every link below
 * points at a page that already exists.
 *
 * Five columns per the redesign spec section 7 (Product, Trust, Developers,
 * Company, Legal) plus a trial strip above them. src/tests/route-coverage.test.ts
 * asserts every top-level page route is linked from the header or this footer,
 * so if you add a page under src/pages, add it here too or that test fails.
 */
import { TRIAL_LINE } from "../lib/site-copy"

const xUrl = __MARKETING_X_URL__
const appUrl = import.meta.env.PUBLIC_APP_URL || "https://app.lyrashieldai.com"

// On the homepage the free scan is an in-page section; elsewhere it is a route.
const freeScanHref = Astro.url.pathname === "/" ? "#free-scan" : "/scan"

const columns = [
  {
    id: "footer-product",
    title: "Product",
    links: [
      { label: "Lite Check", href: freeScanHref },
      { label: "Free tools", href: "/tools" },
      { label: "Pricing", href: "/pricing" },
      { label: "Coding agents", href: "/agents" },
      { label: "Book a demo", href: "/demo" },
    ],
  },
  {
    id: "footer-trust",
    title: "Trust",
    links: [
      { label: "Methodology", href: "/methodology" },
      { label: "Vibe Security 50", href: "/vibe-security-50" },
      { label: "WebMCP Assurance", href: "/webmcp" },
      { label: "Evidence Vault", href: "/evidence-vault" },
      { label: "MCP guard evaluation", href: "/ai-safety" },
      { label: "Report a vulnerability", href: "/security-reporting" },
      { label: "Editorial policy", href: "/blog/editorial-policy" },
    ],
  },
  {
    id: "footer-developers",
    title: "Developers",
    links: [
      { label: "Docs", href: "/docs/integrations" },
      { label: "Agent plugin guide", href: "/docs/integrations/agent-plugins" },
      { label: "GitHub Action", href: "/docs/integrations/github-action" },
      { label: "REST API", href: "/docs/api" },
      { label: "Approvals", href: "/docs/approvals" },
    ],
  },
  {
    id: "footer-company",
    title: "Company",
    links: [
      { label: "About", href: "/about" },
      { label: "Compare", href: "/compare" },
      { label: "Guides", href: "/blog" },
      { label: "Support", href: "/support" },
    ],
  },
  {
    id: "footer-legal",
    title: "Legal",
    links: [
      { label: "Privacy", href: "/privacy" },
      { label: "Terms", href: "/terms" },
      { label: "Terms of Sale", href: "/terms-of-sale" },
    ],
  },
] as const
---

<footer class="border-t border-border bg-bg pt-12 pb-8 text-text-muted">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <!-- Trial strip: the one trial line, from src/lib/site-copy.ts. -->
    <div class="mb-10 flex flex-wrap items-center gap-x-4 gap-y-3 rounded-xl border border-border bg-bg-raised px-4 py-3 sm:px-5">
      <a
        href={`${appUrl.replace(/\/$/, "")}/sign-up?source=marketing_footer&cta=get_started`}
        class="inline-flex min-h-11 items-center rounded-lg bg-accent px-4 text-sm font-semibold text-bg transition-colors hover:bg-accent/90 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
        data-cta-id="footer_get_started"
      >
        Start free trial
      </a>
      <p class="text-sm">{TRIAL_LINE}</p>
    </div>

    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-[1.4fr_repeat(5,1fr)]">
      <div class="max-w-xs">
        <p class="text-sm font-semibold text-text">LyraShield AI</p>
        <p class="mt-3 text-sm leading-6">
          The launch gate for AI-built software. One reviewable launch report of what you checked, what
          you fixed and what a fresh retest confirmed.
        </p>
        <p class="mt-3 font-mono text-xs tracking-wide text-accent uppercase">Open beta</p>
      </div>

      {
        columns.map((column) => (
          <nav aria-labelledby={column.id}>
            <p id={column.id} class="text-sm font-semibold text-text">
              {column.title}
            </p>
            <ul class="mt-3 space-y-0.5">
              {column.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="inline-flex min-h-11 items-center text-sm hover:text-text focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    <div
      class="mt-10 flex flex-col items-center justify-between gap-4 border-t border-border pt-6 sm:flex-row"
    >
      <p class="text-center text-xs sm:text-left">
        Evidence is limited to the authorized scope and the checks that ran. No security guarantee.
      </p>
      <div class="flex flex-col items-center gap-2 sm:items-end">
        <button
          type="button"
          data-analytics-toggle
          class="inline-flex min-h-11 items-center rounded-lg border border-border px-3 text-sm font-medium text-text hover:bg-bg-raised focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
        >
          Turn analytics off
        </button>
        <p data-analytics-status role="status" aria-live="polite" class="max-w-sm text-center text-xs sm:text-right">
          Checking your optional analytics preference…
        </p>
        <a
          data-analytics-settings
          href={`${appUrl.replace(/\/$/, "")}/dashboard/settings`}
          class="inline-flex min-h-11 items-center text-sm hover:text-text focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
        >
          Account analytics settings
        </a>
      </div>
      <nav aria-label="Social" class="flex flex-wrap items-center justify-center gap-x-6">
        <a
          href="/rss.xml"
          class="inline-flex min-h-11 items-center text-sm hover:text-text focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
          >RSS</a
        >
        <a
          href="https://github.com/ecryptoguru/lyrashield-ai"
          rel="me noreferrer noopener"
          target="_blank"
          class="inline-flex min-h-11 items-center text-sm hover:text-text focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
          >GitHub <span class="sr-only">(opens in a new tab)</span> ↗</a
        >
        {
          xUrl && (
            <a
              href={xUrl}
              rel="me noreferrer noopener"
              target="_blank"
              class="inline-flex min-h-11 items-center text-sm hover:text-text focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
            >
              X
            </a>
          )
        }
      </nav>
    </div>
  </div>
</footer>
