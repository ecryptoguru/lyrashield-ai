---
/**
 * Sticky mobile CTA bar (redesign spec section 7, item 2.4).
 *
 * Shown on Home, Pricing and Scan only, after the first screen of scroll, on
 * mobile widths. It hides while a form control has focus so it never covers a
 * field the visitor is typing into — the Lite Check form on Home and the URL
 * field on Scan are both below the fold on a phone.
 */
import { CTA_LABEL } from "../lib/site-copy"

const appUrl = (import.meta.env.PUBLIC_APP_URL as string | undefined)?.replace(/\/$/, "")
const path = Astro.url.pathname.replace(/\/$/, "") || "/"
const eligible = ["/", "/pricing", "/scan"].includes(path)
---

{
  eligible && appUrl && (
    <div
      id="sticky-mobile-cta"
      class="fixed inset-x-0 bottom-0 z-30 hidden border-t border-border bg-bg/95 px-4 pt-3 backdrop-blur-xl lg:hidden"
      style="padding-bottom: max(0.75rem, env(safe-area-inset-bottom));"
      data-sticky-cta
    >
      <a
        href={`${appUrl}/sign-up?source=marketing_sticky&cta=get_started`}
        class="flex min-h-11 items-center justify-center rounded-xl bg-accent px-4 text-sm font-semibold text-bg transition-colors hover:bg-accent/90 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
        data-cta-id="sticky_get_started"
        data-analytics-event="sticky_bar_click"
        data-analytics-prop-cta-id="sticky_get_started"
      >
        {CTA_LABEL.signUp}
      </a>
    </div>
    <script>
      // Reveal after one screen of scroll; hide while a form control is
      // focused so the bar never sits over a field being typed into.
      const bar = document.querySelector<HTMLElement>("[data-sticky-cta]")
      if (bar) {
        let fieldFocused = false
        let shown = false
        const visibleConversions = new Set<Element>()
        const sync = () => {
          const pastFirstScreen = window.scrollY > window.innerHeight
          const next = pastFirstScreen && !fieldFocused && visibleConversions.size === 0
          if (next === shown) return
          shown = next
          bar.classList.toggle("hidden", !shown)
        }
        document.addEventListener(
          "focusin",
          (event) => {
            const target = event.target
            fieldFocused =
              target instanceof HTMLElement &&
              ["INPUT", "TEXTAREA", "SELECT"].includes(target.tagName)
            sync()
          },
          { passive: true }
        )
        document.addEventListener(
          "focusout",
          () => {
            fieldFocused = false
            sync()
          },
          { passive: true }
        )
        const conversionObserver = new IntersectionObserver((entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) visibleConversions.add(entry.target)
            else visibleConversions.delete(entry.target)
          }
          sync()
        })
        document.querySelectorAll('[data-cta-id="final-cta-create-account"], [data-cta-id="footer_get_started"]').forEach((element) => conversionObserver.observe(element))
        addEventListener("scroll", sync, { passive: true })
        addEventListener("resize", sync, { passive: true })
        new ResizeObserver(() => {
          document.documentElement.style.setProperty("--sticky-cta-height", `${bar.getBoundingClientRect().height}px`)
        }).observe(bar)
        sync()
      }
    </script>
  )
}
