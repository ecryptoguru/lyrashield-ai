---
import { toolUrl } from "../lib/tools"
import { CTA_LABEL } from "../lib/site-copy"

const appUrl = (import.meta.env.PUBLIC_APP_URL as string | undefined)?.replace(/\/$/, "")

// Spec section 7: four to seven top-level items, Pricing as plain text beside
// one sign-up button. WebMCP leaves the header (D6); it is linked from
// /agents and /vibe-security-50 instead. "Book a demo" leaves the header too
// and stays in the Enterprise row, the home closer and the footer.
const path = Astro.url.pathname.replace(/\/$/, "") || "/"
const isActive = (href: string) => {
  const target = href.split("#")[0]?.replace(/\/$/, "") || ""
  if (!target) return false
  return path === target || path.startsWith(`${target}/`)
}
const activeClass = "bg-bg-raised text-text"

const productItems = [
  { label: "How it works", href: "/#how-it-works" },
  { label: "Evidence and retests", href: "/methodology" },
  { label: "Vibe Security 50", href: "/vibe-security-50" },
  { label: "Operational Evidence Vault", href: "/evidence-vault" },
  { label: "Compare tools", href: "/compare" },
]
const freeToolItems = [
  { label: "Lite Check", href: "/scan", note: "Start here" },
  { label: "Security Headers and CORS Checker", href: toolUrl("security-headers-checker") },
  { label: "Secret Exposure Scanner", href: toolUrl("secret-exposure-scanner") },
  { label: "Supabase RLS Policy Checker", href: toolUrl("supabase-rls-checker") },
  { label: "All free tools", href: "/tools" },
]
const learnItems = [
  { label: "Guides", href: "/blog" },
  { label: "Docs", href: "/docs/integrations" },
  { label: "API reference", href: "/docs/integrations/rest-api" },
  // #913 renamed this label to "MCP guard evaluation". The restructure moved
  // the destination out of the header, so it is kept here rather than dropped.
  { label: "MCP guard evaluation", href: "/ai-safety" },
  { label: "Support", href: "/support" },
]
---

<header id="site-header" class="sticky top-0 z-40 border-b border-border bg-bg/85 backdrop-blur-xl">
  <div class="mx-auto flex min-h-16 max-w-[80rem] items-center justify-between gap-3 px-4 sm:px-6 lg:px-6">
    <a href="/" class="flex min-h-11 shrink-0 items-center gap-2 rounded-lg text-sm font-semibold tracking-tight whitespace-nowrap text-text hover:text-accent focus:outline-none focus-visible:ring-2 focus-visible:ring-accent sm:gap-2.5 sm:text-base">
      <span class="flex size-9 items-center justify-center rounded-xl border border-border bg-(--logo-void) p-1 shadow-sm" aria-hidden="true">
        <img src="/logo.svg" alt="" width="32" height="32" class="size-8" />
      </span>
      <span>LyraShield AI</span>
      <span class="header-beta-badge rounded border border-accent/50 bg-accent-dim/40 px-1.5 py-0.5 text-[10px] font-semibold tracking-[0.12em] text-accent uppercase">Open beta</span>
    </a>
    <!--
      The full nav switches on at lg (1024px). The row is the logo, five nav
      items (three of them menus), the theme toggle, Sign in and Start free
      trial. It fits at 1024px only because the scoped rule further down
      tightens the link padding and gaps inside the lg-to-xl band; loosening
      that rule without re-measuring reintroduces the iPad-landscape overflow
      (the CTA was clipped to "Get starte").
    -->
    <nav aria-label="Main" class="flex shrink-0 items-center gap-1 sm:gap-2">
      <ul class="hidden shrink-0 items-center gap-1 whitespace-nowrap lg:flex lg:gap-2">
        <li class="relative">
          <details class="group">
            <summary class={`inline-flex min-h-11 cursor-pointer list-none items-center gap-1 rounded-lg px-3 text-sm hover:bg-bg-raised hover:text-text focus:outline-none focus-visible:ring-2 focus-visible:ring-accent ${isActive("/methodology") || isActive("/vibe-security-50") || isActive("/evidence-vault") || isActive("/compare") ? activeClass : "text-text-muted"}`}>
              <span>Product</span>
              <svg data-nav-chevron viewBox="0 0 16 16" class="size-3.5 -translate-y-px transition-transform group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                <path d="m4 6 4 4 4-4" />
              </svg>
            </summary>
            <div class="absolute top-full left-0 mt-1 grid w-64 gap-1 rounded-xl border border-border bg-bg-raised p-2 shadow-xl">
              {productItems.map((item) => (
                <a href={item.href} class="rounded-lg px-3 py-2 text-sm text-text-muted hover:bg-bg hover:text-text focus:outline-none focus-visible:ring-2 focus-visible:ring-accent">
                  {item.label}
                </a>
              ))}
            </div>
          </details>
        </li>
        <li>
          <a
            href="/agents"
            class={`inline-flex min-h-11 items-center rounded-lg px-3 text-sm hover:bg-bg-raised hover:text-text focus:outline-none focus-visible:ring-2 focus-visible:ring-accent ${isActive("/agents") ? activeClass : "text-text-muted"}`}
            data-cta-id="header-for-agents"
          >
            Coding agents
          </a>
        </li>
        <li class="relative">
          <details class="group">
            <summary class={`inline-flex min-h-11 cursor-pointer list-none items-center gap-1 rounded-lg px-3 text-sm hover:bg-bg-raised hover:text-text focus:outline-none focus-visible:ring-2 focus-visible:ring-accent ${isActive("/tools") || isActive("/scan") ? activeClass : "text-text-muted"}`}>
              <span>Free tools</span>
              <svg data-nav-chevron viewBox="0 0 16 16" class="size-3.5 -translate-y-px transition-transform group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                <path d="m4 6 4 4 4-4" />
              </svg>
            </summary>
            <div class="absolute top-full right-0 mt-1 grid w-72 gap-1 rounded-xl border border-border bg-bg-raised p-2 shadow-xl">
              {freeToolItems.map((item) => (
                <a href={item.href} class="flex items-center justify-between gap-3 rounded-lg px-3 py-2 text-sm text-text-muted hover:bg-bg hover:text-text focus:outline-none focus-visible:ring-2 focus-visible:ring-accent">
                  <span>{item.label}</span>
                  {item.note && <span class="font-mono text-[10px] tracking-wider text-accent uppercase">{item.note}</span>}
                </a>
              ))}
            </div>
          </details>
        </li>
        <li>
          <a href="/pricing" class={`inline-flex min-h-11 items-center rounded-lg px-3 text-sm hover:bg-bg-raised hover:text-text focus:outline-none focus-visible:ring-2 focus-visible:ring-accent ${isActive("/pricing") ? activeClass : "text-text-muted"}`}>
            Pricing
          </a>
        </li>
        <li class="relative">
          <details class="group">
            <summary class={`inline-flex min-h-11 cursor-pointer list-none items-center gap-1 rounded-lg px-3 text-sm hover:bg-bg-raised hover:text-text focus:outline-none focus-visible:ring-2 focus-visible:ring-accent ${isActive("/blog") || isActive("/docs") || isActive("/support") ? activeClass : "text-text-muted"}`}>
              <span>Learn</span>
              <svg data-nav-chevron viewBox="0 0 16 16" class="size-3.5 -translate-y-px transition-transform group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                <path d="m4 6 4 4 4-4" />
              </svg>
            </summary>
            <div class="absolute top-full right-0 mt-1 grid w-56 gap-1 rounded-xl border border-border bg-bg-raised p-2 shadow-xl">
              {learnItems.map((item) => (
                <a href={item.href} class="rounded-lg px-3 py-2 text-sm text-text-muted hover:bg-bg hover:text-text focus:outline-none focus-visible:ring-2 focus-visible:ring-accent">
                  {item.label}
                </a>
              ))}
            </div>
          </details>
        </li>
        {appUrl && (
          <li class="flex items-center gap-1">
            <a href={`${appUrl}/sign-in`} class="inline-flex min-h-11 items-center rounded-lg px-3 text-sm text-text-muted hover:bg-bg-raised hover:text-text focus:outline-none focus-visible:ring-2 focus-visible:ring-accent" data-cta-id="header_sign_in">
              Sign in
            </a>
            <a
              href={`${appUrl}/sign-up?source=marketing_header&cta=get_started`}
              class="inline-flex min-h-11 items-center rounded-lg bg-accent px-4 text-sm font-semibold text-bg transition-colors hover:bg-accent/90 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-bg"
              data-cta-id="header_get_started"
            >
              {CTA_LABEL.signUp}
            </a>
          </li>
        )}
      </ul>
      <button
        id="menu-toggle"
        type="button"
        class="inline-flex size-11 items-center justify-center rounded-lg border border-border bg-bg-raised text-text-muted hover:text-text focus:outline-none focus-visible:ring-2 focus-visible:ring-accent lg:hidden"
        aria-controls="mobile-menu"
        aria-expanded="false"
        aria-label="Open navigation menu"
      >
        <svg viewBox="0 0 24 24" class="size-5 menu-open-icon" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        <svg viewBox="0 0 24 24" class="hidden size-5 menu-close-icon" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg>
      </button>

      <!--
        The mobile sheet carries the same destinations as the desktop header as
        one accordion per menu. It is a full-height sheet that scrolls inside
        the viewport (max-height 100dvh, overflow-y auto), so no destination is
        dropped to make it fit a short screen. tests-browser/theme.e2e.ts
        asserts it scrolls and reaches every destination.
      -->
      <dialog
        id="mobile-menu"
        aria-label="Mobile navigation"
        class="fixed z-50 m-0 w-[min(22rem,calc(100vw-2rem))] gap-1 rounded-2xl border border-border bg-bg-raised p-2 shadow-2xl shadow-black/20 lg:hidden"
        style="top: max(4.5rem, calc(4rem + env(safe-area-inset-top))); right: max(1rem, env(safe-area-inset-right)); bottom: auto; left: auto;"
      >
        <div class="mobile-menu__primary">
          <a href="/pricing" class="menu-link inline-flex min-h-11 items-center rounded-xl px-3 text-sm text-text-muted hover:bg-bg hover:text-text focus:outline-none focus-visible:ring-2 focus-visible:ring-accent">Pricing</a>
          <a
            href="/agents"
            class="menu-link inline-flex min-h-11 items-center rounded-xl px-3 text-sm text-text-muted hover:bg-bg hover:text-text focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
            data-cta-id="header-for-agents-mobile"
          >
            Coding agents
          </a>
        </div>
        <div class="mobile-menu__section">
          <details class="mobile-menu__accordion">
            <summary class="menu-link">Product</summary>
            <div class="mobile-menu__accordion-body">
              {productItems.map((item) => <a href={item.href} class="menu-link mobile-menu__resource">{item.label}</a>)}
            </div>
          </details>
          <details class="mobile-menu__accordion">
            <summary class="menu-link">Free tools</summary>
            <div class="mobile-menu__accordion-body">
              {freeToolItems.map((item) => <a href={item.href} class="menu-link mobile-menu__resource">{item.label}</a>)}
            </div>
          </details>
          <details class="mobile-menu__accordion">
            <summary class="menu-link">Learn</summary>
            <div class="mobile-menu__accordion-body">
              {learnItems.map((item) => <a href={item.href} class="menu-link mobile-menu__resource">{item.label}</a>)}
            </div>
          </details>
        </div>
        {appUrl && (
          <div class="mobile-menu__account">
            <a href={`${appUrl}/sign-in`} class="menu-link inline-flex min-h-11 items-center justify-center rounded-xl px-3 text-sm text-text-muted hover:bg-bg hover:text-text focus:outline-none focus-visible:ring-2 focus-visible:ring-accent" data-cta-id="header_sign_in_mobile">Sign in</a>
            <a href={`${appUrl}/sign-up?source=marketing_header&cta=get_started_mobile`} class="menu-link inline-flex min-h-11 items-center justify-center rounded-xl bg-accent px-4 text-sm font-semibold text-bg transition-colors hover:bg-accent/90 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent" data-cta-id="header_get_started_mobile">{CTA_LABEL.signUp}</a>
          </div>
        )}
      </dialog>
      <button id="theme-toggle" type="button" class="inline-flex size-11 items-center justify-center rounded-lg border border-border bg-bg-raised text-text-muted hover:text-text focus:outline-none focus-visible:ring-2 focus-visible:ring-accent" aria-label="System theme active. Change color theme" title="System theme">
        <svg data-theme-icon="system" viewBox="0 0 24 24" class="size-4.5" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="4" width="18" height="13" rx="2"/><path d="M8 21h8M12 17v4"/></svg>
        <svg data-theme-icon="light" viewBox="0 0 24 24" class="hidden size-4.5" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 3v2m0 14v2M3 12h2m14 0h2m-3.64-6.36-1.42 1.42M8.06 15.94l-1.42 1.42m0-11.72 1.42 1.42m7.88 8.88 1.42 1.42"/><circle cx="12" cy="12" r="4"/></svg>
        <svg data-theme-icon="dark" viewBox="0 0 24 24" class="hidden size-4.5" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20.5 14.1A7.5 7.5 0 0 1 9.9 3.5 8.5 8.5 0 1 0 20.5 14.1Z"/></svg>
      </button>
    </nav>
  </div>
</header>

<script>
  const button = document.querySelector<HTMLButtonElement>("#theme-toggle")
  const preferences = ["system", "light", "dark"] as const
  type ThemePreference = (typeof preferences)[number]
  const systemTheme = matchMedia("(prefers-color-scheme: dark)")

  function persistTheme(preference: ThemePreference) {
    localStorage.setItem("lyrashield-theme", preference)
    const domain =
      location.hostname === "lyrashieldai.com" || location.hostname.endsWith(".lyrashieldai.com")
        ? "; Domain=.lyrashieldai.com"
        : ""
    document.cookie = `lyrashield-theme=${preference}; Max-Age=31536000; Path=/${domain}; SameSite=Lax${location.protocol === "https:" ? "; Secure" : ""}`
  }

  function applyTheme(preference: ThemePreference) {
    const dark = preference === "dark" || (preference === "system" && systemTheme.matches)
    document.documentElement.dataset.theme = dark ? "dark" : "light"
    document.documentElement.dataset.themePreference = preference
    document.querySelector('meta[data-theme-color]')?.setAttribute("content", dark ? "#08111c" : "#f5f9fc")
    button?.querySelectorAll<SVGElement>("[data-theme-icon]").forEach((icon) =>
      icon.classList.toggle("hidden", icon.dataset.themeIcon !== preference)
    )
    const label = `${preference[0].toUpperCase()}${preference.slice(1)} theme`
    button?.setAttribute("aria-label", `${label} active. Change color theme`)
    button?.setAttribute("title", label)
  }

  button?.addEventListener("click", () => {
    const current = document.documentElement.dataset.themePreference || "system"
    const next = preferences[(preferences.indexOf(current as ThemePreference) + 1) % preferences.length] ?? "system"
    persistTheme(next)
    applyTheme(next)
  })
  systemTheme.addEventListener("change", () => {
    if (document.documentElement.dataset.themePreference === "system") applyTheme("system")
  })
  addEventListener("storage", (event: StorageEvent) => {
    if (event.key !== "lyrashield-theme") return
    const next = preferences.includes(event.newValue as ThemePreference)
      ? (event.newValue as ThemePreference)
      : "system"
    applyTheme(next)
  })
  applyTheme(
    preferences.includes(document.documentElement.dataset.themePreference as ThemePreference)
      ? (document.documentElement.dataset.themePreference as ThemePreference)
      : "system"
  )

  const menuToggle = document.querySelector<HTMLButtonElement>("#menu-toggle")
  const menu = document.querySelector<HTMLDialogElement>("#mobile-menu")

  if (menuToggle && menu) {
    const openIcon = menuToggle.querySelector<SVGElement>(".menu-open-icon")
    const closeIcon = menuToggle.querySelector<SVGElement>(".menu-close-icon")

    if (openIcon && closeIcon) {
      const setMenuOpen = (open: boolean) => {
        menuToggle.setAttribute("aria-expanded", String(open))
        menuToggle.setAttribute("aria-label", open ? "Close navigation menu" : "Open navigation menu")
        openIcon.classList.toggle("hidden", open)
        closeIcon.classList.toggle("hidden", !open)
      }

      menuToggle.addEventListener("click", () => {
        if (menu.open) {
          menu.close()
        } else {
          menu.show()
          setMenuOpen(true)
        }
      })

      menu.addEventListener("close", () => {
        setMenuOpen(false)
      })

      menu.addEventListener("click", (event) => {
        if (event.target === menu) {
          menu.close()
        }
      })

      // Close the sheet only when a real link is followed. The accordion
      // <summary> elements also carry the menu-link class, so a plain
      // querySelectorAll(".menu-link") would close the sheet the moment a
      // visitor opened a menu — the accordion could never be used.
      menu.querySelectorAll<HTMLAnchorElement>("a.menu-link").forEach((link) => {
        link.addEventListener("click", () => menu.close())
      })

      document.addEventListener("pointerdown", (event) => {
        const target = event.target
        if (!menu.open || (target instanceof Node && (menu.contains(target) || menuToggle.contains(target)))) return
        menu.close()
      })

      addEventListener("keydown", (event: KeyboardEvent) => {
        if (event.key === "Escape" && menu.open) menu.close()
      })

      // The top navbar is visible from md up, so the mobile menu must never stay open
      // there. If the viewport crosses to desktop while the menu is open (e.g. the
      // window is widened, or a desktop browser restores a small-window state), close
      // it so the two navs never render at once.
      const desktopMq = window.matchMedia("(min-width: 64rem)") // Tailwind lg
      const closeOnDesktop = () => {
        if (desktopMq.matches && menu.open) menu.close()
      }
      desktopMq.addEventListener("change", closeOnDesktop)
      closeOnDesktop()
    }
  }
</script>

<style is:global>
  @media (max-width: 359px) {
    #site-header .header-beta-badge {
      display: none;
    }

    #site-header > div {
      gap: 8px;
      padding-inline: 16px;
    }

    #site-header > div > a[href="/"] {
      flex: 1 1 auto;
      gap: 8px;
      min-width: 0;
      white-space: normal;
    }

    #site-header > div > a[href="/"] > span:first-child {
      box-sizing: border-box;
      width: 36px;
      height: 36px;
      flex: 0 0 36px;
      padding: 4px;
    }

    #site-header > div > a[href="/"] > span:first-child img {
      width: 32px;
      height: 32px;
    }

    #site-header nav[aria-label="Main"] {
      gap: 4px;
    }

    #menu-toggle,
    #theme-toggle {
      box-sizing: border-box;
      width: 44px;
      height: 44px;
      min-width: 44px;
      min-height: 44px;
      flex: 0 0 44px;
    }
  }

  #mobile-menu::backdrop {
    background: transparent;
  }

  #mobile-menu {
    box-sizing: border-box;
    /* No display here: a closed <dialog> must stay hidden, and the
       #mobile-menu[open] rule below sets the grid layout when it opens. */
    max-height: 100dvh;
    align-content: start;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: none;
  }

  #mobile-menu::-webkit-scrollbar {
    display: none;
  }

  .mobile-menu__primary,
  .mobile-menu__account {
    display: grid;
    gap: 0.25rem;
  }

  /* A touch target must be 44px, not 2.75rem: 2.75rem resolves against the root
     font-size, which can land a fraction under 44 and fail the minimum. */
  .mobile-menu__primary .menu-link,
  .mobile-menu__account .menu-link,
  .mobile-menu__resource,
  .mobile-menu__accordion > summary {
    min-height: 44px;
  }

  .mobile-menu__account {
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    margin-top: 0.25rem;
    padding-top: 0.5rem;
    border-top: 1px solid var(--border);
  }

  .mobile-menu__section {
    margin-top: 0.125rem;
  }

  .mobile-menu__section > p {
    margin: 0 0 0.125rem;
    padding: 0 0.75rem;
    color: var(--text-muted);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .mobile-menu__accordion {
    border-bottom: 1px solid var(--border);
  }

  .mobile-menu__accordion > summary {
    display: flex;
    min-height: 2.75rem;
    cursor: pointer;
    list-style: none;
    align-items: center;
    justify-content: space-between;
    border-radius: 0.75rem;
    padding: 0 0.75rem;
    color: var(--text);
    font-size: 0.875rem;
    font-weight: 600;
  }

  .mobile-menu__accordion > summary::after {
    content: "";
    width: 0.5rem;
    height: 0.5rem;
    border-right: 1.75px solid currentColor;
    border-bottom: 1.75px solid currentColor;
    transform: rotate(45deg) translateY(-0.1rem);
    transition: transform 150ms ease-out;
  }

  .mobile-menu__accordion[open] > summary::after {
    transform: rotate(-135deg) translateY(-0.1rem);
  }

  .mobile-menu__accordion-body {
    display: grid;
    gap: 0.125rem;
    padding-bottom: 0.375rem;
  }

  .mobile-menu__resources {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.25rem;
  }

  .mobile-menu__resource {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    border-radius: 0.75rem;
    padding: 0 0.75rem;
    color: var(--text-muted);
    font-size: 0.875rem;
  }

  .mobile-menu__resource:hover {
    background: var(--bg);
    color: var(--text);
  }

  /*
   * The header row (logo, five nav items including two dropdowns, theme toggle,
   * Sign in, Get started) is naturally ~1097px wide. The full nav switches on at
   * lg (1024px), so between 1024px and ~1096px it overflowed the page — up to
   * 73px at 1024x768, which is iPad landscape and small laptops. It was visible
   * not as a scrollbar but as the right edge being cut: "Get started" rendered
   * as "Get starte".
   *
   * Tighten the link padding and gaps inside the lg-to-xl band only, which takes
   * the row under 1024px so the breakpoint can stay at lg and no width loses its
   * nav. Measured: overflow 0 from 1024 through 1279; the desktop layout above
   * xl is untouched.
   *
   * If these values are loosened, re-measure at 1024x768 before shipping.
   */
  @media (min-width: 1024px) and (max-width: 1279px) {
    #site-header nav[aria-label="Main"] {
      gap: 0.25rem;
    }

    #site-header nav[aria-label="Main"] > ul {
      gap: 0.25rem;
    }

    #site-header nav[aria-label="Main"] > ul > li > a,
    #site-header nav[aria-label="Main"] > ul > li > details > summary {
      padding-left: 0.5rem;
      padding-right: 0.5rem;
    }
  }

  /* The menu is mobile-only. When open (and only below lg) lay it out as a
     vertical grid; on lg+ it is hidden entirely by the lg:hidden utility above. */
  #mobile-menu[open] {
    display: grid;
    animation: mobile-menu-in 180ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  @keyframes mobile-menu-in {
    from {
      opacity: 0;
      transform: translateY(-0.5rem) scale(0.98);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #mobile-menu[open] {
      animation: none;
    }
  }
</style>
