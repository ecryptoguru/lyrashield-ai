---
const appUrl = (import.meta.env.PUBLIC_APP_URL as string | undefined)?.replace(/\/$/, "")
---

<header class="sticky top-0 z-40 border-b border-border bg-bg/85 backdrop-blur-xl">
  <div class="mx-auto flex min-h-16 max-w-6xl items-center justify-between gap-3 px-4 sm:px-6 lg:px-8">
    <a href="/" class="flex min-h-11 shrink-0 items-center gap-2 rounded-lg text-sm font-semibold tracking-tight whitespace-nowrap text-text hover:text-accent focus:outline-none focus-visible:ring-2 focus-visible:ring-accent sm:gap-2.5 sm:text-base">
      <span class="flex size-9 items-center justify-center rounded-xl border border-border bg-(--logo-void) p-1 shadow-sm" aria-hidden="true">
        <img src="/logo.svg" alt="" width="32" height="32" class="size-8" />
      </span>
      <span>LyraShield AI</span>
      <span class="header-beta-badge rounded border border-accent/50 bg-accent-dim/40 px-1.5 py-0.5 text-[10px] font-semibold tracking-[0.12em] text-accent uppercase">Open beta</span>
    </a>
    <nav aria-label="Main" class="flex items-center gap-1 sm:gap-2">
      <ul class="hidden items-center gap-1 md:flex md:gap-2">
        <li>
          <a href="/#how-it-works" class="inline-flex min-h-11 items-center rounded-lg px-3 text-sm text-text-muted hover:bg-bg-raised hover:text-text focus:outline-none focus-visible:ring-2 focus-visible:ring-accent">
            How it works
          </a>
        </li>
        <li>
          <a href="/scan" class="inline-flex min-h-11 items-center rounded-lg px-3 text-sm font-medium text-accent hover:bg-bg-raised focus:outline-none focus-visible:ring-2 focus-visible:ring-accent">
            Free scan
          </a>
        </li>
        <li>
          <a
            href="/agents"
            class="inline-flex min-h-11 items-center rounded-lg px-3 text-sm text-text-muted hover:bg-bg-raised hover:text-text focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
            data-cta-id="header-for-agents"
          >
            For agents
          </a>
        </li>
        <li class="relative">
          <details class="group">
            <summary class="inline-flex min-h-11 cursor-pointer list-none items-center gap-1 rounded-lg px-3 text-sm text-text-muted hover:bg-bg-raised hover:text-text focus:outline-none focus-visible:ring-2 focus-visible:ring-accent">
              Resources <span aria-hidden="true">⌄</span>
            </summary>
            <div class="absolute right-0 grid w-48 gap-1 rounded-xl border border-border bg-bg-raised p-2 shadow-xl">
              <a href="/methodology" class="rounded-lg px-3 py-2 text-sm text-text-muted hover:bg-bg hover:text-text">Methodology</a>
              <a href="/tools" class="rounded-lg px-3 py-2 text-sm text-text-muted hover:bg-bg hover:text-text">Browser-local tools</a>
              <a href="/blog" class="rounded-lg px-3 py-2 text-sm text-text-muted hover:bg-bg hover:text-text">Guides</a>
              <a href="/docs/integrations" class="rounded-lg px-3 py-2 text-sm text-text-muted hover:bg-bg hover:text-text">Integration docs</a>
            </div>
          </details>
        </li>
        {appUrl && (
          <li>
            <a href={`${appUrl}/sign-in`} class="inline-flex min-h-11 items-center rounded-lg px-3 text-sm text-text-muted hover:bg-bg-raised hover:text-text focus:outline-none focus-visible:ring-2 focus-visible:ring-accent" data-cta-id="header_sign_in">
              Sign in
            </a>
            <a
              href={`${appUrl}/sign-up?source=marketing_header&cta=get_started`}
              class="inline-flex min-h-11 items-center rounded-lg bg-accent px-4 text-sm font-semibold text-bg transition-colors hover:bg-accent/90 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-bg"
              data-cta-id="header_get_started"
            >
              Get started
            </a>
          </li>
        )}
      </ul>
      <button
        id="menu-toggle"
        type="button"
        class="inline-flex size-11 items-center justify-center rounded-lg border border-border bg-bg-raised text-text-muted hover:text-text focus:outline-none focus-visible:ring-2 focus-visible:ring-accent md:hidden"
        aria-controls="mobile-menu"
        aria-expanded="false"
        aria-label="Open navigation menu"
      >
        <svg viewBox="0 0 24 24" class="size-5 menu-open-icon" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        <svg viewBox="0 0 24 24" class="hidden size-5 menu-close-icon" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg>
      </button>

      <dialog
        id="mobile-menu"
        aria-label="Mobile navigation"
        class="fixed z-50 m-0 w-[min(22rem,calc(100vw-2rem))] gap-1 rounded-2xl border border-border bg-bg-raised p-2 shadow-2xl shadow-black/20 md:hidden"
        style="top: max(4.5rem, calc(4rem + env(safe-area-inset-top))); right: max(1rem, env(safe-area-inset-right)); bottom: auto; left: auto;"
      >
        <div class="mobile-menu__primary">
          <a
            href="/agents"
            class="menu-link inline-flex min-h-10 items-center rounded-xl px-3 text-sm text-text-muted hover:bg-bg hover:text-text focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
            data-cta-id="header-for-agents-mobile"
          >
            For agents
          </a>
          <a href="/#how-it-works" class="menu-link inline-flex min-h-10 items-center rounded-xl px-3 text-sm text-text-muted hover:bg-bg hover:text-text focus:outline-none focus-visible:ring-2 focus-visible:ring-accent">How it works</a>
          <a href="/scan" class="menu-link inline-flex min-h-10 items-center rounded-xl px-3 text-sm font-medium text-accent hover:bg-bg focus:outline-none focus-visible:ring-2 focus-visible:ring-accent">Free scan</a>
        </div>
        <div class="mobile-menu__section">
          <p>Explore</p>
          <div class="mobile-menu__resources">
            <a href="/methodology" class="menu-link mobile-menu__resource">Methodology</a>
            <a href="/tools" class="menu-link mobile-menu__resource">Tools</a>
            <a href="/blog" class="menu-link mobile-menu__resource">Resources</a>
            <a href="/docs/integrations" class="menu-link mobile-menu__resource">Docs</a>
          </div>
        </div>
        {appUrl && (
          <div class="mobile-menu__account">
            <a href={`${appUrl}/sign-in`} class="menu-link inline-flex min-h-10 items-center justify-center rounded-xl px-3 text-sm text-text-muted hover:bg-bg hover:text-text focus:outline-none focus-visible:ring-2 focus-visible:ring-accent" data-cta-id="header_sign_in_mobile">Sign in</a>
            <a href={`${appUrl}/sign-up?source=marketing_header&cta=get_started_mobile`} class="menu-link inline-flex min-h-10 items-center justify-center rounded-xl bg-accent px-4 text-sm font-semibold text-bg transition-colors hover:bg-accent/90 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent" data-cta-id="header_get_started_mobile">Get started</a>
          </div>
        )}
      </dialog>
      <button id="theme-toggle" type="button" class="inline-flex size-11 items-center justify-center rounded-lg border border-border bg-bg-raised text-text-muted hover:text-text focus:outline-none focus-visible:ring-2 focus-visible:ring-accent" aria-label="System theme active. Change color theme" title="System theme">
        <svg data-theme-icon="system" viewBox="0 0 24 24" class="size-4.5" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="4" width="18" height="13" rx="2"/><path d="M8 21h8M12 17v4"/></svg>
        <svg data-theme-icon="light" viewBox="0 0 24 24" class="hidden size-4.5" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 3v2m0 14v2M3 12h2m14 0h2m-3.64-6.36-1.42 1.42M8.06 15.94l-1.42 1.42m0-11.72 1.42 1.42m7.88 8.88 1.42 1.42"/><circle cx="12" cy="12" r="4"/></svg>
        <svg data-theme-icon="dark" viewBox="0 0 24 24" class="hidden size-4.5" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20.5 14.1A7.5 7.5 0 0 1 9.9 3.5 8.5 8.5 0 1 0 20.5 14.1Z"/></svg>
      </button>
    </nav>
  </div>
</header>

<script>
  const button = document.querySelector<HTMLButtonElement>("#theme-toggle")
  const preferences = ["system", "light", "dark"] as const
  type ThemePreference = (typeof preferences)[number]
  const systemTheme = matchMedia("(prefers-color-scheme: dark)")

  function applyTheme(preference: ThemePreference) {
    const dark = preference === "dark" || (preference === "system" && systemTheme.matches)
    document.documentElement.dataset.theme = dark ? "dark" : "light"
    document.documentElement.dataset.themePreference = preference
    document.querySelector('meta[data-theme-color]')?.setAttribute("content", dark ? "#08111c" : "#f5f9fc")
    button?.querySelectorAll<SVGElement>("[data-theme-icon]").forEach((icon) =>
      icon.classList.toggle("hidden", icon.dataset.themeIcon !== preference)
    )
    const label = `${preference[0].toUpperCase()}${preference.slice(1)} theme`
    button?.setAttribute("aria-label", `${label} active. Change color theme`)
    button?.setAttribute("title", label)
  }

  button?.addEventListener("click", () => {
    const current = document.documentElement.dataset.themePreference || "system"
    const next = preferences[(preferences.indexOf(current as ThemePreference) + 1) % preferences.length] ?? "system"
    localStorage.setItem("lyrashield-theme", next)
    applyTheme(next)
  })
  systemTheme.addEventListener("change", () => {
    if (document.documentElement.dataset.themePreference === "system") applyTheme("system")
  })
  addEventListener("storage", (event) => {
    if (event.key !== "lyrashield-theme") return
    const next = preferences.includes(event.newValue as ThemePreference)
      ? (event.newValue as ThemePreference)
      : "system"
    applyTheme(next)
  })
  applyTheme(
    preferences.includes(document.documentElement.dataset.themePreference as ThemePreference)
      ? (document.documentElement.dataset.themePreference as ThemePreference)
      : "system"
  )

  const menuToggle = document.querySelector<HTMLButtonElement>("#menu-toggle")
  const menu = document.querySelector<HTMLDialogElement>("#mobile-menu")

  if (menuToggle && menu) {
    const openIcon = menuToggle.querySelector<SVGElement>(".menu-open-icon")
    const closeIcon = menuToggle.querySelector<SVGElement>(".menu-close-icon")

    if (openIcon && closeIcon) {
      const setMenuOpen = (open: boolean) => {
        menuToggle.setAttribute("aria-expanded", String(open))
        menuToggle.setAttribute("aria-label", open ? "Close navigation menu" : "Open navigation menu")
        openIcon.classList.toggle("hidden", open)
        closeIcon.classList.toggle("hidden", !open)
      }

      menuToggle.addEventListener("click", () => {
        if (menu.open) {
          menu.close()
        } else {
          menu.show()
          setMenuOpen(true)
        }
      })

      menu.addEventListener("close", () => {
        setMenuOpen(false)
      })

      menu.addEventListener("click", (event) => {
        if (event.target === menu) {
          menu.close()
        }
      })

      menu.querySelectorAll<HTMLAnchorElement>(".menu-link").forEach((link) => {
        link.addEventListener("click", () => menu.close())
      })

      document.addEventListener("pointerdown", (event) => {
        const target = event.target
        if (!menu.open || (target instanceof Node && (menu.contains(target) || menuToggle.contains(target)))) return
        menu.close()
      })

      addEventListener(
        "scroll",
        () => {
          if (menu.open) menu.close()
        },
        { passive: true }
      )

      addEventListener("keydown", (event) => {
        if (event.key === "Escape" && menu.open) menu.close()
      })

      // The top navbar is visible from md up, so the mobile menu must never stay open
      // there. If the viewport crosses to desktop while the menu is open (e.g. the
      // window is widened, or a desktop browser restores a small-window state), close
      // it so the two navs never render at once.
      const desktopMq = window.matchMedia("(min-width: 48rem)") // Tailwind md
      const closeOnDesktop = () => {
        if (desktopMq.matches && menu.open) menu.close()
      }
      desktopMq.addEventListener("change", closeOnDesktop)
      closeOnDesktop()
    }
  }
</script>

<style is:global>
  @media (max-width: 359px) {
    .header-beta-badge {
      display: none;
    }
  }

  #mobile-menu::backdrop {
    background: transparent;
  }

  #mobile-menu {
    box-sizing: border-box;
    max-height: calc(
      100dvh - max(4.5rem, calc(4rem + env(safe-area-inset-top))) - max(1rem, env(safe-area-inset-bottom))
    );
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: none;
  }

  #mobile-menu::-webkit-scrollbar {
    display: none;
  }

  .mobile-menu__primary,
  .mobile-menu__account {
    display: grid;
    gap: 0.25rem;
  }

  .mobile-menu__account {
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    margin-top: 0.25rem;
    padding-top: 0.5rem;
    border-top: 1px solid var(--border);
  }

  .mobile-menu__section {
    margin-top: 0.125rem;
  }

  .mobile-menu__section > p {
    margin: 0 0 0.125rem;
    padding: 0 0.75rem;
    color: var(--text-muted);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .mobile-menu__resources {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.25rem;
  }

  .mobile-menu__resource {
    display: inline-flex;
    min-height: 2.5rem;
    align-items: center;
    border-radius: 0.75rem;
    padding: 0 0.75rem;
    color: var(--text-muted);
    font-size: 0.875rem;
  }

  .mobile-menu__resource:hover {
    background: var(--bg);
    color: var(--text);
  }
  /* The menu is mobile-only. When open (and only on small screens) lay it out as a
     vertical grid; on md+ it is hidden entirely by the md:hidden utility above. */
  #mobile-menu[open] {
    display: grid;
    animation: mobile-menu-in 180ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  @keyframes mobile-menu-in {
    from {
      opacity: 0;
      transform: translateY(-0.5rem) scale(0.98);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #mobile-menu[open] {
      animation: none;
    }
  }
</style>
