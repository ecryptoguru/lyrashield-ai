---
import Base from "@layouts/Base.astro"

interface NavLink {
  href: string
  label: string
}

interface Props {
  title: string
  description: string
  canonical?: string
  jsonLd?: unknown[]
  updatedDate?: string
  navLinks?: NavLink[]
  currentPath?: string
}

const {
  title,
  description,
  canonical,
  jsonLd,
  updatedDate,
  navLinks = [],
  currentPath = "",
} = Astro.props

const defaultNavLinks: NavLink[] = [
  { href: "/docs/integrations", label: "Overview" },
  { href: "/docs/integrations/claude-code", label: "Claude Code" },
  { href: "/docs/integrations/cursor", label: "Cursor" },
  { href: "/docs/integrations/windsurf", label: "Windsurf" },
  { href: "/docs/integrations/vscode", label: "VS Code" },
  { href: "/docs/integrations/openai-codex", label: "OpenAI Codex" },
  { href: "/docs/integrations/cline", label: "Cline" },
  { href: "/docs/integrations/opencode", label: "OpenCode" },
  { href: "/docs/integrations/kilo-code", label: "Kilo Code" },
  { href: "/docs/integrations/zed", label: "Zed" },
  { href: "/docs/integrations/gemini-cli", label: "Gemini CLI" },
  { href: "/docs/integrations/jetbrains", label: "JetBrains AI" },
  { href: "/docs/integrations/amp", label: "Amp" },
  { href: "/docs/integrations/picode", label: "PiCode" },
  { href: "/docs/integrations/openclaw", label: "OpenClaw" },
  { href: "/docs/integrations/hermes", label: "Hermes" },
  { href: "/docs/integrations/remote-mcp", label: "Remote MCP" },
  { href: "/docs/integrations/github-action", label: "GitHub Action" },
  { href: "/docs/integrations/rest-api", label: "REST API" },
  { href: "/docs/integrations/agent-rules", label: "Agent Rules" },
  { href: "/docs/integrations/troubleshooting", label: "Troubleshooting" },
  { href: "/docs/api", label: "API v1" },
]

const allLinks = navLinks.length > 0 ? navLinks : defaultNavLinks
const resolvedPath = currentPath || Astro.url.pathname
---

<Base
  title={title}
  description={description}
  canonical={canonical}
  jsonLd={jsonLd}
>
  <div class="docs-shell">
    <aside class="docs-sidebar" aria-label="Docs navigation">
      <nav>
        <p class="docs-sidebar__heading">Integrations</p>
        <ul class="docs-sidebar__list">
          {allLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class:list={[
                  "docs-sidebar__link",
                  { "docs-sidebar__link--active": resolvedPath === link.href },
                ]}
                aria-current={resolvedPath === link.href ? "page" : undefined}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </aside>

    <div class="docs-main">
      {updatedDate && (
        <p class="docs-updated">
          Updated <time datetime={updatedDate}>{updatedDate}</time>
        </p>
      )}
      <slot />
    </div>
  </div>
</Base>

<style>
  .docs-shell {
    width: min(100% - 2rem, 80rem);
    margin-inline: auto;
    padding-block: clamp(3rem, 7vw, 6rem);
    display: grid;
    grid-template-columns: 14rem minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
  }

  .docs-sidebar {
    position: sticky;
    top: 5rem;
  }

  .docs-sidebar__heading {
    margin: 0 0 0.75rem;
    color: var(--color-text-muted);
    font-family: "JetBrains Mono Variable", monospace;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .docs-sidebar__list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-left: 1px solid var(--color-border);
  }

  .docs-sidebar__link {
    display: block;
    padding: 0.35rem 0.9rem;
    color: var(--color-text-muted);
    font-size: 0.875rem;
    line-height: 1.5;
    text-decoration: none;
    transition: color 0.1s;
  }

  .docs-sidebar__link:hover {
    color: var(--color-text);
  }

  .docs-sidebar__link--active {
    color: var(--color-accent);
    font-weight: 600;
    border-left: 2px solid var(--color-accent);
    margin-left: -1px;
  }

  .docs-sidebar__link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
    border-radius: 0.2rem;
  }

  .docs-updated {
    margin: 0 0 1.5rem;
    color: var(--color-text-muted);
    font-family: "JetBrains Mono Variable", monospace;
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .docs-main :global(h1) {
    margin: 0;
    font-family: "Bricolage Grotesque Variable", sans-serif;
    font-size: clamp(2rem, 5vw, 3.75rem);
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -0.045em;
  }

  .docs-main :global(h2) {
    margin: 2.75rem 0 0;
    font-family: "Bricolage Grotesque Variable", sans-serif;
    font-size: clamp(1.4rem, 3vw, 2rem);
    font-weight: 700;
    letter-spacing: -0.03em;
  }

  .docs-main :global(h3) {
    margin: 2rem 0 0;
    font-size: 1.15rem;
    font-weight: 650;
    letter-spacing: -0.015em;
  }

  .docs-main :global(p) {
    margin: 1rem 0 0;
    color: var(--color-text-muted);
    line-height: 1.75;
  }

  .docs-main :global(p:first-child) {
    margin-top: 0;
  }

  .docs-main :global(a) {
    color: var(--color-accent);
    text-underline-offset: 0.2em;
  }

  .docs-main :global(a:focus-visible) {
    border-radius: 0.2rem;
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  .docs-main :global(ul),
  .docs-main :global(ol) {
    margin: 0.75rem 0 0;
    padding-left: 1.5rem;
    color: var(--color-text-muted);
    line-height: 1.75;
  }

  .docs-main :global(li + li) {
    margin-top: 0.35rem;
  }

  .docs-main :global(pre) {
    margin: 1.25rem 0 0;
    overflow-x: auto;
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    background: var(--color-bg-raised);
    padding: 1.25rem 1.5rem;
    font-size: 0.83rem;
    line-height: 1.6;
  }

  .docs-main :global(code) {
    border-radius: 0.25rem;
    padding: 0.1em 0.3em;
    color: var(--color-accent);
    background: var(--color-bg-raised);
    font-size: 0.875em;
    font-weight: 600;
  }

  .docs-main :global(pre code) {
    padding: 0;
    color: inherit;
    background: transparent;
    font-weight: 400;
  }

  .docs-main :global(.callout) {
    margin-top: 1.25rem;
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    background: var(--color-bg-raised);
    padding: 1rem 1.25rem;
    font-size: 0.9rem;
    line-height: 1.65;
    color: var(--color-text-muted);
  }

  .docs-main :global(.callout strong) {
    color: var(--color-text);
  }

  .docs-main :global(.callout--warn) {
    border-color: color-mix(in srgb, var(--color-danger) 40%, var(--color-border));
    background: color-mix(in srgb, var(--color-danger) 5%, var(--color-bg-raised));
  }

  .docs-main :global(.callout--warn strong) {
    color: var(--color-danger);
  }

  .docs-main :global(.nav-cards) {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(12rem, 1fr));
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .docs-main :global(.nav-card) {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    background: var(--color-bg-raised);
    padding: 0.85rem 1rem;
    text-decoration: none;
    transition: border-color 0.15s;
  }

  .docs-main :global(.nav-card:hover) {
    border-color: var(--color-accent);
  }

  .docs-main :global(.nav-card__label) {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .docs-main :global(.nav-card__sub) {
    font-size: 0.775rem;
    color: var(--color-text-muted);
  }

  .docs-main :global(table) {
    width: 100%;
    margin-top: 1.25rem;
    border-collapse: collapse;
    font-size: 0.875rem;
  }

  .docs-main :global(th),
  .docs-main :global(td) {
    padding: 0.6rem 0.85rem;
    border: 1px solid var(--color-border);
    text-align: left;
  }

  .docs-main :global(th) {
    background: var(--color-bg-raised);
    font-weight: 650;
    color: var(--color-text);
  }

  .docs-main :global(td) {
    color: var(--color-text-muted);
  }

  @media (max-width: 768px) {
    .docs-shell {
      grid-template-columns: 1fr;
    }

    .docs-sidebar {
      position: static;
    }

    .docs-sidebar__list {
      display: flex;
      flex-wrap: wrap;
      gap: 0.25rem 0;
      border-left: none;
      border-top: 1px solid var(--color-border);
      border-bottom: 1px solid var(--color-border);
      padding: 0.5rem 0;
    }

    .docs-sidebar__link {
      border-radius: 0.4rem;
      border: 1px solid var(--color-border);
      padding: 0.3rem 0.65rem;
      font-size: 0.8rem;
      margin: 0.2rem;
    }

    .docs-sidebar__link--active {
      border-color: var(--color-accent);
      border-left: 1px solid var(--color-accent);
      margin-left: 0.2rem;
    }
  }
</style>
