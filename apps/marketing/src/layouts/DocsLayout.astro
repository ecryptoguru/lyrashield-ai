---
import Base from "@layouts/Base.astro"
import { listPreferredAgents } from "@lyrashield/agent-registry"

interface NavLink {
  href: string
  label: string
}

interface Props {
  title: string
  description: string
  canonical?: string
  jsonLd?: unknown[]
  updatedDate?: string
  navLinks?: NavLink[]
  currentPath?: string
}

const {
  title,
  description,
  canonical,
  jsonLd,
  updatedDate,
  navLinks = [],
  currentPath = "",
} = Astro.props

const breadcrumbTitle = title.replace(/\s*\|\s*LyraShield AI$/, "")

// Derived from the registry rather than hand-listed: a hard-coded list silently
// drops newly shipped agents. `listPreferredAgents` is the same source the
// integrations index and the dashboard use, so the three stay in sync.
// The "(Agent Plugin)" suffix is display detail for a card, not a nav label.
const agentNavLinks: NavLink[] = listPreferredAgents()
  .map((agent) => ({
    href: `/docs/integrations/${agent.docsSlug}`,
    label: agent.displayName.replace(/\s*\(Agent Plugin\)\s*$/, ""),
  }))
  .sort((a, b) => a.label.localeCompare(b.label, "en"))

const guideNavLinks: NavLink[] = [
  { href: "/docs/integrations/agent-plugins", label: "Agent Plugins" },
  { href: "/docs/integrations/remote-mcp", label: "Remote MCP" },
  { href: "/docs/approvals", label: "Approvals" },
  { href: "/docs/integrations/github-action", label: "GitHub Action" },
  { href: "/docs/integrations/rest-api", label: "REST API" },
  { href: "/docs/integrations/agent-rules", label: "Agent Rules" },
  { href: "/docs/integrations/troubleshooting", label: "Troubleshooting" },
  { href: "/docs/api", label: "API v1" },
]

const resolvedPath = currentPath || Astro.url.pathname

// A caller-supplied list stays one flat group; the derived default splits into
// guides and the per-agent guides so the agent list stays scannable.
const navGroups: { heading: string; links: NavLink[] }[] =
  navLinks.length > 0
    ? [{ heading: "Integrations", links: navLinks }]
    : [
        {
          heading: "Integrations",
          links: [{ href: "/docs/integrations", label: "Overview" }, ...guideNavLinks],
        },
        { heading: "Coding agents", links: agentNavLinks },
      ]
---

<Base
  title={title}
  description={description}
  canonical={canonical}
  jsonLd={jsonLd}
>
  <div class="docs-shell">
    <aside class="docs-sidebar" aria-label="Docs navigation">
      <details class="docs-sidebar__browse" open>
        <summary class="docs-sidebar__summary">
          <span>Browse documentation</span>
        </summary>
        <nav>
          {/* Search across the sidebar (Spec item 6.4). Filters the rendered
              links only; it reads no value the visitor did not type here. */}
          <label class="docs-sidebar__search">
            <span class="sr-only">Search documentation</span>
            <input
              type="search"
              id="docs-search-input"
              data-docs-search
              placeholder="Search docs"
              autocomplete="off"
            />
          </label>
          {navGroups.map((group) => (
            <>
              <p class="docs-sidebar__heading">{group.heading}</p>
              <ul class="docs-sidebar__list" data-docs-group>
                {group.links.map((link) => (
                  <li data-docs-link={link.label.toLowerCase()}>
                    <a
                      href={link.href}
                      class:list={[
                        "docs-sidebar__link",
                        { "docs-sidebar__link--active": resolvedPath === link.href },
                      ]}
                      aria-current={resolvedPath === link.href ? "page" : undefined}
                    >
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </>
          ))}
          <p class="docs-sidebar__empty" data-docs-empty hidden>No matching page. Clear the field to see every section.</p>
        </nav>
      </details>
    </aside>

    <div class="docs-main">
      {/* Visible breadcrumb (Spec item 6.7): Docs > current page. The layout
          already carried BreadcrumbList metadata for some callers; this makes
          the trail visible on every docs page. */}
      <nav aria-label="Breadcrumb" class="mb-4">
        <ol class="flex flex-wrap items-center gap-2 text-xs text-text-muted">
          <li><a href="/" class="hover:text-text focus:outline-none focus-visible:ring-2 focus-visible:ring-accent">Home</a></li>
          <li aria-hidden="true">/</li>
          <li><a href="/docs/integrations" class="hover:text-text focus:outline-none focus-visible:ring-2 focus-visible:ring-accent">Docs</a></li>
          <li aria-hidden="true">/</li>
          <li aria-current="page" class="text-text">{breadcrumbTitle}</li>
        </ol>
      </nav>
      {updatedDate && (
        <p class="docs-updated">
          Updated <time datetime={updatedDate}>{updatedDate}</time>
        </p>
      )}
      <slot />
    </div>
  </div>
</Base>

<script>
  // Sidebar search (Spec item 6.4). Filters the rendered nav links only.
  const docsSearch = document.querySelector<HTMLInputElement>("[data-docs-search]")
  if (docsSearch) {
    const links = Array.from(document.querySelectorAll<HTMLElement>("[data-docs-link]"))
    const empty = document.querySelector<HTMLElement>("[data-docs-empty]")
    const apply = () => {
      const term = docsSearch.value.trim().toLowerCase()
      let visible = 0
      for (const link of links) {
        const match = term.length === 0 || (link.dataset.docsLink ?? "").includes(term)
        link.hidden = !match
        if (match) visible += 1
      }
      if (empty) empty.hidden = visible > 0
    }
    docsSearch.addEventListener("input", apply)
  }
</script>

<script>
  // Add a copy control to every docs code block. Purely progressive: if this
  // never runs, the snippets are still selectable exactly as before.
  const COPIED_FEEDBACK_MS = 1600

  function addCopyButtons() {
    const blocks = document.querySelectorAll<HTMLPreElement>(".docs-main pre")
    blocks.forEach((pre) => {
      if (pre.querySelector(".code-copy")) return
      const code = pre.querySelector("code")
      if (!code) return

      const button = document.createElement("button")
      button.type = "button"
      button.className = "code-copy"
      button.textContent = "Copy"
      button.setAttribute("aria-label", "Copy code to clipboard")

      let resetTimer: number | undefined
      button.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(code.innerText)
          button.textContent = "Copied"
          button.dataset.copied = "true"
        } catch {
          // Clipboard can be blocked by permissions or an insecure origin.
          button.textContent = "Press Ctrl+C"
        }
        window.clearTimeout(resetTimer)
        resetTimer = window.setTimeout(() => {
          button.textContent = "Copy"
          delete button.dataset.copied
        }, COPIED_FEEDBACK_MS)
      })

      pre.appendChild(button)
    })
  }

  addCopyButtons()
  document.addEventListener("astro:after-swap", addCopyButtons)

  // The server-rendered disclosure stays open for desktop and no-script users.
  // Collapse it on narrow viewports before the page's load event, and keep it
  // aligned when a reader rotates or resizes the browser.
  const docsBrowseMedia = window.matchMedia("(max-width: 768px)")
  function syncDocsBrowseDisclosure() {
    const browse = document.querySelector<HTMLDetailsElement>(".docs-sidebar__browse")
    if (browse) browse.open = !docsBrowseMedia.matches
  }

  syncDocsBrowseDisclosure()
  docsBrowseMedia.addEventListener("change", syncDocsBrowseDisclosure)
  document.addEventListener("astro:after-swap", syncDocsBrowseDisclosure)
</script>

<style>
  .docs-shell {
    width: min(100% - 2rem, 80rem);
    margin-inline: auto;
    padding-block: clamp(3rem, 7vw, 6rem);
    display: grid;
    grid-template-columns: 14rem minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
  }

  .docs-sidebar {
    position: sticky;
    top: 5rem;
  }

  /* The details element is open in server HTML so desktop and no-JS users retain
     the existing navigation. The bundled enhancement closes it on mobile. */
  .docs-sidebar__summary {
    display: none;
  }

  .docs-sidebar__heading {
    margin: 0 0 0.75rem;
    color: var(--color-text-muted);
    font-family: "JetBrains Mono Variable", monospace;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .docs-sidebar__list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-left: 1px solid var(--color-border);
  }

  /* Second and subsequent group headings need breathing room from the list above. */
  .docs-sidebar__list + .docs-sidebar__heading {
    margin-top: 1.5rem;
  }

  .docs-sidebar__link {
    display: block;
    padding: 0.35rem 0.9rem;
    color: var(--color-text-muted);
    font-size: 0.875rem;
    line-height: 1.5;
    text-decoration: none;
    transition: color 0.1s;
  }

  .docs-sidebar__link:hover {
    color: var(--color-text);
  }

  .docs-sidebar__link--active {
    color: var(--color-accent);
    font-weight: 600;
    border-left: 2px solid var(--color-accent);
    margin-left: -1px;
  }

  .docs-sidebar__link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
    border-radius: 0.2rem;
  }

  .docs-main {
    min-width: 0;
  }

  .docs-updated {
    margin: 0 0 1.5rem;
    color: var(--color-text-muted);
    font-family: "JetBrains Mono Variable", monospace;
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .docs-main :global(h1) {
    margin: 0;
    font-family: "Bricolage Grotesque Variable", sans-serif;
    font-size: clamp(2rem, 5vw, 3.75rem);
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -0.045em;
  }

  .docs-main :global(h2) {
    margin: 2.75rem 0 0;
    font-family: "Bricolage Grotesque Variable", sans-serif;
    font-size: clamp(1.4rem, 3vw, 2rem);
    font-weight: 700;
    letter-spacing: -0.03em;
  }

  .docs-main :global(h3) {
    margin: 2rem 0 0;
    font-size: 1.15rem;
    font-weight: 650;
    letter-spacing: -0.015em;
  }

  .docs-main :global(p) {
    margin: 1rem 0 0;
    color: var(--color-text-muted);
    line-height: 1.75;
  }

  .docs-main :global(p:first-child) {
    margin-top: 0;
  }

  .docs-main :global(a) {
    color: var(--color-accent);
    text-underline-offset: 0.2em;
  }

  .docs-main :global(a:focus-visible) {
    border-radius: 0.2rem;
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  .docs-main :global(ul),
  .docs-main :global(ol) {
    margin: 0.75rem 0 0;
    padding-left: 1.5rem;
    color: var(--color-text-muted);
    line-height: 1.75;
  }

  .docs-main :global(li) {
    overflow-wrap: anywhere;
  }

  .docs-main :global(li + li) {
    margin-top: 0.35rem;
  }

  .docs-main :global(pre) {
    position: relative;
    margin: 1.25rem 0 0;
    overflow-x: auto;
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    background: var(--color-bg-raised);
    padding: 1.25rem 1.5rem;
    font-size: 0.83rem;
    line-height: 1.6;
  }

  /* Copy button injected by the script below. Every docs snippet exists to be
     pasted into a config file, so selecting multi-line JSON by hand — which is
     near-impossible on mobile — should never be the only option. */
  .docs-main :global(.code-copy) {
    position: absolute;
    top: 0.55rem;
    right: 0.55rem;
    z-index: 1;
    border: 1px solid var(--color-border);
    border-radius: 0.4rem;
    background: var(--color-bg);
    color: var(--color-text-muted);
    padding: 0.25rem 0.55rem;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    cursor: pointer;
    opacity: 0;
    transition:
      opacity 0.15s ease,
      color 0.15s ease,
      border-color 0.15s ease;
  }

  .docs-main :global(pre:hover .code-copy),
  .docs-main :global(.code-copy:focus-visible) {
    opacity: 1;
  }

  .docs-main :global(.code-copy:hover) {
    color: var(--color-text);
    border-color: var(--color-accent);
  }

  .docs-main :global(.code-copy[data-copied="true"]) {
    opacity: 1;
    color: var(--color-accent);
    border-color: var(--color-accent);
  }

  /* Touch devices have no hover, so keep the control permanently visible. */
  @media (hover: none) {
    .docs-main :global(.code-copy) {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .docs-main :global(.code-copy) {
      transition: none;
    }
  }

  .docs-main :global(:not(pre) > code) {
    overflow-wrap: anywhere;
  }

  .docs-main :global(code) {
    border-radius: 0.25rem;
    padding: 0.1em 0.3em;
    color: var(--color-accent);
    background: var(--color-bg-raised);
    font-size: 0.875em;
    font-weight: 600;
  }

  .docs-main :global(pre code) {
    padding: 0;
    color: inherit;
    background: transparent;
    font-weight: 400;
  }

  .docs-main :global(.callout) {
    margin-top: 1.25rem;
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    background: var(--color-bg-raised);
    padding: 1rem 1.25rem;
    font-size: 0.9rem;
    line-height: 1.65;
    color: var(--color-text-muted);
  }

  .docs-main :global(.callout strong) {
    color: var(--color-text);
  }

  /* Callout colours live in global.css; these two docs-scoped rules are not a
     copy of them. `.callout strong` above sets the ordinary text colour for
     every callout, which outranks global.css's `.callout--warn strong`, so the
     warn variant has to re-assert the danger colour here. Keep both rules
     token-driven (no literals) so a theme change still flows from one place. */
  .docs-main :global(.callout--warn) {
    border-color: color-mix(in srgb, var(--color-danger) 40%, var(--color-border));
    background: color-mix(in srgb, var(--color-danger) 5%, var(--color-bg-raised));
  }

  .docs-main :global(.callout--warn strong) {
    color: var(--color-danger);
  }

  .docs-main :global(.nav-cards) {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(12rem, 1fr));
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .docs-main :global(.nav-card) {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    background: var(--color-bg-raised);
    padding: 0.85rem 1rem;
    text-decoration: none;
    transition: border-color 0.15s;
  }

  .docs-main :global(.nav-card:hover) {
    border-color: var(--color-accent);
  }

  .docs-main :global(.nav-card__label) {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .docs-main :global(.nav-card__sub) {
    font-size: 0.775rem;
    color: var(--color-text-muted);
    /* Long unbroken tokens (URLs, identifiers) pushed the docs grid past the
       viewport at 768px; wrapping keeps the card inside its column. */
    overflow-wrap: anywhere;
  }

  .docs-main :global(table) {
    /* display:block + overflow-x:auto keeps wide tables in a local scroll
       region instead of expanding the page. */
    display: block;
    width: 100%;
    margin-top: 1.25rem;
    overflow-x: auto;
    border-collapse: collapse;
    font-size: 0.875rem;
  }

  .docs-main :global(th),
  .docs-main :global(td) {
    padding: 0.6rem 0.85rem;
    border: 1px solid var(--color-border);
    text-align: left;
  }

  .docs-main :global(th) {
    background: var(--color-bg-raised);
    font-weight: 650;
    color: var(--color-text);
  }

  .docs-main :global(td) {
    color: var(--color-text-muted);
  }

  @media (max-width: 768px) {
    .docs-shell {
      /* minmax(0, …) — a bare 1fr track floors at max-content, so wide
         code/table content overflows a narrow viewport. */
      grid-template-columns: minmax(0, 1fr);
    }

    .docs-sidebar {
      position: static;
    }

    .docs-sidebar__summary {
      display: flex;
      min-height: 2.75rem;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      padding: 0.55rem 0.85rem;
      border: 1px solid var(--color-border);
      border-radius: 0.55rem;
      color: var(--color-text);
      cursor: pointer;
      font-size: 0.9rem;
      font-weight: 600;
      list-style: none;
    }

    .docs-sidebar__summary::-webkit-details-marker {
      display: none;
    }

    .docs-sidebar__summary::after {
      content: "+";
      color: var(--color-text-muted);
      font-family: "JetBrains Mono Variable", monospace;
      font-size: 1.1rem;
      line-height: 1;
    }

    .docs-sidebar__browse[open] > .docs-sidebar__summary::after {
      content: "−";
    }

    .docs-sidebar__summary:focus-visible {
      outline: 2px solid var(--color-accent);
      outline-offset: 2px;
    }

    .docs-sidebar__browse:not([open]) > nav {
      display: none;
    }

    .docs-sidebar__browse[open] > nav {
      display: block;
      margin-top: 0.85rem;
    }

    .docs-sidebar__list {
      display: flex;
      flex-wrap: wrap;
      gap: 0.25rem 0;
      border-left: none;
      border-top: 1px solid var(--color-border);
      border-bottom: 1px solid var(--color-border);
      padding: 0.5rem 0;
    }

    .docs-sidebar__link {
      border-radius: 0.4rem;
      border: 1px solid var(--color-border);
      /* Touch viewports: 0.8rem text at line-height 1.5 is 19.2px, so 12px of
         block padding puts each row at ~45px — above the 44px target without
         changing the type scale. Desktop keeps the denser 0.35rem rows. */
      padding: 0.75rem 0.75rem;
      font-size: 0.8rem;
      margin: 0.2rem;
    }

    .docs-sidebar__link--active {
      border-color: var(--color-accent);
      border-left: 1px solid var(--color-accent);
      margin-left: 0.2rem;
    }
  }

  .docs-sidebar__search { display: block; margin: 0.5rem 0 0.75rem; }
  .docs-sidebar__search input {
    width: 100%;
    min-height: 2.75rem;
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    background: var(--color-bg-raised);
    padding: 0 0.75rem;
    color: var(--color-text);
    font-size: 0.85rem;
  }
  .docs-sidebar__search input:focus-visible { border-color: var(--color-accent); outline: 2px solid var(--color-accent); outline-offset: 1px; }
  .docs-sidebar__empty { margin: 0.75rem 0.2rem; color: var(--color-text-muted); font-size: 0.8rem; line-height: 1.5; }
</style>
