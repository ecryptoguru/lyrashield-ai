---
import "../styles/global.css"
import SeoHead from "@components/SeoHead.astro"
import JsonLd from "@components/JsonLd.astro"
import Header from "@components/Header.astro"
import Footer from "@components/Footer.astro"
import StickyMobileCta from "@components/StickyMobileCta.astro"
import MyraPanel from "@components/myra/MyraPanel.astro"
import { ogImageFor } from "../lib/og-images"
import bricolageWoff2 from "@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-wght-normal.woff2?url"

interface Props {
  title: string
  description: string
  canonical?: string
  ogImage?: string
  ogImageAlt?: string
  ogImageWidth?: number
  ogImageHeight?: number
  ogType?: "website" | "article"
  noindex?: boolean
  noReferrer?: boolean
  article?: {
    publishedTime?: string
    modifiedTime?: string
    tags?: string[]
  }
  jsonLd?: unknown[]
}

const {
  title,
  description,
  canonical,
  ogImage,
  ogImageAlt,
  ogImageWidth,
  ogImageHeight,
  ogType,
  noindex,
  noReferrer,
  article,
  jsonLd,
} = Astro.props

const siteUrl = Astro.site?.toString() || "http://localhost:4321"
const siteOrigin = Astro.site?.origin || "http://localhost:4321"
const xUrl = __MARKETING_X_URL__
// Section card unless the page names its own (blog posts pass their per-post
// image through this prop).
const resolvedOgImage = ogImage ?? ogImageFor(Astro.url.pathname)
// Default-off flag: the support panel only mounts when explicitly enabled.
const myraEnabled = __MARKETING_MYRA_ENABLED__
const siteDescription =
  "LyraShield AI records what was tested, separates detected risks from retest-confirmed fixes and creates an assurance report for AI-built apps."

// Google's logo guidance requires a raster image, and the SVG that renders in
// the UI is not one. /logo.png is 1024x1024 and already served; declare the
// dimensions so the consumer does not have to fetch it to find out.
const organizationLogo = {
  "@type": "ImageObject",
  url: new URL("/logo.png", siteOrigin).toString(),
  width: 1024,
  height: 1024,
}

// Both mailboxes are already published on /support, /privacy and
// /security-reporting; the structured data states the same destinations
// rather than inventing a new channel. Read through the same env overrides
// those pages honour, or the JSON-LD would advertise a stale address.
const supportEmail =
  (import.meta.env.PUBLIC_SUPPORT_EMAIL as string | undefined) || "support@lyrashieldai.com"
const securityEmail =
  (import.meta.env.PUBLIC_SECURITY_EMAIL as string | undefined) || "security@lyrashieldai.com"

const siteGraph: unknown[] = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "@id": `${siteOrigin}/#organization`,
    name: "LyraShield AI",
    url: siteUrl,
    logo: organizationLogo,
    description: siteDescription,
    knowsAbout: [
      "AI application security",
      "launch gate",
      "security evidence",
      "retest-confirmed findings",
      "security retesting",
    ],
    // Both mailboxes are already published on /support, /privacy and
    // /security-reporting; the structured data states the same destinations
    // rather than inventing a new channel.
    contactPoint: [
      {
        "@type": "ContactPoint",
        contactType: "customer support",
        email: supportEmail,
        url: new URL("/support", siteOrigin).toString(),
        availableLanguage: ["en"],
      },
      {
        "@type": "ContactPoint",
        contactType: "security",
        email: securityEmail,
        url: new URL("/security-reporting", siteOrigin).toString(),
        availableLanguage: ["en"],
      },
    ],
    // Only profiles that genuinely exist belong here. PUBLIC_X_URL is the one
    // configured product handle; add GitHub/LinkedIn only once a real
    // organization profile exists (see the megaplan's founder decisions).
    ...(xUrl ? { sameAs: [xUrl] } : {}),
    founder: {
      "@type": "Person",
      name: "Ankit Das",
      jobTitle: "Founder & CEO",
      sameAs: [
        "https://www.linkedin.com/in/defiankit/",
        "https://github.com/ecryptoguru",
        "https://x.com/defiankit",
      ],
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": `${siteOrigin}/#website`,
    name: "LyraShield AI",
    url: siteUrl,
    inLanguage: "en-US",
    publisher: { "@id": `${siteOrigin}/#organization` },
  },
]

const allJsonLd = [...siteGraph, ...(jsonLd ?? [])]
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <SeoHead
      title={title}
      description={description}
      canonical={canonical}
      ogImage={resolvedOgImage}
      ogImageAlt={ogImageAlt}
      ogImageWidth={ogImageWidth}
      ogImageHeight={ogImageHeight}
      ogType={ogType}
      noindex={noindex}
      article={article}
    />
    {allJsonLd.length > 0 && <JsonLd data={allJsonLd} />}
    <meta name="theme-color" content="#f5f9fc" data-theme-color />
    {noReferrer && <meta name="referrer" content="no-referrer" />}
    <link rel="preload" as="font" type="font/woff2" href={bricolageWoff2} crossorigin="anonymous" />
    <script src="/scripts/head-bootstrap.js" is:inline></script>
  </head>
  <body class="bg-bg text-text font-ui antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-bg-raised focus:px-4 focus:py-2 focus:text-text focus:outline-none focus:ring-2 focus:ring-accent"
    >
      Skip to content
    </a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <StickyMobileCta />
    {myraEnabled && <MyraPanel />}
    <script>
      import { initMotion } from "../lib/reveal"

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initMotion, { once: true })
      } else {
        initMotion()
      }
    </script>
    <script>
      import {
        marketingAnalyticsAllowed,
        marketingAnalyticsCookie,
        marketingAnalyticsPreference,
        MARKETING_EVENT_ALLOWLIST,
        optionalTrackingCookieExpirations,
        privacyBoundedMarketingEvent,
        sanitizeMarketingProperties,
        isMarketingEventName,
      } from "../lib/posthog-privacy"

      const posthogKey = import.meta.env.PUBLIC_POSTHOG_KEY
      const posthogHost = import.meta.env.PUBLIC_POSTHOG_HOST || "https://us.i.posthog.com"
      const posthogUiHost = "https://us.posthog.com"
      const appOrigin = import.meta.env.PUBLIC_APP_URL || "https://app.lyrashieldai.com"
      let accountAnalyticsEnabled: boolean | null = null
      let loadingAccountPreference: Promise<boolean | null> | null = null
      let initializingPosthog = false
      let pageviewCaptured = false
      let eventHandlersAttached = false

      function privacySignalsEnabled(): boolean {
        const dnt = navigator.doNotTrack
        const gpc = (navigator as Navigator & { globalPrivacyControl?: boolean }).globalPrivacyControl
        return gpc === true || ["1", "yes"].includes(dnt?.toLowerCase() ?? "")
      }

      function trackingAllowed(): boolean {
        return marketingAnalyticsAllowed({
          cookie: document.cookie,
          accountEnabled: accountAnalyticsEnabled,
          doNotTrack: navigator.doNotTrack,
          globalPrivacyControl: (navigator as Navigator & { globalPrivacyControl?: boolean })
            .globalPrivacyControl,
        })
      }

      function updatePrivacyControls(message?: string) {
        const cookiePreference = marketingAnalyticsPreference(document.cookie)
        const signalOff = privacySignalsEnabled()
        for (const button of document.querySelectorAll<HTMLButtonElement>("[data-analytics-toggle]")) {
          const enabling = cookiePreference === "off"
          button.disabled = signalOff || (enabling && accountAnalyticsEnabled === false)
          button.textContent = enabling ? "Enable optional analytics" : "Turn analytics off"
        }
        for (const status of document.querySelectorAll<HTMLElement>("[data-analytics-status]")) {
          status.textContent = message ||
            (signalOff
              ? "Your browser’s Do Not Track or Global Privacy Control signal keeps optional analytics off."
              : accountAnalyticsEnabled === null
                ? "Analytics remain off until the signed-in account preference can be checked."
                : accountAnalyticsEnabled === false
                  ? "Analytics are disabled for your account. Change this in dashboard settings."
                  : cookiePreference === "off"
                    ? "Optional analytics are disabled in this browser."
                    : "Optional analytics are enabled by default; you can turn them off for this browser.")
        }
      }

      async function resolveAccountPreference(): Promise<boolean | null> {
        if (loadingAccountPreference) return loadingAccountPreference
        loadingAccountPreference = fetch(new URL("/api/account/preferences", appOrigin), {
          cache: "no-store",
          credentials: "include",
        })
          .then(async (response) => {
            if (response.status === 401) return true // anonymous browser: default enabled
            if (!response.ok) return null
            const body: unknown = await response.json()
            if (!body || typeof body !== "object" || !("success" in body) || body.success !== true) {
              return null
            }
            const data = "data" in body ? body.data : null
            if (!data || typeof data !== "object" || !("analyticsEnabled" in data)) return null
            return typeof data.analyticsEnabled === "boolean" ? data.analyticsEnabled : null
          })
          .catch(() => null)
          .then((enabled) => {
            accountAnalyticsEnabled = enabled
            return enabled
          })
          .finally(() => {
            loadingAccountPreference = null
          })
        return loadingAccountPreference
      }

      function attachEventHandlers(posthog: typeof window.posthog) {
        if (eventHandlersAttached) return
        eventHandlersAttached = true
        document.querySelectorAll("[data-cta-id]").forEach((element) => {
          element.addEventListener("click", () => {
            const ctaId = element.getAttribute("data-cta-id")
            if (ctaId)
              posthog?.capture(
                "cta_click",
                sanitizeMarketingProperties("cta_click", { cta_id: ctaId }) ?? {},
                { send_instantly: true, transport: "sendBeacon" }
              )
          })
        })
        // Spec section 10 events ride a declarative hook so a page can emit one
        // without adding script. Only allowlisted properties survive, so a
        // typed value can never reach analytics even if it were attached.
        document.querySelectorAll<HTMLElement>("[data-analytics-event]").forEach((element) => {
          const eventName = element.getAttribute("data-analytics-event")
          if (!eventName || !isMarketingEventName(eventName)) return
          const trigger = element.getAttribute("data-analytics-trigger") ?? "click"
          const send = () => {
            const props: Record<string, unknown> = {}
            for (const [key, value] of Object.entries(element.dataset)) {
              if (!key.startsWith("analyticsProp")) continue
              const propName = key.slice("analyticsProp".length)
              if (!propName) continue
              props[propName.charAt(0).toLowerCase() + propName.slice(1)] = value
            }
            const sanitized = sanitizeMarketingProperties(eventName, props)
            if (sanitized) posthog?.capture(eventName, sanitized, { send_instantly: true })
          }
          if (trigger === "view") {
            if (typeof IntersectionObserver === "undefined") return
            const observer = new IntersectionObserver((entries) => {
              for (const entry of entries) {
                if (!entry.isIntersecting) continue
                send()
                observer.disconnect()
              }
            })
            observer.observe(element)
            return
          }
          element.addEventListener(trigger, send)
        })
        document.querySelectorAll("details[data-question-id]").forEach((element) => {
          element.addEventListener("toggle", () => {
            const questionId = element.getAttribute("data-question-id")
            if (questionId && (element as HTMLDetailsElement).open) {
              posthog?.capture(
                "faq_open",
                sanitizeMarketingProperties("faq_open", { question_id: questionId }) ?? {}
              )
            }
          })
        })
      }

      async function initializeAnalytics() {
        if (!posthogKey || !trackingAllowed() || initializingPosthog) return
        if (window.posthog?.__loaded) {
          window.posthog.opt_in_capturing()
          return
        }
        initializingPosthog = true
        try {
          const { default: posthog } = await import("posthog-js")
          if (!trackingAllowed()) return
          if (!posthog.__loaded) {
            posthog.init(posthogKey, {
              api_host: posthogHost,
              ui_host: posthogUiHost,
              autocapture: false,
              capture_pageview: false,
              capture_pageleave: true,
              disable_scroll_properties: false,
              disable_session_recording: true,
              persistence: "localStorage",
              respect_dnt: true,
              before_send: (event) =>
                event && trackingAllowed() ? privacyBoundedMarketingEvent(event) : null,
              loaded: (ph) => {
                if (!trackingAllowed()) ph.opt_out_capturing()
                else ph.opt_in_capturing()
              },
            })
          } else {
            posthog.opt_in_capturing()
          }
          window.posthog = posthog
          attachEventHandlers(posthog)
          if (!pageviewCaptured && trackingAllowed()) {
            pageviewCaptured = true
            const pageUrl = new URL(location.href)
            const privacyBoundedPageUrl = `${pageUrl.origin}${pageUrl.pathname}`
            posthog.capture(
              "$pageview",
              sanitizeMarketingProperties("$pageview", {
                $current_url: privacyBoundedPageUrl,
              }) ?? {}
            )
            if (location.pathname === "/") {
              const props = {
                utm_source: pageUrl.searchParams.get("utm_source") || undefined,
                utm_medium: pageUrl.searchParams.get("utm_medium") || undefined,
                utm_campaign: pageUrl.searchParams.get("utm_campaign") || undefined,
                referrer: document.referrer || undefined,
              }
              posthog.capture(
                "landing_view",
                sanitizeMarketingProperties("landing_view", props) ?? {}
              )
            }
          }
        } catch {
          // Silently skip analytics if posthog-js fails to load.
        } finally {
          initializingPosthog = false
        }
      }

      document.querySelectorAll<HTMLButtonElement>("[data-analytics-toggle]").forEach((button) => {
        button.addEventListener("click", async () => {
          if (privacySignalsEnabled()) {
            updatePrivacyControls()
            return
          }
          const enabling = marketingAnalyticsPreference(document.cookie) === "off"
          if (!enabling) {
            document.cookie = marketingAnalyticsCookie(false, location.hostname, location.protocol === "https:")
            for (const cookie of optionalTrackingCookieExpirations(location.hostname, location.protocol === "https:")) {
              document.cookie = cookie
            }
            window.posthog?.opt_out_capturing()
            const cleared = await fetch(new URL("/api/privacy/analytics-opt-out", appOrigin), {
              method: "POST",
              mode: "cors",
              credentials: "include",
              cache: "no-store",
            }).then((response) => response.ok).catch(() => false)
            updatePrivacyControls(
              cleared
                ? "Optional analytics are now disabled in this browser."
                : "Optional analytics are off. Some server-held tracking cookies could not be cleared; try again."
            )
            return
          }
          document.cookie = marketingAnalyticsCookie(true, location.hostname, location.protocol === "https:")
          const accountPreference = await resolveAccountPreference()
          if (accountPreference !== true) {
            updatePrivacyControls()
            return
          }
          updatePrivacyControls("Optional analytics are now enabled for this browser.")
          if (window.posthog?.__loaded) window.posthog.opt_in_capturing()
          void initializeAnalytics()
        })
      })
      const appSettings = new URL("/dashboard/settings", appOrigin).toString()
      document.querySelectorAll<HTMLAnchorElement>("[data-analytics-settings]").forEach((link) => {
        link.href = appSettings
      })

      updatePrivacyControls()
      void resolveAccountPreference().then(() => {
        updatePrivacyControls()
        void initializeAnalytics()
      })

      window.addEventListener("lyrashield:analytics-preference", () => {
        updatePrivacyControls()
        if (!trackingAllowed()) window.posthog?.opt_out_capturing()
        else void initializeAnalytics()
      })
    </script>
    <script src="/scripts/signup-attribution.js" is:inline></script>
  </body>
</html>
