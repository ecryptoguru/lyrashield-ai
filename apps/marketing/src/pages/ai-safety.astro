---
import Base from "@layouts/Base.astro"

const origin = Astro.site?.origin || "http://localhost:4321"
const canonical = new URL("/ai-safety", origin).toString()
const title = "MCP guard evaluation | LyraShield AI"
const description =
  "How LyraShield AI evaluates the deterministic guard that filters MCP tool-call inputs before they reach the scan engine, and the limits of that check."
const reviewed = "2026-10-04"

// Answers restate the prose below. They are not new claims.
const faq = [
  {
    q: "Is LyraShield's MCP guard certified by OWASP or another standards body?",
    a: "No. The guard's pattern categories are drawn from published prompt-injection guidance including the OWASP Gen AI Red Teaming Guide, but no standards body has certified the guard or this page.",
  },
  {
    q: "Does the guard block every prompt injection attempt?",
    a: "No. No finite rule set can prove that, so LyraShield does not claim it. The guard names the patterns it matches and the patterns it does not.",
  },
  {
    q: "Does the guard also filter harmful content?",
    a: "No. It blocks attempts to override, hijack or extract instructions from the agent. Filtering harmful but non-injection content is the responsibility of the underlying model's own safety training, not this guard.",
  },
  {
    q: "Can this replace human security review or model-level safety training?",
    a: "No. It is a bounded, scoped filter. It is not a substitute for model-level safety training, output filtering or human review.",
  },
]

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: "MCP guard evaluation",
    description,
    url: canonical,
    dateModified: reviewed,
    isPartOf: { "@id": `${origin}/#website` },
    publisher: { "@id": `${origin}/#organization` },
    about: ["MCP security", "prompt injection", "tool-call filtering", "OWASP Gen AI"],
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${origin}/` },
      { "@type": "ListItem", position: 2, name: "MCP guard evaluation", item: canonical },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faq.map((item) => ({
      "@type": "Question",
      name: item.q,
      acceptedAnswer: { "@type": "Answer", text: item.a },
    })),
  },
]
---

<Base title={title} description={description} canonical={canonical} jsonLd={jsonLd}>
  <section class="relative mx-auto max-w-5xl px-4 pb-12 pt-14 sm:px-6 sm:pt-20 lg:pt-24">
    <header class="max-w-3xl" data-reveal-group>
      <p class="font-mono text-xs font-semibold tracking-wider text-accent uppercase" data-reveal="fade">
        MCP guard evaluation
      </p>
      <h1 class="mt-3 text-4xl font-bold tracking-tight text-text sm:text-5xl" data-reveal="fade">
        MCP guard evaluation
      </h1>
      <p class="mt-5 text-lg leading-8 text-text-muted" data-reveal="fade">
        LyraShield AI includes a deterministic guard that filters MCP tool-call inputs before they
        reach the scan engine. This page documents what the guard matches, how it normalizes input
        and where it stops. It states no results and no figures, because the evaluation harness that
        produced earlier numbers is not part of this repository.
      </p>
      <p class="mt-4 text-sm text-text-muted" data-reveal="fade">
        Last reviewed: <time datetime={reviewed}>4 Oct 2026</time>
      </p>
    </header>
  </section>

  <!-- What the guard does -->
  <section class="mx-auto max-w-5xl px-4 py-12 sm:px-6" data-reveal-group>
    <h2 class="text-2xl font-semibold text-text" data-reveal>What the guard does</h2>
    <p class="mt-4 max-w-3xl leading-7 text-text-muted" data-reveal>
      The guard is a deterministic filter that runs on MCP tool-call arguments. Each call is
      classified as blocked, sanitized or allowed. A blocked call never reaches the model. An
      allowed call passes through, and the underlying model's own safety training becomes the last
      line of defense.
    </p>
    <p class="mt-4 max-w-3xl leading-7 text-text-muted" data-reveal>
      <strong>This is not a model safety test.</strong> The guard is a rule-based filter, not a
      classifier. It tests whether a tool-call argument carries injection language, and it makes no
      claim about what the model would do with that argument if it arrived.
    </p>
  </section>

  <!-- Pattern categories -->
  <section class="mx-auto max-w-5xl px-4 py-12 sm:px-6" data-reveal-group>
    <h2 class="text-2xl font-semibold text-text" data-reveal>Pattern categories</h2>
    <p class="mt-4 max-w-3xl leading-7 text-text-muted" data-reveal>
      The guard matches a fixed set of prompt-injection categories, drawn from published guidance
      including the{" "}
      <a href="https://genai.owasp.org/initiatives/ai-red-teaming-initiative/" rel="noreferrer" class="text-accent underline decoration-accent/40 underline-offset-4 hover:decoration-accent">OWASP Gen AI Red Teaming Initiative</a>. Each category maps to a named rule so a block can be explained.
    </p>
    <div class="mt-6 overflow-x-auto" data-reveal>
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-border text-left text-text-muted">
            <th class="py-2 pr-4 font-medium">Category</th>
            <th class="py-2 font-medium">What it catches</th>
          </tr>
        </thead>
        <tbody>
          <tr class="border-b border-border/50">
            <td class="py-2 pr-4 text-text">Instruction override</td>
            <td class="py-2 text-text-muted">Attempts to replace or ignore the agent's instructions.</td>
          </tr>
          <tr class="border-b border-border/50">
            <td class="py-2 pr-4 text-text">Role hijack</td>
            <td class="py-2 text-text-muted">Attempts to reassign the agent's role or persona.</td>
          </tr>
          <tr class="border-b border-border/50">
            <td class="py-2 pr-4 text-text">Memory wipe</td>
            <td class="py-2 text-text-muted">Attempts to clear or discard prior context.</td>
          </tr>
          <tr class="border-b border-border/50">
            <td class="py-2 pr-4 text-text">Prompt extraction</td>
            <td class="py-2 text-text-muted">Attempts to reveal system instructions.</td>
          </tr>
          <tr class="border-b border-border/50">
            <td class="py-2 pr-4 text-text">Secret extraction</td>
            <td class="py-2 text-text-muted">Attempts to read environment variables or credentials.</td>
          </tr>
          <tr class="border-b border-border/50">
            <td class="py-2 pr-4 text-text">Code execution</td>
            <td class="py-2 text-text-muted">Attempts to run shell commands or eval-shaped payloads.</td>
          </tr>
          <tr class="border-b border-border/50">
            <td class="py-2 pr-4 text-text">File access</td>
            <td class="py-2 text-text-muted">Attempts to read or write paths outside the tool's scope.</td>
          </tr>
          <tr class="border-b border-border/50">
            <td class="py-2 pr-4 text-text">Destructive commands</td>
            <td class="py-2 text-text-muted">Attempts to delete or overwrite data.</td>
          </tr>
          <tr class="border-b border-border/50">
            <td class="py-2 pr-4 text-text">SQL injection</td>
            <td class="py-2 text-text-muted">SQL-shaped payloads inside a tool argument.</td>
          </tr>
          <tr class="border-b border-border/50">
            <td class="py-2 pr-4 text-text">Encoding and obfuscation</td>
            <td class="py-2 text-text-muted">Base64, leetspeak, homoglyph, zero-width and percent-encoded attempts to evade matching.</td>
          </tr>
          <tr class="border-b border-border/50">
            <td class="py-2 pr-4 text-text">Framework tags</td>
            <td class="py-2 text-text-muted">System and ChatML tag injection.</td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <!-- How it handles input -->
  <section class="mx-auto max-w-5xl px-4 py-12 sm:px-6" data-reveal-group>
    <h2 class="text-2xl font-semibold text-text" data-reveal>How it handles input</h2>
    <p class="mt-4 max-w-3xl leading-7 text-text-muted" data-reveal>
      Trivial obfuscation is normalized before matching so a payload cannot slip past on spelling
      alone. The guard maps cross-script Unicode homoglyphs to their Latin equivalents, applies NFKC
      normalization, replaces zero-width and invisible control characters with spaces, decodes
      percent-encoded input and maps leetspeak digits to letters. Standalone base64-shaped tokens are
      decoded and appended for matching.
    </p>
    <p class="mt-4 max-w-3xl leading-7 text-text-muted" data-reveal>
      The guard runs with a bounded input length, a strict mode and a match timeout. An input that
      exceeds the length bound or the timeout is not silently allowed through.
    </p>
  </section>

  <!-- Known limitations -->
  <section class="mx-auto max-w-5xl px-4 py-12 sm:px-6" data-reveal-group>
    <h2 class="text-2xl font-semibold text-text" data-reveal>Known limitations</h2>
    <ul class="mt-4 max-w-3xl space-y-3 text-text-muted" data-reveal>
      <li class="flex gap-3">
        <span class="mt-1 text-accent">→</span>
        <span><strong>Dot-separated tokens.</strong> "ig.nore" does not match "ignore". Stripping intra-word dots would break legitimate paths such as "config.js", so the guard leaves them alone.</span>
      </li>
      <li class="flex gap-3">
        <span class="mt-1 text-accent">→</span>
        <span><strong>Non-English instructions.</strong> The pattern set is English-only. An instruction written in another language is not matched.</span>
      </li>
      <li class="flex gap-3">
        <span class="mt-1 text-accent">→</span>
        <span><strong>No completeness proof.</strong> A finite rule set cannot show that every injection attempt is caught. A clean result means no known pattern matched.</span>
      </li>
    </ul>
  </section>

  <!-- What this is not -->
  <section class="mx-auto max-w-5xl px-4 py-12 sm:px-6" data-reveal-group>
    <div class="rounded-xl border border-border bg-bg-raised p-6" data-reveal>
      <h2 class="text-xl font-semibold text-text">What this is not</h2>
      <ul class="mt-3 space-y-2 text-sm text-text-muted">
        <li>• Not "AI safety tested" in the sense of a formal evaluation by NIST, MLCommons or a third-party lab.</li>
        <li>• Not "adversarial robustness proven" — no finite rule set proves universal robustness.</li>
        <li>• Not certified by OWASP or any standards body.</li>
        <li>• Not a guarantee that the guard blocks every prompt injection attempt.</li>
        <li>• Not a substitute for model-level safety training, output filtering or human review.</li>
      </ul>
      <p class="mt-4 text-sm text-text-muted">
        See <a href="/methodology" class="text-accent underline decoration-accent/40 underline-offset-4 hover:decoration-accent">methodology</a>
        {" "}for the full scan and evidence methodology.
      </p>
    </div>
  </section>

  <!-- FAQ -->
  <section aria-labelledby="mcp-guard-faq-heading" class="mx-auto max-w-5xl px-4 py-12 sm:px-6">
    <h2 id="mcp-guard-faq-heading" class="text-2xl font-semibold text-text" data-reveal>MCP guard questions</h2>
    <div class="mt-6 divide-y divide-border rounded-xl border border-border bg-bg-raised" data-reveal="scale">
      {faq.map((item, i) => (
        <details class="faq-item p-4" data-question-id={`mcp-guard-faq-${i + 1}`}>
          <summary class="cursor-pointer font-medium text-text">{item.q}</summary>
          <p class="mt-3 text-sm leading-6 text-text-muted">{item.a}</p>
        </details>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section class="mx-auto max-w-5xl px-4 py-12 sm:px-6" data-reveal-group>
    <div class="flex flex-col gap-5 border-t border-border pt-10 sm:flex-row sm:items-center sm:justify-between" data-reveal>
      <div>
        <h2 class="text-2xl font-semibold text-text">Start with a check you can inspect.</h2>
        <p class="mt-2 text-text-muted">The free tools run locally in your browser and state their limits.</p>
      </div>
      <a href="/tools" class="lift inline-flex min-h-12 items-center justify-center rounded-lg bg-accent px-5 text-sm font-semibold text-bg hover:opacity-90 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent">
        View free tools
      </a>
    </div>
  </section>
</Base>
