---
import { getCollection, render } from "astro:content"

import ComparisonPricingLadder from "@components/ComparisonPricingLadder.astro"
import Base from "@layouts/Base.astro"

export async function getStaticPaths() {
  const comparisons = await getCollection("compare", ({ data }) => data.draft === false)
  return comparisons.map((entry) => ({ params: { slug: entry.id }, props: { entry } }))
}

const { entry } = Astro.props
const { title, description, competitor, heading, disclaimer, updatedDate, faq, pricingLadder } = entry.data
const { Content } = await render(entry)

const origin = Astro.site?.origin || "http://localhost:4321"
const canonical = new URL(`/compare/${entry.id}`, origin).toString()
const reviewed = updatedDate.toISOString().slice(0, 10)

const jsonLd: unknown[] = [
  {
    "@context": "https://schema.org",
    "@type": "TechArticle",
    headline: title,
    description,
    url: canonical,
    dateModified: reviewed,
    author: { "@id": `${origin}/#organization` },
    publisher: { "@id": `${origin}/#organization` },
    inLanguage: "en-US",
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${origin}/` },
      { "@type": "ListItem", position: 2, name: "Compare", item: `${origin}/compare` },
      { "@type": "ListItem", position: 3, name: `vs ${competitor}`, item: canonical },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faq.map((item) => ({
      "@type": "Question",
      name: item.q,
      acceptedAnswer: { "@type": "Answer", text: item.a },
    })),
  },
]
---

<Base title={title} description={description} canonical={canonical} jsonLd={jsonLd}>
  <section class="mx-auto max-w-4xl px-4 py-14 sm:px-6 lg:py-24">
    <header data-reveal-group>
      <p class="font-mono text-xs font-semibold tracking-wider text-accent uppercase" data-reveal="fade">Comparison</p>
      <h1 class="mt-4 text-4xl font-semibold tracking-tight text-text sm:text-5xl" data-reveal>{heading}</h1>
      <p class="mt-6 text-lg leading-8 text-text-muted" data-reveal>{description}</p>
      <p class="mt-4 text-sm text-text-muted" data-reveal>
        Last reviewed: <time datetime={reviewed}>{reviewed}</time>
      </p>
    </header>

    <div class="callout mt-10" data-reveal set:html={disclaimer} />

    {/* Shared structure (Spec item 6.6): every comparison opens with the same
        three differences, then the page body, then the same next step. The
        competitor-specific body below is authored per page. */}
    <section aria-labelledby="differ-heading" class="mt-12 rounded-2xl border border-border bg-bg-raised p-6 sm:p-8" data-reveal>
      <h2 id="differ-heading" class="text-2xl font-semibold text-text">Where we differ</h2>
      <ul class="mt-5 space-y-3 leading-7 text-text-muted">
        <li class="flex gap-3"><span class="text-accent" aria-hidden="true">—</span><span>A launch verdict in three states: ready, not ready or insufficient evidence.</span></li>
        <li class="flex gap-3"><span class="text-accent" aria-hidden="true">—</span><span>Every finding keeps its evidence state, and a fresh retest confirms a fix.</span></li>
        <li class="flex gap-3"><span class="text-accent" aria-hidden="true">—</span><span>Fix proposals wait for a human approval before any pull request opens.</span></li>
      </ul>
    </section>

    <div class="compare-body mt-16 border-t border-border pt-12" data-reveal-group>
      <Content />
    </div>

    {pricingLadder && <ComparisonPricingLadder />}

    <section aria-labelledby="faq-heading" class="mt-16 border-t border-border pt-12" data-reveal-group>
      <h2 id="faq-heading" class="text-2xl font-semibold text-text" data-reveal>Frequently asked questions</h2>
      <dl class="mt-8 space-y-8">
        {faq.map((item) => (
          <div data-reveal>
            <dt class="font-semibold text-text">{item.q}</dt>
            <dd class="mt-2 leading-7 text-text-muted">{item.a}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section aria-labelledby="next-heading" class="mt-16 flex flex-col gap-5 border-t border-border pt-12 sm:flex-row sm:items-center sm:justify-between" data-reveal>
      <div>
        <h2 id="next-heading" class="text-2xl font-semibold text-text">What happens next</h2>
        <p class="mt-2 leading-7 text-text-muted">Run the free Lite Check on your own app, then start a trial to review the repository behind it.</p>
      </div>
      <div class="flex flex-wrap gap-3">
        <a href="/scan" data-cta-id="compare-lite-check" class="inline-flex min-h-12 items-center justify-center rounded-lg bg-accent px-5 text-sm font-semibold text-bg hover:opacity-90 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent">Run the free Lite Check</a>
        <a href="/compare" class="inline-flex min-h-12 items-center justify-center rounded-lg border border-border px-5 text-sm font-semibold text-text hover:border-accent focus:outline-none focus-visible:ring-2 focus-visible:ring-accent">All comparisons</a>
      </div>
    </section>
  </section>
</Base>
