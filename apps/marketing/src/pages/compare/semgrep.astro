---
import Base from "@layouts/Base.astro"

const origin = Astro.site?.origin || "http://localhost:4321"
const canonical = new URL("/compare/semgrep", origin).toString()
const title = "LyraShield AI vs Semgrep — Release Assurance vs Pattern-Based Scanning"
const description =
  "How LyraShield AI compares to Semgrep for AI-built application security. Evidence states, coverage framework, MCP integration, and custom rules differences."
const updatedDate = "2026-08-07"

const jsonLd: unknown[] = [
  {
    "@context": "https://schema.org",
    "@type": "TechArticle",
    headline: title,
    description,
    url: canonical,
    dateModified: updatedDate,
    author: { "@id": `${origin}/#organization` },
    publisher: { "@id": `${origin}/#organization` },
    inLanguage: "en-US",
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${origin}/` },
      { "@type": "ListItem", position: 2, name: "Compare", item: `${origin}/compare` },
      { "@type": "ListItem", position: 3, name: "vs Semgrep", item: canonical },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: [
      {
        "@type": "Question",
        name: "Does LyraShield AI replace Semgrep?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "No. Semgrep provides fast, pattern-based static analysis with custom rules. LyraShield AI provides evidence-backed release assurance with coverage receipts and evidence states. They address different parts of the security workflow.",
        },
      },
      {
        "@type": "Question",
        name: "Is Semgrep's Community Edition free?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Yes. Semgrep Community Edition is free and open-source (LGPL-2.1) with the CLI. AI-powered features like Multimodal detection, autofix, and triage require the Semgrep AppSec Platform (paid tiers).",
        },
      },
    ],
  },
]
---

<Base title={title} description={description} canonical={canonical} jsonLd={jsonLd}>
  <section class="mx-auto max-w-4xl px-4 py-14 sm:px-6 lg:py-24">
    <header data-reveal-group>
      <p class="font-mono text-xs font-semibold tracking-wider text-accent uppercase" data-reveal="fade">Comparison</p>
      <h1 class="mt-4 text-4xl font-semibold tracking-tight text-text sm:text-5xl" data-reveal>
        LyraShield AI vs Semgrep
      </h1>
      <p class="mt-6 text-lg leading-8 text-text-muted" data-reveal>
        Evidence-backed release assurance vs fast, pattern-based static analysis with custom rules.
        They address different parts of the security workflow and can complement each other.
      </p>
    </header>

    <div class="callout mt-10" data-reveal>
      <strong>Factual comparison.</strong> Semgrep by Semgrep Inc. provides pattern-based static
      analysis with custom rules, SCA, and secrets detection. LyraShield AI is a pre-launch
      evidence-backed release assurance layer. Neither replaces the other.
    </div>

    <section aria-labelledby="approach-heading" class="mt-16 border-t border-border pt-12" data-reveal-group>
      <h2 id="approach-heading" class="text-2xl font-semibold text-text" data-reveal>Core approach</h2>
      <table class="mt-8 w-full border-collapse text-sm">
        <thead>
          <tr class="border-b border-border text-left">
            <th class="py-3 pr-4 font-semibold text-text">Aspect</th>
            <th class="py-3 pr-4 font-semibold text-text">LyraShield AI</th>
            <th class="py-3 font-semibold text-text">Semgrep</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-border">
          <tr>
            <td class="py-3 pr-4 text-text-muted">Primary focus</td>
            <td class="py-3 pr-4 text-text">Evidence-backed release assurance for AI-built apps</td>
            <td class="py-3 text-text-muted">Pattern-based static analysis, SCA, secrets, custom rules</td>
          </tr>
          <tr>
            <td class="py-3 pr-4 text-text-muted">Scanning approach</td>
            <td class="py-3 pr-4 text-text">Agentic engine with GPT-5.6, coverage framework, evidence states</td>
            <td class="py-3 text-text-muted">Semantic pattern matching with data-flow and taint analysis</td>
          </tr>
          <tr>
            <td class="py-3 pr-4 text-text-muted">Finding lifecycle</td>
            <td class="py-3 pr-4 text-text">Detected → independently verified → retest-confirmed or inconclusive</td>
            <td class="py-3 text-text-muted">Open → reviewing → fixed or ignored; AI auto-triage for false positives</td>
          </tr>
          <tr>
            <td class="py-3 pr-4 text-text-muted">Control framework</td>
            <td class="py-3 pr-4 text-text">Vibe Security 50 (43 machine-testable + 7 evidence-required)</td>
            <td class="py-3 text-text-muted">No published control framework; rule-based detection</td>
          </tr>
          <tr>
            <td class="py-3 pr-4 text-text-muted">Custom rules</td>
            <td class="py-3 pr-4 text-text-muted">Not a primary feature</td>
            <td class="py-3 text-text-muted">Yes — write custom rules in Semgrep syntax (key differentiator)</td>
          </tr>
          <tr>
            <td class="py-3 pr-4 text-text-muted">AI-generated code focus</td>
            <td class="py-3 pr-4 text-text">Built for AI-built apps; scans agent rules, MCP configs, AI patterns</td>
            <td class="py-3 text-text-muted">Semgrep Multimodal (AI detection for business logic flaws); AI triage and autofix</td>
          </tr>
        </tbody>
      </table>
    </section>

    <section aria-labelledby="capabilities-heading" class="mt-16 border-t border-border pt-12" data-reveal-group>
      <h2 id="capabilities-heading" class="text-2xl font-semibold text-text" data-reveal>Capability comparison</h2>
      <table class="mt-8 w-full border-collapse text-sm">
        <thead>
          <tr class="border-b border-border text-left">
            <th class="py-3 pr-4 font-semibold text-text">Capability</th>
            <th class="py-3 pr-4 font-semibold text-text text-center">LyraShield AI</th>
            <th class="py-3 font-semibold text-text text-center">Semgrep</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-border">
          <tr>
            <td class="py-3 pr-4 text-text-muted">Static analysis (SAST)</td>
            <td class="py-3 pr-4 text-center text-text">Agentic</td>
            <td class="py-3 text-center text-text-muted">Pattern-based</td>
          </tr>
          <tr>
            <td class="py-3 pr-4 text-text-muted">Custom rules</td>
            <td class="py-3 pr-4 text-center text-text-muted">No</td>
            <td class="py-3 text-center text-text-muted">Yes (key feature)</td>
          </tr>
          <tr>
            <td class="py-3 pr-4 text-text-muted">SCA (dependency scanning)</td>
            <td class="py-3 pr-4 text-center text-text">Via engine</td>
            <td class="py-3 text-center text-text-muted">Yes (with reachability)</td>
          </tr>
          <tr>
            <td class="py-3 pr-4 text-text-muted">Secret scanning</td>
            <td class="py-3 pr-4 text-center text-text">Yes (engine + GitHub Action)</td>
            <td class="py-3 text-center text-text-muted">Yes (630+ credential types)</td>
          </tr>
          <tr>
            <td class="py-3 pr-4 text-text-muted">Evidence states</td>
            <td class="py-3 pr-4 text-center text-text">Yes (4 states)</td>
            <td class="py-3 text-center text-text-muted">No</td>
          </tr>
          <tr>
            <td class="py-3 pr-4 text-text-muted">Deterministic retest</td>
            <td class="py-3 pr-4 text-center text-text">Yes</td>
            <td class="py-3 text-center text-text-muted">Auto-mark fixed when no longer detected</td>
          </tr>
          <tr>
            <td class="py-3 pr-4 text-text-muted">Coverage receipts</td>
            <td class="py-3 pr-4 text-center text-text">Yes (per-control)</td>
            <td class="py-3 text-center text-text-muted">No</td>
          </tr>
          <tr>
            <td class="py-3 pr-4 text-text-muted">Assurance reports</td>
            <td class="py-3 pr-4 text-center text-text">Yes (immutable snapshots)</td>
            <td class="py-3 text-center text-text-muted">No</td>
          </tr>
          <tr>
            <td class="py-3 pr-4 text-text-muted">MCP server integration</td>
            <td class="py-3 pr-4 text-center text-text">Yes (23+ agents)</td>
            <td class="py-3 text-center text-text-muted">No</td>
          </tr>
          <tr>
            <td class="py-3 pr-4 text-text-muted">Open-source CLI</td>
            <td class="py-3 pr-4 text-center text-text-muted">CLI is npm-published</td>
            <td class="py-3 text-center text-text-muted">Yes (LGPL-2.1, Community Edition)</td>
          </tr>
        </tbody>
      </table>
    </section>

    <section aria-labelledby="deployment-heading" class="mt-16 border-t border-border pt-12" data-reveal-group>
      <h2 id="deployment-heading" class="text-2xl font-semibold text-text" data-reveal>Deployment and pricing</h2>
      <table class="mt-8 w-full border-collapse text-sm">
        <thead>
          <tr class="border-b border-border text-left">
            <th class="py-3 pr-4 font-semibold text-text">Aspect</th>
            <th class="py-3 pr-4 font-semibold text-text">LyraShield AI</th>
            <th class="py-3 font-semibold text-text">Semgrep</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-border">
          <tr>
            <td class="py-3 pr-4 text-text-muted">Deployment</td>
            <td class="py-3 pr-4 text-text">Hosted + CLI + MCP + GitHub Action</td>
            <td class="py-3 text-text-muted">AppSec Platform (SaaS), CLI (CE), IDE extensions, CI/CD integrations</td>
          </tr>
          <tr>
            <td class="py-3 pr-4 text-text-muted">Pricing</td>
            <td class="py-3 pr-4 text-text">Pre-launch; pricing to be announced</td>
            <td class="py-3 text-text-muted">Community free (LGPL-2.1); Team free ≤10 contributors then $35/contributor/mo; Enterprise custom</td>
          </tr>
          <tr>
            <td class="py-3 pr-4 text-text-muted">Languages</td>
            <td class="py-3 pr-4 text-text">Language-agnostic</td>
            <td class="py-3 text-text-muted">30+ languages (GA, Beta, Experimental)</td>
          </tr>
        </tbody>
      </table>
    </section>

    <section aria-labelledby="summary-heading" class="mt-16 border-t border-border pt-12" data-reveal-group>
      <h2 id="summary-heading" class="text-2xl font-semibold text-text" data-reveal>When to use which</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-2" data-reveal-group>
        <div class="rounded-xl border border-border bg-bg-raised p-6" data-reveal>
          <h3 class="font-semibold text-text">Use LyraShield AI when</h3>
          <ul class="mt-4 space-y-3 text-text-muted">
            <li>You need evidence-backed assurance with coverage receipts for release decisions</li>
            <li>Your app is AI-built and you need AI-specific pattern coverage</li>
            <li>You need immutable assurance reports for compliance or client handoff</li>
            <li>You want security checks inside your AI coding agent via MCP</li>
          </ul>
        </div>
        <div class="rounded-xl border border-border bg-bg-raised p-6" data-reveal>
          <h3 class="font-semibold text-text">Use Semgrep when</h3>
          <ul class="mt-4 space-y-3 text-text-muted">
            <li>You need fast, pattern-based scanning with custom rules</li>
            <li>You want an open-source CLI for local scanning (Community Edition)</li>
            <li>You need SCA with reachability analysis</li>
            <li>You want AI-powered triage to reduce false positive noise</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="mt-16 flex flex-col gap-5 border-t border-border pt-10 sm:flex-row sm:items-center sm:justify-between" data-reveal>
      <div>
        <h2 class="text-2xl font-semibold text-text">See the evidence approach in action.</h2>
        <p class="mt-2 text-text-muted">Read the methodology or try the free browser-local tools.</p>
      </div>
      <div class="flex gap-3">
        <a href="/methodology" class="lift inline-flex min-h-12 items-center justify-center rounded-lg border border-border px-5 text-sm font-semibold text-text hover:bg-bg-raised focus:outline-none focus-visible:ring-2 focus-visible:ring-accent">Methodology</a>
        <a href="/tools" class="lift inline-flex min-h-12 items-center justify-center rounded-lg bg-accent px-5 text-sm font-semibold text-bg hover:opacity-90 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent">Free tools</a>
      </div>
    </section>
  </section>
</Base>
