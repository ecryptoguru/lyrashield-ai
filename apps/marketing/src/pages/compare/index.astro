---
import { getCollection } from "astro:content"

import Base from "@layouts/Base.astro"

const origin = Astro.site?.origin || "http://localhost:4321"
const canonical = new URL("/compare", origin).toString()
const title = "LyraShield AI vs Security Tools — Evidence-Based Comparisons"
const description =
  "How LyraShield AI compares to Snyk, Semgrep, SonarQube, GitHub Advanced Security and other AppSec tools. Factual, publicly documented capability comparisons."
const updatedDate = "2026-08-07"

const entries = await getCollection("compare", ({ data }) => data.draft === false)
const comparisons = entries
  .map((entry) => ({
    slug: entry.id,
    name: entry.data.competitor,
    tagline: entry.data.description,
  }))
  .sort((a, b) => a.name.localeCompare(b.name))

/**
 * Grouped by the category a visitor is shopping in, with a one-line
 * "Choose this if" per card (Spec item 6.2). The grouping is a presentation
 * choice over the same 13 pages; compare-validation.test.ts still sees all 13.
 */
const COMPARE_GROUPS: Array<{ id: string; label: string; blurb: string; slugs: string[] }> = [
  {
    id: "code",
    label: "Code and dependency scanners",
    blurb: "Tools that read source, dependencies or quality signals in a repository.",
    slugs: ["snyk", "semgrep", "sonarqube", "github-advanced-security", "corgea"],
  },
  {
    id: "pentest",
    label: "AI pentest and autonomous testing",
    blurb: "Tools that probe a running target and report what they could reach.",
    slugs: ["pentera", "xbow", "horizon3", "runsybil"],
  },
  {
    id: "platform",
    label: "Platform and lifecycle suites",
    blurb: "Broader platforms that combine several layers behind one console.",
    slugs: ["aikido", "mobb", "zeropath", "pixee"],
  },
]

const bySlug = new Map(comparisons.map((c) => [c.slug, c] as const))
const grouped = COMPARE_GROUPS.map((group) => ({
  id: group.id,
  label: group.label,
  blurb: group.blurb,
  items: group.slugs.map((slug) => bySlug.get(slug)).filter((c): c is (typeof comparisons)[number] => Boolean(c)),
}))
// Any page not named by a group above still renders, so a new compare page can
// never silently disappear from the index.
const named = new Set(COMPARE_GROUPS.flatMap((group) => group.slugs))
const ungrouped = comparisons.filter((c) => !named.has(c.slug))
if (ungrouped.length > 0) {
  grouped.push({
    id: "other",
    label: "More comparisons",
    blurb: "Additional tools compared against the same evidence standard.",
    items: ungrouped,
  })
}

/** "Choose this if" line per competitor, in the visitor's own decision terms. */
const CHOOSE_IF: Record<string, string> = {
  aikido: "you want one console covering several security layers and value breadth over evidence depth",
  snyk: "your priority is dependency and container risk inside the developer workflow",
  semgrep: "you want fast custom rules over your own code patterns",
  sonarqube: "you need code quality and maintainability gates as much as security",
  "github-advanced-security": "your whole workflow already lives in GitHub and you want native code scanning",
  pentera: "you run scheduled adversarial testing of production networks",
  xbow: "you want autonomous exploitation attempts against a live target",
  horizon3: "you need continuous attack-path validation across infrastructure",
  runsybil: "you want AI-assisted validation of findings you already have",
  mobb: "you want automated remediation suggestions alongside findings",
  zeropath: "you want AI triage that ranks findings by reachability",
  corgea: "you want AI-assisted static analysis with remediation suggestions",
  pixee: "you want remediation suggestions integrated into your existing code review workflow",
  "endor-labs": "you want dependency and reachability analysis at platform scale",
}

const jsonLd: unknown[] = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: title,
    description,
    url: canonical,
    dateModified: updatedDate,
    isPartOf: { "@id": `${origin}/#website` },
    hasPart: comparisons.map((c) => ({
      "@type": "TechArticle",
      headline: `LyraShield AI vs ${c.name}`,
      url: `${origin}/compare/${c.slug}`,
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${origin}/` },
      { "@type": "ListItem", position: 2, name: "Compare", item: canonical },
    ],
  },
]
---

<Base title={title} description={description} canonical={canonical} jsonLd={jsonLd}>
  <section class="mx-auto max-w-4xl px-4 py-14 sm:px-6 lg:py-24">
    <header data-reveal-group>
      <p class="font-mono text-xs font-semibold tracking-wider text-accent uppercase" data-reveal="fade">Comparisons</p>
      <h1 class="mt-4 text-4xl font-semibold tracking-tight text-text sm:text-5xl" data-reveal>
        LyraShield AI vs security tools
      </h1>
      <p class="mt-6 text-lg leading-8 text-text-muted" data-reveal>
        Factual comparisons of LyraShield AI's evidence-backed launch gate approach against
        established security scanning tools. Each comparison covers capabilities, deployment and
        when to use which — none of these tools replace each other.
      </p>
    </header>

    <div class="callout mt-10" data-reveal>
      <strong>How we compare.</strong> LyraShield AI is an open-beta
      evidence-backed launch gate layer, not a replacement for vulnerability scanners,
      code quality tools or dependency analyzers. Every claim on these pages is checked
      against public documentation; read{" "}
      <a href="/methodology" class="font-medium text-accent underline decoration-accent/40 underline-offset-4 hover:decoration-accent">the methodology</a>{" "}
      for how we record evidence and limits.
    </div>

    <div class="mt-12 space-y-12">
      {grouped.map((group) => (
        <section aria-labelledby={`compare-group-${group.id}`} data-reveal-group>
          <h2 id={`compare-group-${group.id}`} class="text-2xl font-semibold text-text">{group.label}</h2>
          <p class="mt-2 leading-7 text-text-muted">{group.blurb}</p>
          <div class="mt-5 grid gap-6 sm:grid-cols-2">
            {group.items.map((c) => (
              <a href={`/compare/${c.slug}`} class="lift rounded-xl border border-border bg-bg-raised p-6 hover:border-accent/40 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent" data-reveal>
                <h3 class="text-xl font-semibold text-text">vs {c.name}</h3>
                <p class="mt-2 text-sm text-text-muted">{c.tagline}</p>
                {CHOOSE_IF[c.slug] && (
                  <p class="mt-4 text-sm leading-6 text-text"><span class="font-semibold">Choose this if</span> {CHOOSE_IF[c.slug]}.</p>
                )}
                <p class="mt-4 text-sm font-medium text-accent">{c.name} comparison →</p>
              </a>
            ))}
          </div>
        </section>
      ))}
    </div>

    <section aria-labelledby="position-heading" class="mt-16 border-t border-border pt-12" data-reveal-group>
      <h2 id="position-heading" class="text-2xl font-semibold text-text" data-reveal>Where LyraShield AI fits</h2>
      <p class="mt-5 leading-7 text-text-muted" data-reveal>
        LyraShield AI focuses on a gap that traditional security tools don't address:{" "}
        <strong>evidence-backed launch gate for AI-built apps</strong>. It records what was
        checked, what a fresh retest confirmed, what remains uncertain and what coverage was achieved — then
        produces a checksum-bound report you can share with stakeholders.
      </p>
      <p class="mt-4 leading-7 text-text-muted" data-reveal>
        Most teams use LyraShield AI alongside their existing tools: Snyk or Dependabot for
        dependency scanning, SonarQube for code quality, Semgrep for custom rules and LyraShield
        AI for the launch gate layer that ties everything together with evidence states and
        coverage receipts.
      </p>
    </section>

    <section class="mt-16 flex flex-col gap-5 border-t border-border pt-10 sm:flex-row sm:items-center sm:justify-between" data-reveal>
      <div>
        <h2 class="text-2xl font-semibold text-text">Understand the evidence approach.</h2>
        <p class="mt-2 text-text-muted">Read the methodology behind LyraShield AI's evidence states.</p>
      </div>
      <a href="/methodology" class="lift inline-flex min-h-12 items-center justify-center rounded-lg bg-accent px-5 text-sm font-semibold text-bg hover:opacity-90 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent">Read methodology</a>
    </section>
  </section>
</Base>
