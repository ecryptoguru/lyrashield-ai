---
// Fallback must stay in sync with DEFAULT_API_URL in packages/credentials/src/index.ts
// (marketing deliberately has no dependency edge on that package).
const appUrl =
  (import.meta.env.PUBLIC_APP_URL as string | undefined)?.replace(/\/$/, "") ||
  "https://app.lyrashieldai.com"
import Base from "@layouts/Base.astro"
import { tools, toolUrl } from "../../lib/tools"
const origin = Astro.site?.origin || "http://localhost:4321"
const canonical = new URL("/tools", origin).toString()
const description = `Use ${tools.length} free browser-local security tools to review AI app launch controls, HTTP headers, exposed secrets, Supabase RLS policies, JWT sessions, and WebMCP tool surfaces.`
const faq = [
  { q: "How do these free security tools work?", a: "Each tool performs a focused deterministic check in your browser. The page explains exactly what input it reviews, what signals it reports, and what the result cannot establish." },
  { q: "Are inputs uploaded?", a: "No. The checklist, pasted headers, selected files, SQL, JWTs, and cookie values are processed on your device by the page code. Use non-production tokens and review each tool's stated limits." },
  { q: "Does a clear result mean my app is secure?", a: "No. Each tool reports a focused set of signals. A clear result does not prove the whole application is secure; it only means the specific checks did not find a signal." },
]
const featuredTools = tools.filter((tool) => tool.slug === "webmcp-security-checker")
const generalTools = tools.filter((tool) => tool.slug !== "webmcp-security-checker")

const jsonLd = [
  { "@context": "https://schema.org", "@type": "CollectionPage", name: "Free Security Tools for AI-Built Apps", description, url: canonical, isPartOf: { "@id": `${origin}/#website` }, mainEntity: { "@type": "ItemList", numberOfItems: tools.length, itemListElement: tools.map((tool, index) => ({ "@type": "ListItem", position: index + 1, name: tool.title, url: new URL(toolUrl(tool.slug), origin).toString() })) } },
  { "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: [{ "@type": "ListItem", position: 1, name: "Home", item: `${origin}/` }, { "@type": "ListItem", position: 2, name: "Tools", item: canonical }] },
  { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: faq.map((item) => ({ "@type": "Question", name: item.q, acceptedAnswer: { "@type": "Answer", text: item.a } })) },
]
---
<Base title="Free Security Tools for AI-Built Apps | LyraShield AI" description={description} canonical={canonical} jsonLd={jsonLd}>
  <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:py-20">
    <header class="max-w-3xl" data-reveal-group>
      <h1 class="text-4xl font-semibold tracking-tight text-text sm:text-5xl" data-reveal>Free security tools for AI-built apps</h1>
      <p class="mt-5 max-w-2xl text-lg leading-8 text-text-muted" data-reveal>Get a useful answer before creating an account. Each focused check runs in your browser, keeps sensitive input on your device, and states what it cannot prove.</p>
    </header>
    {featuredTools.length > 0 && (
      <section class="mt-12" data-reveal="scale" aria-labelledby="featured-webmcp-heading">
        <div class="flex items-center justify-between gap-3">
          <h2 id="featured-webmcp-heading" class="text-xl font-semibold text-text">WebMCP Security</h2>
          <a href="/webmcp" class="text-sm font-medium text-accent underline decoration-accent/40 underline-offset-4 hover:decoration-accent focus:outline-none focus-visible:ring-2 focus-visible:ring-accent">Read the guide</a>
        </div>
        <div class="mt-4 divide-y divide-border rounded-xl border border-accent/30 bg-bg-raised">
          {featuredTools.map((tool) => (
            <article class="grid gap-5 p-5 md:grid-cols-[1fr_auto] md:items-center" data-reveal>
              <div>
                <h3 class="text-lg font-semibold text-text"><a href={toolUrl(tool.slug)} class="link-underline rounded-sm hover:text-accent focus:outline-none focus-visible:ring-2 focus-visible:ring-accent">{tool.title}</a></h3>
                <p class="mt-2 leading-7 text-text-muted">{tool.description}</p>
                <p class="mt-3 text-sm font-medium text-accent">Local analyzer · {tool.privacy}</p>
              </div>
              <a href={toolUrl(tool.slug)} class="lift inline-flex min-h-11 items-center justify-center rounded-lg border border-border bg-bg px-4 text-sm font-semibold text-text hover:border-accent hover:text-accent focus:outline-none focus-visible:ring-2 focus-visible:ring-accent">Open tool</a>
            </article>
          ))}
        </div>
      </section>
    )}

    <div class="mt-12 divide-y divide-border border-y border-border" data-reveal-group>
      {generalTools.map((tool, index) => (
        <article class="grid gap-5 py-7 md:grid-cols-[3rem_1fr_auto] md:items-center" data-reveal>
          <span class="font-mono text-xs text-text-muted" aria-hidden="true" data-countup={index + 1}>0{index + 1}</span>
          <div>
            <h2 class="text-xl font-semibold text-text"><a href={toolUrl(tool.slug)} class="link-underline rounded-sm hover:text-accent focus:outline-none focus-visible:ring-2 focus-visible:ring-accent">{tool.title}</a></h2>
            <p class="mt-2 leading-7 text-text-muted">{tool.description}</p>
            <p class="mt-3 text-sm font-medium text-accent">Local analyzer · {tool.privacy}</p>
          </div>
          <a href={toolUrl(tool.slug)} class="lift inline-flex min-h-11 items-center justify-center rounded-lg border border-border bg-bg-raised px-4 text-sm font-semibold text-text hover:border-accent hover:text-accent focus:outline-none focus-visible:ring-2 focus-visible:ring-accent">Open tool</a>
        </article>
      ))}
    </div>
    <section aria-labelledby="tools-faq-heading" class="mt-20" data-reveal="scale">
      <h2 id="tools-faq-heading" class="text-2xl font-semibold text-text">Free tools questions</h2>
      <div class="mt-6 divide-y divide-border rounded-xl border border-border bg-bg-raised">
        {faq.map((item, i) => (
          <details class="p-4" data-question-id={`tools-faq-${i + 1}`}>
            <summary class="cursor-pointer font-medium text-text">{item.q}</summary>
            <p class="mt-3 text-sm leading-6 text-text-muted">{item.a}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="mt-20 grid gap-8 border-y border-border py-10 lg:grid-cols-[1fr_auto] lg:items-center" data-reveal>
      <div class="max-w-3xl">
        <h2 class="text-2xl font-semibold text-text">Need an app-wide assurance record?</h2>
        <p class="mt-4 leading-7 text-text-muted">The complete product adds authorized target scanning, SCA and secret checks, explicit coverage receipts, evidence states, approval-gated fix proposals, server-owned retests, immutable reports, schedules, notifications, and workspace-scoped audit history. Read the <a href="/methodology" class="font-medium text-accent underline decoration-accent/40 underline-offset-4 hover:decoration-accent focus:outline-none focus-visible:ring-2 focus-visible:ring-accent">evidence methodology</a> before interpreting a result.</p>
      </div>
      <a href={`${appUrl}/sign-up?source=tools&cta=create_account`} class="lift inline-flex min-h-12 items-center justify-center rounded-lg bg-accent px-5 text-sm font-semibold text-bg shadow-lg shadow-accent/15 hover:bg-accent/90 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent">Create a free account</a>
    </section>
  </section>
</Base>
