---
const appUrl =
  (import.meta.env.PUBLIC_APP_URL as string | undefined)?.replace(/\/$/, "") ||
  "https://app.lyrashieldai.com"
import Base from "@layouts/Base.astro"

const origin = Astro.site?.origin || "http://localhost:4321"
const canonical = new URL("/sample-report", origin).toString()
const description =
  "A sanitized mock example of how LyraShield AI separates scope, detected candidates, independent verification, retest evidence, and limitations."

const howToSteps = [
  {
    name: "Identify the target and scope",
    text: "Confirm what was authorized for review. In this mock, the target is mock-app.example and the scope is the repository plus the public URL.",
  },
  {
    name: "Read detected candidates as signals, not proof",
    text: "The report records the scanner source, affected location, and confidence. Confidence is triage metadata; it does not prove exploitability.",
  },
  {
    name: "Check for independent verification",
    text: "A verified label requires a separate verification receipt. Engine confidence alone cannot self-verify a finding.",
  },
  {
    name: "Review the fix proposal and approval state",
    text: "The proposal explains and may stage a change. PR execution stays unavailable until a server-generated patch is bound to the exact approval.",
  },
  {
    name: "Read the retest and limitations together",
    text: "A complete deterministic retest can confirm the condition is absent. If the evidence is incomplete, the result stays inconclusive and the limitations remain visible.",
  },
]

const faq = [
  {
    q: "Is this a real customer report?",
    a: "No. This page contains only synthetic, sanitized data. No customer target, repository, finding, or result is shown.",
  },
  {
    q: "Can I download a report like this for my app today?",
    a: "Not yet. The full release-assurance workflow is in active development. The Lite Check and browser-local tools are available now.",
  },
  {
    q: "What does 'Review required' mean?",
    a: "It means a detected candidate still needs independent evidence or a retest before the release record can be treated as verified.",
  },
  {
    q: "Does a clean result prove my app has no vulnerabilities?",
    a: "No. The report states the coverage that completed and the evidence it retained. It does not make a universal security claim.",
  },
]

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: "Sample LyraShield AI security assurance report",
    description,
    url: canonical,
    dateModified: "2026-07-16",
    isPartOf: { "@id": `${origin}/#website` },
  },
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    name: "How to read a LyraShield AI assurance report",
    description:
      "A five-step guide to interpreting scope, detected candidates, independent verification, fix proposals, retest outcomes, and retained limitations.",
    totalTime: "PT2M",
    step: howToSteps.map((step, index) => ({
      "@type": "HowToStep",
      position: index + 1,
      name: step.name,
      text: step.text,
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faq.map((item) => ({
      "@type": "Question",
      name: item.q,
      acceptedAnswer: { "@type": "Answer", text: item.a },
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${origin}/` },
      { "@type": "ListItem", position: 2, name: "Sample report", item: canonical },
    ],
  },
]
---

<Base title="Sample AI app security assurance report | LyraShield AI" description={description} canonical={canonical} jsonLd={jsonLd}>
  <article class="mx-auto max-w-5xl px-4 py-16 sm:px-6 lg:px-8 lg:py-24">
    <div class="rounded-2xl border border-(--terminal-panel) bg-(--terminal-void) p-6 text-(--terminal-text) sm:p-9" data-reveal="scale">
      <div class="flex flex-wrap items-center justify-between gap-4 border-b border-(--terminal-edge) pb-5">
        <div>
          <p class="font-mono text-xs font-semibold tracking-[.2em] text-(--terminal-cyan) uppercase">Sanitized mock · not a real assessment</p>
          <h1 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">Sample Assurance Story</h1>
        </div>
        <span class="rounded-full border border-(--terminal-amber)/40 px-3 py-1.5 text-xs font-semibold text-(--terminal-amber)">In active development</span>
      </div>
      <dl class="mt-8 grid gap-4 sm:grid-cols-4" data-reveal-group>
        <div data-reveal="fade"><dt class="text-xs text-(--terminal-muted)">Target</dt><dd class="mt-2 font-mono text-sm">mock-app.example</dd></div>
        <div data-reveal="fade"><dt class="text-xs text-(--terminal-muted)">Scope</dt><dd class="mt-2 text-sm">Repository + public URL</dd></div>
        <div data-reveal="fade"><dt class="text-xs text-(--terminal-muted)">Result</dt><dd class="mt-2 text-sm">Illustrative only</dd></div>
        <div data-reveal="fade"><dt class="text-xs text-(--terminal-muted)">Evidence</dt><dd class="mt-2 text-sm">Synthetic</dd></div>
      </dl>
    </div>

    <section class="mt-10 grid gap-6 md:grid-cols-2" data-reveal-group>
      <div class="lift rounded-2xl border border-border bg-bg-raised p-6" data-reveal><p class="font-mono text-xs text-text-muted"><span data-countup="1">01</span> · DETECTED CANDIDATE</p><h2 class="mt-3 text-xl font-semibold text-text">Server credential referenced by client build</h2><p class="mt-3 leading-7 text-text-muted">The report records the scanner source, affected location, and confidence without turning confidence into proof.</p></div>
      <div class="lift rounded-2xl border border-border bg-bg-raised p-6" data-reveal><p class="font-mono text-xs text-text-muted"><span data-countup="2">02</span> · INDEPENDENT VERIFICATION</p><h2 class="mt-3 text-xl font-semibold text-text">Separate evidence receipt</h2><p class="mt-3 leading-7 text-text-muted">A verified label requires independent evidence. Engine-originated confidence cannot self-verify a finding.</p></div>
      <div class="lift rounded-2xl border border-border bg-bg-raised p-6" data-reveal><p class="font-mono text-xs text-text-muted"><span data-countup="3">03</span> · FIX PROPOSAL</p><h2 class="mt-3 text-xl font-semibold text-text">Approval-bound patch plan</h2><p class="mt-3 leading-7 text-text-muted">Fix PR execution stays unavailable until a server-generated patch is bound to the exact approval.</p></div>
      <div class="lift rounded-2xl border border-border bg-bg-raised p-6" data-reveal><p class="font-mono text-xs text-text-muted"><span data-countup="4">04</span> · RETEST + LIMITATIONS</p><h2 class="mt-3 text-xl font-semibold text-text">Outcome with retained uncertainty</h2><p class="mt-3 leading-7 text-text-muted">A complete deterministic retest may confirm the condition absent; incomplete evidence remains inconclusive.</p></div>
    </section>

    <section class="mt-16" data-reveal="fade" aria-labelledby="how-to-heading">
      <h2 id="how-to-heading" class="text-2xl font-semibold text-text">How to read this sample report</h2>
      <ol class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {howToSteps.map((step, index) => (
          <li class="rounded-xl border border-border bg-bg-raised p-5" data-reveal>
            <p class="font-mono text-xs text-accent">Step {index + 1}</p>
            <h3 class="mt-2 font-semibold text-text">{step.name}</h3>
            <p class="mt-2 text-sm leading-6 text-text-muted">{step.text}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="mt-16" aria-labelledby="faq-heading">
      <h2 id="faq-heading" class="text-2xl font-semibold text-text" data-reveal="fade">Frequently asked questions</h2>
      <div class="mt-6 divide-y divide-border rounded-xl border border-border bg-bg-raised" data-reveal="scale">
        {faq.map((item, i) => (
          <details class="faq-item p-4" data-question-id={`sample-report-faq-${i + 1}`}>
            <summary class="cursor-pointer font-medium text-text">{item.q}</summary>
            <p class="mt-3 text-sm leading-6 text-text-muted">{item.a}</p>
          </details>
        ))}
      </div>
    </section>

    <p class="mt-10 rounded-xl border border-border bg-bg-raised p-5 leading-7 text-text-muted" data-reveal="fade">This page is a sanitized mock for product evaluation. It contains no customer data, benchmark, production result, or claim that the full workflow is currently available.</p>

    {/* This page is the proof artifact a sceptical reader is sent to, and it
        previously ended here with no way onward — no link of any kind in the
        page body. Give the reader the two next steps that match their intent:
        produce a record of their own, or read how the evidence states are
        defined. */}
    <section
      class="mt-16 flex flex-col gap-5 border-t border-border pt-10 sm:flex-row sm:items-center sm:justify-between"
      aria-labelledby="sample-report-next-heading"
      data-reveal
    >
      <div>
        <h2 id="sample-report-next-heading" class="text-2xl font-semibold text-text">
          Produce one of these for your own release.
        </h2>
        <p class="mt-2 text-text-muted">
          Registration is open in the beta. Start with a free passive check, or create an account
          for the full target-to-report loop.
        </p>
      </div>
      <div class="flex flex-wrap gap-3">
        <a
          href={`${appUrl}/sign-up?source=sample_report&cta=create_account`}
          data-cta-id="sample-report-create-account"
          class="lift inline-flex min-h-12 items-center justify-center rounded-lg bg-accent px-5 text-sm font-semibold text-bg hover:opacity-90 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
          >Create a free account</a
        >
        <a
          href="/scan"
          data-cta-id="sample-report-lite-check"
          class="lift inline-flex min-h-12 items-center justify-center rounded-lg border border-border bg-bg px-5 text-sm font-semibold text-text hover:border-accent focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
          >Run a free Lite Check</a
        >
      </div>
    </section>

    <p class="mt-8 text-sm leading-6 text-text-muted" data-reveal="fade">
      How the four evidence states are defined:{" "}
      <a href="/methodology" class="font-semibold text-accent underline decoration-accent/40 underline-offset-4 hover:decoration-accent">read the methodology</a>{" "}
      or see the{" "}
      <a href="/vibe-security-50" class="font-semibold text-accent underline decoration-accent/40 underline-offset-4 hover:decoration-accent">Vibe Security 50 control registry</a>.
    </p>
  </article>
</Base>
