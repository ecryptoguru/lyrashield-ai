---
import DocsLayout from "@layouts/DocsLayout.astro"
import { buildDocsJsonLd } from "../../lib/docs-metadata"

const origin = Astro.site?.origin || "http://localhost:4321"
const title = "Agent Authorization"
const description =
  "How mutating agent actions are authorized in LyraShield: a connected OAuth client is the grant. API keys and legacy bearers get one connect_required response."
const updatedDate = "2026-09-13"

const { canonical, techArticle, breadcrumbList } = buildDocsJsonLd({
  origin,
  path: "/docs/approvals",
  title,
  description,
  updatedDate,
  breadcrumbLabel: "Approvals",
  breadcrumbSection: "Docs",
})
const jsonLd: unknown[] = [techArticle, breadcrumbList]
---

<DocsLayout
  title={`${title} | LyraShield AI`}
  description={description}
  canonical={canonical}
  jsonLd={jsonLd}
  updatedDate={updatedDate}
  currentPath="/docs/approvals"
>
  <h1>Agent authorization</h1>
  <p>
    A connected OAuth client is the authorization. When a client connects to LyraShield over
    OAuth, its grant carries the workspace, scopes, allowed operations, target scope, profiles
    and expiry. Mutating calls that match the grant execute automatically with a caller-supplied{" "}
    <code>idempotencyKey</code>; identical retries replay the stored result instead of running
    twice.
  </p>

  <h2>Callers without a connection</h2>
  <p>
    An API key or a legacy OAuth bearer calling a mutating tool on the hosted endpoint receives
    one structured response and nothing else:
  </p>
  <pre><code>{`{
  "code": "connect_required",
  "message": "This action requires a connected LyraShield client. Connect over OAuth to authorize mutating tools inside a bounded grant.",
  "connectUrl": "https://app.lyrashieldai.com/dashboard/connections",
  "docsUrl": "https://lyrashieldai.com/docs/approvals"
}`}</code></pre>
  <p>
    No approval is queued and nothing executes. Connect a client over OAuth, then re-run the
    action inside the grant. Read-only credentials are denied on scope before this check.
  </p>

  <h2>Retired PENDING flow</h2>
  <p>
    The earlier remote flow — a <code>PENDING</code> result with an <code>approvalId</code> that a
    human approved in a review queue before the agent retried the same call — is retired on the
    remote path. A call that carries a legacy <code>approvalId</code> now receives{" "}
    <code>connect_required</code> like any other connectionless call.
  </p>
  <p>
    Historical agent-action approval records stay readable for audit. Browser Fix PR requests
    still use an exact-patch approval and the REST approval routes below. These routes do not
    reactivate the retired remote MCP <code>PENDING</code> flow:
  </p>
  <ul>
    <li><code>GET /api/v1/agent-approvals?workspaceId=&lt;id&gt;</code> — list approvals</li>
    <li>
      <code>POST /api/v1/agent-approvals/&lt;id&gt;/approve</code> — approve an action (requires{" "}
      <code>input</code> for hash verification)
    </li>
    <li><code>POST /api/v1/agent-approvals/&lt;id&gt;/deny</code> — deny an action</li>
  </ul>

  <h2>Local stdio server</h2>
  <p>
    The local <code>@lyrashield/mcp</code> stdio server uses a workspace API key and calls the
    REST API directly. Scope, role, target authorization and budget are enforced on each
    request; no second LyraShield prompt applies there.
  </p>
</DocsLayout>
