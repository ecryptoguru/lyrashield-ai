---
import AgentSnippet from "@components/AgentSnippet.astro"
import DocsLayout from "@layouts/DocsLayout.astro"
import CliConfigPreview from "@components/integrations/CliConfigPreview.astro"
import { buildDocsJsonLd } from "../../../lib/docs-metadata"

const origin = Astro.site?.origin || "http://localhost:4321"
const title = "LyraShield MCP for Codebuff — Setup Guide"
const description =
  "Connect LyraShield to Codebuff through .agents/mcp.json using its documented local or HTTP MCP server contract."
const updatedDate = "2026-10-02"

const { canonical, techArticle, breadcrumbList } = buildDocsJsonLd({
  origin,
  path: "/docs/integrations/codebuff",
  title,
  description,
  updatedDate,
  breadcrumbLabel: "Codebuff",
})
const jsonLd: unknown[] = [
  techArticle,
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    name: "Set up LyraShield MCP in Codebuff",
    step: [
      {
        "@type": "HowToStep",
        position: 1,
        name: "Open .agents/mcp.json",
        text: "Open or create .agents/mcp.json in your project root.",
      },
      {
        "@type": "HowToStep",
        position: 2,
        name: "Add the mcpServers entry",
        text: 'Add the mcpServers key with command "npx", pinned args and a $LYRASHIELD_API_KEY environment reference.',
      },
      {
        "@type": "HowToStep",
        position: 3,
        name: "Start Codebuff",
        text: "Run codebuff and verify the LyraShield server is listed.",
      },
    ],
  },
  breadcrumbList,
]
---

<DocsLayout
  title={`${title} | LyraShield AI`}
  description={description}
  canonical={canonical}
  jsonLd={jsonLd}
  updatedDate={updatedDate}
  currentPath="/docs/integrations/codebuff"
>
  <h1>Codebuff</h1>
  <p>
    Codebuff is an open-source terminal agent (installed via <code>npm i -g codebuff</code>) that
    reads project MCP configuration from <code>.agents/mcp.json</code> and global configuration from{" "}
    <code>~/.agents/mcp.json</code>. Its <code>mcpServers</code> object supports local stdio and
    remote HTTP entries.
  </p>

  <CliConfigPreview agentId="codebuff" />
  <p>Prefer to see exactly what gets written or set it up without Node.js? Configure it by hand below.</p>

  <h2>Local stdio setup</h2>
  <p>
    Add the following to <code>.agents/mcp.json</code>. Create the file if it does not exist.
  </p>

  <AgentSnippet agentId="codebuff" transport="stdio" />

  <h2>Remote HTTP setup</h2>
  <p>
    Codebuff also documents HTTP servers with <code>type: "http"</code>, <code>url</code> and
    optional headers. Use its <code>$VAR_NAME</code> syntax instead of storing a token literally.
  </p>
  <AgentSnippet agentId="codebuff" transport="remote-http" />

  <h2>Verify the connection</h2>
  <p>
    Start Codebuff and ask: <em>"What LyraShield tools do you have access to?"</em> to confirm the
    server is connected. Codebuff also supports <code>/init</code> and <code>/publish</code>{" "}
    commands and an agent store.
  </p>

  <div class="callout callout--warn">
    <strong>Requirements:</strong> For local stdio, Node.js 24+ and a local OAuth login or workspace API key. The official Codebuff MCP guide documents static HTTP headers; keep a read-only key private for that remote option, and do not treat it as hosted mutation delegation. The{" "}
    <code>@lyrashield/mcp</code> package is published on npm, so{" "}
    <code>npx -y @lyrashield/mcp@0.2.12</code> resolves directly.
  </div>
</DocsLayout>
