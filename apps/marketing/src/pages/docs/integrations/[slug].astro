---
import AgentSnippet from "@components/AgentSnippet.astro"
import DocsLayout from "@layouts/DocsLayout.astro"
import { buildDocsJsonLd } from "../../../lib/docs-metadata"
import { listGeneratedIntegrationDocs } from "../../../lib/integration-doc-routes"

export function getStaticPaths() {
  return listGeneratedIntegrationDocs().map((agent) => ({
    params: { slug: agent.docsSlug },
    props: { agent },
  }))
}

const { agent } = Astro.props
const origin = Astro.site?.origin || "http://localhost:4321"
const path = `/docs/integrations/${agent.docsSlug}`
const title = `LyraShield setup for ${agent.displayName}`
const description = `Connect LyraShield to ${agent.displayName} using the documented ${agent.installStrategy.replaceAll("-", " ")} workflow.`
const updatedDate = agent.verification.checkedOn
const { canonical, techArticle, breadcrumbList } = buildDocsJsonLd({
  origin,
  path,
  title,
  description,
  updatedDate,
  breadcrumbLabel: agent.displayName,
})
const jsonLd: unknown[] = [techArticle, breadcrumbList]
const strategyLabels = {
  "agent-plugin": "Agent Plugin",
  "config-file": "Client configuration file",
  "vendor-cli": "Client's own CLI",
  "guided-manual": "Guided manual setup",
} as const
const sourceUrl = agent.source?.url ?? agent.verification.reference
const capabilities = agent.nativeCapabilities ?? []
---

<DocsLayout
  title={`${title} | LyraShield AI`}
  description={description}
  canonical={canonical}
  jsonLd={jsonLd}
  updatedDate={updatedDate}
  currentPath={path}
>
  <h1>{agent.displayName}</h1>
  <p>
    This guide uses LyraShield's integration registry for the {agent.surface ?? "documented"} surface.
    It shows the current setup strategy and client source; actual client loading and authenticated
    runtime acceptance are tracked separately below.
  </p>

  <h2>Connection setup</h2>
  <p>
    The registry's setup path for this client is <strong>{strategyLabels[agent.installStrategy]}</strong>
    {agent.preferredTransport ? <> over <strong>{agent.preferredTransport === "remote-http" ? "remote HTTP" : "local stdio"}</strong></> : null}.
    Preview the exact current instructions with <code>npx lyrashield install {agent.id} --dry-run</code>.
  </p>
  <pre><code>npx lyrashield install {agent.id} --dry-run</code></pre>
  {agent.installStrategy !== "agent-plugin" && (
    <AgentSnippet agentId={agent.id} transport={agent.preferredTransport ?? undefined} />
  )}
  {agent.installStrategy === "agent-plugin" && (
    <p>
      Use the client's documented plugin or marketplace flow. See the shared{" "}
      <a href="/docs/integrations/agent-plugins">Agent Plugins guide</a> for the portable package;
      this page does not claim the package is listed or runtime-verified in this client.
    </p>
  )}

  {agent.transports.includes("remote-http") && (
    <div class="callout">
      <strong>Hosted access:</strong> use OAuth when the client supports it. Hosted mutations require
      a browser-confirmed delegation and are checked against its workspace, scope and expiry. An
      API key alone does not authorize hosted mutations. See the{" "}
      <a href="/docs/integrations/remote-mcp">Remote MCP guide</a>.
    </div>
  )}
  {agent.transports.includes("stdio") && (
    <div class="callout">
      <strong>Local access:</strong> run <code>npx lyrashield login --oauth</code> to select a
      workspace for local stdio, or use a scoped workspace API key in an appropriate private
      environment. Never commit credentials.
    </div>
  )}

  {agent.locations.length > 0 && (
    <>
      <h2>Configuration locations</h2>
      <ul>
        {agent.locations.map((location) => (
          <li>
            {location.scope}: <code>{location.path}</code>
            {location.sharedByConvention ? " (shared by convention)" : ""}
          </li>
        ))}
      </ul>
    </>
  )}

  <h2>Native components and distribution</h2>
  {capabilities.length > 0 ? (
    <p>
      Documented client capabilities: {capabilities.join(", ")}. These describe what the client can
      load; they do not mean every component is included in the current LyraShield package.
    </p>
  ) : (
    <p>No native plugin, skill, command, rule or hook capability is recorded for this surface.</p>
  )}
  {agent.distribution ? (
    <p>
      Distribution route: {agent.distribution.channel}; registry state{" "}
      <code>{agent.distribution.state}</code>.{" "}
      <a href={agent.distribution.url} target="_blank" rel="noreferrer">Client distribution documentation</a>.
    </p>
  ) : (
    <p>No separate marketplace or distribution channel is recorded for this surface.</p>
  )}

  <h2>Support evidence</h2>
  <p>
    Registry tier: <code>{agent.supportTier}</code>. Evidence: <code>{agent.verification.evidence}</code>,
    checked {updatedDate}. Client version: {agent.verification.clientVersion ?? "not recorded"};
    tested platforms: {agent.verification.platforms.length > 0 ? agent.verification.platforms.join(", ") : "not recorded"}.
    {agent.verification.receipt ? " A runtime receipt is recorded." : " No client runtime receipt is recorded."}
    Marketplace state and runtime compatibility are separate claims.
  </p>
  {sourceUrl && (
    <p>
      Source: <a href={sourceUrl} target="_blank" rel="noreferrer">{agent.displayName} official documentation</a>.
    </p>
  )}
</DocsLayout>
