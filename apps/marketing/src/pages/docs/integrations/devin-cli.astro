---
import AgentSnippet from "@components/AgentSnippet.astro"
import DocsLayout from "@layouts/DocsLayout.astro"
import { buildDocsJsonLd } from "../../../lib/docs-metadata"

const origin = Astro.site?.origin || "http://localhost:4321"
const title = "LyraShield MCP for Devin CLI — Setup Guide"
const description =
  "Connect LyraShield to Devin CLI using its current dedicated MCP config files, local stdio or remote HTTP with OAuth."
const updatedDate = "2026-09-19"

const { canonical, techArticle, breadcrumbList } = buildDocsJsonLd({
  origin,
  path: "/docs/integrations/devin-cli",
  title,
  description,
  updatedDate,
  breadcrumbLabel: "Devin CLI",
})
const jsonLd: unknown[] = [
  techArticle,
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    name: "Set up LyraShield MCP in Devin CLI",
    step: [
      {
        "@type": "HowToStep",
        position: 1,
        name: "Open .devin/mcp_config.local.json",
        text: "Open or create .devin/mcp_config.local.json in your project root for Devin CLI v3000.3 or later.",
      },
      {
        "@type": "HowToStep",
        position: 2,
        name: "Add the mcpServers entry",
        text: 'Add the mcpServers key with command "npx" and args ["-y","@lyrashield/mcp@0.2.8"]. Set LYRASHIELD_API_KEY in the env block.',
      },
      {
        "@type": "HowToStep",
        position: 3,
        name: "Verify with devin mcp list",
        text: "Run devin mcp list to confirm the lyrashield server is registered.",
      },
    ],
  },
  breadcrumbList,
]
---

<DocsLayout
  title={`${title} | LyraShield AI`}
  description={description}
  canonical={canonical}
  jsonLd={jsonLd}
  updatedDate={updatedDate}
  currentPath="/docs/integrations/devin-cli"
>
  <h1>Devin CLI</h1>
  <p>
    Devin CLI (by Cognition, separate from Devin's web application) reads MCP server configuration
    from <code>.devin/mcp_config.local.json</code> in your project root for v3000.3 and later.
    This file is gitignored and uses a <code>mcpServers</code> object. Devin CLI also supports
    remote HTTP and OAuth.
  </p>

  <h2>Install with the CLI (fastest)</h2>
  <p>
    Run <code>npx lyrashield install devin-cli</code> from your project root. It detects Devin CLI,
    writes the current dedicated config. Add <code>--dry-run</code> first to preview the change with no write or run{" "}
    <code>npx lyrashield doctor</code> afterward to inspect local configuration, then make a read-only call in the client.
  </p>
  <pre><code>npx lyrashield install devin-cli</code></pre>
  <p>Prefer to see exactly what gets written or set it up without Node.js? Configure it by hand below.</p>

  <h2>Local stdio setup</h2>
  <p>
    Add the following to <code>.devin/mcp_config.local.json</code>. Create the file if it does not
    exist. You can also manage servers with <code>devin mcp add</code>.
  </p>

  <AgentSnippet agentId="devin-cli" transport="stdio" />
  <p>
    Devin CLI versions before v3000.3 stored <code>mcpServers</code> in
    <code>.devin/config.local.json</code> or another main config file. Current Devin migrates
    those entries on startup. Inspect the migrated entry before adding a second server.
    Project-shared and user-level alternatives are <code>.devin/mcp_config.json</code> and
    <code>~/.config/devin/mcp_config.json</code>.
  </p>

  <h2>Remote HTTP alternative</h2>
  <p>Devin CLI supports Streamable HTTP and OAuth. Use <code>devin mcp login lyrashield</code> after adding the URL.</p>
  <AgentSnippet agentId="devin-cli" transport="remote-http" secondary />

  <div class="callout">
    <strong>Managing servers:</strong> Use <code>devin mcp add|login|enable|disable</code> to
    manage MCP servers. Remote servers needing OAuth authenticate via{" "}
    <code>devin mcp login &lt;server&gt;</code>. MCP tools are namespaced as{" "}
    <code>mcp__&lt;server&gt;__&lt;tool&gt;</code>.
  </div>

  <h2>Verify the connection</h2>
  <p>
    Run <code>devin mcp list</code> to confirm the lyrashield server is registered. Ask Devin:{" "}
    <em>"What LyraShield tools do you have access to?"</em> to confirm the server is connected.
  </p>

  <div class="callout callout--warn">
    <strong>Local stdio requirements:</strong> Node.js 24+ and a local OAuth login or workspace API key. Remote OAuth does not require a local API key. The{" "}
    <code>@lyrashield/mcp</code> package is published on npm, so{" "}
    <code>npx -y @lyrashield/mcp@0.2.8</code> resolves directly.
  </div>
  <h2>Review the app before release</h2>
  <p>
    After confirming the connection, use the <a href="/blog/devin-cli-app-security-checklist">Devin CLI app security checklist</a>
    to review secrets, permissions, dependencies and application tests. The <a href="/blog/devin-cli-mcp-security-workflow">Devin CLI MCP workflow</a>
    explains how scan results and retests fit that review. Connection success alone is not release evidence.
  </p>
</DocsLayout>
