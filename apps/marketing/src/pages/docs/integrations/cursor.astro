---
import AgentSnippet from "@components/AgentSnippet.astro"
import DocsLayout from "@layouts/DocsLayout.astro"
import { buildDocsJsonLd } from "../../../lib/docs-metadata"

const origin = Astro.site?.origin || "http://localhost:4321"
const title = "LyraShield MCP for Cursor — Setup Guide"
const description =
  "Add the LyraShield MCP server to Cursor. Configure .cursor/mcp.json with the npx stdio transport to run security checks inline in the Cursor AI editor."
const updatedDate = "2026-10-02"

const { canonical, techArticle, breadcrumbList } = buildDocsJsonLd({
  origin,
  path: "/docs/integrations/cursor",
  title,
  description,
  updatedDate,
  breadcrumbLabel: "Cursor",
})
const jsonLd: unknown[] = [
  techArticle,
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    name: "Set up LyraShield MCP in Cursor",
    step: [
      {
        "@type": "HowToStep",
        position: 1,
        name: "Open .cursor/mcp.json",
        text: "In your project root (or home directory for a global config), open or create .cursor/mcp.json.",
      },
      {
        "@type": "HowToStep",
        position: 2,
        name: "Add the lyrashield server entry",
        text: 'Add the mcpServers key with command "npx" and args ["-y","@lyrashield/mcp@0.2.12"] without inline credentials. Run npx -y lyrashield@0.2.14 login --oauth in the same OS account first.',
      },
      {
        "@type": "HowToStep",
        position: 3,
        name: "Confirm discovery",
        text: "Reload Cursor and confirm the lyrashield server and tools appear in Settings → MCP.",
      },
      {
        "@type": "HowToStep",
        position: 4,
        name: "Verify authenticated read-only access",
        text: "Call lyrashield_list_workspaces and confirm the intended workspace. Discovery is separate from authentication and scan acceptance.",
      },
    ],
  },
  breadcrumbList,
]
---

<DocsLayout
  title={`${title} | LyraShield AI`}
  description={description}
  canonical={canonical}
  jsonLd={jsonLd}
  updatedDate={updatedDate}
  currentPath="/docs/integrations/cursor"
>
  <h1>Cursor</h1>
  <p>
    Cursor reads MCP servers from <code>.cursor/mcp.json</code> in your project root. For a
    user-level global setup, place the file at <code>~/.cursor/mcp.json</code>.
  </p>

  <h2>Native plugin listing pending</h2>
  <p>
    The Cursor Agent Plugin listing is still pending review and public readback. Use the direct MCP
    setup below until public listing and authenticated runtime acceptance are verified. The CLI installer does not provide
    a direct-MCP writer for this plugin route, so merge the entry manually. This guide does not
    claim plugin listing or authenticated Cursor runtime acceptance.
  </p>

  <h2>Authenticate local stdio</h2>
  <p>
    With Node.js 24 or newer, run <code>npx -y lyrashield@0.2.14 login --oauth</code> in the same OS
    account that runs Cursor. Select the intended workspace. The local MCP server reads the CLI
    credential store; no key belongs in the project config.
  </p>

  <h2>Configuration</h2>
  <p>
    Create or open <code>.cursor/mcp.json</code> in your project root and merge the following entry, preserving existing servers and settings.
  </p>

  <AgentSnippet agentId="cursor" transport="stdio" />

  <div class="callout">
    <strong>Project vs. global:</strong> Place <code>.cursor/mcp.json</code> inside your project
    root to share config with the team (each developer runs <code>npx -y lyrashield@0.2.14 login --oauth</code>
    {" "}locally). Place it at <code>~/.cursor/mcp.json</code> for
    a personal global setup.
  </div>

  <h2>Deeplink install</h2>
  <p>
    Cursor also documents a client-owned deeplink flow for registering MCP servers. See the{" "}
    <a href="https://docs.cursor.com/context/model-context-protocol" target="_blank" rel="noreferrer">
      Cursor MCP documentation
    </a>{" "}
    for the current deeplink format.
  </p>

  <h2>Verify the connection</h2>
  <p>
    Reload the window and open <strong>Settings → MCP</strong>. The <strong>lyrashield</strong>{" "}
    server should appear with its tools. Then ask Cursor to call <code>lyrashield_list_workspaces</code>{" "}
    and confirm the intended workspace. Discovery and a successful authenticated read are separate
    checks; neither proves scan or write acceptance.
  </p>

  <div class="callout callout--warn">
    <strong>Requirements:</strong> Node.js 24+ and a LyraShield workspace OAuth login. The{" "}
    <code>@lyrashield/mcp</code> package is published on npm, so{" "}
    <code>npx -y @lyrashield/mcp@0.2.12</code> resolves directly.
  </div>
</DocsLayout>
