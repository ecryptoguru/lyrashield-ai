---
import AgentSnippet from "@components/AgentSnippet.astro"
import DocsLayout from "@layouts/DocsLayout.astro"

const origin = Astro.site?.origin || "http://localhost:4321"
const canonical = new URL("/docs/integrations/cursor", origin).toString()
const title = "LyraShield MCP for Cursor — Setup Guide"
const description =
  "Add the LyraShield MCP server to Cursor. Configure .cursor/mcp.json with the npx stdio transport to run security checks inline in the Cursor AI editor."
const updatedDate = "2026-08-12"

const jsonLd: unknown[] = [
  {
    "@context": "https://schema.org",
    "@type": "TechArticle",
    headline: title,
    description,
    url: canonical,
    dateModified: updatedDate,
    author: { "@id": `${origin}/#organization` },
    publisher: { "@id": `${origin}/#organization` },
    inLanguage: "en-US",
  },
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    name: "Set up LyraShield MCP in Cursor",
    step: [
      {
        "@type": "HowToStep",
        position: 1,
        name: "Open .cursor/mcp.json",
        text: "In your project root (or home directory for a global config), open or create .cursor/mcp.json.",
      },
      {
        "@type": "HowToStep",
        position: 2,
        name: "Add the lyrashield server entry",
        text: 'Add the mcpServers key with command "npx" and args ["-y","@lyrashield/mcp"], and set your LYRASHIELD_API_KEY in the env block.',
      },
      {
        "@type": "HowToStep",
        position: 3,
        name: "Reload Cursor",
        text: "Reload the window. The lyrashield server should appear in Settings → MCP.",
      },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${origin}/` },
      {
        "@type": "ListItem",
        position: 2,
        name: "Integrations",
        item: `${origin}/docs/integrations`,
      },
      { "@type": "ListItem", position: 3, name: "Cursor", item: canonical },
    ],
  },
]
---

<DocsLayout
  title={`${title} | LyraShield AI`}
  description={description}
  canonical={canonical}
  jsonLd={jsonLd}
  updatedDate={updatedDate}
  currentPath="/docs/integrations/cursor"
>
  <h1>Cursor</h1>
  <p>
    Cursor reads MCP servers from <code>.cursor/mcp.json</code> in your project root. For a
    user-level global setup, place the file at <code>~/.cursor/mcp.json</code>.
  </p>

  <h2>Install with the CLI (fastest)</h2>
  <p>
    Run <code>npx lyrashield install cursor</code> from your project root. It detects Cursor, writes
    the generated Agent Plugin by default, and never copies an OAuth bearer into a file you might commit.
    Add <code>--dry-run</code> first to preview the change with no write, or run{" "}
    <code>npx lyrashield doctor</code> afterward to confirm it's configured correctly.
  </p>
  <pre><code>npx lyrashield install cursor</code></pre>
  <p>Prefer to see exactly what gets written, or set it up without Node.js? Configure it by hand below.</p>

  <h2>Configuration</h2>
  <p>
    Create or open <code>.cursor/mcp.json</code> in your project root and add the following entry.
  </p>

  <AgentSnippet agentId="cursor" transport="stdio" />

  <div class="callout">
    <strong>Project vs. global:</strong> Place <code>.cursor/mcp.json</code> inside your project
    root to share config with the team (each developer runs <code>npx lyrashield login --oauth</code>
    locally). Place it at <code>~/.cursor/mcp.json</code> for
    a personal global setup.
  </div>

  <h2>Deeplink install</h2>
  <p>
    Cursor supports an <code>cursor://mcp/install</code> deeplink. You can open a deeplink directly
    to register the server without editing JSON manually — see the{" "}
    <a href="https://docs.cursor.com/context/model-context-protocol" target="_blank" rel="noreferrer">
      Cursor MCP documentation
    </a>{" "}
    for the current deeplink format.
  </p>

  <h2>Agent Plugin (recommended)</h2>
  <p>
    Cursor supports the open Agent Plugins v1.0.0 standard (agent-plugins.org), and LyraShield ships
    a portable plugin that bundles the MCP server and a security skill into a single installable
    package. The skill teaches Cursor's AI when to run LyraShield checks, so you get both the tools
    and the guidance in one step.
  </p>
  <p>
    <code>npx lyrashield install cursor</code> now installs the portable plugin by default — the
    preferred path over the manual config and deeplink options above. Add <code>--dry-run</code>{" "}
    first to preview the install with no write.
  </p>
  <pre><code>npx lyrashield install cursor</code></pre>
  <div class="callout">
    <strong>No credential in committed files:</strong> After <code>npx lyrashield login --oauth</code>, the
    plugin's MCP server reads credentials from <code>~/.lyrashield/credentials.json</code> (or the
    <code>LYRASHIELD_API_KEY</code> environment variable). No key needs to be inlined in{" "}
    <code>.cursor/mcp.json</code> or any other file you might commit.
  </div>

  <h2>Verify the connection</h2>
  <p>
    Reload the window and open <strong>Settings → MCP</strong>. The <strong>lyrashield</strong>{" "}
    server should appear with a green status indicator. You can also ask Cursor's AI: <em
      >"List the available LyraShield tools."</em
    >
  </p>

  <div class="callout callout--warn">
    <strong>Requirements:</strong> Node.js 24+ and a LyraShield workspace OAuth login. The
    <code>@lyrashield/mcp</code> package is published on npm, so
    <code>npx -y @lyrashield/mcp</code> resolves directly.
  </div>
</DocsLayout>
