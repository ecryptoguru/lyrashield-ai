---
import AgentSnippet from "@components/AgentSnippet.astro"
import DocsLayout from "@layouts/DocsLayout.astro"

const origin = Astro.site?.origin || "http://localhost:4321"
const canonical = new URL("/docs/integrations/hermes", origin).toString()
const title = "LyraShield MCP for Hermes (Nous Research) — Setup Guide"
const description =
  "Connect LyraShield to Hermes by Nous Research. Configure the mcp_servers: block in your profile YAML for stdio transport. Hermes also supports ACP for editor integrations."
const updatedDate = "2026-07-31"

const jsonLd: unknown[] = [
  {
    "@context": "https://schema.org",
    "@type": "TechArticle",
    headline: title,
    description,
    url: canonical,
    dateModified: updatedDate,
    author: { "@id": `${origin}/#organization` },
    publisher: { "@id": `${origin}/#organization` },
    inLanguage: "en-US",
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${origin}/` },
      {
        "@type": "ListItem",
        position: 2,
        name: "Integrations",
        item: `${origin}/docs/integrations`,
      },
      { "@type": "ListItem", position: 3, name: "Hermes", item: canonical },
    ],
  },
]
---

<DocsLayout
  title={`${title} | LyraShield AI`}
  description={description}
  canonical={canonical}
  jsonLd={jsonLd}
  updatedDate={updatedDate}
  currentPath="/docs/integrations/hermes"
>
  <h1>Hermes (Nous Research)</h1>
  <p>
    Hermes by Nous Research reads MCP server configuration from a profile YAML file under the{" "}
    <code>mcp_servers:</code> key.
  </p>

  <h2>Get the exact values with the CLI</h2>
  <p>
    There's no config file LyraShield can safely write for Hermes yet. Run{" "}
    <code>npx lyrashield install hermes</code> anyway — it won't write anything, but it prints the
    exact command, arguments, and environment values below, generated from the current registry, so
    this page can't drift out of sync with what you actually need to paste in.
  </p>
  <pre><code>npx lyrashield install hermes</code></pre>

  <h2>Profile YAML configuration</h2>
  <p>Add the following to your Hermes profile YAML:</p>

  <AgentSnippet agentId="hermes" />

  <h2>ACP for editor integrations</h2>
  <p>
    When using Hermes with editor integrations via the Agent Communication Protocol (ACP), the MCP
    tools registered in your profile are available to the connected editor. Follow your editor's ACP
    setup instructions to connect Hermes, then the LyraShield tools will surface automatically.
  </p>

  <h2>Verify the connection</h2>
  <p>
    Start Hermes with your profile and list available tools. The LyraShield MCP tools should appear
    in the tool registry. Ask the agent: <em>"What LyraShield security tools do you have?"</em>
  </p>

  <div class="callout callout--warn">
    <strong>Requirements:</strong> Node.js 20+ and a LyraShield workspace API key. The
    <code>@lyrashield/mcp</code> package is published on npm, so
    <code>npx -y @lyrashield/mcp</code> resolves directly.
  </div>
</DocsLayout>
