---
import AgentSnippet from "@components/AgentSnippet.astro"
import DocsLayout from "@layouts/DocsLayout.astro"

const origin = Astro.site?.origin || "http://localhost:4321"
const canonical = new URL("/docs/integrations/hermes", origin).toString()
const title = "LyraShield MCP for Hermes (Nous Research) — Setup Guide"
const description =
  "Connect LyraShield to Hermes by Nous Research with native remote OAuth or local stdio MCP."
const updatedDate = "2026-09-09"

const jsonLd: unknown[] = [
  {
    "@context": "https://schema.org",
    "@type": "TechArticle",
    headline: title,
    description,
    url: canonical,
    dateModified: updatedDate,
    author: { "@id": `${origin}/#organization` },
    publisher: { "@id": `${origin}/#organization` },
    inLanguage: "en-US",
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${origin}/` },
      {
        "@type": "ListItem",
        position: 2,
        name: "Integrations",
        item: `${origin}/docs/integrations`,
      },
      { "@type": "ListItem", position: 3, name: "Hermes", item: canonical },
    ],
  },
]
---

<DocsLayout
  title={`${title} | LyraShield AI`}
  description={description}
  canonical={canonical}
  jsonLd={jsonLd}
  updatedDate={updatedDate}
  currentPath="/docs/integrations/hermes"
>
  <h1>Hermes (Nous Research)</h1>
  <p>
    Hermes by Nous Research reads MCP server configuration from <code>~/.hermes/config.yaml</code>
    {" "}under the <code>mcp_servers:</code> key.
  </p>

  <h2>Install with the CLI</h2>
  <p>
    Run <code>npx lyrashield install hermes</code> to merge the LyraShield entry into the documented
    user configuration file. Use <code>--dry-run</code> first if you want to inspect the change.
  </p>
  <pre><code>npx lyrashield install hermes</code></pre>

  <h2>Remote OAuth setup (recommended)</h2>
  <p>
    Add the remote configuration below to <code>~/.hermes/config.yaml</code>, then run{" "}
    <code>hermes mcp login lyrashield</code>. Hermes completes PKCE OAuth in your browser and stores
    the token outside the configuration file.
  </p>

  <AgentSnippet agentId="hermes" transport="remote-http" />

  <h2>Local stdio alternative</h2>
  <p>Use the local server when the remote OAuth flow is unavailable:</p>

  <AgentSnippet agentId="hermes" />

  <h2>ACP for editor integrations</h2>
  <p>
    When using Hermes with editor integrations via the Agent Communication Protocol (ACP), the MCP
    tools registered in your profile are available to the connected editor. Follow your editor's ACP
    setup instructions to connect Hermes, then the LyraShield tools will surface automatically.
  </p>

  <h2>Verify the connection</h2>
  <p>
    Run <code>hermes mcp test lyrashield</code> after saving, then start Hermes and list available
    tools. The LyraShield MCP tools should appear in the tool registry.
  </p>

  <div class="callout callout--warn">
    <strong>Local stdio requirements:</strong> Node.js 24+ and a LyraShield login or workspace API
    key. Keep keys in <code>~/.hermes/.env</code>; Hermes resolves the generated{" "}
    <code>{"${env:LYRASHIELD_API_KEY}"}</code> reference from its secret scope.
  </div>
</DocsLayout>
