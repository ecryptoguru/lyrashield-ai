---
import AgentSnippet from "@components/AgentSnippet.astro"
import DocsLayout from "@layouts/DocsLayout.astro"
import { buildDocsJsonLd } from "../../../lib/docs-metadata"

const origin = Astro.site?.origin || "http://localhost:4321"
const title = "LyraShield MCP for Kilo Code — Setup Guide"
const description =
  'Connect LyraShield to Kilo Code. Configure kilo.jsonc with the mcp key and type:"local". Uses the same single-brace {env:VAR} interpolation as OpenCode.'
const updatedDate = "2026-08-13"

const { canonical, techArticle, breadcrumbList } = buildDocsJsonLd({
  origin,
  path: "/docs/integrations/kilo-code",
  title,
  description,
  updatedDate,
  breadcrumbLabel: "Kilo Code",
})
const jsonLd: unknown[] = [techArticle, breadcrumbList]
---

<DocsLayout
  title={`${title} | LyraShield AI`}
  description={description}
  canonical={canonical}
  jsonLd={jsonLd}
  updatedDate={updatedDate}
  currentPath="/docs/integrations/kilo-code"
>
  <h1>Kilo Code</h1>
  <p>
    Kilo Code reads project MCP servers from <code>kilo.jsonc</code> (JSONC — JSON with comments).
    The root key is <code>mcp</code>. It also recognizes <code>.kilo/kilo.jsonc</code> when a team
    prefers the hidden project directory.
  </p>

  <h2>Install with the CLI (fastest)</h2>
  <p>
    Run <code>npx lyrashield install kilo-code</code> from your project root. It detects Kilo Code,
    writes the correct config automatically and never inlines your API key into a file you might
    commit. Add <code>--dry-run</code> first to preview the change with no write or run{" "}
    <code>npx lyrashield doctor</code> afterward to inspect local configuration, then make a read-only call in the client.
  </p>
  <pre><code>npx lyrashield install kilo-code</code></pre>
  <p>Prefer to see exactly what gets written or set it up without Node.js? Configure it by hand below.</p>

  <div class="callout callout--warn">
    <strong>Env interpolation:</strong> Like OpenCode, Kilo Code uses single-brace{" "}
    <code>{"{env:VAR}"}</code> for environment variable interpolation — not{" "}
    <code>{"${VAR}"}</code>.
  </div>

  <h2>Local stdio setup</h2>
  <AgentSnippet agentId="kilo-code" transport="stdio" />

  <h2>Remote endpoint</h2>
  <AgentSnippet agentId="kilo-code" transport="remote-http" secondary />

  <h2>Verify the connection</h2>
  <p>
    Reload the Kilo Code window and open the MCP servers panel. Confirm that the lyrashield server
    shows a connected status.
  </p>

  <div class="callout callout--warn">
    <strong>Requirements:</strong> For local stdio, Node.js 24+ and a local OAuth login or workspace API key. Remote OAuth needs no local key. The{" "}
    <code>@lyrashield/mcp</code> package is published on npm, so{" "}
    <code>npx -y @lyrashield/mcp@0.2.8</code> resolves directly.
  </div>
</DocsLayout>
