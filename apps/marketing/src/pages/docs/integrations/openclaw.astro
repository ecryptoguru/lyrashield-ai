---
import AgentSnippet from "@components/AgentSnippet.astro"
import DocsLayout from "@layouts/DocsLayout.astro"

const origin = Astro.site?.origin || "http://localhost:4321"
const canonical = new URL("/docs/integrations/openclaw", origin).toString()
const title = "LyraShield MCP for OpenClaw — Setup Guide"
const description =
  "Connect LyraShield to OpenClaw through its MCP registry or Control UI. Configure a local stdio or Streamable HTTP server, then probe it before enabling it for agent runs."
const updatedDate = "2026-08-13"

const jsonLd: unknown[] = [
  {
    "@context": "https://schema.org",
    "@type": "TechArticle",
    headline: title,
    description,
    url: canonical,
    dateModified: updatedDate,
    author: { "@id": `${origin}/#organization` },
    publisher: { "@id": `${origin}/#organization` },
    inLanguage: "en-US",
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${origin}/` },
      {
        "@type": "ListItem",
        position: 2,
        name: "Integrations",
        item: `${origin}/docs/integrations`,
      },
      { "@type": "ListItem", position: 3, name: "OpenClaw", item: canonical },
    ],
  },
]
---

<DocsLayout
  title={`${title} | LyraShield AI`}
  description={description}
  canonical={canonical}
  jsonLd={jsonLd}
  updatedDate={updatedDate}
  currentPath="/docs/integrations/openclaw"
>
  <h1>OpenClaw</h1>
  <p>
    OpenClaw manages client-side MCP servers through its MCP registry and Control UI. Do not use
    MCPorter configuration for OpenClaw-managed servers.
  </p>

  <h2>Get the exact values with the CLI</h2>
  <p>
    LyraShield prints the connection values, then OpenClaw stores them through its own MCP UI or
    CLI. Run <code>npx lyrashield install openclaw</code> to retrieve the local command values.
  </p>
  <pre><code>npx lyrashield install openclaw</code></pre>

  <h2>Add the server in OpenClaw</h2>
  <p>
    In the Control UI, open <strong>Settings → MCP</strong>, add a server, and enter the values
    below. Alternatively use <code>openclaw mcp add</code> for a local server or
    <code>openclaw mcp set</code> for a remote server.
  </p>

  <AgentSnippet agentId="openclaw" />

  <h2>Skill definition (optional)</h2>
  <p>
    Create a <code>skill.md</code> file in your OpenClaw skills directory to teach the agent when
    to invoke LyraShield automatically. For example:
  </p>

  <pre><code>{`# LyraShield Security Checks

Run LyraShield checks before submitting a pull request or after applying a fix.

## When to use
- Before creating a PR: run check_diff on the staged changes
- After applying a security fix: run verify_fix to confirm resolution
- When reviewing dependency updates: run supply chain checks

## How to invoke
Use the lyrashield MCP tools available in the tool registry.`}</code></pre>

  <h2>Verify the connection</h2>
  <p>
    Run <code>openclaw mcp doctor --probe</code> after saving. It checks the saved configuration,
    connects to the server, and lists the available tools.
  </p>

  <div class="callout callout--warn">
    <strong>Requirements:</strong> Node.js 20+ and a LyraShield workspace API key. The
    <code>@lyrashield/mcp</code> package is published on npm, so
    <code>npx -y @lyrashield/mcp</code> resolves directly.
  </div>
</DocsLayout>
