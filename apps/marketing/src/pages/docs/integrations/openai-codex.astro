---
import DocsLayout from "@layouts/DocsLayout.astro"

const origin = Astro.site?.origin || "http://localhost:4321"
const canonical = new URL("/docs/integrations/openai-codex", origin).toString()
const title = "LyraShield MCP for OpenAI Codex — Setup Guide"
const description =
  "Connect LyraShield to OpenAI Codex CLI. Add the MCP server entry to ~/.codex/config.toml using the [mcp_servers.lyrashield] TOML table with command, args, and env_vars."
const updatedDate = "2026-07-24"

const jsonLd: unknown[] = [
  {
    "@context": "https://schema.org",
    "@type": "TechArticle",
    headline: title,
    description,
    url: canonical,
    dateModified: updatedDate,
    author: { "@id": `${origin}/#organization` },
    publisher: { "@id": `${origin}/#organization` },
    inLanguage: "en-US",
  },
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    name: "Set up LyraShield MCP in OpenAI Codex",
    step: [
      {
        "@type": "HowToStep",
        position: 1,
        name: "Open ~/.codex/config.toml",
        text: "Open or create the file ~/.codex/config.toml in your home directory.",
      },
      {
        "@type": "HowToStep",
        position: 2,
        name: "Add the [mcp_servers.lyrashield] table",
        text: "Add a [mcp_servers.lyrashield] table with command, args, and env_vars fields.",
      },
      {
        "@type": "HowToStep",
        position: 3,
        name: "Set your API key in env_vars",
        text: "Set LYRASHIELD_API_KEY in the env_vars table within the mcp_servers.lyrashield block.",
      },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${origin}/` },
      {
        "@type": "ListItem",
        position: 2,
        name: "Integrations",
        item: `${origin}/docs/integrations`,
      },
      { "@type": "ListItem", position: 3, name: "OpenAI Codex", item: canonical },
    ],
  },
]
---

<DocsLayout
  title={`${title} | LyraShield AI`}
  description={description}
  canonical={canonical}
  jsonLd={jsonLd}
  updatedDate={updatedDate}
  currentPath="/docs/integrations/openai-codex"
>
  <h1>OpenAI Codex</h1>
  <p>
    OpenAI Codex CLI reads MCP server configuration from <code>~/.codex/config.toml</code>. The
    file uses TOML format with a <code>[mcp_servers.&lt;name&gt;]</code> table for each server.
  </p>

  <h2>Configuration</h2>
  <p>
    Open or create <code>~/.codex/config.toml</code> and add the following block. The{" "}
    <code>env_vars</code> key (not <code>env</code>) is the correct field name for environment
    variables in Codex TOML config.
  </p>

  <pre><code>{`[mcp_servers.lyrashield]
command = "npx"
args = ["-y", "@lyrashield/mcp"]

[mcp_servers.lyrashield.env_vars]
LYRASHIELD_API_KEY = "lsk_your_key_here"
LYRASHIELD_API_URL = "https://app.lyrashieldai.com"`}</code></pre>

  <div class="callout">
    <strong>env_vars vs. env:</strong> OpenAI Codex uses <code>env_vars</code> in its TOML config,
    not <code>env</code>. Using <code>env</code> will be silently ignored.
  </div>

  <h2>Verify the connection</h2>
  <p>
    Start the Codex CLI and list available tools. You should see the LyraShield server listed. Run a
    quick query: <em>"What tools does LyraShield provide?"</em> to confirm the server is active.
  </p>

  <div class="callout callout--warn">
    <strong>Requirements:</strong> Node.js 20+ and a LyraShield workspace API key. The
    <code>@lyrashield/mcp</code> package is published on npm, so
    <code>npx -y @lyrashield/mcp</code> resolves directly.
  </div>
</DocsLayout>
