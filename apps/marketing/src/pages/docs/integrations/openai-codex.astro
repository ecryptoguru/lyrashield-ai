---
import AgentSnippet from "@components/AgentSnippet.astro"
import DocsLayout from "@layouts/DocsLayout.astro"
import { buildDocsJsonLd } from "../../../lib/docs-metadata"

const origin = Astro.site?.origin || "http://localhost:4321"
const title = "LyraShield MCP for OpenAI Codex"
const description =
  "Connect LyraShield to OpenAI Codex CLI with the currently published pinned MCP server in ~/.codex/config.toml. Agent Plugin distribution remains pending."
const updatedDate = "2026-10-02"

const { canonical, techArticle, breadcrumbList } = buildDocsJsonLd({
  origin,
  path: "/docs/integrations/openai-codex",
  title,
  description,
  updatedDate,
  breadcrumbLabel: "OpenAI Codex",
})
const jsonLd: unknown[] = [
  techArticle,
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    name: "Set up LyraShield MCP in OpenAI Codex",
    step: [
      {
        "@type": "HowToStep",
        position: 1,
        name: "Authenticate local stdio",
        text: "Run npx -y lyrashield@0.2.13 login --oauth in the same OS account and select one workspace.",
      },
      {
        "@type": "HowToStep",
        position: 2,
        name: "Add the [mcp_servers.lyrashield] table",
        text: "Merge a [mcp_servers.lyrashield] table with command npx and args [\"-y\", \"@lyrashield/mcp@0.2.11\"], preserving existing entries.",
      },
      {
        "@type": "HowToStep",
        position: 3,
        name: "Confirm client discovery",
        text: "Restart Codex and inspect its available servers and tools to confirm the lyrashield server is discovered.",
      },
      {
        "@type": "HowToStep",
        position: 4,
        name: "Verify an authenticated read",
        text: "Call lyrashield_list_workspaces to verify authorized access to the intended workspace. Discovery alone does not prove authentication.",
      },
    ],
  },
  breadcrumbList,
]
---

<DocsLayout
  title={`${title} | LyraShield AI`}
  description={description}
  canonical={canonical}
  jsonLd={jsonLd}
  updatedDate={updatedDate}
  currentPath="/docs/integrations/openai-codex"
>
  <h1>OpenAI Codex</h1>
  <p>
    OpenAI Codex CLI reads MCP server configuration from <code>~/.codex/config.toml</code>. The
    file uses TOML format with a <code>[mcp_servers.&lt;name&gt;]</code> table for each server.
  </p>

  <h2>Agent Plugin release pending</h2>
  <p>
    The marketplace repository's default branch contains preparation artifacts. Do not install
    from that branch or substitute an older plugin without portable-schema validation. A reviewed
    matching immutable package release is required before plugin installation can be recommended.
    The published CLI 0.2.13 uses older marketplace behavior; use the direct MCP fallback below.
  </p>

  <h2>Authenticate local stdio</h2>
  <p>
    With Node.js 24 or newer, run the pinned login command in the same OS account that starts Codex
    and select the intended workspace. The stdio MCP server reads the local credential store;
    this login is separate from client discovery.
  </p>
  <pre><code>npx -y lyrashield@0.2.13 login --oauth</code></pre>

  <h2>Configuration</h2>
  <p>
    Open or create <code>~/.codex/config.toml</code> and merge the following block, preserving
    other servers. Published CLI config writes remain withheld pending the safe writer release. The{" "}
    <code>env</code> sub-table stores explicit values. The separate <code>env_vars</code> field accepts
    an array of names to inherit from Codex's parent process.
  </p>

  <AgentSnippet agentId="openai-codex" transport="stdio" />

  <div class="callout">
    <strong>env_vars vs. env:</strong> use <code>[mcp_servers.lyrashield.env]</code> for explicit
    values. Use <code>env_vars = ["NAME"]</code> only to inherit named variables.
  </div>

  <h2>Confirm client discovery</h2>
  <p>
    Restart Codex CLI and inspect its available servers and tools. Confirm the LyraShield server
    is discovered before making a service call.
  </p>

  <h2>Verify an authenticated read</h2>
  <p>
    Ask Codex to call <code>lyrashield_list_workspaces</code> and confirm the expected workspace.
    A listed server alone does not prove authentication; a successful read does not prove scan
    or write acceptance.
  </p>

  <div class="callout callout--warn">
    <strong>Requirements:</strong> Node.js 24+ and a LyraShield workspace OAuth login. The{" "}
    <code>@lyrashield/mcp</code> package is published on npm, so{" "}
    <code>npx -y @lyrashield/mcp@0.2.11</code> resolves directly.
  </div>
</DocsLayout>
