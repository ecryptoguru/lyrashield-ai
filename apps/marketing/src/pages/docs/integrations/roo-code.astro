---
import AgentSnippet from "@components/AgentSnippet.astro"
import DocsLayout from "@layouts/DocsLayout.astro"
import { buildDocsJsonLd } from "../../../lib/docs-metadata"

const origin = Astro.site?.origin || "http://localhost:4321"
const title = "LyraShield MCP for Roo Code — Setup Guide"
const description =
  "Connect LyraShield to Roo Code. Configure .roo/mcp.json with the mcpServers object for stdio or use type: streamable-http for the remote endpoint."
const updatedDate = "2026-09-09"

const { canonical, techArticle, breadcrumbList } = buildDocsJsonLd({
  origin,
  path: "/docs/integrations/roo-code",
  title,
  description,
  updatedDate,
  breadcrumbLabel: "Roo Code",
})
const jsonLd: unknown[] = [
  techArticle,
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    name: "Set up LyraShield MCP in Roo Code",
    step: [
      {
        "@type": "HowToStep",
        position: 1,
        name: "Open .roo/mcp.json",
        text: "Open or create .roo/mcp.json in your project root.",
      },
      {
        "@type": "HowToStep",
        position: 2,
        name: "Add the lyrashield entry",
        text: 'Add the mcpServers key with command "npx" and args ["-y","@lyrashield/mcp@0.2.8"] and set LYRASHIELD_API_KEY in the env block.',
      },
      {
        "@type": "HowToStep",
        position: 3,
        name: "Reload Roo Code",
        text: "Restart VS Code or reload the window to apply the new config.",
      },
    ],
  },
  breadcrumbList,
]
---

<DocsLayout
  title={`${title} | LyraShield AI`}
  description={description}
  canonical={canonical}
  jsonLd={jsonLd}
  updatedDate={updatedDate}
  currentPath="/docs/integrations/roo-code"
>
  <h1>Roo Code</h1>
  <p>
    Roo Code reads MCP servers from <code>.roo/mcp.json</code> (project-level). This file overrides
    the global <code>mcp_settings.json</code> in VS Code globalStorage. Entries may carry{" "}
    <code>alwaysAllow: string[]</code> and <code>disabled: boolean</code> fields.
  </p>

  <h2>Install with the CLI (fastest)</h2>
  <p>
    Run <code>npx lyrashield install roo-code</code> from your project root. It detects Roo Code,
    writes the correct config automatically and never inlines your API key into a file you might
    commit. Add <code>--dry-run</code> first to preview the change with no write or run{" "}
    <code>npx lyrashield doctor</code> afterward to inspect local configuration, then make a read-only call in the client.
  </p>
  <pre><code>npx lyrashield install roo-code</code></pre>
  <p>Prefer to see exactly what gets written or set it up without Node.js? Configure it by hand below.</p>

  <h2>Local stdio setup</h2>
  <p>
    Add the following to <code>.roo/mcp.json</code>. Create the file if it does not exist.
  </p>

  <AgentSnippet agentId="roo-code" transport="stdio" />

  <h2>Remote Streamable-HTTP setup</h2>
  <p>
    For environments where you prefer not to run a local process, connect to the remote endpoint.
  </p>

  <div class="callout callout--warn">
    <strong>Gotcha — use <code>type: "streamable-http"</code> exactly:</strong> Roo Code validates
    the literal string. <code>type: "http"</code> or <code>streamableHttp</code> fails. Use the
    hyphenated form.
  </div>

  <AgentSnippet agentId="roo-code" transport="remote-http" secondary />

  <div class="callout">
    <strong>Remote authorization:</strong> Browser-confirmed OAuth delegations run matching actions
    without repeated approval. Mutating calls authenticated with an API key receive a
    connect_required response pointing at OAuth connect and out-of-grant delegated calls are denied.
    Local stdio approval is separate from hosted delegation.
  </div>

  <h2>Verify the connection</h2>
  <p>
    Open the Roo Code panel in VS Code and check the MCP server status. Ask Roo: <em
      >"What LyraShield tools are available?"</em
    > to confirm the server is connected.
  </p>

  <div class="callout callout--warn">
    <strong>Requirements:</strong> For local stdio, Node.js 24+ and a local OAuth login or workspace API key. Remote OAuth needs no local key. The{" "}
    <code>@lyrashield/mcp</code> package is published on npm, so{" "}
    <code>npx -y @lyrashield/mcp@0.2.8</code> resolves directly.
  </div>
</DocsLayout>
