---
import AgentSnippet from "@components/AgentSnippet.astro"
import DocsLayout from "@layouts/DocsLayout.astro"

const origin = Astro.site?.origin || "http://localhost:4321"
const canonical = new URL("/docs/integrations/gemini-cli", origin).toString()
const title = "LyraShield MCP for Gemini CLI — Setup Guide"
const description =
  "Connect LyraShield to Gemini CLI (legacy). Two important gotchas: declare LYRASHIELD_API_KEY in the env block (Gemini CLI strips env vars containing KEY/TOKEN/SECRET from subprocesses) and avoid underscores in the server name. New setups should use Antigravity instead."
const updatedDate = "2026-08-07"

const jsonLd: unknown[] = [
  {
    "@context": "https://schema.org",
    "@type": "TechArticle",
    headline: title,
    description,
    url: canonical,
    dateModified: updatedDate,
    author: { "@id": `${origin}/#organization` },
    publisher: { "@id": `${origin}/#organization` },
    inLanguage: "en-US",
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${origin}/` },
      {
        "@type": "ListItem",
        position: 2,
        name: "Integrations",
        item: `${origin}/docs/integrations`,
      },
      { "@type": "ListItem", position: 3, name: "Gemini CLI", item: canonical },
    ],
  },
]
---

<DocsLayout
  title={`${title} | LyraShield AI`}
  description={description}
  canonical={canonical}
  jsonLd={jsonLd}
  updatedDate={updatedDate}
  currentPath="/docs/integrations/gemini-cli"
>
  <h1>Gemini CLI (legacy → Antigravity)</h1>
  <p>
    Gemini CLI reads MCP servers from <code>~/.gemini/settings.json</code> under the{" "}
    <code>mcpServers</code> key.
  </p>

  <div class="callout callout--warn">
    <strong>Gemini CLI is being transitioned to Antigravity.</strong> New setups should use the{" "}
    <a href="/docs/integrations/antigravity">Antigravity guide</a> instead — it uses the same{" "}
    <code>~/.gemini/</code> config directory, so existing LyraShield entries continue to work. This
    guide remains for legacy Gemini CLI users.
  </div>

  <h2>Install with the CLI (fastest)</h2>
  <p>
    Run <code>npx lyrashield install gemini-cli</code> from your project root. It detects Gemini
    CLI, writes the correct config automatically, and never inlines your API key into a file you
    might commit. Add <code>--dry-run</code> first to preview the change with no write, or run{" "}
    <code>npx lyrashield doctor</code> afterward to confirm it's configured correctly.
  </p>
  <pre><code>npx lyrashield install gemini-cli</code></pre>
  <p>Prefer to see exactly what gets written, or set it up without Node.js? Configure it by hand below.</p>

  <div class="callout callout--warn">
    <strong>Two critical gotchas for Gemini CLI:</strong>
    <ol>
      <li>
        <strong>Env var stripping:</strong> Gemini CLI strips environment variables whose names
        contain <code>KEY</code>, <code>TOKEN</code>, or <code>SECRET</code> from subprocess
        environments as a security measure. You <em>must</em> declare <code>LYRASHIELD_API_KEY</code>
        explicitly in the <code>env</code> block inside the server entry — inheriting it from the shell
        is not sufficient.
      </li>
      <li>
        <strong>No underscores in server name:</strong> Use a name without underscores (e.g.{" "}
        <code>lyrashield</code>, not <code>lyra_shield</code>) to avoid Gemini CLI parsing issues.
      </li>
    </ol>
  </div>

  <h2>Configuration</h2>
  <p>
    Open or create <code>~/.gemini/settings.json</code> and add the following. Note the{" "}
    <code>LYRASHIELD_API_KEY</code> is declared in the <code>env</code> block, not inherited from
    the environment.
  </p>

  <AgentSnippet agentId="gemini-cli" transport="stdio" />

  <h2>Verify the connection</h2>
  <p>
    Start Gemini CLI and run <code>gemini --list-tools</code> or ask: <em
      >"What LyraShield tools do you have?"</em
    > to confirm the server is connected.
  </p>

  <div class="callout callout--warn">
    <strong>Requirements:</strong> Node.js 20+ and a LyraShield workspace API key. The
    <code>@lyrashield/mcp</code> package is published on npm, so
    <code>npx -y @lyrashield/mcp</code> resolves directly.
  </div>
</DocsLayout>
