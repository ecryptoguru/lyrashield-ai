---
import DocsLayout from "@layouts/DocsLayout.astro"

const origin = Astro.site?.origin || "http://localhost:4321"
const canonical = new URL("/docs/integrations/aider", origin).toString()
const title = "LyraShield for Aider — Standalone CLI Guide"
const description = "Use LyraShield alongside Aider through the standalone CLI and CI. Aider does not currently document native MCP client support."
const updatedDate = "2026-09-08"
const jsonLd = [{
  "@context": "https://schema.org",
  "@type": "TechArticle",
  headline: title,
  description,
  url: canonical,
  dateModified: updatedDate,
  author: { "@id": `${origin}/#organization` },
  publisher: { "@id": `${origin}/#organization` },
  inLanguage: "en-US",
}]
---

<DocsLayout title={`${title} | LyraShield AI`} description={description} canonical={canonical} jsonLd={jsonLd} updatedDate={updatedDate} currentPath="/docs/integrations/aider">
  <h1>Aider</h1>
  <p>
    Aider's official configuration reference does not define an MCP client, an
    <code>mcp-servers</code> setting, or a <code>--mcp-servers</code> option. LyraShield therefore
    does not write MCP configuration for Aider.
  </p>
  <h2>Use the supported standalone workflow</h2>
  <pre><code>npx lyrashield login --oauth
npx lyrashield check-diff
npx lyrashield gate --verdict --commit "$(git rev-parse HEAD)"</code></pre>
  <p>
    Run the diff check during development and bind the release verdict to the commit being built.
    The same commands work in CI and keep Aider's own configuration untouched.
  </p>
  <div class="callout callout--warn">
    Third-party Aider MCP bridges are separate integrations. Review and test one independently before
    granting it repository or LyraShield access.
  </div>
  <p><a href="https://aider.chat/docs/config/aider_conf.html">Aider configuration reference</a></p>
</DocsLayout>
