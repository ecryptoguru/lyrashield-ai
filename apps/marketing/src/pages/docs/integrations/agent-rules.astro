---
import DocsLayout from "@layouts/DocsLayout.astro"
import { listRuleFormats, renderRule } from "@lyrashield/agent-rules"
import type { RuleFormat } from "@lyrashield/agent-rules"

const origin = Astro.site?.origin || "http://localhost:4321"
const canonical = new URL("/docs/integrations/agent-rules", origin).toString()
const title = "LyraShield Agent Rules — Generated rule files for every supported agent"
const description =
  "Generated agent rules, skill files, and plugin snippets for Claude Code, Cursor, Windsurf, VS Code Copilot, Cline, OpenClaw, and AGENTS.md agents. Each file is managed by the lyrashield rules command with checksumed blocks."
const updatedDate = "2026-07-31"

const agentIds: Record<RuleFormat, string> = {
  "claude-code": "claude-code",
  "agents-md": "openai-codex",
  cursor: "cursor",
  copilot: "vscode",
  windsurf: "windsurf",
  cline: "cline",
  openclaw: "openclaw",
}

const snippets = listRuleFormats().flatMap((info) =>
  info.defaultFiles.map((file) => {
    const rule = renderRule({
      format: info.format,
      file,
      agentId: agentIds[info.format],
      agentDisplayName: info.label,
    })
    return {
      format: info.format,
      label: info.label,
      file: rule.file,
      content: rule.content,
    }
  })
)

const jsonLd: unknown[] = [
  {
    "@context": "https://schema.org",
    "@type": "TechArticle",
    headline: title,
    description,
    url: canonical,
    dateModified: updatedDate,
    author: { "@id": `${origin}/#organization` },
    publisher: { "@id": `${origin}/#organization` },
    inLanguage: "en-US",
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${origin}/` },
      {
        "@type": "ListItem",
        position: 2,
        name: "Integrations",
        item: `${origin}/docs/integrations`,
      },
      { "@type": "ListItem", position: 3, name: "Agent Rules", item: canonical },
    ],
  },
]
---

<DocsLayout
  title={`${title} | LyraShield AI`}
  description={description}
  canonical={canonical}
  jsonLd={jsonLd}
  updatedDate={updatedDate}
  currentPath="/docs/integrations/agent-rules"
>
  <h1>Agent rules</h1>
  <p>
    The <code>lyrashield rules</code> command writes and manages these rule files for you. Each file
    is wrapped in a checksummed LyraShield block so the CLI can detect edits and the LyraShield
    scanner treats a valid block as protective. Run the command in your project root:
  </p>

  <pre><code>{`lyrashield rules add <agent>`}</code></pre>

  <p>
    Replace <code>&lt;agent&gt;</code> with an agent id from the <a href="/docs/integrations"
      >integrations index</a
    >. To remove a file, run <code>lyrashield rules remove &lt;agent&gt;</code>. To validate checksums,
    run <code>lyrashield rules check</code>.
  </p>

  <div class="callout">
    <strong>Prerequisite:</strong> The LyraShield MCP server must be configured before agent rules can
    invoke it. See the <a href="/docs/integrations">integrations overview</a> for setup instructions.
  </div>

  {
    snippets.map(({ label, file, content }) => (
      <section class="rule-snippet">
        <h2>
          {label} — <code>{file}</code>
        </h2>
        <pre>
          <code>{content}</code>
        </pre>
      </section>
    ))
  }

  <h2>Tips for effective agent rules</h2>
  <ul>
    <li>
      Keep the rules focused on <em>when</em> to run checks — the agent will use the MCP tool
      descriptions to understand <em>how</em>.
    </li>
    <li>
      Add an explicit scope constraint to prevent the agent from scanning targets it does not own.
    </li>
    <li>
      Include a note that a passing check is not a guarantee — this keeps expectations accurate and
      prevents over-reliance on automated results.
    </li>
    <li>
      For teams, commit the rules file to the repository so all developers share the same behavior.
    </li>
  </ul>

  <style>
    .rule-snippet {
      margin-top: 1.5rem;
    }
    .rule-snippet h2 {
      margin-bottom: 0.5rem;
      font-size: 1.1rem;
      font-weight: 600;
    }
  </style>
</DocsLayout>
