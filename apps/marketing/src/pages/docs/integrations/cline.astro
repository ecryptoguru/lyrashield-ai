---
import AgentSnippet from "@components/AgentSnippet.astro"
import DocsLayout from "@layouts/DocsLayout.astro"

const origin = Astro.site?.origin || "http://localhost:4321"
const canonical = new URL("/docs/integrations/cline", origin).toString()
const title = "LyraShield MCP for Cline — Setup Guide"
const description =
  'Connect LyraShield to Cline (VS Code extension). Configure cline_mcp_settings.json with the stdio server for local use, or use "type":"streamableHttp" for the remote endpoint.'
const updatedDate = "2026-07-31"

const jsonLd: unknown[] = [
  {
    "@context": "https://schema.org",
    "@type": "TechArticle",
    headline: title,
    description,
    url: canonical,
    dateModified: updatedDate,
    author: { "@id": `${origin}/#organization` },
    publisher: { "@id": `${origin}/#organization` },
    inLanguage: "en-US",
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${origin}/` },
      {
        "@type": "ListItem",
        position: 2,
        name: "Integrations",
        item: `${origin}/docs/integrations`,
      },
      { "@type": "ListItem", position: 3, name: "Cline", item: canonical },
    ],
  },
]
---

<DocsLayout
  title={`${title} | LyraShield AI`}
  description={description}
  canonical={canonical}
  jsonLd={jsonLd}
  updatedDate={updatedDate}
  currentPath="/docs/integrations/cline"
>
  <h1>Cline</h1>
  <p>
    Cline reads MCP servers from <code>cline_mcp_settings.json</code>, which you can edit directly
    in VS Code via the Cline MCP settings panel.
  </p>

  <h2>Get the exact values with the CLI</h2>
  <p>
    There's no config file LyraShield can safely write for Cline yet. Run{" "}
    <code>npx lyrashield install cline</code> anyway — it won't write anything, but it prints the
    exact command, arguments, and environment values below, generated from the current registry, so
    this page can't drift out of sync with what you actually need to paste in.
  </p>
  <pre><code>npx lyrashield install cline</code></pre>

  <h2>Local stdio setup</h2>
  <AgentSnippet agentId="cline" transport="stdio" />

  <h2>Remote Streamable-HTTP setup</h2>
  <p>
    For environments where you prefer not to run a local process, connect to the remote endpoint.
  </p>

  <div class="callout callout--warn">
    <strong>Gotcha — set type explicitly:</strong> Cline defaults to legacy SSE transport when{" "}
    <code>type</code> is omitted. For the LyraShield remote endpoint you must set{" "}
    <code>"type": "streamableHttp"</code> explicitly.
  </div>

  <AgentSnippet agentId="cline" transport="remote-http" secondary />

  <h2>Verify the connection</h2>
  <p>
    Open the Cline panel in VS Code and check the MCP server status. Ask Cline: <em
      >"What LyraShield tools are available?"</em
    > to confirm the server is connected.
  </p>

  <div class="callout callout--warn">
    <strong>Requirements:</strong> Node.js 24+ and a LyraShield workspace API key. The
    <code>@lyrashield/mcp</code> package is published on npm, so
    <code>npx -y @lyrashield/mcp</code> resolves directly.
  </div>
</DocsLayout>
