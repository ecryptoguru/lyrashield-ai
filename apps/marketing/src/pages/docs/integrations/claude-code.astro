---
import AgentSnippet from "@components/AgentSnippet.astro"
import DocsLayout from "@layouts/DocsLayout.astro"
import { buildDocsJsonLd } from "../../../lib/docs-metadata"

const origin = Astro.site?.origin || "http://localhost:4321"
const title = "LyraShield MCP for Claude Code — Setup Guide"
const description =
  "Add the LyraShield MCP server to Claude Code in under two minutes. Configure .mcp.json or use claude mcp add to run checks inline while you build."
const updatedDate = "2026-10-02"

const { canonical, techArticle, breadcrumbList } = buildDocsJsonLd({
  origin,
  path: "/docs/integrations/claude-code",
  title,
  description,
  updatedDate,
  breadcrumbLabel: "Claude Code",
})
const jsonLd: unknown[] = [
  techArticle,
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    name: "Set up LyraShield MCP in Claude Code",
    step: [
      {
        "@type": "HowToStep",
        position: 1,
        name: "Create or open .mcp.json",
        text: "In your project root, create or open the file .mcp.json.",
      },
      {
        "@type": "HowToStep",
        position: 2,
        name: "Add the mcpServers entry",
        text: 'Add an mcpServers key with the lyrashield entry using command "npx" and args ["-y","@lyrashield/mcp@0.2.12"].',
      },
      {
        "@type": "HowToStep",
        position: 3,
        name: "Log in locally",
        text: "Run npx -y lyrashield@0.2.14 login --oauth so the local MCP server can read the selected workspace credential.",
      },
      {
        "@type": "HowToStep",
        position: 4,
        name: "Reload Claude Code",
        text: "Reload the window or restart Claude Code. The lyrashield MCP server should appear in the MCP servers list.",
      },
    ],
  },
  breadcrumbList,
]
---

<DocsLayout
  title={`${title} | LyraShield AI`}
  description={description}
  canonical={canonical}
  jsonLd={jsonLd}
  updatedDate={updatedDate}
  currentPath="/docs/integrations/claude-code"
>
  <h1>Claude Code</h1>
  <p>
    Claude Code reads MCP servers from a <code>.mcp.json</code> file in your project root or you
    can register a server with the <code>claude mcp add</code> CLI command.
  </p>

  <h2>Current guided setup</h2>
  <p>
    Use the pinned direct-MCP configuration below while the matching native plugin listing awaits
    review and public readback. This Claude setup follows the plugin route, so the CLI does not
    provide a direct-MCP config-writing command for it; merge the entry manually and preserve your
    other settings. The client guide keeps plugin distribution, client discovery, authentication
    and runtime acceptance as separate checks.
  </p>

  <h2>Option A — .mcp.json (recommended for teams)</h2>
  <p>
    Create or open <code>.mcp.json</code> in your project root and add the following. Commit the
    file to share the configuration with your team; each developer runs the OAuth login locally.
  </p>

  <AgentSnippet agentId="claude-code" transport="stdio" />

  <div class="callout">
    <strong>OAuth first:</strong> Run <code>npx -y lyrashield@0.2.14 login --oauth</code> to select one
    workspace. API keys are the CI or non-OAuth-client fallback. A browser-confirmed remote OAuth
    delegation can run matching actions without repeated LyraShield approval.
  </div>

  <h2>Option B — Claude CLI</h2>
  <p>
    Run the documented stdio form in a terminal. The project scope creates a shareable MCP entry;
    each developer keeps their LyraShield credential in the local credential store.
  </p>

  <pre><code>{`claude mcp add --scope project --transport stdio lyrashield \\
  -- npx -y @lyrashield/mcp@0.2.12`}</code></pre>

  <h2>Public Agent Plugin listing pending</h2>
  <p>
    The portable Agent Plugin package <code>@lyrashield/agent-plugin@0.1.31</code> is published; this
    client's public listing and authenticated runtime acceptance are still pending. Use direct MCP
    until those checks pass. Do not install from the marketplace's mutable preparation branch.
    Publication, plugin discovery, OAuth authentication and an authenticated read-only call are
    separate gates.
  </p>

  <h2>Verify the connection</h2>
  <p>
    After reloading Claude Code, open the MCP servers panel. You should see <strong
      >lyrashield</strong
    > listed as connected. Ask Claude: <em>"What LyraShield tools are available?"</em> to confirm
    the tools surface correctly.
  </p>

  <h2>Agent rules</h2>
  <p>
    Add a <code>CLAUDE.md</code> snippet to teach Claude when to run LyraShield checks automatically.
    See the <a href="/docs/integrations/agent-rules">Agent Rules Snippets</a> page for ready-to-paste
    instructions.
  </p>

  <div class="callout callout--warn">
    <strong>Requirements:</strong> For local stdio, Node.js 24+ and a local OAuth login or workspace API key. Remote OAuth needs no local key. The{" "}
    <code>@lyrashield/mcp</code> package is published on npm, so{" "}
    <code>npx -y @lyrashield/mcp@0.2.12</code> resolves directly.
  </div>
</DocsLayout>
