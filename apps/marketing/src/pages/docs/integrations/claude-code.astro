---
import AgentSnippet from "@components/AgentSnippet.astro"
import DocsLayout from "@layouts/DocsLayout.astro"

const origin = Astro.site?.origin || "http://localhost:4321"
const canonical = new URL("/docs/integrations/claude-code", origin).toString()
const title = "LyraShield MCP for Claude Code — Setup Guide"
const description =
  "Add the LyraShield MCP server to Claude Code in under two minutes. Configure .mcp.json or use the claude mcp add command to run security checks inline while you build."
const updatedDate = "2026-08-12"

const jsonLd: unknown[] = [
  {
    "@context": "https://schema.org",
    "@type": "TechArticle",
    headline: title,
    description,
    url: canonical,
    dateModified: updatedDate,
    author: { "@id": `${origin}/#organization` },
    publisher: { "@id": `${origin}/#organization` },
    inLanguage: "en-US",
  },
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    name: "Set up LyraShield MCP in Claude Code",
    step: [
      {
        "@type": "HowToStep",
        position: 1,
        name: "Create or open .mcp.json",
        text: "In your project root, create or open the file .mcp.json.",
      },
      {
        "@type": "HowToStep",
        position: 2,
        name: "Add the mcpServers entry",
        text: 'Add an mcpServers key with the lyrashield entry using command "npx" and args ["-y","@lyrashield/mcp"].',
      },
      {
        "@type": "HowToStep",
        position: 3,
        name: "Set your API key",
        text: "Add LYRASHIELD_API_KEY to the env block inside the server entry.",
      },
      {
        "@type": "HowToStep",
        position: 4,
        name: "Reload Claude Code",
        text: "Reload the window or restart Claude Code. The lyrashield MCP server should appear in the MCP servers list.",
      },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${origin}/` },
      {
        "@type": "ListItem",
        position: 2,
        name: "Integrations",
        item: `${origin}/docs/integrations`,
      },
      { "@type": "ListItem", position: 3, name: "Claude Code", item: canonical },
    ],
  },
]
---

<DocsLayout
  title={`${title} | LyraShield AI`}
  description={description}
  canonical={canonical}
  jsonLd={jsonLd}
  updatedDate={updatedDate}
  currentPath="/docs/integrations/claude-code"
>
  <h1>Claude Code</h1>
  <p>
    Claude Code reads MCP servers from a <code>.mcp.json</code> file in your project root, or you
    can register a server with the <code>claude mcp add</code> CLI command.
  </p>

  <h2>Install with the CLI (fastest)</h2>
  <p>
    Run <code>npx lyrashield install claude-code</code> from your project root. It detects Claude
    Code, installs the generated Agent Plugin by default, and never copies an OAuth bearer into a
    file you might commit. Add <code>--dry-run</code> first to preview the change with no write, or run{" "}
    <code>npx lyrashield doctor</code> afterward to confirm it's configured correctly.
  </p>
  <pre><code>npx lyrashield install claude-code</code></pre>
  <p>
    Prefer to see exactly what gets written, or set it up without Node.js? Configure it by hand
    below. Running <code>npx lyrashield install claude-code</code> writes Option A (
    <code>.mcp.json</code>) for you; Option B below remains available if you prefer Claude Code's
    own command.
  </p>

  <h2>Option A — .mcp.json (recommended for teams)</h2>
  <p>
    Create or open <code>.mcp.json</code> in your project root and add the following. Commit the
    file to share the configuration with your team; each developer runs the OAuth login locally.
  </p>

  <AgentSnippet agentId="claude-code" transport="stdio" />

  <div class="callout">
    <strong>OAuth first:</strong> Run <code>npx lyrashield login --oauth</code> to select one
    workspace. API keys are the CI or non-OAuth-client fallback: create a read-only key for
    inspection or an explicit write key for mutating actions, which still require approval.
  </div>

  <h2>Option B — Claude CLI with an API-key fallback</h2>
  <p>
    Run the following command in a terminal. Claude Code stores this globally and it applies across
    all projects for the current user.
  </p>

  <pre><code>{`claude mcp add lyrashield \\
  --command npx \\
  --args "-y,@lyrashield/mcp" \\
  --env LYRASHIELD_API_KEY=lsk_your_key_here \\
  --env LYRASHIELD_API_URL=https://app.lyrashieldai.com`}</code></pre>

  <h2>Option C — Agent Plugin (recommended)</h2>
  <p>
    Claude Code supports the open Agent Plugins v1.0.0 standard (agent-plugins.org), and LyraShield
    ships a portable plugin that bundles the MCP server and a security skill into a single
    installable package. The skill teaches Claude when to run LyraShield checks, so you get both the
    tools and the guidance in one step.
  </p>
  <p>
    <code>npx lyrashield install claude-code</code> now installs the plugin by default — this is the
    preferred path over Option A and Option B above. Add <code>--dry-run</code> first to preview the
    install with no write.
  </p>
  <pre><code>npx lyrashield install claude-code</code></pre>
  <div class="callout">
    <strong>No credential in committed files:</strong> After <code>npx lyrashield login --oauth</code>, the
    plugin's MCP server reads credentials from <code>~/.lyrashield/credentials.json</code> (or the
    <code>LYRASHIELD_API_KEY</code> environment variable). No key needs to be inlined in{" "}
    <code>.mcp.json</code> or any other file you might commit.
  </div>

  <h2>Verify the connection</h2>
  <p>
    After reloading Claude Code, open the MCP servers panel. You should see <strong
      >lyrashield</strong
    > listed as connected. Ask Claude: <em>"What LyraShield tools are available?"</em> to confirm
    the tools surface correctly.
  </p>

  <h2>Agent rules</h2>
  <p>
    Add a <code>CLAUDE.md</code> snippet to teach Claude when to run LyraShield checks automatically.
    See the <a href="/docs/integrations/agent-rules">Agent Rules Snippets</a> page for ready-to-paste
    instructions.
  </p>

  <div class="callout callout--warn">
    <strong>Requirements:</strong> Node.js 20+ and a LyraShield workspace API key. The
    <code>@lyrashield/mcp</code> package is published on npm, so
    <code>npx -y @lyrashield/mcp</code> resolves directly.
  </div>
</DocsLayout>
