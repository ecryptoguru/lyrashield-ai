---
import DocsLayout from "@layouts/DocsLayout.astro"

const origin = Astro.site?.origin || "http://localhost:4321"
const canonical = new URL("/docs/integrations/picode", origin).toString()
const title = "LyraShield for Pi — Standalone CLI Guide"
const description = "Use LyraShield alongside Pi through the standalone CLI and CI. Pi core does not document native MCP client support."
const updatedDate = "2026-09-08"
const jsonLd = [{
  "@context": "https://schema.org",
  "@type": "TechArticle",
  headline: title,
  description,
  url: canonical,
  dateModified: updatedDate,
  author: { "@id": `${origin}/#organization` },
  publisher: { "@id": `${origin}/#organization` },
  inLanguage: "en-US",
}]
---

<DocsLayout title={`${title} | LyraShield AI`} description={description} canonical={canonical} jsonLd={jsonLd} updatedDate={updatedDate} currentPath="/docs/integrations/picode">
  <h1>Pi</h1>
  <p>
    Pi's official documentation describes packages, extensions, and skills, but does not define a
    native MCP client configuration. LyraShield does not create <code>.mcp.json</code> or{" "}
    <code>.pi/mcp.json</code> for Pi core.
  </p>
  <h2>Use the supported standalone workflow</h2>
  <pre><code>npx lyrashield login --oauth
npx lyrashield check-diff
npx lyrashield gate --verdict --commit "$(git rev-parse HEAD)"</code></pre>
  <p>
    If you adopt a third-party Pi MCP extension, review its code and configuration contract first;
    its behavior is not evidence of native Pi support. Oh My Pi is a separate client with its own
    documented MCP configuration.
  </p>
  <p><a href="https://pi.dev/docs/latest">Pi official documentation</a></p>
</DocsLayout>
