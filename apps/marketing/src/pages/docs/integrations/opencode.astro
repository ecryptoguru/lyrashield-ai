---
import AgentSnippet from "@components/AgentSnippet.astro"
import DocsLayout from "@layouts/DocsLayout.astro"
import CliConfigPreview from "@components/integrations/CliConfigPreview.astro"
import { buildDocsJsonLd } from "../../../lib/docs-metadata"

const origin = Astro.site?.origin || "http://localhost:4321"
const title = "LyraShield MCP for OpenCode — Setup Guide"
const description =
  'Connect LyraShield to OpenCode with native remote OAuth or local stdio MCP under the top-level "mcp" key.'
const updatedDate = "2026-10-02"

const { canonical, techArticle, breadcrumbList } = buildDocsJsonLd({
  origin,
  path: "/docs/integrations/opencode",
  title,
  description,
  updatedDate,
  breadcrumbLabel: "OpenCode",
})
const jsonLd: unknown[] = [techArticle, breadcrumbList]
---

<DocsLayout
  title={`${title} | LyraShield AI`}
  description={description}
  canonical={canonical}
  jsonLd={jsonLd}
  updatedDate={updatedDate}
  currentPath="/docs/integrations/opencode"
>
  <h1>OpenCode</h1>
  <p>
    OpenCode reads MCP servers from <code>opencode.json</code> in your project root. The root key
    is <code>mcp</code> (not <code>mcpServers</code>). Local entries use a command array and{" "}
    <code>environment</code>; remote entries use <code>type: "remote"</code>.
  </p>

  <CliConfigPreview agentId="opencode" />
  <p>Prefer to see exactly what gets written or set it up without Node.js? Configure it by hand below.</p>

  <div class="callout callout--warn">
    <strong>Env interpolation gotcha:</strong> OpenCode uses single-brace syntax{" "}
    <code>{"{env:VAR}"}</code> for environment variable interpolation — not{" "}
    <code>{"${VAR}"}</code>. Using the wrong syntax will result in the literal string being passed
    instead of the variable value.
  </div>

  <div class="callout">
    <strong>Version binding:</strong> OpenCode's current documentation uses a top-level <code>mcp</code>
    {" "}object and per-server <code>enabled</code> flag. Record the client version with runtime evidence
    and revalidate this schema after upgrades.
  </div>

  <h2>Remote OAuth setup (recommended)</h2>
  <AgentSnippet agentId="opencode" transport="remote-http" />

  <p>
    Run <code>opencode mcp auth lyrashield</code> to complete OAuth. OpenCode stores tokens outside
    the project configuration and refreshes them for later sessions.
  </p>

  <h2>Local stdio alternative</h2>
  <AgentSnippet agentId="opencode" transport="stdio" />

  <p>
    Export <code>LYRASHIELD_API_KEY</code> in your shell or add it to a <code>.env</code> file that
    OpenCode loads.
  </p>

  <h2>Verify the connection</h2>
  <p>
    Start OpenCode and confirm the lyrashield server appears in the MCP server list. Ask the
    assistant to list available tools to verify the connection is live.
  </p>

  <div class="callout callout--warn">
    <strong>Local stdio requirements:</strong> For local stdio, Node.js 24+ and a local OAuth login or workspace API key. Remote OAuth needs no local key. The{" "}
    <code>@lyrashield/mcp</code> package is published on npm, so{" "}
    <code>npx -y @lyrashield/mcp@0.2.12</code> resolves directly.
  </div>
</DocsLayout>
