---
import AgentSnippet from "@components/AgentSnippet.astro"
import DocsLayout from "@layouts/DocsLayout.astro"

const origin = Astro.site?.origin || "http://localhost:4321"
const canonical = new URL("/docs/integrations/windsurf", origin).toString()
const title = "LyraShield MCP for Windsurf — Setup Guide"
const description =
  "Connect LyraShield to Windsurf (Codeium). Install the Agent Plugin for one-step setup, or configure the global mcp_config.json for stdio or the remote Streamable-HTTP endpoint."
const updatedDate = "2026-08-07"

const jsonLd: unknown[] = [
  {
    "@context": "https://schema.org",
    "@type": "TechArticle",
    headline: title,
    description,
    url: canonical,
    dateModified: updatedDate,
    author: { "@id": `${origin}/#organization` },
    publisher: { "@id": `${origin}/#organization` },
    inLanguage: "en-US",
  },
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    name: "Set up LyraShield MCP in Windsurf",
    step: [
      {
        "@type": "HowToStep",
        position: 1,
        name: "Open the global MCP config",
        text: "Open or create ~/.codeium/windsurf/mcp_config.json.",
      },
      {
        "@type": "HowToStep",
        position: 2,
        name: "Add the lyrashield entry",
        text: 'Add the mcpServers key with command "npx" and args ["-y","@lyrashield/mcp"], and set LYRASHIELD_API_KEY in the env block.',
      },
      {
        "@type": "HowToStep",
        position: 3,
        name: "Reload Windsurf",
        text: "Restart Windsurf or reload the window to apply the new config.",
      },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${origin}/` },
      {
        "@type": "ListItem",
        position: 2,
        name: "Integrations",
        item: `${origin}/docs/integrations`,
      },
      { "@type": "ListItem", position: 3, name: "Windsurf", item: canonical },
    ],
  },
]
---

<DocsLayout
  title={`${title} | LyraShield AI`}
  description={description}
  canonical={canonical}
  jsonLd={jsonLd}
  updatedDate={updatedDate}
  currentPath="/docs/integrations/windsurf"
>
  <h1>Windsurf</h1>
  <p>
    Windsurf (by Codeium) stores MCP configuration in a global file at{" "}
    <code>~/.codeium/windsurf/mcp_config.json</code>. The file applies to all projects.
  </p>

  <h2>Install with the CLI (fastest)</h2>
  <p>
    Run <code>npx lyrashield install windsurf</code> from your project root. It detects Windsurf,
    installs the Agent Plugin by default, and never inlines your API key into a file you might
    commit. Add <code>--dry-run</code> first to preview the change with no write, or run{" "}
    <code>npx lyrashield doctor</code> afterward to confirm it's configured correctly.
  </p>
  <pre><code>npx lyrashield install windsurf</code></pre>
  <p>Prefer to see exactly what gets written, or set it up without Node.js? Configure it by hand below.</p>

  <h2>Agent Plugin (recommended)</h2>
  <p>
    Windsurf supports the open Agent Plugins v1.0.0 standard (agent-plugins.org), and LyraShield
    ships a portable plugin that bundles the MCP server and a security skill into a single
    installable package. The skill teaches Windsurf when to run LyraShield checks, so you get both
    the tools and the guidance in one step.
  </p>
  <p>
    <code>npx lyrashield install windsurf</code> now installs the plugin by default. Run{" "}
    <code>npx lyrashield login</code> first so the MCP server can read credentials without inlining
    a key in any config file.
  </p>
  <pre><code>npx lyrashield login
npx lyrashield install windsurf</code></pre>
  <div class="callout">
    <strong>No API key in committed files:</strong> After <code>npx lyrashield login</code>, the
    plugin's MCP server reads credentials from <code>~/.lyrashield/credentials.json</code> (or the
    <code>LYRASHIELD_API_KEY</code> environment variable). Nothing with a key needs to be committed.
  </div>

  <h2>Local stdio setup</h2>
  <p>
    Add the following to <code>~/.codeium/windsurf/mcp_config.json</code>. Create the file if it
    does not exist.
  </p>

  <AgentSnippet agentId="windsurf" transport="stdio" />

  <h2>Remote endpoint (Windsurf cloud / hosted)</h2>
  <p>
    For Windsurf cloud environments that cannot run local processes, use <code>serverUrl</code>{" "}
    instead of <code>command</code> + <code>args</code> to connect to the remote Streamable-HTTP
    endpoint.
  </p>

  <AgentSnippet agentId="windsurf" transport="remote-http" />

  <div class="callout">
    <strong>Read-only vs. read-and-write:</strong> Remote mutating tools (scan triggers, finding
    submissions, report creation) require a read-and-write API key and a human out-of-band
    approval. Read-only inspection tools work with any key.
  </div>

  <h2>Verify the connection</h2>
  <p>
    Restart Windsurf and open <strong>Settings → MCP Servers</strong>. The lyrashield entry should
    appear as active. Run a quick check by asking Cascade: <em
      >"What LyraShield tools do you have access to?"</em
    >
  </p>

  <div class="callout callout--warn">
    <strong>Requirements:</strong> Node.js 20+ and a LyraShield workspace API key. The
    <code>@lyrashield/mcp</code> package is published on npm, so
    <code>npx -y @lyrashield/mcp</code> resolves directly.
  </div>
</DocsLayout>
