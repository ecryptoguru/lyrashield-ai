---
import DocsLayout from "@layouts/DocsLayout.astro"
import { listAgents } from "@lyrashield/agent-registry"
import type { AgentEntry } from "@lyrashield/agent-registry"

const origin = Astro.site?.origin || "http://localhost:4321"
const canonical = new URL("/docs/integrations", origin).toString()
const title = "Connect LyraShield to AI Coding Tools | Integrations"
const description =
  "Connect LyraShield AI to Claude Code, Cursor, Windsurf, VS Code, GitHub Actions, and more. Step-by-step MCP server setup, REST API keys, and agent rules for every AI coding environment."

const updatedDate = "2026-08-07"

const agents = listAgents()

function agentSubtitle(agent: AgentEntry): string {
  if (agent.installStrategy === "config-file") {
    const loc =
      agent.locations.find((location) => location.sharedByConvention) ??
      agent.locations[0]
    return loc?.path ?? "Config file"
  }
  if (agent.installStrategy === "vendor-cli") {
    return `${agent.vendorCli?.command} ${agent.vendorCli?.args?.join(" ")}`.trim()
  }
  return "Manual setup"
}

const faqItems = [
  {
    q: "What is the LyraShield MCP server?",
    a: "LyraShield ships a Model Context Protocol (MCP) server that exposes security-check tools to AI coding assistants. You can run it locally via npx (stdio transport) or connect to the hosted remote endpoint for cloud editors that cannot run local processes.",
  },
  {
    q: "Do I need an API key to use the MCP server?",
    a: "No for marketplace clients: use the hosted OAuth connection and select one workspace. API keys remain available for CLI, CI, and agents without OAuth; set LYRASHIELD_API_KEY to a workspace key created under Settings → API keys.",
  },
  {
    q: "Which editors use the remote MCP endpoint instead of the local stdio server?",
    a: "Cloud-hosted editors that cannot run local processes — such as Lovable, Bolt.new, Replit, and v0 — use protected-resource discovery at https://app.lyrashieldai.com/api/mcp. OAuth is read-only by default; explicit write scope and LyraShield approval are required for mutating tools.",
  },
  {
    q: "Is the @lyrashield/mcp package available on npm now?",
    a: "Yes — @lyrashield/mcp is published on npm. Run npx -y @lyrashield/mcp (Node.js 20+) with your LYRASHIELD_API_KEY set, or add it to your editor's MCP config as shown in each guide.",
  },
  {
    q: "Can I use LyraShield in a CI pipeline without an AI editor?",
    a: "Yes. The GitHub Action integration runs LyraShield checks directly in your workflow without any AI assistant. It is the recommended path for cloud-only editors and for teams that want automated checks on every pull request.",
  },
  {
    q: "How does CLI login work without pasting a secret?",
    a: "Run lyrashield login --oauth. The CLI opens the LyraShield device-authorization page, lets you choose one workspace, and stores the short-lived bearer locally. API-key login remains available for CI and non-interactive environments.",
  },
  {
    q: "Is there a CLI, or do I have to hand-edit config files?",
    a: "There's a CLI. lyrashield (also published as the scoped alias @lyrashield/cli) is on npm — run npx lyrashield init to detect installed agents and configure them in one command, or npx lyrashield doctor to check what's already set up. It writes the same config shown in each agent's guide below, so the guides double as a reference for what the CLI does under the hood.",
  },
  {
    q: "What is the Agent Plugin?",
    a: "The Agent Plugin is a portable plugin following the open Agent Plugins v1.0.0 standard (agent-plugins.org). It bundles LyraShield's MCP server and a security skill into a single installable package, so a supported agent can load both the tools and the guidance for when to run them in one step. npx lyrashield init now prefers the plugin install for the launch clients (Claude Code, Cursor, Windsurf, VS Code, Codex, Kiro) and falls back to config-file edits for agents that do not support the standard yet.",
  },
]

const jsonLd: unknown[] = [
  {
    "@context": "https://schema.org",
    "@type": "TechArticle",
    headline: "Connect LyraShield to AI Coding Tools",
    description,
    url: canonical,
    dateModified: updatedDate,
    author: { "@id": `${origin}/#organization` },
    publisher: { "@id": `${origin}/#organization` },
    inLanguage: "en-US",
    isPartOf: { "@id": `${origin}/docs/integrations` },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${origin}/` },
      { "@type": "ListItem", position: 2, name: "Docs", item: `${origin}/docs/integrations` },
      {
        "@type": "ListItem",
        position: 3,
        name: "Integrations",
        item: canonical,
      },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqItems.map((item) => ({
      "@type": "Question",
      name: item.q,
      acceptedAnswer: { "@type": "Answer", text: item.a },
    })),
  },
]
---

<DocsLayout
  title={`${title} | LyraShield AI`}
  description={description}
  canonical={canonical}
  jsonLd={jsonLd}
  updatedDate={updatedDate}
  currentPath="/docs/integrations"
>
  <h1>Integrations</h1>
  <p>
    Connect LyraShield to your AI coding environment to run security checks inline while you build.
    Choose the setup that matches your editor or workflow.
  </p>

  <h2>Fastest path: the CLI</h2>
  <p>
    Run <code>npx lyrashield init</code> from your project root. It detects which of the agents below
    are installed and configures each one automatically — no per-agent config-file editing required
    for most of them. <code>npx lyrashield doctor</code> reports what's configured at any time.
  </p>
  <pre><code>npx lyrashield init</code></pre>
  <p>
    <code>lyrashield</code> is published on npm (also as the scoped alias <code>@lyrashield/cli</code
    >). It writes files directly for {agents.filter((a) => a.installStrategy === "config-file").length} of the {agents.filter((a) => a.installStrategy !== "agent-plugin").length} agents below, shells out to the vendor's own CLI for
    {agents.filter((a) => a.installStrategy === "vendor-cli").length}, and prints exact copy-paste values for the remaining {agents.filter((a) => a.installStrategy === "guided-manual").length} whose tooling has no config file to
    safely write. Every per-agent guide below still documents the manual path — useful to see exactly
    what gets written, or if you'd rather not use Node.js.
  </p>

  <h2>Agent Plugin (Agent Plugins v1.0.0)</h2>
  <p>
    LyraShield ships a portable plugin that follows the open Agent Plugins v1.0.0 standard
    (agent-plugins.org). The plugin bundles the LyraShield MCP server and a security skill that
    teaches the agent when to run LyraShield checks, so a supported client gets both the tools and
    the guidance in a single install — no hand-edited config required.
  </p>
  <p>
    <code>npx lyrashield init</code> now prefers the plugin install for the six launch clients:
    Claude Code, Cursor, Windsurf, VS Code, Codex, and Kiro. For agents that do not support the
    standard yet, the CLI falls back to writing the config-file edits documented in each guide below.
  </p>
  <div class="callout">
    <strong>No API key in committed files:</strong> After <code>npx lyrashield login</code>, the
    plugin's MCP server reads credentials from <code>~/.lyrashield/credentials.json</code> (or the
    <code>LYRASHIELD_API_KEY</code> environment variable). Nothing with a key needs to be committed.
  </div>
  <div class="nav-cards">
    <a href="/docs/integrations/claude-code" class="nav-card">
      <span class="nav-card__label">Claude Code</span>
      <span class="nav-card__sub">Agent Plugin install</span>
    </a>
    <a href="/docs/integrations/cursor" class="nav-card">
      <span class="nav-card__label">Cursor</span>
      <span class="nav-card__sub">Agent Plugin install</span>
    </a>
    <a href="/docs/integrations/vscode" class="nav-card">
      <span class="nav-card__label">VS Code</span>
      <span class="nav-card__sub">Agent Plugin install</span>
    </a>
    <a href="/docs/integrations/windsurf" class="nav-card">
      <span class="nav-card__label">Windsurf</span>
      <span class="nav-card__sub">Agent Plugin install</span>
    </a>
    <a href="/docs/integrations/openai-codex" class="nav-card">
      <span class="nav-card__label">OpenAI Codex</span>
      <span class="nav-card__sub">Agent Plugin install</span>
    </a>
    <a href="/docs/integrations/kiro" class="nav-card">
      <span class="nav-card__label">Kiro</span>
      <span class="nav-card__sub">Agent Plugin install</span>
    </a>
    <a href="/docs/integrations/github-copilot" class="nav-card">
      <span class="nav-card__label">GitHub Copilot</span>
      <span class="nav-card__sub">Agent Plugin install</span>
    </a>
  </div>

  <h2>Local MCP server (stdio)</h2>
  <p>
    For editors that can run local processes, install the LyraShield MCP server via <code
      >npx -y @lyrashield/mcp</code
    >. The server uses stdio transport and exposes LyraShield tools directly inside your AI
    assistant.
  </p>
  <div class="nav-cards">
    {
      agents
        .filter((agent) => agent.transports.includes("stdio"))
        .map((agent) => (
          <a href={`/docs/integrations/${agent.docsSlug}`} class="nav-card">
            <span class="nav-card__label">{agent.displayName}</span>
            <span class="nav-card__sub">{agentSubtitle(agent)}</span>
          </a>
        ))
    }
  </div>

  <h2>Remote MCP endpoint</h2>
  <p>
    Cloud editors that cannot run local processes connect to the remote Streamable-HTTP endpoint at
    <code>https://app.lyrashieldai.com/api/mcp</code>. Marketplace clients discover the OAuth
    authorization server automatically, select exactly one workspace, and start with read access.
    The
    <a href="/docs/integrations/remote-mcp">Remote MCP</a> guide covers Lovable, Bolt.new, Replit,
    and v0. The <a href="/docs/integrations/github-action">GitHub Action</a> is the recommended
    complement for automated PR checks.
  </p>
  <div class="nav-cards">
    <a href="/docs/integrations/remote-mcp" class="nav-card">
      <span class="nav-card__label">Remote MCP</span>
      <span class="nav-card__sub">Lovable · Bolt.new · Replit · v0</span>
    </a>
  </div>

  <h2 id="oauth">Hosted OAuth connection</h2>
  <p>
    OAuth clients use authorization code + PKCE (S256), refresh and revocation, and a consent screen
    that names the client, workspace, and requested scopes. A connection is bound to one active
    workspace; changing workspaces requires disconnecting and reconnecting. Write scope is optional,
    and every write still enters the exact-argument approval flow. Use the API-key guide below only
    for CI or clients that cannot complete OAuth.
  </p>

  <h2>Cross-cutting setup</h2>
  <div class="nav-cards">
    <a href="/docs/integrations/github-action" class="nav-card">
      <span class="nav-card__label">GitHub Action</span>
      <span class="nav-card__sub">CI/CD security checks on every PR</span>
    </a>
    <a href="/docs/integrations/rest-api" class="nav-card">
      <span class="nav-card__label">REST API & API Keys</span>
      <span class="nav-card__sub">Workspace keys, scopes, lsk_ prefix</span>
    </a>
    <a href="/docs/api" class="nav-card">
      <span class="nav-card__label">API v1</span>
      <span class="nav-card__sub">OpenAPI docs and endpoints</span>
    </a>
    <a href="/docs/integrations/agent-rules" class="nav-card">
      <span class="nav-card__label">Agent Rules Snippets</span>
      <span class="nav-card__sub">CLAUDE.md · AGENTS.md · .cursorrules · .mdc · skill.md</span>
    </a>
    <a href="/docs/integrations/troubleshooting" class="nav-card">
      <span class="nav-card__label">Troubleshooting</span>
      <span class="nav-card__sub">Common gotchas and fixes</span>
    </a>
  </div>

  <h2>Frequently asked questions</h2>
  <div class="faq-list">
    {
      faqItems.map((item, i) => (
        <details class="faq-item" data-question-id={`integrations-faq-${i + 1}`}>
          <summary class="faq-item__q">{item.q}</summary>
          <p class="faq-item__a">{item.a}</p>
        </details>
      ))
    }
  </div>
</DocsLayout>

<style>
  .faq-list {
    margin-top: 1.25rem;
    border-top: 1px solid var(--color-border);
  }

  .faq-item {
    border-bottom: 1px solid var(--color-border);
  }

  .faq-item__q {
    padding: 1rem 0;
    font-weight: 600;
    color: var(--color-text);
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .faq-item__q::-webkit-details-marker {
    display: none;
  }

  .faq-item__q::after {
    content: "▼";
    font-size: 0.65rem;
    color: var(--color-text-muted);
    flex-shrink: 0;
    transition: transform 0.15s;
  }

  .faq-item[open] .faq-item__q::after {
    transform: rotate(180deg);
  }

  .faq-item__a {
    padding-bottom: 1rem;
    font-size: 0.9rem;
  }

  .faq-item:focus-within .faq-item__q {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
    border-radius: 0.2rem;
  }
</style>
