---
import DocsLayout from "@layouts/DocsLayout.astro"
import { listPreferredAgents } from "@lyrashield/agent-registry"
import type { AgentEntry } from "@lyrashield/agent-registry"

const origin = Astro.site?.origin || "http://localhost:4321"
const canonical = new URL("/docs/integrations", origin).toString()
const title = "Connect LyraShield to AI Coding Tools"
const description =
  "Connect LyraShield to coding tools with MCP, CLI installers, skills, REST API keys, and agent rules for Claude Code, Cursor, VS Code, and GitHub Actions."

const updatedDate = "2026-10-02"

const agents = listPreferredAgents()

function agentSubtitle(agent: AgentEntry): string {
  if (agent.installStrategy === "config-file") {
    const loc =
      agent.locations.find((location) => location.sharedByConvention) ??
      agent.locations[0]
    return loc?.path ?? "Config file"
  }
  if (agent.installStrategy === "vendor-cli") {
    return `${agent.vendorCli?.command} ${agent.vendorCli?.args?.join(" ")}`.trim()
  }
  return "Manual setup"
}

const faqItems = [
  {
    q: "What is the LyraShield MCP server?",
    a: "LyraShield ships a Model Context Protocol (MCP) server that exposes security-check tools to AI coding assistants. You can run it locally via npx (stdio transport) or connect to the hosted remote endpoint for cloud editors that cannot run local processes.",
  },
  {
    q: "Do I need an API key to use the MCP server?",
    a: "Local stdio uses npx -y lyrashield@0.2.14 login --oauth in the same OS account; the server reads the selected workspace credential store. Hosted OAuth-capable clients authenticate inside the client. Copilot Cloud Agent uses a private read-only Agents secret. Never commit credentials.",
  },
  {
    q: "Which editors use the remote MCP endpoint instead of the local stdio server?",
    a: "Cloud-hosted editors that cannot run local processes — such as Lovable, Bolt.new, Replit and v0 — use protected-resource discovery at https://app.lyrashieldai.com/api/mcp. During OAuth, users choose one workspace and the requested access. Matching delegated actions run without repeated LyraShield approval.",
  },
  {
    q: "Is the @lyrashield/mcp package available on npm now?",
    a: "Yes — @lyrashield/mcp is published on npm. Run npx -y @lyrashield/mcp@0.2.12 (Node.js 24+) with your LYRASHIELD_API_KEY set or add it to your editor's MCP config as shown in each guide.",
  },
  {
    q: "Can I use LyraShield in a CI pipeline without an AI editor?",
    a: "Yes. The GitHub Action integration runs LyraShield checks directly in your workflow without any AI assistant. It is the recommended path for cloud-only editors and for teams that want automated checks on every pull request.",
  },
  {
    q: "How does CLI login work without pasting a secret?",
    a: "Run npx --yes lyrashield@0.2.14 login --oauth. The CLI opens hosted OAuth consent with PKCE, lets you choose one workspace and stores the short-lived bearer locally. API-key login remains available for CI and non-interactive environments.",
  },
  {
    q: "Is there a CLI or do I have to hand-edit config files?",
    a: "CLI 0.2.14 includes config writers for exact client contracts recorded by the installer and shared-skill installation for documented client skill paths. Each guide shows a preview and install command where supported; otherwise it provides a manual setup. Authenticate local stdio with CLI OAuth, confirm client discovery, then verify a read-only call.",
  },
  {
    q: "What is the Agent Plugin?",
    a: "The portable package bundles an MCP descriptor and security guidance. Client marketplace listings are still awaiting review and readback, so follow each client guide for its direct MCP fallback. CLI config installation and shared skills are separate features available only where an exact client contract or skill path is recorded. See /docs/integrations/agent-plugins.",
  },
]

const jsonLd: unknown[] = [
  {
    "@context": "https://schema.org",
    "@type": "TechArticle",
    headline: "Connect LyraShield to AI Coding Tools",
    description,
    url: canonical,
    dateModified: updatedDate,
    author: { "@id": `${origin}/#organization` },
    publisher: { "@id": `${origin}/#organization` },
    inLanguage: "en-US",
    isPartOf: { "@id": `${origin}/docs/integrations` },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${origin}/` },
      { "@type": "ListItem", position: 2, name: "Docs", item: `${origin}/docs/integrations` },
      {
        "@type": "ListItem",
        position: 3,
        name: "Integrations",
        item: canonical,
      },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqItems.map((item) => ({
      "@type": "Question",
      name: item.q,
      acceptedAnswer: { "@type": "Answer", text: item.a },
    })),
  },
]
---

<DocsLayout
  title={`${title} | LyraShield AI`}
  description={description}
  canonical={canonical}
  jsonLd={jsonLd}
  updatedDate={updatedDate}
  currentPath="/docs/integrations"
>
  <h1>Integrations</h1>
  <p>
    Connect LyraShield to your AI coding environment to run security checks inline while you build.
    Choose the setup that matches your editor or workflow.
  </p>

  <h2>Choose your client setup</h2>
  <p>
    Follow the client-specific guide. Where CLI 0.2.14 provides a matching installer, preview the
    planned changes and run its pinned command; otherwise merge the LyraShield entry manually using
    <code>command: "npx"</code> and <code>args: ["-y", "@lyrashield/mcp@0.2.12"]</code> for local
    stdio. Preserve existing settings and symlinks. Authenticate in the same OS account, restart the
    client, confirm tool discovery and make a read-only authenticated call. Hosted OAuth uses the
    client’s own sign-in flow.
  </p>
  <pre><code>npx -y lyrashield@0.2.14 login --oauth</code></pre>
  <p>
    The CLI also installs shared skills where a client has one documented LyraShield skill path.
    Each client guide shows whether that command is available. A completed install does not prove
    client discovery, authentication, marketplace listing or runtime acceptance.
  </p>

  <div class="callout">
    The full client catalog, evidence labels and per-client setup guides are on the{" "}
    <a href="/agents">coding agents page</a>. Marketplace availability and runtime verification
    are tracked separately.
  </div>

  <h2>Agent Plugin release pending</h2>
  <p>
    Claude Code, Cursor, OpenAI Codex and GitHub Copilot plugin installation awaits a reviewed matching
    immutable package release. The marketplace default branch contains preparation artifacts.
    Use their current direct MCP guides with <code>@lyrashield/mcp@0.2.12</code>, authenticate
    local stdio separately with <code>npx -y lyrashield@0.2.14 login --oauth</code>, then confirm
    client discovery and an authenticated read-only workspace call.
  </p>
  <p>
    Do not install from the mutable preparation branch. Cursor also uses the pinned direct MCP
    fallback; Kiro's Power remains in preparation with a direct MCP fallback. The
    <a href="/docs/integrations/agent-plugins">Agent Plugins guide</a> describes these distribution
    boundaries. CLI config writing and shared-skill installation remain separately available where
    their exact client contracts and skill paths are recorded.
  </p>
  <div class="callout">
    <strong>No credential in committed files:</strong> For local stdio, after{" "}
    <code>npx --yes lyrashield@0.2.14 login --oauth</code>,
    the MCP server reads the selected workspace credential from{" "}
    <code>~/.lyrashield/credentials.json</code>. Hosted OAuth does not need that local file. API keys remain a CI and non-OAuth-client fallback;
    do not commit either credential.
  </div>
  <div class="nav-cards">
    <a href="/docs/integrations/claude-code" class="nav-card">
      <span class="nav-card__label">Claude Code</span>
      <span class="nav-card__sub">Direct MCP fallback · plugin listing pending</span>
    </a>
    <a href="/docs/integrations/cursor" class="nav-card">
      <span class="nav-card__label">Cursor</span>
      <span class="nav-card__sub">Direct MCP fallback · plugin listing pending</span>
    </a>
    <a href="/docs/integrations/vscode" class="nav-card">
      <span class="nav-card__label">VS Code</span>
      <span class="nav-card__sub">MCP config guide</span>
    </a>
    <a href="/docs/integrations/devin" class="nav-card">
      <span class="nav-card__label">Devin</span>
      <span class="nav-card__sub">MCP Marketplace setup</span>
    </a>
    <a href="/docs/integrations/openai-codex" class="nav-card">
      <span class="nav-card__label">OpenAI Codex</span>
      <span class="nav-card__sub">Direct MCP fallback · plugin listing pending</span>
    </a>
    <a href="/docs/integrations/github-copilot" class="nav-card">
      <span class="nav-card__label">GitHub Copilot</span>
      <span class="nav-card__sub">Direct MCP fallback · plugin listing pending</span>
    </a>
    <a href="/docs/integrations/kiro" class="nav-card">
      <span class="nav-card__label">Kiro</span>
      <span class="nav-card__sub">Power in preparation · MCP setup available</span>
    </a>
  </div>

  <h2>Local MCP server (stdio)</h2>
  <p>
    For editors that can run local processes, install the LyraShield MCP server via <code
      >npx -y @lyrashield/mcp@0.2.12</code
    >. The server uses stdio transport and exposes LyraShield tools directly inside your AI
    assistant.
  </p>
  <div class="nav-cards">
    {
      agents
        .filter((agent) => agent.transports.includes("stdio"))
        .map((agent) => (
          <a href={`/docs/integrations/${agent.docsSlug}`} class="nav-card">
            <span class="nav-card__label">{agent.displayName}</span>
            <span class="nav-card__sub">{agentSubtitle(agent)}</span>
          </a>
        ))
    }
  </div>

  <h2>Remote MCP endpoint</h2>
  <p>
    Cloud editors that cannot run local processes connect to the remote Streamable-HTTP endpoint at{" "}
    <code>https://app.lyrashieldai.com/api/mcp</code>. OAuth-capable clients discover the OAuth
    authorization server automatically, select exactly one workspace and start with read access.
    The{" "}
    <a href="/docs/integrations/remote-mcp">Remote MCP</a> guide covers Lovable, Bolt.new, Replit
    and v0. The <a href="/docs/integrations/github-action">GitHub Action</a> is the recommended
    complement for automated PR checks.
  </p>
  <div class="nav-cards">
    <a href="/docs/integrations/remote-mcp" class="nav-card">
      <span class="nav-card__label">Remote MCP</span>
      <span class="nav-card__sub">Lovable · Bolt.new · Replit · v0</span>
    </a>
  </div>

  <h2 id="oauth">Hosted OAuth connection</h2>
  <p>
    OAuth clients use authorization code + PKCE (S256), refresh and revocation and a consent screen
    that names the client, workspace and requested scopes. A connection is bound to one active
    workspace; changing workspaces requires disconnecting and reconnecting. Matching delegated
    actions run without repeated approval after consent. Use the API-key guide below only
    for CI or clients that cannot complete OAuth.
  </p>

  <h2>Cross-cutting setup</h2>
  <div class="nav-cards">
    <a href="/docs/integrations/github-action" class="nav-card">
      <span class="nav-card__label">GitHub Action</span>
      <span class="nav-card__sub">CI/CD security checks on every PR</span>
    </a>
    <a href="/docs/integrations/rest-api" class="nav-card">
      <span class="nav-card__label">REST API & API Keys</span>
      <span class="nav-card__sub">Workspace keys, scopes, lsk_ prefix</span>
    </a>
    <a href="/docs/api" class="nav-card">
      <span class="nav-card__label">API v1</span>
      <span class="nav-card__sub">OpenAPI docs and endpoints</span>
    </a>
    <a href="/docs/integrations/agent-rules" class="nav-card">
      <span class="nav-card__label">Agent Rules Snippets</span>
      <span class="nav-card__sub">CLAUDE.md · AGENTS.md · .cursorrules · .mdc · skill.md</span>
    </a>
    <a href="/docs/integrations/troubleshooting" class="nav-card">
      <span class="nav-card__label">Troubleshooting</span>
      <span class="nav-card__sub">Common gotchas and fixes</span>
    </a>
  </div>

  <h2>Frequently asked questions</h2>
  <div class="faq-list">
    {
      faqItems.map((item, i) => (
        <details class="faq-item" data-question-id={`integrations-faq-${i + 1}`}>
          <summary class="faq-item__q">{item.q}</summary>
          <p class="faq-item__a">{item.a}</p>
        </details>
      ))
    }
  </div>
</DocsLayout>

<style>
  .faq-list {
    margin-top: 1.25rem;
    border-top: 1px solid var(--color-border);
  }

  .faq-item {
    border-bottom: 1px solid var(--color-border);
  }

  .faq-item__q {
    padding: 1rem 0;
    font-weight: 600;
    color: var(--color-text);
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .faq-item__q::-webkit-details-marker {
    display: none;
  }

  .faq-item__q::after {
    content: "▼";
    font-size: 0.65rem;
    color: var(--color-text-muted);
    flex-shrink: 0;
    transition: transform 0.15s;
  }

  .faq-item[open] .faq-item__q::after {
    transform: rotate(180deg);
  }

  .faq-item__a {
    padding-bottom: 1rem;
    font-size: 0.9rem;
  }

  .faq-item:focus-within .faq-item__q {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
    border-radius: 0.2rem;
  }
</style>
