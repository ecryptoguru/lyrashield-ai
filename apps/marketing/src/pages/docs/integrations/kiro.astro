---
import DocsLayout from "@layouts/DocsLayout.astro"
import { buildDocsJsonLd } from "../../../lib/docs-metadata"

const origin = Astro.site?.origin || "http://localhost:4321"
const title = "LyraShield MCP for Kiro — Setup Guide"
const description =
  "Connect LyraShield to Kiro through its documented workspace or user MCP settings file."
const updatedDate = "2026-09-19"

const { canonical, techArticle, breadcrumbList } = buildDocsJsonLd({
  origin,
  path: "/docs/integrations/kiro",
  title,
  description,
  updatedDate,
  breadcrumbLabel: "Kiro",
})
const jsonLd: unknown[] = [
  techArticle,
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    name: "Configure LyraShield MCP for Kiro",
    step: [
      {
        "@type": "HowToStep",
        position: 1,
        name: "Log in to LyraShield",
        text: "Run npx lyrashield login --oauth to select a workspace and save the local OAuth credential.",
      },
      {
        "@type": "HowToStep",
        position: 2,
        name: "Add the MCP entry",
        text: "Merge the LyraShield entry into .kiro/settings/mcp.json or ~/.kiro/settings/mcp.json.",
      },
      {
        "@type": "HowToStep",
        position: 3,
        name: "Verify the connection",
        text: "Restart Kiro and run a read-only LyraShield workspace query.",
      },
    ],
  },
  breadcrumbList,
]
---

<DocsLayout
  title={`${title} | LyraShield AI`}
  description={description}
  canonical={canonical}
  jsonLd={jsonLd}
  updatedDate={updatedDate}
  currentPath="/docs/integrations/kiro"
>
  <h1>Kiro</h1>
  <p>
    Kiro reads MCP servers from <code>.kiro/settings/mcp.json</code> for one workspace or{" "}
    <code>~/.kiro/settings/mcp.json</code> for the current user. LyraShield supplies the server
    entry; copying a plugin folder alone does not activate it.
  </p>

  <h2>Configure LyraShield</h2>
  <p>
    Log in locally, then merge the entry below into one of Kiro's documented settings files:
  </p>
  <pre><code>npx lyrashield login --oauth</code></pre>
  <pre><code>{`{
  "mcpServers": {
    "lyrashield": {
      "command": "npx",
      "args": ["-y", "@lyrashield/mcp@0.2.8"]
    }
  }
}`}</code></pre>
  <p>
    <code>npx lyrashield install kiro</code> prints this exact recovery path. It preserves existing
    Kiro servers and does not write credentials into the settings file.
  </p>

  <div class="callout">
    <strong>No credential in committed files:</strong> After <code>npx lyrashield login --oauth</code>, the
    local MCP server reads credentials from <code>~/.lyrashield/credentials.json</code> (or the{" "}
    <code>LYRASHIELD_API_KEY</code> environment variable). Nothing with a key needs to be committed.
  </div>

  <h2>Remote OAuth alternative</h2>
  <p>
    Current Kiro supports URL-only remote MCP servers and browser OAuth. The registry retains
    local stdio as the preferred workflow until a real Kiro read call and lifecycle receipt are
    retained for hosted OAuth. Do not create a duplicate if a local LyraShield entry already works.
  </p>
  <pre><code>{`{
  "mcpServers": {
    "lyrashield": { "url": "https://app.lyrashieldai.com/api/mcp" }
  }
}`}</code></pre>

  <h2>Verify the connection</h2>
  <p>
    Restart Kiro or reconnect MCP servers, then run a read-only LyraShield workspace query. Treat
    an install receipt separately from authenticated tool execution.
  </p>

  <div class="callout callout--warn">
    <strong>Requirement:</strong> Node.js 24+ and a LyraShield workspace OAuth login. Kiro launches
    the local MCP package over stdio; the package reads the user-only credential store.
  </div>
</DocsLayout>
