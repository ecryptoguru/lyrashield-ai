---
import AgentSnippet from "@components/AgentSnippet.astro"
import DocsLayout from "@layouts/DocsLayout.astro"

const origin = Astro.site?.origin || "http://localhost:4321"
const canonical = new URL("/docs/integrations/vscode", origin).toString()
const title = "LyraShield MCP for VS Code — Setup Guide"
const description =
  'Add the LyraShield MCP server to VS Code with GitHub Copilot agent mode. The critical difference: VS Code uses the root key "servers" — not "mcpServers" — in .vscode/mcp.json.'
const updatedDate = "2026-08-12"

const marketplaceRepoUrl = "https://github.com/ecryptoguru/lyrashield-marketplace"

// Repo-committed team recommendation. VS Code reads these keys from workspace settings in
// either .claude/settings.json or .github/copilot/settings.json.
const workspaceRecommendation = JSON.stringify(
  {
    extraKnownMarketplaces: {
      "lyrashield-ai": {
        source: { source: "github", repo: "ecryptoguru/lyrashield-marketplace" },
      },
    },
    enabledPlugins: { "lyrashield@lyrashield-ai": true },
  },
  null,
  2
)

const jsonLd: unknown[] = [
  {
    "@context": "https://schema.org",
    "@type": "TechArticle",
    headline: title,
    description,
    url: canonical,
    dateModified: updatedDate,
    author: { "@id": `${origin}/#organization` },
    publisher: { "@id": `${origin}/#organization` },
    inLanguage: "en-US",
  },
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    name: "Set up LyraShield MCP in VS Code",
    step: [
      {
        "@type": "HowToStep",
        position: 1,
        name: "Create .vscode/mcp.json",
        text: "In your project root, create .vscode/mcp.json. Note the root key is 'servers' (not 'mcpServers') — this is the most common VS Code copy-paste error.",
      },
      {
        "@type": "HowToStep",
        position: 2,
        name: "Add the lyrashield entry with type:stdio",
        text: 'Add the servers key with the lyrashield entry. Set "type": "stdio", command to "npx", and args to ["-y","@lyrashield/mcp"].',
      },
      {
        "@type": "HowToStep",
        position: 3,
        name: "Set your API key in env",
        text: "Add LYRASHIELD_API_KEY to the env object within the lyrashield entry.",
      },
      {
        "@type": "HowToStep",
        position: 4,
        name: "Reload VS Code",
        text: "Reload the window. Confirm the server appears in the Copilot MCP servers view.",
      },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${origin}/` },
      {
        "@type": "ListItem",
        position: 2,
        name: "Integrations",
        item: `${origin}/docs/integrations`,
      },
      { "@type": "ListItem", position: 3, name: "VS Code", item: canonical },
    ],
  },
]
---

<DocsLayout
  title={`${title} | LyraShield AI`}
  description={description}
  canonical={canonical}
  jsonLd={jsonLd}
  updatedDate={updatedDate}
  currentPath="/docs/integrations/vscode"
>
  <h1>VS Code</h1>
  <p>
    VS Code (with the GitHub Copilot extension in agent mode) reads MCP servers from{" "}
    <code>.vscode/mcp.json</code> in your project root.
  </p>

  <h2>Install with the CLI (fastest)</h2>
  <p>
    Run <code>npx lyrashield install vscode</code> from your project root. It detects VS Code,
    writes the correct config automatically, and never inlines your API key into a file you might
    commit. Add <code>--dry-run</code> first to preview the change with no write, or run{" "}
    <code>npx lyrashield doctor</code> afterward to confirm it's configured correctly.
  </p>
  <pre><code>npx lyrashield install vscode</code></pre>
  <p>
    Prefer to install LyraShield as an Agent Plugin instead of an MCP config entry? See{" "}
    <a href="#install-as-an-agent-plugin">Install as an Agent Plugin</a>. Prefer to see exactly
    what gets written, or set it up without Node.js? Configure it by hand below.
  </p>

  <h2 id="install-as-an-agent-plugin">Install as an Agent Plugin</h2>
  <p>
    LyraShield also ships as an Agent Plugin: one install brings the MCP server and the LyraShield
    review skill together, instead of wiring the server by hand. VS Code can install it straight
    from the public plugin repository.
  </p>

  <h3>Install from source (available now)</h3>
  <p>
    Open the Command Palette (<code>Ctrl/Cmd + Shift + P</code>) and run{" "}
    <em>Chat: Install Plugin From Source</em>, then paste the repository URL. VS Code clones the
    repository and installs the plugin. You can also reach this from{" "}
    <em>Install Plugin from Source</em> on the <strong>Plugins</strong> page of the Agent
    Customizations editor.
  </p>
  <pre><code>{marketplaceRepoUrl}</code></pre>

  <div class="callout callout--warn">
    <strong>No one-click marketplace install yet:</strong> LyraShield is not yet listed in a
    published VS Code plugin marketplace, so there is no one-click install button today. Install
    from source, or add the marketplace by URL as shown below — both work now and install the same
    plugin.
  </div>

  <h3>Recommend the plugin to your whole team</h3>
  <p>
    Adoption can be a repo-committed decision rather than something each developer repeats. Add the
    following to <code>.claude/settings.json</code> or <code>.github/copilot/settings.json</code> in
    your repository. <code>extraKnownMarketplaces</code> registers the marketplace for the project
    and <code>enabledPlugins</code> marks the plugin as enabled by default. VS Code shows a
    recommendation notification the first time someone sends a chat message.
  </p>
  <pre><code>{workspaceRecommendation}</code></pre>
  <p>
    Teammates can review recommended plugins in the Extensions view by filtering on{" "}
    <code>@agentPlugins @recommended</code>.
  </p>

  <div class="callout">
    <strong>Credentials stay out of the repo:</strong> the snippet above contains no API key. Run
    <code>npx lyrashield login --oauth</code> once per machine; the plugin's MCP server reads the
    selected workspace credential from <code>~/.lyrashield/credentials.json</code>.
  </div>

  <h3>Claude Code and other Agent Plugin clients</h3>
  <p>
    The same repository is an addressable plugin marketplace, so clients that support marketplace
    commands can add it directly:
  </p>
  <pre><code>/plugin marketplace add ecryptoguru/lyrashield-marketplace
/plugin install lyrashield@lyrashield-ai</code></pre>

  <h2>Manual configuration</h2>
  <p>Prefer a plain MCP config entry? Configure it by hand below.</p>

  <div class="callout callout--warn">
    <strong>Critical gotcha:</strong> VS Code uses the root key <code>servers</code>, not{" "}
    <code>mcpServers</code>. Using <code>mcpServers</code> silently fails. Every entry also
    requires a <code>"type": "stdio"</code> field.
  </div>

  <p>
    Create or open <code>.vscode/mcp.json</code> in your project root. Use <code>servers</code> as
    the top-level key.
  </p>

  <AgentSnippet agentId="vscode" transport="stdio" />

  <h2>User-level global config</h2>
  <p>
    To register the server globally for all projects, open VS Code settings (<code>
      Ctrl/Cmd + Shift + P
    </code> → <em>Preferences: Open User Settings (JSON)</em>) and add the same <code>
      servers
    </code> block at the top level under the <code>github.copilot.chat.agent.mcpServers</code> or equivalent
    user-level MCP key.
  </p>

  <h2>Credentials</h2>
  <div class="callout">
    <strong>No credential in committed files:</strong> After <code>npx lyrashield login --oauth</code>,
    the local MCP server reads the selected workspace credential from
    <code>~/.lyrashield/credentials.json</code>. No key needs to be inlined in{" "}
    <code>.vscode/mcp.json</code> or any other file you might commit.
  </div>

  <h2>Verify the connection</h2>
  <p>
    Reload the window (<code>Ctrl/Cmd + Shift + P</code> → <em>Developer: Reload Window</em>).
    Open the Copilot Chat panel, switch to agent mode, and confirm that LyraShield tools appear in
    the tool list.
  </p>

  <div class="callout callout--warn">
    <strong>Requirements:</strong> Node.js 20+ and a LyraShield workspace OAuth login. The
    <code>@lyrashield/mcp</code> package is published on npm, so
    <code>npx -y @lyrashield/mcp</code> resolves directly.
  </div>
</DocsLayout>
