---
import AgentSnippet from "@components/AgentSnippet.astro"
import DocsLayout from "@layouts/DocsLayout.astro"

const origin = Astro.site?.origin || "http://localhost:4321"
const canonical = new URL("/docs/integrations/zed", origin).toString()
const title = "LyraShield MCP for Zed — Setup Guide"
const description =
  'Connect LyraShield to Zed editor. Add the MCP server under the context_servers key (not mcpServers) in Zed settings.json to enable inline security checks.'
const updatedDate = "2026-07-31"

const jsonLd: unknown[] = [
  {
    "@context": "https://schema.org",
    "@type": "TechArticle",
    headline: title,
    description,
    url: canonical,
    dateModified: updatedDate,
    author: { "@id": `${origin}/#organization` },
    publisher: { "@id": `${origin}/#organization` },
    inLanguage: "en-US",
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${origin}/` },
      {
        "@type": "ListItem",
        position: 2,
        name: "Integrations",
        item: `${origin}/docs/integrations`,
      },
      { "@type": "ListItem", position: 3, name: "Zed", item: canonical },
    ],
  },
]
---

<DocsLayout
  title={`${title} | LyraShield AI`}
  description={description}
  canonical={canonical}
  jsonLd={jsonLd}
  updatedDate={updatedDate}
  currentPath="/docs/integrations/zed"
>
  <h1>Zed</h1>
  <p>
    Zed reads MCP context servers from your user <code>settings.json</code>. Open it via{" "}
    <strong>Zed → Settings → Open Settings</strong> (<code>Cmd/Ctrl + ,</code>).
  </p>

  <h2>Install with the CLI (fastest)</h2>
  <p>
    Run <code>npx lyrashield install zed</code> from your project root. It detects Zed, writes the
    correct config automatically, and never inlines your API key into a file you might commit. Add{" "}
    <code>--dry-run</code> first to preview the change with no write, or run{" "}
    <code>npx lyrashield doctor</code> afterward to confirm it's configured correctly.
  </p>
  <pre><code>npx lyrashield install zed</code></pre>
  <p>Prefer to see exactly what gets written, or set it up without Node.js? Configure it by hand below.</p>

  <div class="callout callout--warn">
    <strong>Critical gotcha:</strong> Zed uses the key <code>context_servers</code> — not{" "}
    <code>mcpServers</code>. Using <code>mcpServers</code> will have no effect.
  </div>

  <h2>Configuration</h2>
  <p>
    Add the following to your Zed <code>settings.json</code>. The <code>context_servers</code> key
    goes at the top level of the settings object.
  </p>

  <AgentSnippet agentId="zed" transport="stdio" />

  <h2>Verify the connection</h2>
  <p>
    Save <code>settings.json</code>. Open the Zed AI assistant panel and check that the lyrashield
    context server appears in the active servers list. You can ask the assistant to list available
    tools to confirm.
  </p>

  <div class="callout callout--warn">
    <strong>Requirements:</strong> Node.js 24+ and a LyraShield workspace API key. The
    <code>@lyrashield/mcp</code> package is published on npm, so
    <code>npx -y @lyrashield/mcp</code> resolves directly.
  </div>
</DocsLayout>
