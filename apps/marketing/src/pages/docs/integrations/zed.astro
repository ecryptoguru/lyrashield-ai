---
import AgentSnippet from "@components/AgentSnippet.astro"
import DocsLayout from "@layouts/DocsLayout.astro"
import { buildDocsJsonLd } from "../../../lib/docs-metadata"

const origin = Astro.site?.origin || "http://localhost:4321"
const title = "LyraShield MCP for Zed — Setup Guide"
const description =
  'Connect LyraShield to Zed editor. Add the MCP server under the context_servers key (not mcpServers) in Zed settings.json to enable inline security checks.'
const updatedDate = "2026-09-19"

const { canonical, techArticle, breadcrumbList } = buildDocsJsonLd({
  origin,
  path: "/docs/integrations/zed",
  title,
  description,
  updatedDate,
  breadcrumbLabel: "Zed",
})
const jsonLd: unknown[] = [techArticle, breadcrumbList]
---

<DocsLayout
  title={`${title} | LyraShield AI`}
  description={description}
  canonical={canonical}
  jsonLd={jsonLd}
  updatedDate={updatedDate}
  currentPath="/docs/integrations/zed"
>
  <h1>Zed</h1>
  <p>
    Zed reads MCP context servers from your user <code>settings.json</code>. Open it via{" "}
    <strong>Zed → Settings → Open Settings</strong> (<code>Cmd/Ctrl + ,</code>).
  </p>

  <h2>Install with the CLI (fastest)</h2>
  <p>
    Run <code>npx lyrashield install zed</code> from your project root. It detects Zed, writes the
    current flat <code>command</code>, <code>args</code> and <code>env</code> fields. Add{" "}
    <code>--dry-run</code> first to preview the change with no write or run{" "}
    <code>npx lyrashield doctor</code> afterward to inspect local configuration, then make a read-only call in the client.
  </p>
  <pre><code>npx lyrashield install zed</code></pre>
  <p>Prefer to see exactly what gets written or set it up without Node.js? Configure it by hand below.</p>

  <div class="callout callout--warn">
    <strong>Critical gotcha:</strong> Zed uses the key <code>context_servers</code> — not{" "}
    <code>mcpServers</code>. Using <code>mcpServers</code> will have no effect.
  </div>

  <h2>Configuration</h2>
  <p>
    Add the following to your Zed <code>settings.json</code>. The <code>context_servers</code> key
    goes at the top level of the settings object.
  </p>

  <AgentSnippet agentId="zed" transport="stdio" />
  <p>
    Older Zed examples used nested <code>command.path</code>; the current
    <a href="https://zed.dev/docs/ai/mcp">Zed MCP settings</a> use flat fields. Update a legacy entry through Zed settings rather than creating a second LyraShield server.
  </p>

  <h2>Remote HTTP alternative</h2>
  <p>
    Zed can connect to a remote URL without an Authorization header and start its OAuth flow.
    Keep an existing stdio connection unless you choose to migrate.
  </p>
  <AgentSnippet agentId="zed" transport="remote-http" secondary />

  <h2>Verify the connection</h2>
  <p>
    Save <code>settings.json</code>. Open the Zed AI assistant panel and check that the lyrashield
    context server appears as active. Restart Zed, inspect the tool list and rules, then make a
    read-only LyraShield call; a config file or doctor result alone does not prove connection.
  </p>

  <div class="callout callout--warn">
    <strong>Local stdio requirements:</strong> Node.js 24+ and a local OAuth login or workspace API key. Remote OAuth does not require a local API key. The{" "}
    <code>@lyrashield/mcp</code> package is published on npm, so{" "}
    <code>npx -y @lyrashield/mcp@0.2.8</code> resolves directly.
  </div>
</DocsLayout>
