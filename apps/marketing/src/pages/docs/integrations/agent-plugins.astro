---
import DocsLayout from "@layouts/DocsLayout.astro"

const origin = Astro.site?.origin || "http://localhost:4321"
const canonical = new URL("/docs/integrations/agent-plugins", origin).toString()
const title = "LyraShield Agent Plugin — Coding Agent Setup"
const description =
  "Install the LyraShield Agent Plugin through each coding client's documented local, marketplace, or MCP activation path."
const updatedDate = "2026-09-09"

// Kept in the same order as the launch-client table below.
const launchClients = [
  {
    name: "Claude Code",
    slug: "claude-code",
    path: "Claude marketplace",
    cliDefault: "Guided marketplace",
  },
  {
    name: "Cursor",
    slug: "cursor",
    path: "~/.cursor/plugins/local/lyrashield",
    cliDefault: "Direct local copy",
  },
  {
    name: "OpenAI Codex",
    slug: "openai-codex",
    path: "~/.codex/plugins/lyrashield",
    cliDefault: "Direct local copy",
  },
  {
    name: "GitHub Copilot",
    slug: "github-copilot",
    path: "Copilot marketplace",
    cliDefault: "Guided marketplace",
  },
  {
    name: "Kiro",
    slug: "kiro",
    path: ".kiro/settings/mcp.json",
    cliDefault: "Guided MCP merge",
  },
]

const faqItems = [
  {
    q: "What is the LyraShield Agent Plugin?",
    a: "It is a portable package that carries the LyraShield MCP descriptor and security guidance. Each client still controls activation through its own documented local, marketplace, or MCP settings path.",
  },
  {
    q: "Which clients can install the Agent Plugin?",
    a: "The package has descriptors for Claude Code, Cursor, OpenAI Codex, GitHub Copilot, and Kiro. Cursor and Codex accept a local copy; Claude and Copilot use marketplaces; Kiro uses its MCP settings file. Other agents follow their own guide.",
  },
  {
    q: "Do I need to log in before installing the plugin?",
    a: "Kiro's local stdio path needs npx lyrashield login --oauth first. Remote plugin paths complete hosted OAuth inside the client when the connection starts.",
  },
  {
    q: "Does the plugin let the agent change my code on its own?",
    a: "No. LyraShield findings and fixes are proposals requiring review before they land. A browser-confirmed OAuth delegation can run its recorded LyraShield workflows without repeated approval, but it remains limited by the user's current role, workspace, targets, profiles, budget, scope, and connection expiry. LyraShield never auto-merges a pull request.",
  },
  {
    q: "Why does VS Code use an MCP config file instead of the plugin?",
    a: "No generated VS Code Agent Plugin shim exists. Its verified path is the .vscode/mcp.json file that npx lyrashield install vscode writes. The VS Code guide documents the servers root key and per-entry stdio type.",
  },
]

const jsonLd: unknown[] = [
  {
    "@context": "https://schema.org",
    "@type": "TechArticle",
    headline: title,
    description,
    url: canonical,
    dateModified: updatedDate,
    author: { "@id": `${origin}/#organization` },
    publisher: { "@id": `${origin}/#organization` },
    inLanguage: "en-US",
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${origin}/` },
      {
        "@type": "ListItem",
        position: 2,
        name: "Integrations",
        item: `${origin}/docs/integrations`,
      },
      { "@type": "ListItem", position: 3, name: "Agent Plugins", item: canonical },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqItems.map((item) => ({
      "@type": "Question",
      name: item.q,
      acceptedAnswer: { "@type": "Answer", text: item.a },
    })),
  },
]
---

<DocsLayout
  title={`${title} | LyraShield AI`}
  description={description}
  canonical={canonical}
  jsonLd={jsonLd}
  updatedDate={updatedDate}
  currentPath="/docs/integrations/agent-plugins"
>
  <h1>Agent Plugins</h1>
  <p>
    LyraShield ships as a portable plugin following the open{" "}
    <a href="https://agent-plugins.org" target="_blank" rel="noopener noreferrer"
      >Agent Plugins v1.0.0</a
    >{" "}
    format. One package bundles two things: the LyraShield MCP server, which gives your agent the
    scan, finding, fix-plan, and verify tools, and a security skill that tells the agent when to
    reach for them. Each client still activates the package through its own supported path.
  </p>

  <h2>Start with the LyraShield CLI</h2>
  <p>
    Run the installer for the client you use. It copies the package only where the client documents
    a local discovery path; otherwise it prints the exact marketplace or MCP settings step.
  </p>
  <pre><code>npx lyrashield install &lt;agent&gt;
npx lyrashield install &lt;agent&gt; --dry-run</code></pre>
  <p>
    <code>npx lyrashield init</code> detects installed clients and follows the same rules. A dry run
    executes no vendor command and writes no file.
  </p>

  <div class="callout">
    <strong>No credential in committed files:</strong> remote clients use hosted OAuth. Kiro's local
    stdio server reads <code>~/.lyrashield/credentials.json</code>. A workspace API key remains the
    explicit CI fallback; do not commit it.
  </div>

  <h2>The five launch clients</h2>
  <p>
    The package contains client artifacts for these five clients. Every other agent LyraShield
    supports uses the config-file, vendor-CLI, or guided-manual path in its own guide.
  </p>
  <table>
    <thead>
      <tr>
        <th>Client</th>
        <th>Activation</th>
        <th>CLI behavior</th>
      </tr>
    </thead>
    <tbody>
      {launchClients.map((client) => (
        <tr>
          <td><a href={`/docs/integrations/${client.slug}`}>{client.name}</a></td>
          <td><code>{client.path}</code></td>
          <td>{client.cliDefault}</td>
        </tr>
      ))}
    </tbody>
  </table>

  <div class="callout">
    <strong>VS Code uses MCP configuration:</strong> no generated Agent Plugin shim exists for VS
    Code. Use <code>npx lyrashield install vscode</code> or follow the{" "}
    <a href="/docs/integrations/vscode">VS Code guide</a>.
  </div>

  <h2>What the skill adds</h2>
  <p>
    The MCP server alone gives an agent tools; the bundled skill gives it judgement about depth. It
    maps a request like a pre-commit diff check to a quick bounded review, and a deep security
    review to the intrusive agentic mode that only runs inside the authorised isolated sandbox for a
    repository target. That keeps a routine check from silently becoming a long expensive scan.
  </p>

  <h2>Findings are proposals, not automatic changes</h2>
  <p>
    Installing the plugin does not let an agent rewrite your code unattended. During remote OAuth,
    the user chooses one workspace and the requested workflows. Matching calls can then run without
    repeated LyraShield approval, while current role, target access, profile, budget, connection,
    scope, expiry, and idempotency checks still apply. Legacy and out-of-grant requests fail closed
    or use the <a href="/docs/approvals">exact-input approval fallback</a>. Fixes and pull requests
    remain proposals requiring review before they land; LyraShield never merges them automatically.
  </p>

  <h2>Uninstall</h2>
  <p>
    The CLI removes only files or configuration it manages. Marketplace and UI installations must
    be removed through that client's own plugin manager.
  </p>
  <pre><code>npx lyrashield uninstall &lt;agent&gt;</code></pre>

  <h2>Frequently asked questions</h2>
  {faqItems.map((item) => (
    <>
      <h3>{item.q}</h3>
      <p>{item.a}</p>
    </>
  ))}

  <div class="callout">
    <strong>Requirements:</strong> Node.js 24+ and a LyraShield account. LyraShield is live with
    open registration in open beta, and some platform features remain on the near-term roadmap. Get
    started at{" "}
    <a href="https://lyrashieldai.com" target="_blank" rel="noopener noreferrer">lyrashieldai.com</a
    >.
  </div>
</DocsLayout>
