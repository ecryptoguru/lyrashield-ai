---
import DocsLayout from "@layouts/DocsLayout.astro"
import { buildDocsJsonLd } from "../../../lib/docs-metadata"

const origin = Astro.site?.origin || "http://localhost:4321"
const title = "LyraShield Agent Plugin — Coding Agent Setup"
const description =
  "Use LyraShield's portable Agent Plugin format, pinned CLI installers, shared skills and client-specific setup guides."
const updatedDate = "2026-10-02"

// Kept in the same order as the launch-client table below.
const launchClients = [
  {
    name: "Claude Code",
    slug: "claude-code",
    path: ".mcp.json (direct MCP)",
    cliDefault: "Plugin listing pending; direct MCP available",
  },
  {
    name: "Cursor",
    slug: "cursor",
    path: ".cursor/mcp.json (direct MCP)",
    cliDefault: "Plugin listing pending; direct MCP available",
  },
  {
    name: "OpenAI Codex",
    slug: "openai-codex",
    path: "~/.codex/config.toml (direct MCP)",
    cliDefault: "Plugin listing pending; direct MCP available",
  },
  {
    name: "GitHub Copilot",
    slug: "github-copilot",
    path: "~/.copilot/mcp-config.json (direct MCP)",
    cliDefault: "Plugin listing pending; direct MCP available",
  },
  {
    name: "Kiro",
    slug: "kiro",
    path: "Kiro Power in preparation; local MCP fallback available now",
    cliDefault: "MCP configuration fallback",
  },
]

const faqItems = [
  {
    q: "What is the LyraShield Agent Plugin?",
    a: "It is a portable package that carries the LyraShield MCP descriptor and security guidance. Each client still controls activation through its own documented local, marketplace or MCP settings path.",
  },
  {
    q: "Which clients have a native package path?",
    a: "Portable plugin artifacts are prepared for Claude Code, Cursor, OpenAI Codex and GitHub Copilot, but their marketplace listings remain pending review and public readback. Use the direct MCP setup in each guide until those listings are verified. Kiro's native Power distribution is also in preparation; use its MCP settings fallback. CLI config installation and shared skills are separate and appear only for exact supported client contracts and documented skill paths.",
  },
  {
    q: "Do I need to log in before installing the plugin?",
    a: "For local stdio, run npx --yes lyrashield@0.2.14 login --oauth first so the MCP server can read the selected workspace credential. Hosted clients use their documented OAuth flow. The plugin listing remains pending; follow each client guide for its supported direct MCP fallback.",
  },
  {
    q: "Does the plugin let the agent change my code on its own?",
    a: "No. LyraShield findings and fixes are proposals requiring review before they land. A browser-confirmed OAuth delegation can run its recorded LyraShield workflows without repeated approval, but it remains limited by the user's current role, workspace, targets, profiles, budget, scope and connection expiry. LyraShield never auto-merges a pull request.",
  },
  {
    q: "Why does VS Code use an MCP config file instead of the plugin?",
    a: "No generated VS Code Agent Plugin shim exists. Its documented config path is .vscode/mcp.json, and CLI 0.2.14 includes a matching config installer. Preview it with npx --yes lyrashield@0.2.14 install vscode --dry-run, then run the install command after reviewing its changes. The VS Code guide documents the servers root key and per-entry stdio type. Runtime verification remains client-specific.",
  },
]

const { canonical, techArticle, breadcrumbList } = buildDocsJsonLd({
  origin,
  path: "/docs/integrations/agent-plugins",
  title,
  description,
  updatedDate,
  breadcrumbLabel: "Agent Plugins",
})
const jsonLd: unknown[] = [
  techArticle,
  breadcrumbList,
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqItems.map((item) => ({
      "@type": "Question",
      name: item.q,
      acceptedAnswer: { "@type": "Answer", text: item.a },
    })),
  },
]
---

<DocsLayout
  title={`${title} | LyraShield AI`}
  description={description}
  canonical={canonical}
  jsonLd={jsonLd}
  updatedDate={updatedDate}
  currentPath="/docs/integrations/agent-plugins"
>
  <h1>Agent Plugins</h1>
  <p>
    LyraShield prepares a portable plugin following the open{" "}
    <a href="https://agent-plugins.org" target="_blank" rel="noopener noreferrer"
      >Agent Plugins v1.0.0</a
    >{" "}
    format. One package bundles two things: the LyraShield MCP server, which gives your agent the
    scan, finding, fix-plan and verify tools and a security skill that tells the agent when to
    reach for them. Each client still activates the package through its own supported path.
  </p>

  <h2>Public Agent Plugin listings pending</h2>
  <p>
    The portable Agent Plugin package <code>@lyrashield/agent-plugin@0.1.31</code> is published and
    passes offline Agent Plugins schema validation. Public marketplace listings and authenticated
    client acceptance remain pending. The marketplace default branch is preparation only. Until each
    client's listing and runtime are verified, follow its direct MCP
    guides with <code>@lyrashield/mcp@0.2.12</code> and authenticate separately using
    <code>npx -y lyrashield@0.2.14 login --oauth</code>.
  </p>

  <h2>CLI config and skills setup</h2>
  <p>
    The pinned npm CLI is{" "}
    <a href="https://www.npmjs.com/package/lyrashield/v/0.2.14" target="_blank" rel="noreferrer">
      version 0.2.14
    </a>
    . Config-writing commands are available only where the guide provides an exact installer
    command. Shared skills can be installed only for clients with one documented skill path. For
    other clients, use the linked guide's documented manual or client-native setup.
  </p>
  <pre><code>npx --yes lyrashield@0.2.14 install vscode --dry-run</code></pre>
  <p>
    Review the output, then run <code>npx --yes lyrashield@0.2.14 install vscode</code> to write the
    supported VS Code entry. Use the linked client guides for other commands and skill paths. A
    config or skill install does not prove the client discovered or authenticated the integration.
  </p>

  <div class="callout">
    <strong>No credential in committed files:</strong> remote clients use hosted OAuth. Kiro's local
    stdio server reads <code>~/.lyrashield/credentials.json</code>. A workspace API key remains the
    explicit CI fallback; do not commit it.
  </div>

  <h2>Current guided setup paths</h2>
  <p>
    The published portable source package contains client artifacts, but its presence does not establish a public listing or authenticated client acceptance. Kiro's
    native Power distribution is in preparation and is not publicly installable yet; its guide
    documents the MCP settings fallback. Other clients use the configuration, vendor CLI
    or guided-manual path documented in their own guide. Marketplace availability and runtime
    acceptance are tracked independently.
  </p>
  <table>
    <thead>
      <tr>
        <th>Client</th>
        <th>Activation</th>
        <th>Current setup</th>
      </tr>
    </thead>
    <tbody>
      {launchClients.map((client) => (
        <tr>
          <td><a href={`/docs/integrations/${client.slug}`}>{client.name}</a></td>
          <td><code>{client.path}</code></td>
          <td>{client.cliDefault}</td>
        </tr>
      ))}
    </tbody>
  </table>

  <div class="callout">
    <strong>VS Code uses MCP configuration:</strong> no generated Agent Plugin shim exists for VS
    Code. Preview with <code>npx --yes lyrashield@0.2.14 install vscode --dry-run</code>, then run{" "}
    <code>npx --yes lyrashield@0.2.14 install vscode</code> after reviewing the changes. See the{" "}
    <a href="/docs/integrations/vscode">VS Code guide</a> for the current settings and manual path.
  </div>

  <h2>What the skill adds</h2>
  <p>
    The MCP server alone gives an agent tools; the bundled skill gives it judgement about depth. It
    maps a request like a pre-commit diff check to a quick bounded review and a deep security
    review to the intrusive agentic mode that only runs inside the authorised isolated sandbox for a
    repository target. That keeps a routine check from silently becoming a long expensive scan.
    Install shared skills with the pinned CLI only when the client guide documents a matching skill
    directory; skills are not proof of marketplace availability or client acceptance.
  </p>

  <h2>Findings are proposals, not automatic changes</h2>
  <p>
    Installing the plugin does not let an agent rewrite your code unattended. During remote OAuth,
    the user chooses one workspace and the requested workflows. Matching calls can then run without
    repeated LyraShield approval, while current role, target access, profile, budget, connection,
    scope, expiry and idempotency checks still apply. Mutating calls authenticated with an API key
    receive a connect_required response pointing at OAuth connect and out-of-grant delegated calls
    are denied. Historical <a href="/docs/approvals">exact-input approval records</a> are separate
    from active hosted delegation. Fixes and pull requests
    remain proposals requiring review before they land; LyraShield never merges them automatically.
  </p>

  <h2>Uninstall</h2>
  <p>
    Marketplace and UI installations must be removed through that client's own plugin manager.
    For CLI-managed config, preview removal for a supported client, then remove only the LyraShield
    entry. Preserve all other configuration.
  </p>
  <pre><code>npx --yes lyrashield@0.2.14 uninstall vscode --dry-run
npx --yes lyrashield@0.2.14 uninstall vscode</code></pre>

  <h2>Frequently asked questions</h2>
  {faqItems.map((item) => (
    <>
      <h3>{item.q}</h3>
      <p>{item.a}</p>
    </>
  ))}

  <div class="callout">
    <strong>Requirements:</strong> Node.js 24+ and a LyraShield account. LyraShield is live with
    open registration in open beta and some platform features remain on the near-term roadmap. Get
    started at{" "}
    <a href="https://lyrashieldai.com" target="_blank" rel="noopener noreferrer">lyrashieldai.com</a
    >.
  </div>
</DocsLayout>
