---
import AgentSnippet from "@components/AgentSnippet.astro"
import DocsLayout from "@layouts/DocsLayout.astro"
import CliConfigPreview from "@components/integrations/CliConfigPreview.astro"
import { buildDocsJsonLd } from "../../../lib/docs-metadata"

const origin = Astro.site?.origin || "http://localhost:4321"
const title = "LyraShield MCP for GitHub Copilot CLI"
const description =
  "Connect LyraShield to GitHub Copilot CLI. Configure ~/.copilot/mcp-config.json with the stdio server or use the remote HTTP endpoint in cloud environments."
const updatedDate = "2026-10-02"

const { canonical, techArticle, breadcrumbList } = buildDocsJsonLd({
  origin,
  path: "/docs/integrations/copilot-cli",
  title,
  description,
  updatedDate,
  breadcrumbLabel: "GitHub Copilot CLI",
})
const jsonLd: unknown[] = [
  techArticle,
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    name: "Set up LyraShield MCP in GitHub Copilot CLI",
    step: [
      {
        "@type": "HowToStep",
        position: 1,
        name: "Open the MCP config",
        text: "Open or create ~/.copilot/mcp-config.json (global) or .mcp.json (project-level).",
      },
      {
        "@type": "HowToStep",
        position: 2,
        name: "Add the lyrashield entry",
        text: 'Add the mcpServers key with type "local", command "npx" and args ["-y","@lyrashield/mcp@0.2.12"]. Run npx -y lyrashield@0.2.14 login --oauth in the same OS account; the stdio server reads the local credential store. Keep credentials out of the config.',
      },
      {
        "@type": "HowToStep",
        position: 3,
        name: "Verify with copilot mcp list",
        text: "Run copilot mcp list to confirm the lyrashield server is registered.",
      },
    ],
  },
  breadcrumbList,
]
---

<DocsLayout
  title={`${title} | LyraShield AI`}
  description={description}
  canonical={canonical}
  jsonLd={jsonLd}
  updatedDate={updatedDate}
  currentPath="/docs/integrations/copilot-cli"
>
  <h1>GitHub Copilot CLI</h1>
  <p>
    GitHub Copilot CLI reads MCP server configuration from <code>~/.copilot/mcp-config.json</code>{" "}
    (global), <code>.mcp.json</code> (project) or <code>.github/mcp.json</code> (project). You can
    also manage servers with the <code>copilot mcp add</code> command.
  </p>

  <CliConfigPreview agentId="copilot-cli" />
  <p>Merge the current configuration by hand below; Node.js 24 or newer is required for local stdio.</p>

  <h2>Local stdio setup</h2>
  <p>
    Add the following to <code>~/.copilot/mcp-config.json</code> or <code>.mcp.json</code>. Preserve
    other entries. Authenticate separately with <code>npx -y lyrashield@0.2.14 login --oauth</code>{" "}
    in the same OS account and select the intended workspace.
  </p>

  <AgentSnippet agentId="copilot-cli" transport="stdio" />

  <div class="callout">
    <strong>type field:</strong> Copilot CLI stdio entries use <code>"type": "local"</code> (or{" "}
    <code>"stdio"</code>). Each entry may also carry a <code>tools</code> array (e.g.{" "}
    <code>["*"]</code>) to allowlist server tools. GitHub's own built-in MCP server does not need to
    be added manually.
  </div>

  <h2>Remote HTTP setup</h2>
  <p>
    For environments where you prefer not to run a local process, connect to the remote endpoint.
  </p>

  <AgentSnippet agentId="copilot-cli" transport="remote-http" secondary />

  <div class="callout">
    <strong>Remote authorization:</strong> Browser-confirmed OAuth delegations run matching actions
    without repeated approval. Mutating calls authenticated with an API key receive a
    connect_required response pointing at OAuth connect and out-of-grant delegated calls are denied.
    Local stdio approval is separate from hosted delegation.
  </div>

  <h2>Verify the connection</h2>
  <p>
    Run <code>copilot mcp list</code> to confirm the lyrashield server is registered. Then ask Copilot to call <code>lyrashield_list_workspaces</code> and confirm the intended workspace.
    Server discovery and an authenticated read are separate checks.
  </p>

  <div class="callout callout--warn">
    <strong>Requirements:</strong> For local stdio, Node.js 24+ and a local OAuth login or workspace API key. Remote OAuth needs no local key. The{" "}
    <code>@lyrashield/mcp</code> package is published on npm, so{" "}
    <code>npx -y @lyrashield/mcp@0.2.12</code> resolves directly.
  </div>
</DocsLayout>
