---
import AgentSnippet from "@components/AgentSnippet.astro"
import DocsLayout from "@layouts/DocsLayout.astro"

const origin = Astro.site?.origin || "http://localhost:4321"
const canonical = new URL("/docs/integrations/amp", origin).toString()
const title = "LyraShield MCP for Amp (Sourcegraph) — Setup Guide"
const description =
  "Add the LyraShield MCP server to Amp using its CLI. Keep credentials in your shell environment, and choose an always-available server or a task-scoped Agent Skill."
const updatedDate = "2026-08-13"

const jsonLd: unknown[] = [
  {
    "@context": "https://schema.org",
    "@type": "TechArticle",
    headline: title,
    description,
    url: canonical,
    dateModified: updatedDate,
    author: { "@id": `${origin}/#organization` },
    publisher: { "@id": `${origin}/#organization` },
    inLanguage: "en-US",
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${origin}/` },
      {
        "@type": "ListItem",
        position: 2,
        name: "Integrations",
        item: `${origin}/docs/integrations`,
      },
      { "@type": "ListItem", position: 3, name: "Amp", item: canonical },
    ],
  },
]
---

<DocsLayout
  title={`${title} | LyraShield AI`}
  description={description}
  canonical={canonical}
  jsonLd={jsonLd}
  updatedDate={updatedDate}
  currentPath="/docs/integrations/amp"
>
  <h1>Amp</h1>
  <p>
    Amp uses a CLI command to register MCP servers. It can also load MCP configuration from an
    Agent Skill, which keeps the tools out of context until that skill is needed.
  </p>

  <div class="callout">
    <strong>Keep secrets out of config:</strong> Set your API key as a shell environment variable
    rather than hardcoding it in a command or settings file.
  </div>

  <h2>Install with the CLI (fastest)</h2>
  <p>
    Run <code>npx lyrashield install amp</code>. It shells out to <code>amp mcp add</code> on your
    behalf with the correct command and arguments filled in — the same result as the manual step
    below, without retyping it. You still need <code>LYRASHIELD_API_KEY</code> exported in your
    shell profile first, since Amp reads it from the environment rather than from the command.
  </p>
  <pre><code>npx lyrashield install amp</code></pre>

  <h2>Register via CLI</h2>
  <p>
    Run the following command in your terminal. Export <code>LYRASHIELD_API_KEY</code> in your
    shell profile (<code>~/.bashrc</code>, <code>~/.zshrc</code>, etc.) so it is available when
    Amp starts the server.
  </p>

  <AgentSnippet agentId="amp" />

  <h2>Verify the connection</h2>
  <p>
    List registered servers with <code>amp mcp list</code>. The lyrashield server should appear.
    Start Amp and ask: <em>"What LyraShield tools are available?"</em> to confirm tools surface
    correctly.
  </p>

  <div class="callout callout--warn">
    <strong>Requirements:</strong> Node.js 24+ and a LyraShield workspace API key. The
    <code>@lyrashield/mcp</code> package is published on npm, so
    <code>npx -y @lyrashield/mcp</code> resolves directly.
  </div>
</DocsLayout>
