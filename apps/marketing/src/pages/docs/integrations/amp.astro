---
import AgentSnippet from "@components/AgentSnippet.astro"
import DocsLayout from "@layouts/DocsLayout.astro"
import { buildDocsJsonLd } from "../../../lib/docs-metadata"

const origin = Astro.site?.origin || "http://localhost:4321"
const title = "LyraShield MCP for Amp (Sourcegraph)"
const description =
  "Add the LyraShield MCP server to Amp using its CLI. Keep credentials in your shell environment, and choose an always-on or task-scoped Agent Skill."
const updatedDate = "2026-09-19"

const { canonical, techArticle, breadcrumbList } = buildDocsJsonLd({
  origin,
  path: "/docs/integrations/amp",
  title,
  description,
  updatedDate,
  breadcrumbLabel: "Amp",
})
const jsonLd: unknown[] = [techArticle, breadcrumbList]
---

<DocsLayout
  title={`${title} | LyraShield AI`}
  description={description}
  canonical={canonical}
  jsonLd={jsonLd}
  updatedDate={updatedDate}
  currentPath="/docs/integrations/amp"
>
  <h1>Amp</h1>
  <p>
    Amp uses a CLI command to register MCP servers. It can also load MCP configuration from an
    Agent Skill, which keeps the tools out of context until that skill is needed.
  </p>

  <div class="callout">
    <strong>Keep secrets out of config:</strong> Local stdio can use a LyraShield CLI OAuth login.
    For an API-key fallback, export it in the shell rather than hardcoding it in a command or settings file.
  </div>

  <h2>Install with the CLI (fastest)</h2>
  <p>
    Run <code>npx lyrashield install amp</code>. It shells out to <code>amp mcp add</code> on your
    behalf with the correct command and arguments filled in — the same result as the manual step
    below, without retyping it. Use <code>lyrashield login --oauth</code> for the local credential
    store, or export <code>LYRASHIELD_API_KEY</code> for an API-key fallback.
  </p>
  <pre><code>npx lyrashield install amp</code></pre>

  <h2>Register via CLI</h2>
  <p>
    Run the following command in your terminal. Export <code>LYRASHIELD_API_KEY</code> in your
    shell profile (<code>~/.bashrc</code>, <code>~/.zshrc</code>, etc.) so it is available when
    Amp starts the server.
  </p>

  <AgentSnippet agentId="amp" />

  <h2>Remote OAuth alternative</h2>
  <p>
    Current Amp also supports client-managed remote MCP definitions and OAuth. Use the command
    below as a separate connection, then verify tool discovery and a read call before replacing stdio.
  </p>
  <pre><code>amp mcp remote --personal add LyraShield https://app.lyrashieldai.com/api/mcp --auth oauth</code></pre>

  <h2>Verify the connection</h2>
  <p>
    List registered servers with <code>amp mcp list</code>. The lyrashield server should appear.
    Start Amp and ask: <em>"What LyraShield tools are available?"</em> to confirm tools surface
    correctly.
  </p>

  <div class="callout callout--warn">
    <strong>Requirements:</strong> For local stdio, Node.js 24+ and a local OAuth login or workspace API key. Remote OAuth needs no local key. The{" "}
    <code>@lyrashield/mcp</code> package is published on npm, so{" "}
    <code>npx -y @lyrashield/mcp@0.2.8</code> resolves directly.
  </div>
</DocsLayout>
