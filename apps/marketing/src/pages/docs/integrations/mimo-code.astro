---
import AgentSnippet from "@components/AgentSnippet.astro"
import DocsLayout from "@layouts/DocsLayout.astro"

const origin = Astro.site?.origin || "http://localhost:4321"
const canonical = new URL("/docs/integrations/mimo-code", origin).toString()
const title = "LyraShield MCP for MiMo Code — Setup Guide"
const description =
  "Connect LyraShield to MiMo Code (Xiaomi). Configure .mimocode/mimocode.jsonc with the mcp root key — not mcpServers — using array-command format for stdio or type: remote for HTTP."
const updatedDate = "2026-08-07"

const jsonLd: unknown[] = [
  {
    "@context": "https://schema.org",
    "@type": "TechArticle",
    headline: title,
    description,
    url: canonical,
    dateModified: updatedDate,
    author: { "@id": `${origin}/#organization` },
    publisher: { "@id": `${origin}/#organization` },
    inLanguage: "en-US",
  },
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    name: "Set up LyraShield MCP in MiMo Code",
    step: [
      {
        "@type": "HowToStep",
        position: 1,
        name: "Open the MiMo Code config",
        text: "Open or create .mimocode/mimocode.jsonc (project) or ~/.config/mimocode/mimocode.jsonc (global).",
      },
      {
        "@type": "HowToStep",
        position: 2,
        name: "Add the mcp entry",
        text: 'Add the mcp root key (not mcpServers) with type "local", command as an array, environment, and enabled: true.',
      },
      {
        "@type": "HowToStep",
        position: 3,
        name: "Reload MiMo Code",
        text: "Restart MiMo Code to apply the new config.",
      },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${origin}/` },
      {
        "@type": "ListItem",
        position: 2,
        name: "Integrations",
        item: `${origin}/docs/integrations`,
      },
      { "@type": "ListItem", position: 3, name: "MiMo Code", item: canonical },
    ],
  },
]
---

<DocsLayout
  title={`${title} | LyraShield AI`}
  description={description}
  canonical={canonical}
  jsonLd={jsonLd}
  updatedDate={updatedDate}
  currentPath="/docs/integrations/mimo-code"
>
  <h1>MiMo Code</h1>
  <p>
    MiMo Code (by Xiaomi) reads MCP server configuration from{" "}
    <code>.mimocode/mimocode.jsonc</code> (project) or{" "}
    <code>~/.config/mimocode/mimocode.jsonc</code> (global). The root key is <code>mcp</code>, not{" "}
    <code>mcpServers</code>.
  </p>

  <h2>Install with the CLI (fastest)</h2>
  <p>
    Run <code>npx lyrashield install mimo-code</code> from your project root. It detects MiMo Code,
    writes the correct config automatically, and never inlines your API key into a file you might
    commit. Add <code>--dry-run</code> first to preview the change with no write, or run{" "}
    <code>npx lyrashield doctor</code> afterward to confirm it's configured correctly.
  </p>
  <pre><code>npx lyrashield install mimo-code</code></pre>
  <p>Prefer to see exactly what gets written, or set it up without Node.js? Configure it by hand below.</p>

  <div class="callout callout--warn">
    <strong>Gotcha — root key is <code>mcp</code>, not <code>mcpServers</code>:</strong> Using{" "}
    <code>mcpServers</code> silently fails. MiMo Code uses a different root key than most editors.
  </div>

  <h2>Local stdio setup</h2>
  <p>
    Add the following to <code>.mimocode/mimocode.jsonc</code> or{" "}
    <code>~/.config/mimocode/mimocode.jsonc</code>. MiMo Code uses <code>type: "local"</code> with{" "}
    <code>command</code> as an array (e.g. <code>["npx","-y","@lyrashield/mcp"]</code>) and an{" "}
    <code>environment</code> object, plus an <code>enabled</code> boolean.
  </p>

  <AgentSnippet agentId="mimo-code" transport="stdio" />

  <h2>Remote HTTP setup</h2>
  <p>
    For environments where you prefer not to run a local process, connect to the remote endpoint.
    MiMo Code uses <code>type: "remote"</code> with <code>url</code> + <code>headers</code> and{" "}
    <code>enabled</code>. OAuth is handled automatically.
  </p>

  <AgentSnippet agentId="mimo-code" transport="remote-http" />

  <div class="callout">
    <strong>Read-only vs. read-and-write:</strong> Remote mutating tools (scan triggers, finding
    submissions, report creation) require a read-and-write API key and a human out-of-band
    approval. Read-only inspection tools work with any key.
  </div>

  <h2>Verify the connection</h2>
  <p>
    Restart MiMo Code and ask: <em>"What LyraShield tools do you have access to?"</em> to confirm
    the server is connected.
  </p>

  <div class="callout callout--warn">
    <strong>Requirements:</strong> Node.js 20+ and a LyraShield workspace API key. The
    <code>@lyrashield/mcp</code> package is published on npm, so
    <code>npx -y @lyrashield/mcp</code> resolves directly.
  </div>
</DocsLayout>
