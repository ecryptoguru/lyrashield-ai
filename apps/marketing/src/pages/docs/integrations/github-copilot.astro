---
import AgentSnippet from "@components/AgentSnippet.astro"
import DocsLayout from "@layouts/DocsLayout.astro"
import { buildDocsJsonLd } from "../../../lib/docs-metadata"

const origin = Astro.site?.origin || "http://localhost:4321"
const title = "LyraShield MCP for GitHub Copilot"
const description =
  "Connect GitHub Copilot CLI through the currently published pinned LyraShield MCP server. Agent Plugin distribution remains pending."
const updatedDate = "2026-10-02"

const { canonical, techArticle, breadcrumbList } = buildDocsJsonLd({
  origin,
  path: "/docs/integrations/github-copilot",
  title,
  description,
  updatedDate,
  breadcrumbLabel: "GitHub Copilot",
})
const jsonLd: unknown[] = [
  techArticle,
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    name: "Set up LyraShield MCP in GitHub Copilot CLI",
    step: [
      {
        "@type": "HowToStep",
        position: 1,
        name: "Authenticate local stdio",
        text: "Run npx -y lyrashield@0.2.13 login --oauth in the same OS account and select one workspace.",
      },
      {
        "@type": "HowToStep",
        position: 2,
        name: "Configure the pinned MCP server",
        text: 'Merge mcpServers.lyrashield into ~/.copilot/mcp-config.json with type "local", command "npx" and args ["-y", "@lyrashield/mcp@0.2.11"]. Preserve existing servers and keep credentials out of the config.',
      },
      {
        "@type": "HowToStep",
        position: 3,
        name: "Confirm client discovery",
        text: "Restart Copilot CLI and run /mcp show lyrashield in its interactive session to inspect connection status and tools.",
      },
      {
        "@type": "HowToStep",
        position: 4,
        name: "Verify an authenticated read",
        text: "Ask Copilot to call lyrashield_list_workspaces and confirm the expected workspace. Discovery alone does not prove authorization.",
      },
    ],
  },
  breadcrumbList,
]
---

<DocsLayout
  title={`${title} | LyraShield AI`}
  description={description}
  canonical={canonical}
  jsonLd={jsonLd}
  updatedDate={updatedDate}
  currentPath="/docs/integrations/github-copilot"
>
  <h1>GitHub Copilot</h1>
  <p>
    Use the currently published local stdio MCP server with GitHub Copilot CLI. This guide is for
    the CLI; <a href="/docs/integrations/vscode">Copilot in VS Code</a> and
    <a href="/docs/integrations/github-copilot-cloud-agent">Copilot Cloud Agent</a> have separate
    configuration and authentication contracts.
  </p>

  <h2>Agent Plugin release pending</h2>
  <p>
    The marketplace repository's default branch contains preparation artifacts. Do not install
    from that branch or enable its plugin in shared settings. A reviewed matching immutable
    package release is required before plugin installation can be recommended. The published CLI
    0.2.13 still prints older marketplace instructions; follow the direct MCP steps here instead.
  </p>

  <h2>Authenticate local stdio</h2>
  <p>
    Use Node.js 24 or newer. Run this command in the same OS account that runs Copilot CLI, then
    select the intended LyraShield workspace in the browser:
  </p>
  <pre><code>npx -y lyrashield@0.2.13 login --oauth</code></pre>
  <p>
    The local MCP server reads the CLI credential store. Keep credentials out of committed files;
    authentication is separate from adding or discovering the server.
  </p>

  <h2>Configure the pinned MCP server</h2>
  <p>
    Merge this entry into <code>~/.copilot/mcp-config.json</code>, preserving other servers. Use
    <code>mcpServers</code> and <code>type: "local"</code> for Copilot CLI. Published CLI config
    writes remain withheld pending the safe writer release.
  </p>
  <AgentSnippet agentId="copilot-cli" transport="stdio" />

  <h2>Confirm client discovery</h2>
  <p>
    Restart Copilot CLI, then enter <code>/mcp show lyrashield</code> in the interactive session to
    inspect the server status and available tools. A listed server proves discovery; it does not
    prove authenticated access to a workspace.
  </p>

  <h2>Verify an authenticated read</h2>
  <p>
    Ask Copilot to call <code>lyrashield_list_workspaces</code> and confirm the expected workspace,
    then list its authorized targets. If consent expires, repeat CLI OAuth login and restart the
    client. This read-only check does not start a scan or prove approval-bound write behavior.
  </p>
  <p>
    See <a href="/docs/integrations/copilot-cli">Copilot CLI MCP configuration</a> for project scope
    and the separate remote HTTP alternative. Client-runtime acceptance remains a separate gate.
  </p>
</DocsLayout>
