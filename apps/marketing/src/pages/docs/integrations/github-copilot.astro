---
import DocsLayout from "@layouts/DocsLayout.astro"

const origin = Astro.site?.origin || "http://localhost:4321"
const canonical = new URL("/docs/integrations/github-copilot", origin).toString()
const title = "LyraShield Agent Plugin for GitHub Copilot — Setup Guide"
const description =
  "Install the LyraShield Agent Plugin through GitHub Copilot's documented marketplace flow."
const updatedDate = "2026-09-08"

const jsonLd: unknown[] = [
  {
    "@context": "https://schema.org",
    "@type": "TechArticle",
    headline: title,
    description,
    url: canonical,
    dateModified: updatedDate,
    author: { "@id": `${origin}/#organization` },
    publisher: { "@id": `${origin}/#organization` },
    inLanguage: "en-US",
  },
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    name: "Install the LyraShield Agent Plugin for GitHub Copilot",
    step: [
      {
        "@type": "HowToStep",
        position: 1,
        name: "Add the marketplace",
        text: "Run copilot plugin marketplace add ecryptoguru/lyrashield-marketplace.",
      },
      {
        "@type": "HowToStep",
        position: 2,
        name: "Install the plugin",
        text: "Run copilot plugin install lyrashield@lyrashield-ai.",
      },
      {
        "@type": "HowToStep",
        position: 3,
        name: "Authenticate and verify",
        text: "Start Copilot, complete the hosted LyraShield OAuth flow, and verify a read-only workspace query.",
      },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${origin}/` },
      {
        "@type": "ListItem",
        position: 2,
        name: "Integrations",
        item: `${origin}/docs/integrations`,
      },
      { "@type": "ListItem", position: 3, name: "GitHub Copilot", item: canonical },
    ],
  },
]
---

<DocsLayout
  title={`${title} | LyraShield AI`}
  description={description}
  canonical={canonical}
  jsonLd={jsonLd}
  updatedDate={updatedDate}
  currentPath="/docs/integrations/github-copilot"
>
  <h1>GitHub Copilot</h1>
  <p>
    LyraShield ships a GitHub Copilot plugin with a portable manifest, MCP connection, and security
    skill. Copilot installs it through a registered marketplace, a repository, or a local path.
  </p>

  <h2>Install from the LyraShield marketplace</h2>
  <pre><code>copilot plugin marketplace add ecryptoguru/lyrashield-marketplace
copilot plugin install lyrashield@lyrashield-ai</code></pre>
  <p>
    <code>npx lyrashield install github-copilot</code> prints these commands. It does not copy the
    package into a private directory and claim that Copilot discovered it.
  </p>

  <div class="callout">
    <strong>No credential in committed files:</strong> the remote MCP endpoint authenticates through
    the client-hosted OAuth flow. The plugin contains no LyraShield API key.
  </div>

  <h2>What the plugin includes</h2>
  <ul>
    <li><strong>MCP server:</strong> the LyraShield tool surface through remote HTTP.</li>
    <li><strong>Security skill:</strong> guidance for when to run LyraShield checks during coding sessions.</li>
    <li><strong>Instructions:</strong> packaged guidance for LyraShield's evidence and approval boundaries.</li>
  </ul>

  <h2>Verify the connection</h2>
  <p>
    Start Copilot, complete LyraShield's hosted OAuth flow, and ask it to list LyraShield
    workspaces. A mutation must stay denied until the exact input is approved out of band.
  </p>

  <div class="callout callout--warn">
    <strong>Acceptance boundary:</strong> a valid manifest and successful marketplace install prove
    installability. Authenticated reads, approval-bound writes, revocation, restart, and upgrade
    need separate client-runtime receipts.
  </div>
</DocsLayout>
