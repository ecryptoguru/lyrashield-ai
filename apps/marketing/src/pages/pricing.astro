---
import Base from "@layouts/Base.astro"
import {
  CLOUD_PLANS,
  LOCAL_SKU_MAP,
  MINUTE_PACKS,
  PACK_VALIDITY_DAYS,
  formatINR,
  formatUSD,
  getPlan,
} from "@lyrashield/pricing"

const origin = Astro.site?.origin || "http://localhost:4321"
const canonical = new URL("/pricing", origin).toString()
const title = "Pricing — Cloud & Local Plans | LyraShield AI"
const description =
  "Cloud plans from $29 a month with a limited free trial of 60 agent-minutes and no card. Prepaid minute packs and annual billing are available; Local launches later."

const cloudPlans = CLOUD_PLANS.filter((plan) => plan.selfServe)
const enterprisePlan = getPlan("ENTERPRISE")

const pricingFaqs = [
  {
    q: "What is an agent-minute?",
    a: 'An agent-minute is a unit of wall-clock time — the real elapsed time from when a scan phase starts to when it ends, measured on the server clock. It is not "active-loop time" or "thinking time"; it includes all processing, network I/O and model calls within that phase. Deep and Custom scans consume agent-minutes at 3× the standard rate.',
  },
  {
    q: "Is there a free trial?",
    a: "Yes. New accounts can claim one 7-day limited trial with 60 agent-minutes and up to 3 targets, with no credit card required. Agency is purchase-only.",
  },
  {
    q: "What happens if I run out of agent-minutes?",
    a: `You can add a prepaid minute pack at any time. Packs are valid for ${PACK_VALIDITY_DAYS} days and are consumed after your monthly pool. Overage billing at $0.15/min with a spend limit is available on Agency.`,
  },
  {
    q: "Can I trial Agency?",
    a: "The free trial is a separate limited tier with 60 agent-minutes and three targets. Agency team seats and its 4,500-minute pool require a paid Agency subscription.",
  },
  {
    q: "Do prices include tax?",
    a: "India prices are GST-inclusive and billed in INR. Global billing is processed in USD by the merchant of record.",
  },
]

const tierIntents: Record<string, string> = {
  STARTER: "For solo builders reviewing up to five targets with standard scans.",
  PRO: "For solo builders who need Deep / Custom scans across up to 15 targets.",
  LAUNCH_ASSURANCE:
    "For agencies reviewing up to 50 targets with one five-member team sharing the buyer's minute pool.",
  ENTERPRISE: "For organisations that need custom limits and a contact-led rollout.",
}

const offers = cloudPlans.map((plan) => ({
  "@type": "Offer",
  name: `${plan.name} plan`,
  price: plan.price.usd.monthly,
  priceCurrency: "USD",
  availability: "https://schema.org/InStock",
  url: `${canonical}#cloud-pricing`,
  category: "Subscription",
}))

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: title,
    description,
    url: canonical,
    isPartOf: { "@id": `${origin}/#website` },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "@id": `${canonical}#faq`,
    mainEntity: pricingFaqs.map((item) => ({
      "@type": "Question",
      name: item.q,
      acceptedAnswer: { "@type": "Answer", text: item.a },
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "@id": `${canonical}#application`,
    name: "LyraShield AI",
    applicationCategory: "SecurityApplication",
    operatingSystem: "Web",
    description,
    url: canonical,
    provider: { "@id": `${origin}/#organization` },
    isPartOf: { "@id": `${origin}/#website` },
    offers,
  },
]

const minutePacks = MINUTE_PACKS

const localLaunch = LOCAL_SKU_MAP.individual_launch

const appUrl =
  (import.meta.env.PUBLIC_APP_URL as string | undefined)?.replace(/\/$/, "") ||
  "https://app.lyrashieldai.com"
---

<Base title={title} description={description} canonical={canonical} jsonLd={jsonLd}>
  <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="text-center">
      <h1 class="text-4xl font-bold tracking-tight text-text sm:text-5xl">
        Pricing
      </h1>
      <p class="mt-4 text-lg text-text-muted">
        Cloud subscriptions and local licenses. Try the limited Trial tier free; Agency requires a paid subscription.
      </p>
    </div>

    <!-- Cloud / Local Toggle -->
    <div class="mt-8 flex justify-center">
      <div
        class="inline-flex rounded-lg border border-border bg-bg-raised p-1"
        role="group"
        aria-label="Product mode"
      >
        <button
          id="tab-cloud"
          aria-pressed="true"
          class="rounded-md px-4 py-2 text-sm font-medium transition-colors bg-bg text-text shadow-sm"
        >
          Cloud
        </button>
        <button
          id="tab-local"
          aria-pressed="false"
          class="rounded-md px-4 py-2 text-sm font-medium transition-colors text-text-muted hover:text-text"
        >
          Local
        </button>
      </div>
    </div>

    <!-- Cloud Pricing -->
    <div id="cloud-pricing" class="mt-12">
      <!-- Currency + Billing Toggle -->
      <div class="mb-8 flex flex-col items-center gap-4 sm:flex-row sm:justify-center sm:gap-8">
        <div
          class="inline-flex rounded-lg border border-border bg-bg-raised p-1"
          role="group"
          aria-label="Currency"
        >
          <button
            id="cur-usd"
            aria-pressed="true"
            class="currency-btn rounded-md px-3 py-1.5 text-sm font-medium bg-bg text-text shadow-sm"
            >USD</button
          >
          <button
            id="cur-inr"
            aria-pressed="false"
            class="currency-btn rounded-md px-3 py-1.5 text-sm font-medium text-text-muted"
            >INR</button
          >
        </div>
        <div
          class="inline-flex rounded-lg border border-border bg-bg-raised p-1"
          role="group"
          aria-label="Billing interval"
        >
          <button
            id="int-monthly"
            aria-pressed="true"
            class="interval-btn rounded-md px-3 py-1.5 text-sm font-medium bg-bg text-text shadow-sm"
            >Monthly</button
          >
          <button
            id="int-annual"
            aria-pressed="false"
            class="interval-btn rounded-md px-3 py-1.5 text-sm font-medium text-text-muted"
            >Annual</button
          >
        </div>
      </div>

      <!-- Plan Cards -->
      <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
        {
          cloudPlans.map((plan) => (
            <div class="rounded-xl border border-border bg-bg-raised p-6 shadow-sm">
              {/* h2, not h3: these cards are the first headings after the page
                  h1, so h3 skipped a level (UF-08). Classes are unchanged, so
                  the visual size and weight are identical. */}
              <h2 class="text-lg font-semibold text-text">{plan.name}</h2>
              <p class="mt-2 text-sm text-text-muted">{tierIntents[plan.id]}</p>
              <div class="mt-4">
                <span
                  class="price-usd-monthly price text-3xl font-bold text-text"
                  data-monthly={plan.price.usd.monthly}
                  data-annual={plan.price.usd.annual}
                >
                  ${plan.price.usd.monthly}
                </span>
                <span class="price-usd-monthly text-sm text-text-muted">/mo</span>
                <span
                  class="price-usd-annual hidden text-3xl font-bold text-text"
                  data-monthly={plan.price.usd.monthly}
                  data-annual={plan.price.usd.annual}
                >
                  ${plan.price.usd.annual}
                </span>
                <span class="price-usd-annual hidden text-sm text-text-muted">
                  /yr
                </span>
                <span class="price-inr-monthly hidden text-3xl font-bold text-text">
                  ₹{plan.price.inr.monthly.toLocaleString("en-IN")}
                </span>
                <span class="price-inr-monthly hidden text-sm text-text-muted">
                  /mo
                </span>
                <span class="price-inr-annual hidden text-3xl font-bold text-text">
                  ₹{plan.price.inr.annual.toLocaleString("en-IN")}
                </span>
                <span class="price-inr-annual hidden text-sm text-text-muted">
                  /yr
                </span>
              </div>
              <ul class="mt-4 space-y-2">
                {plan.features.map((feature) => (
                  <li class="flex items-start gap-2 text-sm text-text-muted">
                    <svg
                      class="h-4 w-4 shrink-0 text-green-500"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                      stroke-width="2"
                    >
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                    </svg>
                    {feature}
                  </li>
                ))}
              </ul>
              <a
                href={`${appUrl}/sign-up?plan=${plan.id}`}
                class="mt-6 block w-full rounded-lg bg-accent px-4 py-2.5 text-center text-sm font-semibold text-bg hover:bg-accent/90 transition-colors"
              >
                {plan.id === "LAUNCH_ASSURANCE" ? "Choose Agency" : `Start with ${plan.name}`}
              </a>
            </div>
          ))
        }
      </div>

      <!-- Enforced plan differences -->
      <div class="mt-10">
        <h2 class="text-2xl font-bold text-text">What changes between plans</h2>
        <p class="mt-2 text-sm text-text-muted">
          Every paid plan includes the assurance tools below. Choose by review depth, monthly capacity, targets and team size.
        </p>
        <p class="mt-3 text-xs text-text-muted sm:hidden">Swipe sideways to compare all three plans.</p>
        <!-- The table is 608px wide and the wrapper scrolls it at narrow widths,
             so the region itself has to be reachable by keyboard (axe
             `scrollable-region-focusable`). Same pattern as the dashboard tables. -->
        <div
          class="mt-5 overflow-x-auto rounded-lg border border-border focus-visible:ring-2 focus-visible:ring-accent"
          tabindex="0"
          role="region"
          aria-label="Plan comparison"
        >
          <table class="w-full min-w-152 border-collapse text-left text-sm">
            <caption class="sr-only">Comparison of Starter, Pro and Agency plan limits</caption>
            <thead class="bg-bg-raised text-text">
              <tr>
                <th scope="col" class="sticky left-0 bg-bg-raised px-4 py-3 font-semibold">Plan difference</th>
                {cloudPlans.map((plan) => (
                  <th scope="col" class="px-4 py-3 font-semibold">{plan.name}</th>
                ))}
              </tr>
            </thead>
            <tbody class="text-text-muted">
              <tr class="border-t border-border">
                <th scope="row" class="sticky left-0 bg-bg px-4 py-3 font-medium text-text">Included agent-minutes / month</th>
                {cloudPlans.map((plan) => (
                  <td class="px-4 py-3">{plan.agentMinutes.toLocaleString()}</td>
                ))}
              </tr>
              <tr class="border-t border-border">
                <th scope="row" class="sticky left-0 bg-bg px-4 py-3 font-medium text-text">Protected targets</th>
                {cloudPlans.map((plan) => (
                  <td class="px-4 py-3">Up to {plan.targetCaps}</td>
                ))}
              </tr>
              <tr class="border-t border-border">
                <th scope="row" class="sticky left-0 bg-bg px-4 py-3 font-medium text-text">Workspace members</th>
                {cloudPlans.map((plan) => (
                  <td class="px-4 py-3">Up to {plan.memberSeats}{plan.id === "LAUNCH_ASSURANCE" ? " · shared minute pool" : ""}</td>
                ))}
              </tr>
              <tr class="border-t border-border">
                <th scope="row" class="sticky left-0 bg-bg px-4 py-3 font-medium text-text">Scan modes</th>
                {cloudPlans.map((plan) => (
                  <td class="px-4 py-3">
                    Safe, Quick, Standard{plan.deepAllowed ? ", Deep, Custom" : ""}
                  </td>
                ))}
              </tr>
              <tr class="border-t border-border">
                <th scope="row" class="sticky left-0 bg-bg px-4 py-3 font-medium text-text">Overage after minutes and packs</th>
                {cloudPlans.map((plan) => (
                  <td class="px-4 py-3">
                    {plan.id === "LAUNCH_ASSURANCE" ? "$0.15/min with a spend limit" : "Not available"}
                  </td>
                ))}
              </tr>
            </tbody>
          </table>
        </div>
        <p class="mt-3 text-xs text-text-muted">
          Deep and Custom scans use agent-minutes at 3× the standard rate. Prepaid minute packs are available on every plan.
        </p>
      </div>

      <!-- Shared capabilities and CI setup -->
      <div class="mt-8 rounded-lg border border-border bg-bg-raised p-4">
        <h3 class="font-semibold text-text">Included across plans</h3>
        <p class="mt-2 text-sm text-text-muted">
          The free GitHub Action runs scan-level SARIF in GitHub repositories without a LyraShield account or API key.
        </p>
        <p class="mt-2 text-sm text-text-muted">
          Eligible workspace members on every plan can connect the CLI and MCP server, review repository MCP and WebMCP findings, use the Evidence Vault and retests, and access versioned launch verdicts, launch reports and shareable scorecards. Scans follow each plan's minutes, target limits and modes.
        </p>
        <p class="mt-2 text-sm text-text-muted">
          To block merges on a verdict, run the CLI verdict command in CI and require its check in your repository settings.
        </p>
      </div>

      <!-- Minute Packs Section -->
      <div class="mt-16">
        <h2 class="text-2xl font-bold text-text">Minute Packs</h2>
        <p class="mt-2 text-sm text-text-muted">
          Add prepaid agent-minutes to any plan. Packs are valid for {PACK_VALIDITY_DAYS} days and
          are consumed after your monthly pool.
        </p>
        <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-3">
          {
            minutePacks.map((pack) => (
              <div class="rounded-lg border border-border bg-bg-raised p-4">
                <h3 class="font-semibold text-text">{pack.name}</h3>
                <p class="mt-2 text-2xl font-bold text-text">
                  USD ${pack.priceUsd}
                </p>
                <p class="text-sm text-text-muted">{pack.minutes} agent-minutes</p>
                <p class="mt-1 text-xs text-text-muted">Valid for {PACK_VALIDITY_DAYS} days</p>
              </div>
            ))
          }
        </div>
      </div>

      <!-- Enterprise Contact-Led -->
      <div
        class="mt-12 rounded-xl border border-border bg-bg-raised p-8"
      >
        <h2 class="text-2xl font-bold text-text">Enterprise</h2>
        <p class="mt-2 text-sm text-text-muted">{tierIntents.ENTERPRISE}</p>
        <p class="mt-3">
          <span class="price-usd-monthly text-2xl font-bold text-text"
            >From ${enterprisePlan.price.usd.monthly.toLocaleString("en-US")}/mo</span
          >
          <span class="price-usd-annual hidden text-2xl font-bold text-text"
            >From ${enterprisePlan.price.usd.monthly.toLocaleString("en-US")}/mo</span
          >
          <span class="price-inr-monthly hidden text-2xl font-bold text-text"
            >From ₹{enterprisePlan.price.inr.monthly.toLocaleString("en-IN")}/mo</span
          >
          <span class="price-inr-annual hidden text-2xl font-bold text-text"
            >From ₹{enterprisePlan.price.inr.monthly.toLocaleString("en-IN")}/mo</span
          >
        </p>
        <ul class="mt-4 space-y-2">
          {enterprisePlan.features.map((feature) => (
            <li class="flex items-start gap-2 text-sm text-text-muted">
              <svg
                class="h-4 w-4 shrink-0 text-green-500"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
              {feature}
            </li>
          ))}
        </ul>
        <a
          href="/support"
          class="mt-4 inline-block rounded-lg border border-accent px-6 py-2.5 text-sm font-semibold text-accent hover:bg-accent-dim/40 transition-colors"
        >
          Contact Sales
        </a>
      </div>

      <!-- Trial CTA -->
      <div class="mt-12 text-center">
        <h2 class="text-xl font-semibold text-text">
          Not sure yet? Start with a free trial.
        </h2>
        <p class="mt-2 text-sm text-text-muted">
          60 agent-minutes, up to 3 targets, 7 days. No credit card required.
        </p>
        <a
          href={`${appUrl}/sign-up`}
          class="mt-4 inline-block rounded-lg bg-accent px-6 py-2.5 text-sm font-semibold text-bg hover:bg-accent/90 transition-colors"
        >
          Start Free Trial
        </a>
      </div>

      <!-- Free trial -->
      <div class="mt-12 rounded-lg bg-accent-dim/30 p-4 text-center">
        <p class="text-sm text-text-muted">
          Start with a 7-day free trial — no credit card required.
        </p>
      </div>
    </div>

    <!-- Local Pricing -->
    <div id="local-pricing" class="mt-12 hidden">
      <div class="relative mx-auto max-w-xl overflow-hidden rounded-xl border border-border bg-bg-raised">
        <div aria-hidden="true" inert class="pointer-events-none select-none space-y-5 p-6 blur-sm opacity-50">
          <p class="text-xs font-semibold uppercase tracking-wider text-accent">Local license</p>
          <h3 class="text-xl font-semibold text-text">{localLaunch.name}</h3>
          <p class="text-3xl font-bold text-text">{formatUSD(localLaunch.priceUsd)}</p>
          <p class="text-lg font-semibold text-text">{formatINR(localLaunch.priceInr!)}</p>
          <p class="text-sm text-text-muted">{localLaunch.description}</p>
        </div>
        <div class="absolute inset-0 flex flex-col items-center justify-center bg-bg/75 px-6 text-center">
          <span class="rounded-full border border-accent/40 bg-bg-raised px-3 py-1 text-xs font-semibold uppercase tracking-wider text-accent">Launching later</span>
          <h2 class="mt-4 text-2xl font-bold text-text">Local is launching later</h2>
          <p class="mt-2 max-w-sm text-sm text-text-muted">Cloud plans are available now. Local license details and purchasing will open at launch.</p>
        </div>
      </div>
    </div>

    <!-- Agent-minute definition -->
    <div
      class="mt-16 rounded-xl border border-border bg-bg-raised p-6"
    >
      <h2 class="text-xl font-bold text-text">What is an agent-minute?</h2>
      <p class="mt-2 text-sm text-text-muted">
        An agent-minute is a unit of wall-clock time — the real elapsed time from when a scan phase
        starts to when it ends, measured on the server clock. It is not "active-loop time" or
        "thinking time"; it includes all processing, network I/O and model calls within that phase.
        Deep and Custom scans consume agent-minutes at 3× the standard rate.
      </p>
      <p class="mt-3 text-sm text-text-muted">
        Overage (when all included minutes and packs are exhausted) is billed at $0.15/min for
        Agency plans with a spend limit configured. Minute packs are valid for {PACK_VALIDITY_DAYS}
        days from purchase.
      </p>
    </div>

    <!-- Pricing FAQ -->
    <section aria-labelledby="pricing-faq-heading" class="mt-16">
      <h2 id="pricing-faq-heading" class="text-2xl font-bold text-text">
        Pricing questions
      </h2>
      <div
        class="mt-6 divide-y divide-border rounded-xl border border-border bg-bg-raised"
      >
        {
          pricingFaqs.map((item) => (
            <details class="p-5">
              <summary class="cursor-pointer font-semibold text-text">
                {item.q}
              </summary>
              <p class="mt-3 text-sm leading-6 text-text-muted">{item.a}</p>
            </details>
          ))
        }
      </div>
    </section>
  </div>

  <script>
    // Cloud / Local toggle
    const tabCloud = document.getElementById("tab-cloud")
    const tabLocal = document.getElementById("tab-local")
    const cloudPricing = document.getElementById("cloud-pricing")
    const localPricing = document.getElementById("local-pricing")

    function setTab(active: "cloud" | "local") {
      tabCloud?.setAttribute("aria-pressed", String(active === "cloud"))
      tabLocal?.setAttribute("aria-pressed", String(active === "local"))
      if (active === "cloud") {
        tabCloud?.classList.add(
          "bg-bg",
          "text-text",
          "shadow-sm"
        )
        tabCloud?.classList.remove("text-text-muted")
        tabLocal?.classList.remove(
          "bg-bg",
          "text-text",
          "shadow-sm"
        )
        tabLocal?.classList.add("text-text-muted")
        cloudPricing?.classList.remove("hidden")
        localPricing?.classList.add("hidden")
      } else {
        tabLocal?.classList.add(
          "bg-bg",
          "text-text",
          "shadow-sm"
        )
        tabLocal?.classList.remove("text-text-muted")
        tabCloud?.classList.remove(
          "bg-bg",
          "text-text",
          "shadow-sm"
        )
        tabCloud?.classList.add("text-text-muted")
        localPricing?.classList.remove("hidden")
        cloudPricing?.classList.add("hidden")
      }
    }

    tabCloud?.addEventListener("click", () => setTab("cloud"))
    tabLocal?.addEventListener("click", () => setTab("local"))
    if (new URLSearchParams(window.location.search).get("mode") === "local") setTab("local")

    // Currency toggle
    const curUsd = document.getElementById("cur-usd")
    const curInr = document.getElementById("cur-inr")

    // Interval toggle
    const intMonthly = document.getElementById("int-monthly")
    const intAnnual = document.getElementById("int-annual")

    type Currency = "usd" | "inr"
    type Interval = "monthly" | "annual"

    function updatePrices(currency: Currency, interval: Interval) {
      // Hide all price elements
      document
        .querySelectorAll(
          ".price-usd-monthly, .price-usd-annual, .price-inr-monthly, .price-inr-annual"
        )
        .forEach((el) => {
          el.classList.add("hidden")
        })

      // Show the selected combination
      document.querySelectorAll(`.price-${currency}-${interval}`).forEach((el) => {
        el.classList.remove("hidden")
      })

      // Update button styles
      ;[curUsd, curInr].forEach((btn) => {
        btn?.classList.remove(
          "bg-bg",
          "text-text",
          "shadow-sm"
        )
        btn?.classList.add("text-text-muted")
      })
      ;[intMonthly, intAnnual].forEach((btn) => {
        btn?.classList.remove(
          "bg-bg",
          "text-text",
          "shadow-sm"
        )
        btn?.classList.add("text-text-muted")
      })

      const activeCur = currency === "usd" ? curUsd : curInr
      const activeInt = interval === "monthly" ? intMonthly : intAnnual
      curUsd?.setAttribute("aria-pressed", String(currency === "usd"))
      curInr?.setAttribute("aria-pressed", String(currency === "inr"))
      intMonthly?.setAttribute("aria-pressed", String(interval === "monthly"))
      intAnnual?.setAttribute("aria-pressed", String(interval === "annual"))
      activeCur?.classList.add("bg-bg", "text-text", "shadow-sm")
      activeCur?.classList.remove("text-text-muted")
      activeInt?.classList.add("bg-bg", "text-text", "shadow-sm")
      activeInt?.classList.remove("text-text-muted")
    }

    let currentCurrency: Currency = "usd"
    let currentInterval: Interval = "monthly"

    curUsd?.addEventListener("click", () => {
      currentCurrency = "usd"
      updatePrices(currentCurrency, currentInterval)
    })
    curInr?.addEventListener("click", () => {
      currentCurrency = "inr"
      updatePrices(currentCurrency, currentInterval)
    })
    intMonthly?.addEventListener("click", () => {
      currentInterval = "monthly"
      updatePrices(currentCurrency, currentInterval)
    })
    intAnnual?.addEventListener("click", () => {
      currentInterval = "annual"
      updatePrices(currentCurrency, currentInterval)
    })

  </script>
</Base>
