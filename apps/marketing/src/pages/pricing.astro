---
import Base from "@layouts/Base.astro"
import {
  CLOUD_PLANS,
  LOCAL_SKU_MAP,
  MINUTE_PACKS,
  formatINR,
  formatUSD,
  getPlan,
} from "@lyrashield/pricing"

const origin = Astro.site?.origin || "http://localhost:4321"
const canonical = new URL("/pricing", origin).toString()
const title = "Pricing — Cloud & Local Plans | LyraShield AI"
const description =
  "Cloud plans from Starter to Launch Assurance with monthly/annual billing, prepaid minute packs, and a 14-day free trial with no credit card required. Local licenses for self-hosted use. Agent-minutes are wall-clock time."

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: title,
    description,
    url: canonical,
    isPartOf: { "@id": `${origin}/#website` },
  },
]

const cloudPlans = CLOUD_PLANS.filter((plan) => plan.selfServe)
const enterprisePlan = getPlan("ENTERPRISE")

const minutePacks = MINUTE_PACKS

const localLaunch = LOCAL_SKU_MAP.individual_launch

const appUrl =
  (import.meta.env.PUBLIC_APP_URL as string | undefined)?.replace(/\/$/, "") ||
  "https://app.lyrashieldai.com"
---

<Base title={title} description={description} canonical={canonical} jsonLd={jsonLd}>
  <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="text-center">
      <h1 class="text-4xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-5xl">
        Pricing
      </h1>
      <p class="mt-4 text-lg text-gray-600 dark:text-gray-400">
        Cloud subscriptions and local licenses. Start with a free trial — no credit card required.
      </p>
    </div>

    <!-- Cloud / Local Toggle -->
    <div class="mt-8 flex justify-center">
      <div
        class="inline-flex rounded-lg border border-gray-200 bg-gray-50 p-1 dark:border-gray-700 dark:bg-gray-800"
        role="group"
        aria-label="Product mode"
      >
        <button
          id="tab-cloud"
          aria-pressed="true"
          class="rounded-md px-4 py-2 text-sm font-medium transition-colors bg-white text-gray-900 shadow-sm dark:bg-gray-700 dark:text-white"
        >
          Cloud
        </button>
        <button
          id="tab-local"
          aria-pressed="false"
          class="rounded-md px-4 py-2 text-sm font-medium transition-colors text-gray-500 hover:text-gray-900 dark:text-gray-400 dark:hover:text-white"
        >
          Local
        </button>
      </div>
    </div>

    <!-- Cloud Pricing -->
    <div id="cloud-pricing" class="mt-12">
      <!-- Currency + Billing Toggle -->
      <div class="mb-8 flex flex-col items-center gap-4 sm:flex-row sm:justify-center sm:gap-8">
        <div
          class="inline-flex rounded-lg border border-gray-200 bg-gray-50 p-1 dark:border-gray-700 dark:bg-gray-800"
          role="group"
          aria-label="Currency"
        >
          <button
            id="cur-usd"
            aria-pressed="true"
            class="currency-btn rounded-md px-3 py-1.5 text-sm font-medium bg-white text-gray-900 shadow-sm dark:bg-gray-700 dark:text-white"
            >USD</button
          >
          <button
            id="cur-inr"
            aria-pressed="false"
            class="currency-btn rounded-md px-3 py-1.5 text-sm font-medium text-gray-500 dark:text-gray-400"
            >INR</button
          >
        </div>
        <div
          class="inline-flex rounded-lg border border-gray-200 bg-gray-50 p-1 dark:border-gray-700 dark:bg-gray-800"
          role="group"
          aria-label="Billing interval"
        >
          <button
            id="int-monthly"
            aria-pressed="true"
            class="interval-btn rounded-md px-3 py-1.5 text-sm font-medium bg-white text-gray-900 shadow-sm dark:bg-gray-700 dark:text-white"
            >Monthly</button
          >
          <button
            id="int-annual"
            aria-pressed="false"
            class="interval-btn rounded-md px-3 py-1.5 text-sm font-medium text-gray-500 dark:text-gray-400"
            >Annual</button
          >
        </div>
      </div>

      <!-- Plan Cards -->
      <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
        {
          cloudPlans.map((plan) => (
            <div class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm dark:border-gray-700 dark:bg-gray-800">
              <h3 class="text-lg font-semibold text-gray-900 dark:text-white">{plan.name}</h3>
              <div class="mt-4">
                <span
                  class="price-usd-monthly price text-3xl font-bold text-gray-900 dark:text-white"
                  data-monthly={plan.price.usd.monthly}
                  data-annual={plan.price.usd.annual}
                >
                  ${plan.price.usd.monthly}
                </span>
                <span class="price-usd-monthly text-sm text-gray-500 dark:text-gray-400">/mo</span>
                <span
                  class="price-usd-annual hidden text-3xl font-bold text-gray-900 dark:text-white"
                  data-monthly={plan.price.usd.monthly}
                  data-annual={plan.price.usd.annual}
                >
                  ${plan.price.usd.annual}
                </span>
                <span class="price-usd-annual hidden text-sm text-gray-500 dark:text-gray-400">
                  /yr
                </span>
                <span class="price-inr-monthly hidden text-3xl font-bold text-gray-900 dark:text-white">
                  ₹{plan.price.inr.monthly.toLocaleString("en-IN")}
                </span>
                <span class="price-inr-monthly hidden text-sm text-gray-500 dark:text-gray-400">
                  /mo
                </span>
                <span class="price-inr-annual hidden text-3xl font-bold text-gray-900 dark:text-white">
                  ₹{plan.price.inr.annual.toLocaleString("en-IN")}
                </span>
                <span class="price-inr-annual hidden text-sm text-gray-500 dark:text-gray-400">
                  /yr
                </span>
              </div>
              <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">
                {plan.agentMinutes.toLocaleString()} agent-minutes / month
              </p>
              {plan.deepAllowed && (
                <p class="mt-1 text-sm font-medium text-indigo-600 dark:text-indigo-400">
                  Deep / Custom scans enabled
                </p>
              )}
              <ul class="mt-4 space-y-2">
                {plan.features.map((feature) => (
                  <li class="flex items-start gap-2 text-sm text-gray-600 dark:text-gray-400">
                    <svg
                      class="h-4 w-4 flex-shrink-0 text-green-500"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                      stroke-width="2"
                    >
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                    </svg>
                    {feature}
                  </li>
                ))}
              </ul>
              <a
                href={`${appUrl}/sign-up?plan=${plan.id}`}
                class="mt-6 block w-full rounded-lg bg-indigo-600 px-4 py-2.5 text-center text-sm font-semibold text-white hover:bg-indigo-700 transition-colors"
              >
                Start with {plan.name}
              </a>
            </div>
          ))
        }
      </div>

      <!-- Minute Packs Section -->
      <div class="mt-16">
        <h2 class="text-2xl font-bold text-gray-900 dark:text-white">Minute Packs</h2>
        <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">
          Add prepaid agent-minutes to any plan. Packs are valid for 6 months and are consumed after
          your monthly pool.
        </p>
        <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-3">
          {
            minutePacks.map((pack) => (
              <div class="rounded-lg border border-gray-200 bg-white p-4 dark:border-gray-700 dark:bg-gray-800">
                <h3 class="font-semibold text-gray-900 dark:text-white">{pack.name}</h3>
                <p class="mt-2 text-2xl font-bold text-gray-900 dark:text-white">
                  USD ${pack.priceUsd}
                </p>
                <p class="text-sm text-gray-600 dark:text-gray-400">{pack.minutes} agent-minutes</p>
                <p class="mt-1 text-xs text-gray-500 dark:text-gray-500">Valid for 6 months</p>
              </div>
            ))
          }
        </div>
      </div>

      <!-- Enterprise Contact-Led -->
      <div
        class="mt-12 rounded-xl border border-gray-200 bg-gray-50 p-8 dark:border-gray-700 dark:bg-gray-800/50"
      >
        <h2 class="text-2xl font-bold text-gray-900 dark:text-white">Enterprise</h2>
        <p class="mt-3">
          <span class="price-usd-monthly text-2xl font-bold text-gray-900 dark:text-white"
            >From ${enterprisePlan.price.usd.monthly.toLocaleString("en-US")}/mo</span
          >
          <span class="price-usd-annual hidden text-2xl font-bold text-gray-900 dark:text-white"
            >From ${enterprisePlan.price.usd.monthly.toLocaleString("en-US")}/mo</span
          >
          <span class="price-inr-monthly hidden text-2xl font-bold text-gray-900 dark:text-white"
            >From ₹{enterprisePlan.price.inr.monthly.toLocaleString("en-IN")}/mo</span
          >
          <span class="price-inr-annual hidden text-2xl font-bold text-gray-900 dark:text-white"
            >From ₹{enterprisePlan.price.inr.monthly.toLocaleString("en-IN")}/mo</span
          >
        </p>
        <p class="mt-2 text-gray-600 dark:text-gray-400">
          Custom agent-minute pools, custom target limits and dedicated support. SSO/SAML and
          multi-workspace management are on the roadmap.
        </p>
        <a
          href="/support"
          class="mt-4 inline-block rounded-lg border border-indigo-600 px-6 py-2.5 text-sm font-semibold text-indigo-600 hover:bg-indigo-50 dark:hover:bg-indigo-900/20 transition-colors"
        >
          Contact Sales
        </a>
      </div>

      <!-- Trial CTA -->
      <div class="mt-12 text-center">
        <h2 class="text-xl font-semibold text-gray-900 dark:text-white">
          Not sure yet? Start with a free trial.
        </h2>
        <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">
          100 agent-minutes, up to 3 targets, 14 days. No credit card required.
        </p>
        <a
          href={`${appUrl}/sign-up`}
          class="mt-4 inline-block rounded-lg bg-indigo-600 px-6 py-2.5 text-sm font-semibold text-white hover:bg-indigo-700 transition-colors"
        >
          Start Free Trial
        </a>
      </div>

      <!-- Free trial -->
      <div class="mt-12 rounded-lg bg-green-50 p-4 text-center dark:bg-green-900/20">
        <p class="text-sm text-green-800 dark:text-green-400">
          Start with a 14-day free trial — no credit card required.
        </p>
      </div>
    </div>

    <!-- Local Pricing -->
    <div id="local-pricing" class="mt-12 hidden">
      <div class="mx-auto max-w-xl">
        <div
          class="rounded-xl border border-indigo-200 bg-white p-6 shadow-sm dark:border-indigo-800 dark:bg-gray-800"
        >
          <p
            class="text-xs font-semibold uppercase tracking-wider text-indigo-600 dark:text-indigo-400"
          >
            Launch offer
          </p>
          <h3 class="mt-2 text-xl font-semibold text-gray-900 dark:text-white">
            {localLaunch.name}
          </h3>
          <p class="mt-3 text-3xl font-bold text-gray-900 dark:text-white">
            {formatUSD(localLaunch.priceUsd)}
            <span class="text-base font-normal text-gray-500 dark:text-gray-400"> globally</span>
          </p>
          <p class="mt-1 text-lg font-semibold text-gray-900 dark:text-white">
            {formatINR(localLaunch.priceInr!)}
            <span class="text-sm font-normal text-gray-500 dark:text-gray-400"
              >India, GST included</span
            >
          </p>
          <p class="mt-3 text-sm text-gray-600 dark:text-gray-400">{localLaunch.description}</p>
          <a
            href={`${appUrl}/buy/local`}
            class="mt-6 block w-full rounded-lg bg-indigo-600 px-4 py-2.5 text-center text-sm font-semibold text-white transition-colors hover:bg-indigo-700"
          >
            Buy Local license
          </a>
        </div>
      </div>

      <!-- Local notes -->
      <div class="mt-8 space-y-3">
        <div class="rounded-lg bg-gray-50 p-4 dark:bg-gray-800/50">
          <h3 class="font-medium text-gray-900 dark:text-white">Local License Details</h3>
          <ul class="mt-2 space-y-1 text-sm text-gray-600 dark:text-gray-400">
            <li>• 3-machine activation limit per seat</li>
            <li>• Perpetual use with 1 year of updates</li>
            <li>
              • Local licenses are non-refundable except where law or payment errors require
              otherwise
            </li>
          </ul>
        </div>
      </div>
    </div>

    <!-- Agent-minute definition -->
    <div
      class="mt-16 rounded-xl border border-gray-200 bg-white p-6 dark:border-gray-700 dark:bg-gray-800"
    >
      <h2 class="text-xl font-bold text-gray-900 dark:text-white">What is an agent-minute?</h2>
      <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">
        An agent-minute is a unit of wall-clock time — the real elapsed time from when a scan phase
        starts to when it ends, measured on the server clock. It is not "active-loop time" or
        "thinking time"; it includes all processing, network I/O, and model calls within that phase.
        Deep and Custom scans consume agent-minutes at 3× the standard rate.
      </p>
      <p class="mt-3 text-sm text-gray-600 dark:text-gray-400">
        Overage (when all included minutes and packs are exhausted) is billed at $0.15/min for
        Launch Assurance plans with a spend limit configured. Minute packs are valid for 6 months
        from purchase.
      </p>
    </div>
  </div>

  <script>
    // Cloud / Local toggle
    const tabCloud = document.getElementById("tab-cloud")
    const tabLocal = document.getElementById("tab-local")
    const cloudPricing = document.getElementById("cloud-pricing")
    const localPricing = document.getElementById("local-pricing")

    function setTab(active: "cloud" | "local") {
      tabCloud?.setAttribute("aria-pressed", String(active === "cloud"))
      tabLocal?.setAttribute("aria-pressed", String(active === "local"))
      if (active === "cloud") {
        tabCloud?.classList.add(
          "bg-white",
          "text-gray-900",
          "shadow-sm",
          "dark:bg-gray-700",
          "dark:text-white"
        )
        tabCloud?.classList.remove("text-gray-500", "dark:text-gray-400")
        tabLocal?.classList.remove(
          "bg-white",
          "text-gray-900",
          "shadow-sm",
          "dark:bg-gray-700",
          "dark:text-white"
        )
        tabLocal?.classList.add("text-gray-500", "dark:text-gray-400")
        cloudPricing?.classList.remove("hidden")
        localPricing?.classList.add("hidden")
      } else {
        tabLocal?.classList.add(
          "bg-white",
          "text-gray-900",
          "shadow-sm",
          "dark:bg-gray-700",
          "dark:text-white"
        )
        tabLocal?.classList.remove("text-gray-500", "dark:text-gray-400")
        tabCloud?.classList.remove(
          "bg-white",
          "text-gray-900",
          "shadow-sm",
          "dark:bg-gray-700",
          "dark:text-white"
        )
        tabCloud?.classList.add("text-gray-500", "dark:text-gray-400")
        localPricing?.classList.remove("hidden")
        cloudPricing?.classList.add("hidden")
      }
    }

    tabCloud?.addEventListener("click", () => setTab("cloud"))
    tabLocal?.addEventListener("click", () => setTab("local"))
    if (new URLSearchParams(window.location.search).get("mode") === "local") setTab("local")

    // Currency toggle
    const curUsd = document.getElementById("cur-usd")
    const curInr = document.getElementById("cur-inr")

    // Interval toggle
    const intMonthly = document.getElementById("int-monthly")
    const intAnnual = document.getElementById("int-annual")

    type Currency = "usd" | "inr"
    type Interval = "monthly" | "annual"

    function updatePrices(currency: Currency, interval: Interval) {
      // Hide all price elements
      document
        .querySelectorAll(
          ".price-usd-monthly, .price-usd-annual, .price-inr-monthly, .price-inr-annual"
        )
        .forEach((el) => {
          el.classList.add("hidden")
        })

      // Show the selected combination
      document.querySelectorAll(`.price-${currency}-${interval}`).forEach((el) => {
        el.classList.remove("hidden")
      })

      // Update button styles
      ;[curUsd, curInr].forEach((btn) => {
        btn?.classList.remove(
          "bg-white",
          "text-gray-900",
          "shadow-sm",
          "dark:bg-gray-700",
          "dark:text-white"
        )
        btn?.classList.add("text-gray-500", "dark:text-gray-400")
      })
      ;[intMonthly, intAnnual].forEach((btn) => {
        btn?.classList.remove(
          "bg-white",
          "text-gray-900",
          "shadow-sm",
          "dark:bg-gray-700",
          "dark:text-white"
        )
        btn?.classList.add("text-gray-500", "dark:text-gray-400")
      })

      const activeCur = currency === "usd" ? curUsd : curInr
      const activeInt = interval === "monthly" ? intMonthly : intAnnual
      curUsd?.setAttribute("aria-pressed", String(currency === "usd"))
      curInr?.setAttribute("aria-pressed", String(currency === "inr"))
      intMonthly?.setAttribute("aria-pressed", String(interval === "monthly"))
      intAnnual?.setAttribute("aria-pressed", String(interval === "annual"))
      activeCur?.classList.add(
        "bg-white",
        "text-gray-900",
        "shadow-sm",
        "dark:bg-gray-700",
        "dark:text-white"
      )
      activeCur?.classList.remove("text-gray-500", "dark:text-gray-400")
      activeInt?.classList.add(
        "bg-white",
        "text-gray-900",
        "shadow-sm",
        "dark:bg-gray-700",
        "dark:text-white"
      )
      activeInt?.classList.remove("text-gray-500", "dark:text-gray-400")
    }

    let currentCurrency: Currency = "usd"
    let currentInterval: Interval = "monthly"

    curUsd?.addEventListener("click", () => {
      currentCurrency = "usd"
      updatePrices(currentCurrency, currentInterval)
    })
    curInr?.addEventListener("click", () => {
      currentCurrency = "inr"
      updatePrices(currentCurrency, currentInterval)
    })
    intMonthly?.addEventListener("click", () => {
      currentInterval = "monthly"
      updatePrices(currentCurrency, currentInterval)
    })
    intAnnual?.addEventListener("click", () => {
      currentInterval = "annual"
      updatePrices(currentCurrency, currentInterval)
    })
  </script>
</Base>
