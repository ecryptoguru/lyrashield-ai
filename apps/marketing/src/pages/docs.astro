---
const origin = (import.meta.env.PUBLIC_SITE_URL as string | undefined)?.replace(/\/$/, "") ||
  Astro.site?.origin || "http://localhost:4321"
const target = `${origin}/docs/integrations`
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Docs | LyraShield AI</title>
    <meta name="robots" content="noindex, nofollow" />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
  </head>
  <body>
    <p>Redirecting to <a href={target}>docs</a>...</p>
  </body>
</html>
