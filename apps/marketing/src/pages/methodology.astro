---
import Base from "@layouts/Base.astro"
import ProductShot from "@components/ProductShot.astro"

const origin = Astro.site?.origin || "http://localhost:4321"
const canonical = new URL("/methodology", origin).toString()
const title = "AI app security evidence methodology | LyraShield AI"
const description =
  "How LyraShield AI records authorized scan scope, coverage, finding evidence states, retest outcomes and every known limitation."
// One editorial review date drives the visible "Last reviewed" text, the
// <time datetime> attribute, the page JSON-LD dateModified and the sitemap
// lastmod (parsed in astro.config.mjs). Change this constant only.
const reviewed = "2026-10-05"
const reviewedLabel = new Date(`${reviewed}T00:00:00Z`).toLocaleDateString("en-GB", {
  day: "numeric",
  month: "short",
  year: "numeric",
  timeZone: "UTC",
})
const evidenceStates = [
  {
    name: "Detected candidate",
    meaning: "A scanner found a signal worth reviewing. Confidence can help prioritize it, but does not prove exploitability.",
  },
  {
    name: "Independently verified (future step)",
    meaning: "Defined for a future separate verification step: a separate receipt would have to support the finding. No shipped path produces this state today, so no finding is in it. Engine confidence alone never creates it.",
  },
  {
    name: "Retest-confirmed",
    meaning: "A server-owned deterministic retest found the relevant condition absent after a fix, with complete applicable coverage.",
  },
  {
    name: "Inconclusive",
    meaning: "The available retest evidence cannot establish that the condition is gone. The uncertainty remains visible.",
  },
]
const faq = [
  {
    q: "What is an evidence state?",
    a: "An evidence state describes how much support a finding has. Detected, retest-confirmed and inconclusive are the three shipped states. They are not interchangeable labels. A fourth state, independently verified, is defined for a future separate verification step; no finding is in it today.",
  },
  {
    q: "Does a clean or high score prove an app is secure?",
    a: "No. A score is an interpretation aid derived from the evidence. It does not override the underlying findings, coverage limits or retest receipts.",
  },
  {
    q: "What does 'no finding returned' mean?",
    a: "It means the assigned check completed without reporting anything in scope. It is not the same as 'passed' or 'secure'; it only records that the check ran and returned nothing.",
  },
  {
    q: "What is the Vibe Security 50?",
    a: "It is a fixed list of 50 controls LyraShield AI reviews on AI-built apps. 43 are routed to code or URL review where applicable and 7 require operational or human evidence outside the scan because a repository or URL scan cannot establish them safely.",
  },
]
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: "LyraShield AI security evidence methodology",
    description,
    url: canonical,
    dateModified: reviewed,
    reviewedBy: { "@id": `${origin}/#organization` },
    isPartOf: { "@id": `${origin}/#website` },
    about: [
      "application security testing",
      "scan coverage",
      "security evidence",
      "evidence states",
      "security retesting",
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${origin}/` },
      { "@type": "ListItem", position: 2, name: "Methodology", item: canonical },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faq.map((item) => ({
      "@type": "Question",
      name: item.q,
      acceptedAnswer: { "@type": "Answer", text: item.a },
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "DefinedTermSet",
    name: "LyraShield AI Evidence States",
    description:
      "The four evidence states LyraShield AI assigns to security findings, from initial detection to retest-confirmed resolution.",
    hasDefinedTerm: evidenceStates.map((state) => ({
      "@type": "DefinedTerm",
      name: state.name,
      description: state.meaning,
    })),
  },
]
---

<Base
  title={title}
  description={description}
  canonical={canonical}
  jsonLd={jsonLd}
>
  <section class="mx-auto max-w-5xl px-4 py-14 sm:px-6 lg:py-24">
    <header class="max-w-3xl" data-reveal-group>
      <p class="font-mono text-xs font-semibold tracking-wider text-accent uppercase" data-reveal="fade">Methodology</p>
      <h1 class="mt-4 text-4xl font-semibold tracking-tight text-text sm:text-5xl" data-reveal>
        A security result should say what it knows—and what it does not.
      </h1>
      <p class="mt-6 text-lg leading-8 text-text-muted" data-reveal>
        An evidence state records how strongly a security finding is supported. Three states ship
        today. Detected means a scanner saw a signal. Retest-confirmed means a server-owned
        retest found the condition absent after a fix. Inconclusive means the evidence cannot
        establish the condition is gone. A fourth state, independently verified, is defined for a
        future separate verification step and no finding is in it today. These are never blended
        into a single score.
      </p>
      <div class="mt-6 rounded-xl border border-border bg-bg-raised p-5 text-sm leading-7 text-text-muted" data-reveal="fade">
        <p class="font-semibold text-text">TL;DR</p>
        <p class="mt-2">
          Every finding carries one of three shipped evidence states: <strong>detected</strong> (a scanner signal that needs review), <strong>retest-confirmed</strong> (a deterministic retest found the condition absent) or <strong>inconclusive</strong> (the retained evidence cannot establish resolution). A fourth state, independently verified, is defined for a future separate verification step; no finding is in it today. A score or clean result never overrides these facts.
        </p>
      </div>
      <p class="mt-4 text-sm text-text-muted" data-reveal="fade">Last reviewed: <time datetime={reviewed}>{reviewedLabel}</time> · Maintained by LyraShield Security + Engineering</p>
    </header>

    <section aria-labelledby="record-heading" class="mt-16 border-y border-border py-12">
      <h2 id="record-heading" class="text-2xl font-semibold text-text" data-reveal>What every new scan record preserves</h2>
      <dl class="mt-8 grid gap-x-10 gap-y-8 md:grid-cols-2" data-reveal-group>
        <div data-reveal><dt class="font-semibold text-text">Scope</dt><dd class="mt-2 leading-7 text-text-muted">The authorized target, available source, scan mode and the result-manifest checksum recorded with it.</dd></div>
        <div data-reveal><dt class="font-semibold text-text">Coverage</dt><dd class="mt-2 leading-7 text-text-muted">Which checks completed, were limited, were skipped or did not apply, including retained limitations.</dd></div>
        <div data-reveal><dt class="font-semibold text-text">Provenance</dt><dd class="mt-2 leading-7 text-text-muted">Which scanner produced a candidate and, where the state applies, the coverage receipt behind it.</dd></div>
        <div data-reveal><dt class="font-semibold text-text">Outcome</dt><dd class="mt-2 leading-7 text-text-muted">The server-owned retest result and the evidence boundary behind validated or inconclusive status.</dd></div>
      </dl>

      <ProductShot
        class="mt-10"
        src="/product/current-scan-dark.webp"
        lightSrc="/product/current-scan-light.webp"
        alt="A completed, sealed scan record in the current dashboard, with retained findings, a zero-count reserved verification column, coverage state and an assurance-report action. The private target name is redacted."
        width={1600}
        height={640}
        chrome="app.lyrashieldai.com/dashboard/scans"
      >
        <b>A completed scan keeps its scope and evidence state.</b> This demo-workspace capture
        shows duration, retained findings and coverage separately. The reserved verification count is zero.
        Completion is not a guarantee of security. The private target name is redacted.
      </ProductShot>
    </section>

    <section aria-labelledby="states-heading" class="py-16">
      <h2 id="states-heading" class="text-2xl font-semibold text-text" data-reveal>Evidence states are not interchangeable</h2>
      <div class="mt-8 divide-y divide-border border-y border-border" data-reveal-group>
        {evidenceStates.map((state, index) => (
          <article class="grid gap-3 py-7 md:grid-cols-[3rem_13rem_1fr] md:gap-6" data-reveal>
            <span class="font-mono text-xs text-text-muted" aria-hidden="true" data-countup={index + 1}>0{index + 1}</span>
            <h3 class="font-semibold text-text">{state.name}</h3>
            <p class="leading-7 text-text-muted">{state.meaning}</p>
          </article>
        ))}
      </div>

      <ProductShot
        class="mt-10 mx-auto max-w-[48rem]"
        src="/product/current-findings-dark.webp"
        lightSrc="/product/current-findings-light.webp"
        alt="The current finding detail panel separates severity from status and evidence state. Actions lead to retained evidence or a fix proposal. Private finding details are redacted."
        width={960}
        height={834}
        chrome="app.lyrashieldai.com/dashboard/findings"
      >
        <b>Severity and evidence state remain distinct.</b> This captured finding is critical,
        open and inconclusive. The detail panel leads to retained evidence and a fix proposal.
        A fix proposal is something you create and review;
        nothing auto-merges. Finding titles, file paths and target names are blurred.
      </ProductShot>
    </section>

    <section aria-labelledby="verdict-heading" class="py-16" data-reveal-group>
      <h2 id="verdict-heading" class="text-2xl font-semibold text-text" data-reveal>Release verdict</h2>
      <p class="mt-5 max-w-3xl leading-7 text-text-muted" data-reveal>
        A public scorecard may include a release verdict. The verdict is derived from the frozen LyraShield Score using the same versioned model that produced the grade. It is an interpretation aid, not an override of the underlying evidence.
      </p>
      <dl class="mt-8 grid gap-6 sm:grid-cols-2" data-reveal-group>
        <div data-reveal>
          <dt class="font-semibold text-text">Go</dt>
          <dd class="mt-2 leading-7 text-text-muted">Score 80 or above. The evidence suggests the target is ready to release, with the retained limitations visible on the scorecard.</dd>
        </div>
        <div data-reveal>
          <dt class="font-semibold text-text">Go with conditions</dt>
          <dd class="mt-2 leading-7 text-text-muted">Score 40–79. The result is releasable only if the conditions recorded in the scorecard—open findings, coverage limits and retest state—are accepted.</dd>
        </div>
        <div data-reveal>
          <dt class="font-semibold text-text">No go</dt>
          <dd class="mt-2 leading-7 text-text-muted">Score below 40. The evidence does not currently support release.</dd>
        </div>
        <div data-reveal>
          <dt class="font-semibold text-text">Not evaluated</dt>
          <dd class="mt-2 leading-7 text-text-muted">No score snapshot was available for the shared record.</dd>
        </div>
      </dl>
    </section>

    <section aria-labelledby="coverage-heading" class="border-t border-border py-16" data-reveal-group>
      <h2 id="coverage-heading" class="text-2xl font-semibold text-text" data-reveal>Coverage states</h2>
      <p class="mt-5 max-w-3xl leading-7 text-text-muted" data-reveal>
        Coverage records what happened to each check, which is a separate question from what a
        finding is. A verdict is only as strong as the coverage behind it.
      </p>
      <div
        class="mt-8 overflow-x-auto rounded-xl border border-border bg-bg-raised focus-visible:ring-2 focus-visible:ring-accent"
        tabindex="0"
        role="region"
        aria-label="Coverage states"
      >
        <table class="w-full min-w-140 border-collapse text-left text-sm">
          <caption class="sr-only">Coverage states and what each one means for a verdict</caption>
          <thead class="bg-bg-raised text-text">
            <tr>
              <th scope="col" class="px-4 py-3 font-semibold">Coverage state</th>
              <th scope="col" class="px-4 py-3 font-semibold">What it means</th>
              <th scope="col" class="px-4 py-3 font-semibold">Effect on the verdict</th>
            </tr>
          </thead>
          <tbody class="text-text-muted">
            <tr class="border-t border-border">
              <th scope="row" class="px-4 py-3 font-medium text-text">Completed</th>
              <td class="px-4 py-3">The check ran against the authorized scope and returned a result.</td>
              <td class="px-4 py-3">Counts toward the verdict.</td>
            </tr>
            <tr class="border-t border-border">
              <th scope="row" class="px-4 py-3 font-medium text-text">Limited</th>
              <td class="px-4 py-3">The check ran but could not see everything in its scope.</td>
              <td class="px-4 py-3">Counts, with the limitation retained on the record.</td>
            </tr>
            <tr class="border-t border-border">
              <th scope="row" class="px-4 py-3 font-medium text-text">Skipped</th>
              <td class="px-4 py-3">The check did not run, for example because a prerequisite was absent.</td>
              <td class="px-4 py-3">Surfaces as insufficient evidence rather than a pass.</td>
            </tr>
            <tr class="border-t border-border">
              <th scope="row" class="px-4 py-3 font-medium text-text">Not applicable</th>
              <td class="px-4 py-3">The control does not apply to the scanned target type.</td>
              <td class="px-4 py-3">Excluded from the denominator and stated as such.</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <section aria-labelledby="limits-heading" class="rounded-2xl border border-border bg-bg-raised p-7 sm:p-9" data-reveal="scale">
      <h2 id="limits-heading" class="text-2xl font-semibold text-text">What this methodology does not claim</h2>
      <ul class="mt-6 grid gap-4 text-text-muted sm:grid-cols-2">
        <li>It does not prove an application has no vulnerabilities.</li>
        <li>It does not imply every Vibe Security 50 control can be established by one scan.</li>
        <li>It does not replace an authorized penetration test or specialist point tool.</li>
        <li>A Fix PR opens only after a human approves, with a server-generated patch and scoped authorization: explicit browser approval or an eligible credential's verified permission.</li>
      </ul>
    </section>

    <section aria-labelledby="interpret-heading" class="py-16" data-reveal-group>
      <h2 id="interpret-heading" class="text-2xl font-semibold text-text" data-reveal>How should you interpret a LyraShield AI result?</h2>
      <p class="mt-5 max-w-3xl text-lg leading-8 text-text-muted" data-reveal>Read the result in this order: confirm the authorized target and mode, inspect completed and limited coverage, separate detected findings from retest-confirmed ones, then read the retest receipt and retained limitations. A LyraShield score or confidence value never replaces the underlying scope, coverage, evidence-state and retest facts.</p>
      <p class="mt-5 max-w-3xl leading-7 text-text-muted" data-reveal>For a broader catalog of web application verification requirements, consult the <a href="https://owasp.org/asvs" rel="noreferrer" class="font-medium text-accent underline decoration-accent/40 underline-offset-4 hover:decoration-accent focus:outline-none focus-visible:ring-2 focus-visible:ring-accent">OWASP Application Security Verification Standard</a>. This reference does not imply certification or full ASVS coverage.</p>
      <p class="mt-5 max-w-3xl leading-7 text-text-muted" data-reveal>LyraShield AI does not claim "SOC 2 compliant," "certified," "guarantees security," "AI safety tested" (without a named framework) or "adversarial robustness proven." Each of those requires external attestation, a reproducible evaluation corpus, a defined threat model or a formal certificate that LyraShield has not yet obtained.</p>
    </section>

    <section aria-labelledby="faq-heading" class="py-16">
      <h2 id="faq-heading" class="text-2xl font-semibold text-text" data-reveal>Methodology questions</h2>
      <div class="mt-6 divide-y divide-border rounded-xl border border-border bg-bg-raised" data-reveal="scale">
        {faq.map((item, i) => (
          <details class="faq-item p-4" data-question-id={`methodology-faq-${i + 1}`}>
            <summary class="cursor-pointer font-medium text-text">{item.q}</summary>
            <p class="mt-3 text-sm leading-6 text-text-muted">{item.a}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="mt-16 flex flex-col gap-5 border-t border-border pt-10 sm:flex-row sm:items-center sm:justify-between" data-reveal>
      <div><h2 class="text-2xl font-semibold text-text">Start with a check you can inspect.</h2><p class="mt-2 text-text-muted">The free tools run locally in your browser and state their limits.</p></div>
      <a href="/tools" class="lift inline-flex min-h-12 items-center justify-center rounded-lg bg-accent px-5 text-sm font-semibold text-bg hover:opacity-90 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent">View free tools</a>
    </section>
  </section>
</Base>
