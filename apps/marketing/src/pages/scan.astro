---
import Base from "@layouts/Base.astro"

const origin = Astro.site?.origin || "http://localhost:4321"
const canonical = new URL("/scan", origin).toString()
const appOrigin = (import.meta.env.PUBLIC_SCANNER_URL as string | undefined)?.replace(/\/$/, "") || ""
const scannerAvailable = Boolean(appOrigin)
const dashboardOrigin = (import.meta.env.PUBLIC_APP_URL as string | undefined)?.replace(/\/$/, "") || ""
const turnstileSiteKey = (import.meta.env.PUBLIC_TURNSTILE_SITE_KEY as string | undefined) || ""
const title = "Free AI App Security Check — Passive URL Scan | LyraShield AI"
const description = "Run a free, passive URL security check for AI-built apps. Review exposed secrets, browser security headers, data-layer signals, and HTTPS basics. No signup."
const faqs = [
  { question: "What does the LyraShield free security check look for?", answer: "It reads the public page, response headers, and up to six same-origin JavaScript or CSS assets linked by that page. It checks for high-confidence secret patterns, baseline security headers, data-layer signals, HTTPS consistency, and supported framework fingerprints." },
  { question: "Is the LyraShield Lite Check safe?", answer: "It is passive and read-only. It does not log in, send attack payloads, query databases, enumerate private paths, exploit a finding, or actively test row-level security. Scan only apps you own or have permission to test." },
  { question: "Do you store my app data or exposed secrets?", answer: "The scanner does not persist page bodies, matched secret values, or findings. Analytics receives only a one-way hash of the target hostname plus coarse funnel data. A public scorecard contains aggregate counters only and never the target URL or finding detail." },
  { question: "Does a clean Lite Check mean my app is secure?", answer: "No. A clean result means no surface issues were found in this limited, outside-only check. Business-logic flaws, authenticated access issues, server-side code, and exploit validation require a deeper authorized assessment." },
]
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: "LyraShield AI Lite Check",
    applicationCategory: "SecurityApplication",
    operatingSystem: "Web",
    url: canonical,
    description,
    // Links this free tool back to the main SoftwareApplication entity
    // (index.astro's #application) so a crawler building a knowledge graph
    // from JSON-LD sees one product with a free entry point, not two
    // unrelated applications.
    isPartOf: { "@id": `${origin}/#application` },
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
    featureList: ["Passive public-page check", "Exposed secret pattern detection", "Security header review", "Data-layer risk signals", "HTTPS and mixed-content basics"],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((faq) => ({ "@type": "Question", name: faq.question, acceptedAnswer: { "@type": "Answer", text: faq.answer } })),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${origin}/` },
      { "@type": "ListItem", position: 2, name: "Free security check", item: canonical },
    ],
  },
]
---

<Base title={title} description={description} canonical={canonical} jsonLd={jsonLd} noindex={!scannerAvailable}>
  <section class="relative overflow-hidden border-b border-border">
    <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_75%_18%,color-mix(in_srgb,var(--accent)_15%,transparent),transparent_32%)]"></div>
    <div class="relative mx-auto grid max-w-6xl gap-12 px-4 py-16 sm:px-6 lg:grid-cols-[1.05fr_.95fr] lg:items-center lg:px-8 lg:py-24">
      <div data-reveal-group>
        <p class="font-mono text-xs font-semibold tracking-[.2em] text-accent uppercase" data-reveal="fade">Live URL scan · passive and read-only</p>
        <h1 class="mt-5 max-w-3xl text-4xl font-semibold tracking-tight text-text sm:text-5xl lg:text-6xl" data-reveal>Free security check for AI-built apps</h1>
        <p class="mt-6 max-w-2xl text-lg leading-8 text-text-muted" data-reveal>{scannerAvailable ? "Paste your app's URL. We'll check for the security gaps that AI coding tools most often leave behind — exposed secrets, missing protections, risky data-access setups. Results in seconds. No signup." : "The passive Lite Check is available after the separately protected LyraShield app API is deployed. Explore the methodology and browser-local tools while this preview remains in pre-launch mode."}</p>

        <form id="scan-form" class="mt-9 max-w-2xl" data-reveal data-api-origin={appOrigin} data-turnstile-site-key={turnstileSiteKey}>
          <label for="scan-url" class="block text-sm font-semibold text-text">Public app URL</label>
          <div class="mt-2 flex flex-col gap-3 sm:flex-row">
            <input id="scan-url" name="url" type="text" inputmode="url" autocomplete="url" required={scannerAvailable} maxlength="2048" placeholder="example.com or https://your-app.com" disabled={!scannerAvailable} aria-describedby="scan-error" class="min-h-13 flex-1 rounded-xl border border-border bg-bg-raised px-4 text-base text-text shadow-sm placeholder:text-text-muted focus:border-accent focus:outline-none focus-visible:ring-2 focus-visible:ring-accent disabled:cursor-not-allowed disabled:opacity-60" />
            <button id="scan-button" type="submit" disabled={!scannerAvailable} class="min-h-13 rounded-xl bg-accent px-6 font-semibold text-bg shadow-sm hover:opacity-90 disabled:cursor-not-allowed disabled:opacity-55">{scannerAvailable ? "Scan my app" : "Scanner API not connected"}</button>
          </div>
          <label class="mt-4 flex cursor-pointer items-start gap-3 rounded-xl border border-border bg-bg-raised/70 p-4 text-sm leading-6 text-text-muted">
            <input id="authorized" name="authorized" type="checkbox" required={scannerAvailable} disabled={!scannerAvailable} aria-describedby="scan-error" class="mt-1 size-4 shrink-0 accent-(--accent)" />
            <span>Scan only apps you own or have permission to test. We run a passive, read-only check — nothing intrusive. By scanning you agree to our <a href="/terms" class="font-medium text-accent underline underline-offset-4">Terms</a>.</span>
          </label>
          <div id="turnstile-container" class="mt-4"></div>
          {!scannerAvailable && <p class="mt-4 rounded-lg border border-(--terminal-warning)/40 bg-(--terminal-amber)/10 p-3 text-sm leading-6 text-text-muted" role="status">Live scanning requires the separately deployed LyraShield app API. This preview will not send a target to localhost or another fallback service.</p>}
          <p id="scan-error" class="mt-4 hidden rounded-lg border border-danger/40 bg-danger/5 p-3 text-sm text-danger" role="alert"></p>
        </form>
      </div>

      <div class="rounded-2xl border border-border bg-(--terminal-void) p-5 text-(--terminal-text) shadow-2xl sm:p-7" data-reveal="right" aria-label="Lite Check preview">
        <div class="flex items-center justify-between border-b border-(--terminal-edge) pb-4 font-mono text-xs"><span class="text-(--terminal-cyan)">lyrashield / lite-check</span><span class="text-(--terminal-muted)">PASSIVE</span></div>
        <div class="space-y-4 py-6 font-mono text-sm leading-6" data-reveal-group>
          <p data-reveal="fade"><span class="mr-3 text-(--terminal-cyan)" data-countup="1">01</span>Fetch only public browser assets</p>
          <p data-reveal="fade"><span class="mr-3 text-(--terminal-cyan)" data-countup="2">02</span>Keep credentials out of results</p>
          <p data-reveal="fade"><span class="mr-3 text-(--terminal-amber)" data-countup="3">03</span>Separate signals from proof</p>
          <p data-reveal="fade"><span class="mr-3 text-(--terminal-muted)" data-countup="4">04</span>State every important limit</p>
        </div>
        <p class="border-t border-(--terminal-edge) pt-4 text-sm leading-6 text-(--terminal-muted)">No login · no exploit payloads · no table queries · no active RLS test</p>
      </div>
    </div>
  </section>

  <section id="scanning" class="mx-auto hidden max-w-5xl px-4 py-14 sm:px-6 lg:px-8" aria-labelledby="scanning-heading">
    <div class="overflow-hidden rounded-2xl border border-border bg-(--terminal-void) text-(--terminal-text) shadow-xl">
      <div class="flex items-center justify-between border-b border-(--terminal-edge) px-5 py-4 font-mono text-xs sm:px-7"><span class="text-(--terminal-cyan)">public-surface.log</span><span class="flex items-center gap-2 text-(--terminal-amber)"><span class="scan-running-dot" aria-hidden="true"></span>RUNNING</span></div>
      <div class="grid items-center gap-8 px-5 py-8 sm:px-7 md:grid-cols-[.75fr_1.25fr] md:py-10">
        <div class="scan-radar mx-auto" aria-hidden="true">
          <div class="scan-orbit scan-orbit-outer"><span></span><span></span><span></span></div>
          <div class="scan-orbit scan-orbit-inner"><span></span><span></span></div>
          <div class="scan-core"><img src="/logo.svg" alt="LyraShield logo" width="54" height="54" /></div>
        </div>

        <div>
          <p class="font-mono text-xs tracking-[.18em] text-(--terminal-muted) uppercase">Passive review in progress</p>
          <h2 id="scanning-heading" class="mt-3 text-2xl font-semibold tracking-tight sm:text-3xl">Reading the public surface</h2>
          <p class="sr-only" role="status" aria-live="polite">Lite Check in progress. Results will appear below when the passive review finishes.</p>
          {/* Indeterminate on purpose: aria-valuetext without aria-valuenow. The
              stepper reflects activity, not a completion percentage — claiming a
              percentage here would contradict what this check can actually prove. */}
          <div id="scan-stage-announcer" class="sr-only" role="progressbar" aria-labelledby="scanning-heading" aria-valuetext="Step 1 of 5: Establishing a bounded, read-only connection."></div>
          <p id="scan-activity" class="mt-3 min-h-6 text-sm leading-6 text-(--terminal-dim)">Establishing a bounded, read-only connection.</p>

          <ol id="scan-steps" class="mt-6 space-y-2 font-mono text-sm" aria-label="What the Lite Check is reviewing">
            <li class="scan-stage" data-step="0" data-state="active" data-status="Establishing a bounded, read-only connection." aria-current="step"><span class="scan-stage-marker" aria-hidden="true"></span>Safe public connection</li>
            <li class="scan-stage" data-step="1" data-state="pending" data-status="Reading public HTML and same-origin assets."><span class="scan-stage-marker" aria-hidden="true"></span>Public HTML and linked assets</li>
            <li class="scan-stage" data-step="2" data-state="pending" data-status="Reviewing response headers and browser protections."><span class="scan-stage-marker" aria-hidden="true"></span>Browser protection headers</li>
            <li class="scan-stage" data-step="3" data-state="pending" data-status="Checking client bundles for high-confidence secret patterns."><span class="scan-stage-marker" aria-hidden="true"></span>Exposed secret patterns</li>
            <li class="scan-stage" data-step="4" data-state="pending" data-status="Separating data-layer signals from what this check cannot prove."><span class="scan-stage-marker" aria-hidden="true"></span>Data-layer signals and limits</li>
          </ol>
        </div>
      </div>
      <p class="border-t border-(--terminal-edge) px-5 py-4 text-sm text-(--terminal-muted) sm:px-7">We only read what your app already sends to any visitor. The highlighted row shows activity, not a claimed completion percentage.</p>
    </div>
  </section>

  <style>
    .scan-radar {
      position: relative;
      width: min(15rem, 68vw);
      aspect-ratio: 1;
      display: grid;
      place-items: center;
    }

    .scan-radar::before,
    .scan-radar::after {
      content: "";
      position: absolute;
      border-radius: 999px;
      border: 1px solid var(--terminal-edge);
    }

    .scan-radar::before { inset: 7%; }
    .scan-radar::after { inset: 25%; }

    .scan-orbit {
      position: absolute;
      inset: 7%;
      border-radius: 999px;
      animation: scan-orbit 7s linear infinite;
      will-change: transform;
    }

    .scan-orbit-inner {
      inset: 25%;
      animation-duration: 4.5s;
      animation-direction: reverse;
    }

    .scan-orbit span {
      position: absolute;
      width: .55rem;
      height: .55rem;
      border-radius: 999px;
      background: var(--terminal-cyan);
      box-shadow: 0 0 0 .35rem color-mix(in srgb, var(--terminal-cyan) 10%, transparent), 0 0 1.5rem color-mix(in srgb, var(--terminal-cyan) 55%, transparent);
    }

    .scan-orbit span:nth-child(1) { top: -.25rem; left: 50%; }
    .scan-orbit span:nth-child(2) { right: 5%; bottom: 18%; background: var(--terminal-amber); }
    .scan-orbit span:nth-child(3) { bottom: 10%; left: 10%; }
    .scan-orbit-inner span:nth-child(2) { top: 65%; right: -4%; bottom: auto; }

    .scan-core {
      position: relative;
      z-index: 1;
      display: grid;
      width: 5.25rem;
      aspect-ratio: 1;
      place-items: center;
      border: 1px solid var(--terminal-panel);
      border-radius: 1.25rem;
      background: var(--terminal-raised);
      box-shadow: 0 0 0 1rem color-mix(in srgb, var(--terminal-cyan) 4%, transparent);
      animation: scan-core 2.4s ease-in-out infinite;
    }

    .scan-running-dot,
    .scan-stage-marker {
      display: inline-block;
      width: .55rem;
      height: .55rem;
      flex: 0 0 auto;
      border-radius: 999px;
      background: var(--terminal-amber);
      box-shadow: 0 0 0 .25rem color-mix(in srgb, var(--terminal-amber) 12%, transparent);
      animation: scan-pulse 1.4s ease-in-out infinite;
    }

    .scan-stage {
      display: flex;
      min-height: 2.5rem;
      align-items: center;
      gap: .85rem;
      border-left: 1px solid var(--terminal-edge);
      padding: .5rem 0 .5rem 1rem;
      color: var(--terminal-faint);
      transition: color .35s ease, transform .35s cubic-bezier(.2, .8, .2, 1), border-color .35s ease;
    }

    .scan-stage-marker {
      width: .45rem;
      height: .45rem;
      background: var(--terminal-panel);
      box-shadow: none;
      animation: none;
    }

    .scan-stage[data-state="active"] {
      transform: translateX(.45rem);
      border-left-color: var(--terminal-cyan);
      color: var(--terminal-text);
    }

    .scan-stage[data-state="active"] .scan-stage-marker {
      background: var(--terminal-cyan);
      box-shadow: 0 0 0 .3rem color-mix(in srgb, var(--terminal-cyan) 12%, transparent);
      animation: scan-pulse 1.4s ease-in-out infinite;
    }

    @keyframes scan-orbit { to { transform: rotate(1turn); } }
    @keyframes scan-core { 50% { transform: scale(1.04); opacity: .86; } }
    @keyframes scan-pulse { 50% { transform: scale(.72); opacity: .55; } }

    @media (prefers-reduced-motion: reduce) {
      .scan-orbit,
      .scan-core,
      .scan-running-dot,
      .scan-stage-marker { animation: none; }
    }
  </style>

  <section id="results" class="mx-auto hidden max-w-5xl px-4 py-14 sm:px-6 lg:px-8" aria-live="polite" tabindex="-1">
    <div class="rounded-2xl border border-border bg-bg-raised p-6 shadow-xl sm:p-8">
      <div class="flex flex-wrap items-center justify-between gap-4"><div><p class="font-mono text-xs font-semibold tracking-[.2em] text-accent uppercase">Lite Check · not the LyraShield Score</p><h2 id="result-heading" class="mt-3 text-3xl font-semibold tracking-tight text-text"></h2></div><div id="result-counts" class="flex flex-wrap gap-2"></div></div>
      <p id="result-target" class="mt-4 break-all font-mono text-xs text-text-muted"></p>
      <p class="mt-6 max-w-3xl leading-7 text-text-muted">This is a surface-level, passive check — a preview of what LyraShield's full loop does. It can't see everything, and a clean result here isn't a guarantee.</p>
    </div>

    <div id="clean-result" class="mt-8 hidden rounded-2xl border border-accent/40 bg-accent-dim/25 p-6 sm:p-8"><h3 class="text-2xl font-semibold text-text">No surface issues found in this passive check.</h3><p class="mt-3 max-w-3xl leading-7 text-text-muted">That's a good sign — but it's a limited, outside-only look. Deeper classes of vulnerability (business-logic flaws, authenticated access issues, exploit validation) need an authorized full scan. Sign up below to run a full check or save a scorecard.</p></div>
    <div id="findings" class="mt-8 space-y-4"></div>

    <section id="upsell" class="mt-10 rounded-2xl border border-border bg-(--terminal-void) p-6 text-(--terminal-text) sm:p-9">
      <p class="font-mono text-xs font-semibold tracking-[.2em] text-(--terminal-cyan) uppercase">Full loop · open registration</p>
      <h2 class="mt-4 text-3xl font-semibold tracking-tight">This is the surface. LyraShield goes the whole loop.</h2>
      <p class="mt-4 max-w-3xl leading-7 text-(--terminal-dim)">The full platform runs an agentic repository scan, records evidence state, prepares a fix proposal, retests, and hands you a shareable report. PR execution stays blocked until an exact server-generated patch is bound to approval, and every result retains its coverage limits.</p>
      {dashboardOrigin && <a href={`${dashboardOrigin}/sign-up`} class="mt-7 inline-flex min-h-12 items-center justify-center rounded-lg bg-(--terminal-cyan) px-5 font-semibold text-(--terminal-void) hover:bg-(--terminal-cyan-hover) focus:outline-none focus-visible:ring-2 focus-visible:ring-white">Create free account</a>}
      <form id="capture-form" class="mt-7 max-w-2xl">
        <label for="result-email" class="block text-sm font-semibold">Email for product updates and scorecards</label>
        <div class="mt-2 flex flex-col gap-3 sm:flex-row"><input id="result-email" type="email" required autocomplete="email" placeholder="you@example.com" class="min-h-12 flex-1 rounded-lg border border-(--terminal-panel) bg-(--terminal-raised) px-4 text-(--terminal-text) placeholder:text-(--terminal-muted)" /><button type="submit" data-capture-action="waitlist" class="min-h-12 rounded-lg bg-(--terminal-cyan) px-5 font-semibold text-(--terminal-void)">Get product updates</button></div>
        <div class="mt-3 flex flex-col gap-3 sm:flex-row"><button type="submit" data-capture-action="scorecard" class="min-h-12 rounded-lg border border-(--terminal-cyan) px-5 font-semibold text-(--terminal-cyan)">Get my shareable scorecard</button><a href="/sample-report" data-upsell="sample_report" class="inline-flex min-h-12 items-center justify-center rounded-lg px-5 font-semibold text-(--terminal-dim) hover:text-white">See a sample full report</a></div>
        <p id="capture-status" class="mt-4 text-sm text-(--terminal-dim)" role="status"></p>
      </form>
      <div id="scorecard-actions" class="mt-5 hidden flex-wrap gap-3"><a id="scorecard-link" href="#" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-11 items-center rounded-lg bg-(--terminal-cyan) px-4 font-semibold text-(--terminal-void)">Open scorecard</a><button id="share-scorecard" type="button" class="min-h-11 rounded-lg border border-(--terminal-panel) px-4 font-semibold">Share scorecard</button></div>
    </section>
  </section>

  <section class="border-t border-border bg-bg-raised/65"><div class="mx-auto max-w-5xl px-4 py-16 sm:px-6 lg:px-8"><p class="font-mono text-xs font-semibold tracking-[.2em] text-accent uppercase" data-reveal="fade">What this check can tell you</p><div class="mt-8 grid gap-8 md:grid-cols-2" data-reveal-group><article data-reveal><h2 class="text-xl font-semibold text-text">Exposed secrets</h2><p class="mt-3 leading-7 text-text-muted">Looks for high-confidence server-side credential patterns in public HTML and linked client assets. Public Supabase anon keys, Firebase web config, Stripe publishable keys, and reCAPTCHA site keys are not labeled secrets.</p></article><article data-reveal><h2 class="text-xl font-semibold text-text">Browser protections</h2><p class="mt-3 leading-7 text-text-muted">Reads Content Security Policy, HSTS, MIME sniffing, framing, referrer, and browser-permission headers. Missing headers are hardening gaps, not automatic proof of exploitation.</p></article><article data-reveal><h2 class="text-xl font-semibold text-text">Data-layer signals</h2><p class="mt-3 leading-7 text-text-muted">Recognizes supported public BaaS markers and explains why server-enforced RLS or security rules deserve review. It never queries a table or collection.</p></article><article data-reveal><h2 class="text-xl font-semibold text-text">Transport and framework signals</h2><p class="mt-3 leading-7 text-text-muted">Checks HTTPS and obvious mixed-content references, then records ordinary public framework fingerprints to help scope a deeper authorized review.</p></article></div></div></section>

  <section class="mx-auto max-w-4xl px-4 py-16 sm:px-6 lg:px-8"><h2 class="text-3xl font-semibold tracking-tight text-text" data-reveal>Questions about the free Lite Check</h2><div class="mt-8 divide-y divide-border border-y border-border" data-reveal="fade">{faqs.map((faq, index) => (<details data-question-id={`lite-${index + 1}`} class="group py-5"><summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-4 font-semibold text-text"><span>{faq.question}</span><span class="text-accent group-open:rotate-45" aria-hidden="true">+</span></summary><p class="max-w-3xl pb-2 pr-8 leading-7 text-text-muted">{faq.answer}</p></details>))}</div></section>

  {turnstileSiteKey && <script src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit" async defer is:inline></script>}
  <script>
    import { normalizePublicHttpUrl } from "../lib/public-url"

    type LiteCheck = { category: string; severity: "needs_attention" | "worth_reviewing" | "ok"; title: string; whatItIs: string; whyItMatters: string; learnMoreUrl: string }
    type LiteResult = { target: string; scannedAt: string; checks: LiteCheck[]; liteResultSummary: { needsAttention: number; worthReviewing: number; looksOk: number; findingCount: number }; disclaimers: string[] }
    type TurnstileWindow = Window & { turnstile?: { render: (element: string | HTMLElement, options: Record<string, unknown>) => string; reset: (id: string) => void } }

    const scanForm = document.querySelector<HTMLFormElement>("#scan-form")
    const scanning = document.querySelector<HTMLElement>("#scanning")
    const results = document.querySelector<HTMLElement>("#results")
    const errorBox = document.querySelector<HTMLElement>("#scan-error")
    const scanButton = document.querySelector<HTMLButtonElement>("#scan-button")
    const appOrigin = scanForm?.dataset.apiOrigin || ""
    const turnstileSiteKey = scanForm?.dataset.turnstileSiteKey || ""
    const LITE_SCAN_TIMEOUT_MS = 30_000
    // Turnstile is loaded from a third party; ad blockers and network failures
    // are common. Bound the wait instead of polling forever in silence.
    const TURNSTILE_POLL_INTERVAL_MS = 100
    const TURNSTILE_MAX_ATTEMPTS = 100 // ~10s
    let turnstileToken = ""
    let turnstileWidget = ""
    let turnstileAttempts = 0
    let currentResult: LiteResult | null = null
    let lastAction = "waitlist"

    const capture = (event: string, props: Record<string, unknown> = {}) => window.posthog?.capture(event, { product: "LyraShield", ...props })
    const query = new URL(location.href).searchParams
    let pendingHomepageScan = false
    if (query.get("start") === "1") {
      try {
        const target = sessionStorage.getItem("lyrashield-lite-target")
        if (target) {
          document.querySelector<HTMLInputElement>("#scan-url")!.value = target
          document.querySelector<HTMLInputElement>("#authorized")!.checked = true
          sessionStorage.removeItem("lyrashield-lite-target")
          pendingHomepageScan = true
        }
      } catch {}
    }
    const attribution = { utm_source: query.get("utm_source") || undefined, utm_medium: query.get("utm_medium") || undefined, utm_campaign: query.get("utm_campaign") || undefined, referrer: document.referrer || undefined }
    const referralCode = query.get("ref")?.toUpperCase().match(/^[23456789ABCDEFGHJKLMNPQRSTUVWXYZ]{8}$/)?.[0]

    async function hashDomain(url: string): Promise<string> {
      const host = new URL(url).hostname.toLowerCase()
      const digest = await crypto.subtle.digest("SHA-256", new TextEncoder().encode(host))
      return Array.from(new Uint8Array(digest)).map((byte) => byte.toString(16).padStart(2, "0")).join("")
    }

    function animateSteps() {
      const steps = [...document.querySelectorAll<HTMLElement>("#scan-steps li")]
      const activity = document.querySelector<HTMLElement>("#scan-activity")
      const progressbar = document.querySelector<HTMLElement>("#scan-stage-announcer")
      const stepDurationMs = 800 // ponytail: fixed UI cadence; make configurable only if product timing diverges.
      let active = 0
      let timer = 0
      let resolveFinished = () => {}
      let isFinished = false
      const finished = new Promise<void>((resolve) => { resolveFinished = resolve })

      const finish = () => {
        if (isFinished) return
        isFinished = true
        resolveFinished()
      }

      const showStep = (index: number) => {
        steps.forEach((step, stepIndex) => {
          const isActive = stepIndex === index
          step.dataset.state = isActive ? "active" : "pending"
          if (isActive) step.setAttribute("aria-current", "step")
          else step.removeAttribute("aria-current")
        })
        const status = steps[index]?.dataset.status || "Reviewing the public surface."
        if (activity) activity.textContent = status
        // Screen readers get the same stage change sighted users see in the stepper.
        progressbar?.setAttribute("aria-valuetext", `Step ${index + 1} of ${steps.length}: ${status}`)
      }

      showStep(active)
      if (matchMedia("(prefers-reduced-motion: reduce)").matches) {
        showStep(steps.length - 1)
        finish()
      } else {
        const advance = () => {
          active += 1
          if (active >= steps.length) return finish()
          showStep(active)
          timer = window.setTimeout(advance, stepDurationMs)
        }
        timer = window.setTimeout(advance, stepDurationMs)
      }

      return { finished, stop: () => { window.clearTimeout(timer); finish() } }
    }

    function chip(label: string, value: number, tone: string): HTMLElement { const el = document.createElement("span"); el.className = `rounded-full border px-3 py-1.5 text-xs font-semibold ${tone}`; el.textContent = `${value} ${label}`; return el }
    const severityLabel = { needs_attention: "Needs attention", worth_reviewing: "Worth reviewing", ok: "Looks OK" }
    const severityTone = { needs_attention: "border-danger/40 bg-danger/10 text-danger", worth_reviewing: "border-[var(--terminal-warning)]/40 bg-[var(--terminal-amber)]/10 text-[var(--terminal-warning-text)] dark:text-[var(--terminal-amber)]", ok: "border-accent/40 bg-accent-dim/35 text-accent" }

    function renderResult(result: LiteResult, durationMs: number) {
      currentResult = result
      const summary = result.liteResultSummary
      const heading = document.querySelector<HTMLElement>("#result-heading")!
      heading.textContent = summary.findingCount === 0 ? "No surface issues found" : `${summary.findingCount} thing${summary.findingCount === 1 ? "" : "s"} worth a look`
      document.querySelector<HTMLElement>("#result-target")!.textContent = `${result.target} · ${new Date(result.scannedAt).toLocaleString()}`
      const counts = document.querySelector<HTMLElement>("#result-counts")!
      counts.replaceChildren(
        chip("needs attention", summary.needsAttention, severityTone.needs_attention),
        chip("worth reviewing", summary.worthReviewing, severityTone.worth_reviewing),
        chip("look OK", summary.looksOk, severityTone.ok)
      )
      document.querySelector<HTMLElement>("#clean-result")!.classList.toggle("hidden", summary.findingCount !== 0)
      const findings = document.querySelector<HTMLElement>("#findings")!
      findings.replaceChildren()
      result.checks.forEach((check) => {
        const details = document.createElement("details")
        details.className = "group rounded-2xl border border-border bg-bg-raised p-5 sm:p-6"
        const summaryEl = document.createElement("summary")
        summaryEl.className = "flex min-h-11 cursor-pointer list-none items-center justify-between gap-4"
        const left = document.createElement("span")
        left.className = "flex flex-wrap items-center gap-3"
        const tag = document.createElement("span")
        tag.className = `rounded-full border px-2.5 py-1 text-xs font-semibold ${severityTone[check.severity]}`
        tag.textContent = severityLabel[check.severity]
        const title = document.createElement("strong")
        title.className = "text-left text-text"
        title.textContent = check.title
        left.appendChild(tag)
        left.appendChild(title)
        const plus = document.createElement("span")
        plus.className = "text-xl text-accent group-open:rotate-45"
        plus.setAttribute("aria-hidden", "true")
        plus.textContent = "+"
        summaryEl.appendChild(left)
        summaryEl.appendChild(plus)
        const body = document.createElement("div")
        body.className = "mt-4 grid gap-5 border-t border-border pt-5 text-sm leading-6 text-text-muted sm:grid-cols-2"
        const what = document.createElement("p")
        what.textContent = check.whatItIs
        const why = document.createElement("p")
        why.textContent = check.whyItMatters
        const link = document.createElement("a")
        link.href = `${check.learnMoreUrl}#evidence-states`
        link.className = "mt-4 inline-flex min-h-11 items-center font-semibold text-accent"
        link.textContent = "How LyraShield handles this →"
        const wrap = document.createElement("div")
        wrap.appendChild(why)
        wrap.appendChild(link)
        body.appendChild(what)
        body.appendChild(wrap)
        details.appendChild(summaryEl)
        details.appendChild(body)
        details.addEventListener("toggle", () => { if (details.open) capture("finding_expanded", { category: check.category, severity: check.severity }) })
        findings.appendChild(details)
      })
      results?.classList.remove("hidden"); results?.focus(); capture("scan_completed", { duration_ms: durationMs, finding_count: summary.findingCount, categories_flagged: [...new Set(result.checks.filter((check) => check.severity !== "ok").map((check) => check.category))], had_findings: summary.findingCount > 0 }); capture("upsell_viewed")
    }

    async function hashDomainOrReportError(url: string): Promise<string | null> {
      try {
        return await hashDomain(url)
      } catch {
        if (errorBox) {
          errorBox.textContent = "Enter a valid public URL."
          errorBox.classList.remove("hidden")
        }
        return null
      }
    }

    function captureScanStarted(domainHash: string) {
      const device = matchMedia("(max-width: 767px)").matches ? "mobile" : "desktop"
      capture("scan_started", { target_domain_hash: domainHash, device, ...attribution })
    }

    function showScanningUi() {
      scanButton!.disabled = true
      scanButton!.textContent = "Scanning…"
      results?.classList.add("hidden")
      scanning?.classList.remove("hidden")
      scanning?.setAttribute("aria-busy", "true")
      const motion = matchMedia("(prefers-reduced-motion: reduce)").matches
      scanning?.scrollIntoView({ behavior: motion ? "auto" : "smooth", block: "start" })
      return animateSteps()
    }

    function hideScanningUi(progress: ReturnType<typeof animateSteps>) {
      progress.stop()
      scanning?.classList.add("hidden")
      scanning?.removeAttribute("aria-busy")
      scanButton!.disabled = false
      scanButton!.textContent = "Scan my app"
    }

    async function runLiteScan(url: string, token: string): Promise<{ result: LiteResult; durationMs: number }> {
      // Without a deadline an unreachable target leaves the visitor watching the
      // running animation forever, with no result and no way to recover.
      const controller = new AbortController()
      const timeoutId = window.setTimeout(() => controller.abort(), LITE_SCAN_TIMEOUT_MS)
      let response: Response
      try {
        response = await fetch(`${appOrigin}/api/lite-scan`, {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ url, authorized: true, ...(token ? { turnstileToken: token } : {}) }),
          signal: controller.signal,
        })
      } catch (err) {
        if (err instanceof DOMException && err.name === "AbortError") {
          throw Object.assign(
            new Error("The check timed out. The site may be slow or unreachable — please try again."),
            { reason: "timeout" }
          )
        }
        throw Object.assign(
          new Error("Could not reach the checker. Check your connection and try again."),
          { reason: "network_error" }
        )
      } finally {
        window.clearTimeout(timeoutId)
      }
      const body = await response.json() as { result?: LiteResult; durationMs?: number; error?: string; message?: string }
      if (!response.ok || !body.result) {
        throw Object.assign(new Error(body.message || "The passive check could not finish."), {
          reason: body.error || "scan_error",
        })
      }
      return { result: body.result, durationMs: body.durationMs ?? 0 }
    }

    function handleScanError(error: Error & { reason?: string }, domainHash: string) {
      if (errorBox) {
        errorBox.textContent = error.message
        errorBox.classList.remove("hidden")
      }
      capture(error.reason === "ssrf_blocked" ? "scan_blocked" : "scan_error", {
        reason: error.reason || "unreachable",
        target_domain_hash: domainHash,
      })
      ;(window as TurnstileWindow).turnstile?.reset(turnstileWidget)
    }

    async function handleScanFormSubmit(event: Event) {
      event.preventDefault()
      errorBox?.classList.add("hidden")
      if (!appOrigin) return

      const input = document.querySelector<HTMLInputElement>("#scan-url")!
      let url = ""
      try {
        url = normalizePublicHttpUrl(input.value)
        input.value = url
      } catch {
        if (errorBox) {
          errorBox.textContent = "Enter a valid public HTTP or HTTPS URL without credentials."
          errorBox.classList.remove("hidden")
        }
        input.focus()
        return
      }

      const domainHash = await hashDomainOrReportError(url)
      if (!domainHash) return

      captureScanStarted(domainHash)
      const progress = showScanningUi()
      try {
        const { result, durationMs } = await runLiteScan(url, turnstileToken)
        await progress.finished
        renderResult(result, durationMs)
      } catch (cause) {
        handleScanError(cause as Error & { reason?: string }, domainHash)
      } finally {
        hideScanningUi(progress)
      }
    }

    function trackUpsellClicks() {
      document.querySelectorAll<HTMLButtonElement>("[data-capture-action]").forEach((button) => {
        button.addEventListener("click", () => {
          lastAction = button.dataset.captureAction || "waitlist"
          capture("upsell_clicked", { cta: lastAction })
        })
      })
      document.querySelector("[data-upsell='sample_report']")?.addEventListener("click", () => {
        capture("upsell_clicked", { cta: "sample_report" })
      })
    }

    async function handleCaptureFormSubmit(event: Event) {
      event.preventDefault()
      if (!currentResult) return
      const email = document.querySelector<HTMLInputElement>("#result-email")!.value
      const status = document.querySelector<HTMLElement>("#capture-status")!
      status.textContent = "Saving…"
      try {
        const waitlist = await fetch("/api/waitlist", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({
            email,
            source: "lite_scanner",
            referralCode,
            utmSource: attribution.utm_source,
            utmMedium: attribution.utm_medium,
            utmCampaign: attribution.utm_campaign,
            referrer: attribution.referrer,
          }),
        })
        const waitlistBody = await waitlist.json() as { referralCode?: string; message?: string }
        if (!waitlist.ok) throw new Error(waitlistBody.message || "Could not save your email.")
        capture("waitlist_joined", { source: "lite_scanner" })
        if (referralCode) capture("referral_signup", { source: "lite_scanner" })
        status.textContent = "You’re subscribed. We’ll email product updates and new feature announcements."
        if (lastAction === "scorecard") {
          const s = currentResult.liteResultSummary
          const card = await fetch(`${appOrigin}/api/lite-scorecards`, {
            method: "POST",
            headers: { "content-type": "application/json" },
            body: JSON.stringify({
              needsAttention: s.needsAttention,
              worthReviewing: s.worthReviewing,
              looksOk: s.looksOk,
              referralCode: waitlistBody.referralCode,
            }),
          })
          const cardBody = await card.json() as { url?: string }
          if (!card.ok || !cardBody.url) throw new Error("Could not create the scorecard.")
          const absolute = new URL(cardBody.url, appOrigin).toString()
          const link = document.querySelector<HTMLAnchorElement>("#scorecard-link")!
          link.href = absolute
          document.querySelector<HTMLElement>("#scorecard-actions")!.classList.remove("hidden")
          document.querySelector<HTMLElement>("#scorecard-actions")!.classList.add("flex")
          status.textContent = "Your shareable scorecard is ready."
          capture("scorecard_generated", { referral_code: waitlistBody.referralCode ? "present" : "absent" })
        }
      } catch (cause) {
        status.textContent = cause instanceof Error ? cause.message : "Could not save this result."
      }
    }

    async function handleShareScorecard() {
      const url = document.querySelector<HTMLAnchorElement>("#scorecard-link")!.href
      const status = document.querySelector<HTMLElement>("#capture-status")
      const payload = { title: "My LyraShield AI Lite Check", url }

      // canShare tells us the payload is actually shareable on this platform;
      // share() alone can exist and still reject for this data shape.
      const canNativeShare =
        typeof navigator.share === "function" &&
        (typeof navigator.canShare !== "function" || navigator.canShare(payload))

      if (canNativeShare) {
        try {
          await navigator.share(payload)
          capture("scorecard_shared", { channel: "native" })
          return
        } catch (cause) {
          // Dismissing the share sheet is a normal user choice, not a failure.
          if ((cause as DOMException | undefined)?.name === "AbortError") return
          // Anything else: fall through to the clipboard path.
        }
      }

      try {
        await navigator.clipboard.writeText(url)
        if (status) status.textContent = "Link copied to your clipboard."
        capture("scorecard_shared", { channel: "copy" })
      } catch {
        // Clipboard can be blocked by permissions or a non-secure context.
        if (status) status.textContent = "Could not copy automatically — copy the link above."
      }
    }

    function startHomepageScan() {
      if (pendingHomepageScan) {
        pendingHomepageScan = false
        scanForm?.requestSubmit()
      }
    }

    function bootTurnstile() {
      const turnstile = (window as TurnstileWindow).turnstile
      if (!turnstile) {
        turnstileAttempts += 1
        if (turnstileAttempts > TURNSTILE_MAX_ATTEMPTS) {
          if (errorBox) {
            errorBox.textContent =
              "Could not load the verification challenge. Disable your ad blocker for this page or reload to try again."
            errorBox.classList.remove("hidden")
          }
          // No scan is in flight at boot, so there is no progress animation to
          // stop — just make sure the form is not left in a disabled state.
          if (scanButton) scanButton.disabled = false
          return
        }
        window.setTimeout(bootTurnstile, TURNSTILE_POLL_INTERVAL_MS)
        return
      }
      turnstileWidget = turnstile.render("#turnstile-container", {
        sitekey: turnstileSiteKey,
        size: "flexible",
        appearance: "interaction-only",
        callback: (token: string) => {
          turnstileToken = token
          startHomepageScan()
        },
        "expired-callback": () => {
          turnstileToken = ""
        },
      })
    }

    scanForm?.addEventListener("submit", handleScanFormSubmit)
    trackUpsellClicks()
    document.querySelector<HTMLFormElement>("#capture-form")?.addEventListener("submit", handleCaptureFormSubmit)
    document.querySelector<HTMLButtonElement>("#share-scorecard")?.addEventListener("click", handleShareScorecard)

    if (referralCode) capture("referral_visit", { source: "lite_scanner" })
    if (turnstileSiteKey) {
      bootTurnstile()
    } else {
      startHomepageScan()
    }
  </script>
</Base>
