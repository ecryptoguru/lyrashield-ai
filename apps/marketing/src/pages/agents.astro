---
import Base from "@layouts/Base.astro"
import { agentOnboarding } from "../lib/agent-onboarding"

const origin = Astro.site?.origin || "http://localhost:4321"
const canonical = new URL("/agents", origin).toString()
const pageUrl = canonical
const title = "LyraShield AI for Coding Agents — MCP Setup & Approval-Gated Tools"
const description = agentOnboarding.description

const howToSteps = [
  {
    "@type": "HowToStep" as const,
    position: 1,
    name: "Sign in with OAuth",
    text: `Run ${agentOnboarding.commands[0]} to select a workspace and save the local credential.`,
    url: `${pageUrl}#setup`,
  },
  {
    "@type": "HowToStep" as const,
    position: 2,
    name: "Install the Agent Plugin",
    text: `Run ${agentOnboarding.commands[1]} to detect and configure your coding agent.`,
    url: `${pageUrl}#setup`,
  },
  {
    "@type": "HowToStep" as const,
    position: 3,
    name: "Choose your supported coding agent",
    text: "Use the matching integration guide for your coding agent.",
    url: `${pageUrl}#clients`,
  },
  {
    "@type": "HowToStep" as const,
    position: 4,
    name: "Use review tools with approval",
    text: "Read-only tools are available after authentication; mutations require write scope and explicit human approval.",
    url: `${pageUrl}#safety`,
  },
]

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "TechArticle",
    headline: title,
    description,
    url: pageUrl,
    dateModified: "2026-08-15",
    author: { "@id": `${origin}/#organization` },
    publisher: { "@id": `${origin}/#organization` },
    inLanguage: "en-US",
  },
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    name: "Set up LyraShield for your coding agent",
    description:
      "Start with OAuth, then run the Agent Plugin installer. Read-only tools are available after authentication; mutations need a write scope and human out-of-band approval.",
    step: howToSteps,
    totalTime: "PT2M",
  },
]
---

<Base title={title} description={description} canonical={canonical} jsonLd={jsonLd}>
  <section class="px-4 py-16 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-5xl">
      <p class="font-mono text-sm uppercase tracking-[0.14em] text-accent" data-reveal>
        For coding agents
      </p>
      <h1
        class="mt-4 max-w-3xl text-4xl font-semibold tracking-tight text-text sm:text-5xl lg:text-6xl"
        data-reveal
      >
        Release assurance your coding agent can act on.
      </h1>
      <p class="mt-5 max-w-2xl text-lg leading-8 text-text-muted" data-reveal>
        {description}
      </p>
      <a
        href="/docs/integrations/agent-plugins"
        data-cta-id="agents-start-setup"
        class="lift mt-7 inline-flex min-h-12 items-center rounded-lg bg-accent px-6 text-sm font-semibold text-bg transition-colors hover:bg-accent/90 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
        data-reveal
      >
        Set up LyraShield for your agent
      </a>
    </div>
  </section>

  <section class="px-4 py-12 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-5xl">
      <h2 class="font-mono text-sm uppercase tracking-[0.12em] text-text-muted" data-reveal>
        Six-stage release loop
      </h2>
      <ol
        class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3"
        aria-label="Release assurance workflow"
        data-reveal-group
      >
        {
          agentOnboarding.workflow.map((name, index) => (
            <li class="rounded-xl border border-border bg-bg-raised p-5" data-reveal>
              <span class="font-mono text-xs text-accent">
                {String(index + 1).padStart(2, "0")}
              </span>
              <p class="mt-1 font-semibold text-text">{name}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="px-4 py-12 sm:px-6 lg:px-8" id="setup">
    <div class="mx-auto max-w-5xl">
      <h2 class="font-mono text-sm uppercase tracking-[0.12em] text-text-muted" data-reveal>
        Two-command setup
      </h2>
      <div
        class="mt-6 overflow-hidden rounded-xl border border-border bg-bg-raised"
        data-reveal
        aria-label="Setup commands"
      >
        <pre class="p-5 font-mono text-sm leading-relaxed text-text"><code
          >{agentOnboarding.commands.join("\n")}</code
        ></pre>
      </div>
      <p class="mt-4 max-w-2xl text-sm text-text-muted" data-reveal>
        Log in with OAuth first, then run the init command to detect and configure your agent.
      </p>
      {/* Real numbered markup matching the HowTo schema's four steps 1:1. The
          schema previously described four steps (OAuth, install, choose agent,
          use tools with approval) with nothing on the page rendered as an
          actual <ol> — Google's HowTo/list-snippet feature wants the visible
          markup and the schema to correspond, not just the schema alone. */}
      <ol class="mt-8 space-y-4 border-t border-border pt-8" data-reveal-group>
        <li class="flex gap-3" data-reveal>
          <span class="font-mono text-sm text-accent">1</span>
          <span class="text-sm text-text-muted">
            <span class="font-medium text-text">Sign in with OAuth</span> — run{" "}
            <code class="rounded bg-bg-raised px-1.5 py-0.5 font-mono text-[0.85em] text-text">{agentOnboarding.commands[0]}</code>{" "}
            to select a workspace and save the local credential.
          </span>
        </li>
        <li class="flex gap-3" data-reveal>
          <span class="font-mono text-sm text-accent">2</span>
          <span class="text-sm text-text-muted">
            <span class="font-medium text-text">Install the Agent Plugin</span> — run{" "}
            <code class="rounded bg-bg-raised px-1.5 py-0.5 font-mono text-[0.85em] text-text">{agentOnboarding.commands[1]}</code>{" "}
            to detect and configure your coding agent.
          </span>
        </li>
        <li class="flex gap-3" data-reveal>
          <span class="font-mono text-sm text-accent">3</span>
          <span class="text-sm text-text-muted">
            <span class="font-medium text-text">Choose your supported coding agent</span> — use the
            matching <a href="#clients" class="font-medium text-accent underline decoration-accent/40 underline-offset-4 hover:decoration-accent">integration guide</a> for your client.
          </span>
        </li>
        <li class="flex gap-3" data-reveal>
          <span class="font-mono text-sm text-accent">4</span>
          <span class="text-sm text-text-muted">
            <span class="font-medium text-text">Use review tools with approval</span> — read-only
            tools are available after authentication; mutations require write scope and{" "}
            <a href="#safety" class="font-medium text-accent underline decoration-accent/40 underline-offset-4 hover:decoration-accent">explicit human approval</a>.
          </span>
        </li>
      </ol>
    </div>
  </section>

  <section class="px-4 py-12 sm:px-6 lg:px-8" id="clients">
    <div class="mx-auto max-w-5xl">
      <h2 class="font-mono text-sm uppercase tracking-[0.12em] text-text-muted" data-reveal>
        Supported coding agents ({agentOnboarding.clients.length})
      </h2>
      <p class="mt-4 max-w-2xl leading-7 text-text-muted" data-reveal>
        <code class="rounded bg-bg-raised px-1.5 py-0.5 font-mono text-[0.85em] text-text"
          >npx lyrashield init</code
        > detects which of these you have installed and configures each one. The badge says what setup
        looks like for that client; every name links to its own guide.
      </p>
      {
        agentOnboarding.clientGroups.map((group) => (
          <div class="mt-10" data-reveal-group>
            <h3 class="font-mono text-xs tracking-[0.12em] text-accent uppercase" data-reveal>
              {group.label} · {group.clients.length}
            </h3>
            <ul
              class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3"
              aria-label={`Coding agents: ${group.label}`}
            >
              {group.clients.map((client) => (
                <li data-reveal>
                  <a
                    href={client.href}
                    class="flex min-h-[4.5rem] flex-col justify-center gap-1 rounded-xl border border-border bg-bg-raised p-4 transition-colors hover:border-accent focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
                  >
                    <span class="font-semibold text-text">{client.name}</span>
                    <span class="text-xs text-text-muted">{client.strategyLabel}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  <section class="px-4 py-12 sm:px-6 lg:px-8" id="safety">
    <div class="mx-auto max-w-5xl rounded-2xl border border-border bg-bg-raised p-6 sm:p-10" data-reveal>
      <h2 class="font-mono text-sm uppercase tracking-[0.12em] text-text-muted" data-reveal>
        What an agent can and cannot do
      </h2>
      <ul class="mt-6 space-y-3" data-reveal-group>
        {
          agentOnboarding.safety.map((item) => (
            <li class="flex gap-3 text-text" data-reveal>
              <span class="text-accent" aria-hidden="true">
                —
              </span>
              <span>{item}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="px-4 py-12 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-5xl" data-reveal>
      <p class="text-text-muted">
        Read the{" "}
        <a href="/docs/integrations/agent-plugins" class="font-semibold text-accent underline underline-offset-4">
          Agent Plugin guide
        </a>{" "}
        or the{" "}
        <a href="/docs/integrations/remote-mcp" class="font-semibold text-accent underline underline-offset-4">
          Remote MCP docs
        </a>{" "}
        for the full setup and safety model.
      </p>
    </div>
  </section>
</Base>
