---
import Base from "@layouts/Base.astro"
import { agentOnboarding } from "../lib/agent-onboarding"
import { buildDateFor } from "../lib/build-date"
import { CTA_LABEL } from "../lib/site-copy"

const origin = Astro.site?.origin || "http://localhost:4321"
const canonical = new URL("/agents", origin).toString()
const pageUrl = canonical
const title = "LyraShield AI for coding agents — MCP and agent tools"
const description = agentOnboarding.description
const buildDate = buildDateFor("src/pages/agents.astro", "src/lib/agent-onboarding.ts")
// Explicit freshness floor: the last content change to this page. The
// git-derived buildDate wins when it resolves; the floor keeps dateModified
// honest when the page ships without .git.
const updatedDate = "2026-10-02"
const dateModified = buildDate ?? `${updatedDate}T00:00:00.000Z`

const appUrl =
  (import.meta.env.PUBLIC_APP_URL as string | undefined)?.replace(/\/$/, "") ||
  "https://app.lyrashieldai.com"

const answerFirst =
  `LyraShield documents ${agentOnboarding.clients.length} coding-agent workflows. Most connect through MCP; Aider uses the standalone CLI or CI path, while Pi has built-in MCP and OAuth support. Availability and setup differ by client and the integration labels below show the evidence behind each claim; LyraShield runtime acceptance remains client-specific. Read-only tools can retrieve recorded findings; hosted writes run only within a browser-confirmed connection grant and are checked again at execution.`

const howToSteps = [
  {
    "@type": "HowToStep" as const,
    position: 1,
    name: "Choose a client workflow",
    text: "Use the matching integration guide and check its support tier, transport and activation steps.",
    url: `${pageUrl}#setup`,
  },
  {
    "@type": "HowToStep" as const,
    position: 2,
    name: "Configure and authenticate",
    text: "Use client-hosted OAuth when supported; local stdio flows use the LyraShield CLI credential store or an API key.",
    url: `${pageUrl}#setup`,
  },
  {
    "@type": "HowToStep" as const,
    position: 3,
    name: "Choose your supported coding agent",
    text: "Use the matching integration guide for your coding agent.",
    url: `${pageUrl}#clients`,
  },
  {
    "@type": "HowToStep" as const,
    position: 4,
    name: "Verify in the client",
    text: "Restart the client, inspect its tool list and rules and make a read-only call. Hosted writes require a scoped connection grant and execution-time checks.",
    url: `${pageUrl}#safety`,
  },
]

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "TechArticle",
    headline: title,
    description,
    url: pageUrl,
    dateModified,
    author: { "@id": `${origin}/#organization` },
    publisher: { "@id": `${origin}/#organization` },
    inLanguage: "en-US",
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${origin}/` },
      { "@type": "ListItem", position: 2, name: "For coding agents", item: pageUrl },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    name: "Set up LyraShield for your coding agent",
    description:
      "Select a documented client workflow, authenticate through the supported method and verify a read-only tool call in that client.",
    step: howToSteps,
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: title,
    description,
    url: pageUrl,
    dateModified,
    isPartOf: { "@id": `${origin}/#website` },
    about: { "@id": `${origin}/#application` },
    inLanguage: "en-US",
  },
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "@id": `${pageUrl}#application`,
    name: "LyraShield AI",
    applicationCategory: "SecurityApplication",
    operatingSystem: "Web",
    description,
    url: pageUrl,
    provider: { "@id": `${origin}/#organization` },
    isPartOf: { "@id": `${origin}/#website` },
  },
]
---

<Base title={title} description={description} canonical={canonical} jsonLd={jsonLd}>
  <section class="px-4 py-16 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-5xl">
      <p class="font-mono text-sm uppercase tracking-[0.14em] text-accent" data-reveal>
        For coding agents
      </p>
      <h1
        class="mt-4 max-w-3xl text-4xl font-semibold tracking-tight text-text sm:text-5xl lg:text-6xl"
        data-reveal
      >
        A launch gate your coding agent can act on.
      </h1>
      <p class="mt-5 max-w-2xl text-lg leading-8 text-text-muted" data-reveal>
        {answerFirst}
      </p>
      <a
        href="/docs/integrations/agent-plugins"
        data-cta-id="agents-start-setup"
        class="lift mt-7 inline-flex min-h-12 items-center rounded-lg bg-accent px-6 text-sm font-semibold text-bg transition-colors hover:bg-accent/90 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
        data-reveal
      >
        Set up LyraShield for your agent
      </a>
    </div>
  </section>

  <section class="px-4 py-12 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-5xl">
      <h2 class="font-mono text-sm uppercase tracking-[0.12em] text-text-muted" data-reveal>
        Six-stage release loop
      </h2>
      <ol
        class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3"
        aria-label="Launch gate workflow"
        data-reveal-group
      >
        {
          agentOnboarding.workflow.map((name, index) => (
            <li class="rounded-xl border border-border bg-bg-raised p-5" data-reveal>
              <span class="font-mono text-xs text-accent">
                {String(index + 1).padStart(2, "0")}
              </span>
              <p class="mt-1 font-semibold text-text">{name}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="px-4 py-12 sm:px-6 lg:px-8" id="setup">
    <div class="mx-auto max-w-5xl">
      <h2 class="font-mono text-sm uppercase tracking-[0.12em] text-text-muted" data-reveal>
        {agentOnboarding.setupHeading}
      </h2>
      <div
        class="mt-6 overflow-hidden rounded-xl border border-border bg-bg-raised"
        data-reveal
        aria-label="Local OAuth setup command"
      >
        <pre class="p-5 font-mono text-sm leading-relaxed text-text"><code
          >{agentOnboarding.commands.join("\n")}</code
        ></pre>
      </div>
      <p class="mt-4 max-w-2xl text-sm text-text-muted" data-reveal>
        {agentOnboarding.setupDescription}
      </p>
      <ol class="mt-8 space-y-4 border-t border-border pt-8" data-reveal-group>
        <li class="flex gap-3" data-reveal>
          <span class="font-mono text-sm text-accent">1</span>
          <span class="text-sm text-text-muted">
            <span class="font-medium text-text">Choose a client workflow</span> — use the
            matching <a href="#clients" class="font-medium text-accent underline decoration-accent/40 underline-offset-4 hover:decoration-accent">integration guide</a> and check its support label.
          </span>
        </li>
        <li class="flex gap-3" data-reveal>
          <span class="font-mono text-sm text-accent">2</span>
          <span class="text-sm text-text-muted">
            <span class="font-medium text-text">Configure and authenticate</span> — use the client's
            documented MCP or standalone path. Hosted OAuth runs in the client; local stdio uses
            the CLI credential store or an API key.
          </span>
        </li>
        <li class="flex gap-3" data-reveal>
          <span class="font-mono text-sm text-accent">3</span>
          <span class="text-sm text-text-muted">
            <span class="font-medium text-text">Check activation</span> — restart the client,
            inspect its discovered tools and rules and make a read-only call.
          </span>
        </li>
        <li class="flex gap-3" data-reveal>
          <span class="font-mono text-sm text-accent">4</span>
          <span class="text-sm text-text-muted">
            <span class="font-medium text-text">Use scoped review tools</span> — hosted writes require
            a browser-confirmed grant and execution-time checks.{" "}
            <a href="#safety" class="font-medium text-accent underline decoration-accent/40 underline-offset-4 hover:decoration-accent">Read the safety model</a>.
          </span>
        </li>
      </ol>
    </div>
  </section>

  <section class="px-4 py-12 sm:px-6 lg:px-8" id="clients">
    <div class="mx-auto max-w-5xl">
      <h2 class="font-mono text-sm uppercase tracking-[0.12em] text-text-muted" data-reveal>
        Documented client workflows ({agentOnboarding.clients.length})
      </h2>
      <p class="mt-4 max-w-2xl leading-7 text-text-muted" data-reveal>
        Use the pinned CLI installer where a client guide provides an exact supported command;
        otherwise follow its manual MCP or native setup. The CLI installs shared skills only where
        the client has one documented skill path. Preserve existing settings, comments where
        supported and symlinks; restart the client, confirm discovery and complete an authenticated
        read-only call. Marketplace listing and runtime acceptance remain separate evidence.
      </p>
      <label class="mt-6 block max-w-md">
        <span class="text-sm font-semibold text-text">Find your client</span>
        <input
          type="search"
          id="agent-client-filter"
          data-agent-client-filter
          placeholder="Search clients by name"
          autocomplete="off"
          class="mt-2 min-h-12 w-full rounded-lg border border-border bg-bg-raised px-4 text-base text-text placeholder:text-text-muted focus:border-accent focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
        />
      </label>
      <p id="agent-client-empty" class="mt-4 hidden text-sm text-text-muted" role="status">
        No documented client matches that search. Clear the field to see all clients.
      </p>
      {
        agentOnboarding.clientGroups.map((group) => (
          <div class="mt-10" data-reveal-group>
            <h3 class="font-mono text-xs tracking-[0.12em] text-accent uppercase" data-reveal>
              {group.label} · {group.clients.length}
            </h3>
            <ul
              class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3"
              aria-label={`Coding agents: ${group.label}`}
            >
              {group.clients.map((client) => (
                <li data-reveal data-agent-client={client.name.toLowerCase()}>
                  <a
                    href={client.href}
                    class="flex min-h-[4.5rem] flex-col justify-center gap-1 rounded-xl border border-border bg-bg-raised p-4 transition-colors hover:border-accent focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
                  >
                    <span class="font-semibold text-text">{client.name}</span>
                    <span class="text-xs text-text-muted">{client.strategyLabel}</span>
                    <span class="text-xs text-text-muted">{client.supportTier} · {client.evidence.replaceAll("_", " ").toLowerCase()} evidence</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  <script>
    // Client picker: a plain substring filter over the rendered client list. It
    // touches no network surface and reads no value the visitor did not type
    // into the filter field itself.
    const filter = document.querySelector<HTMLInputElement>("[data-agent-client-filter]")
    const empty = document.getElementById("agent-client-empty")
    if (filter) {
      const items = Array.from(document.querySelectorAll<HTMLElement>("[data-agent-client]"))
      const apply = () => {
        const term = filter.value.trim().toLowerCase()
        let visible = 0
        for (const item of items) {
          const match = term.length === 0 || (item.dataset.agentClient ?? "").includes(term)
          item.hidden = !match
          if (match) visible += 1
        }
        empty?.classList.toggle("hidden", visible > 0)
      }
      filter.addEventListener("input", apply)
    }
  </script>

  <section class="px-4 py-12 sm:px-6 lg:px-8" id="safety">
    <div class="mx-auto max-w-5xl rounded-2xl border border-border bg-bg-raised p-6 sm:p-10" data-reveal>
      <h2 class="font-mono text-sm uppercase tracking-[0.12em] text-text-muted" data-reveal>
        What an agent can and cannot do
      </h2>
      <ul class="mt-6 space-y-3" data-reveal-group>
        {
          agentOnboarding.safety.map((item) => (
            <li class="flex gap-3 text-text" data-reveal>
              <span class="text-accent" aria-hidden="true">
                —
              </span>
              <span>{item}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="px-4 py-12 sm:px-6 lg:px-8">
    <div class="mx-auto flex max-w-5xl flex-col gap-4 sm:flex-row sm:items-center sm:justify-between" data-reveal>
      <p class="text-text-muted">
        Read the{" "}
        <a href="/docs/integrations/agent-plugins" class="font-semibold text-accent underline underline-offset-4">
          Agent Plugin guide
        </a>{" "}
        or the{" "}
        <a href="/docs/integrations/remote-mcp" class="font-semibold text-accent underline underline-offset-4">
          Remote MCP docs
        </a>{" "}
        for the full setup and safety model.
      </p>
      <a
        href={`${appUrl}/sign-up?source=agents`}
        data-cta-id="agents-start-trial"
        class="lift inline-flex min-h-12 shrink-0 items-center justify-center rounded-lg bg-accent px-6 text-sm font-semibold text-bg transition-colors hover:bg-accent/90 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
      >
        {CTA_LABEL.signUp}
      </a>
    </div>
  </section>
</Base>
