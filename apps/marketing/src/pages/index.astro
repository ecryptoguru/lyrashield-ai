---
import Base from "@layouts/Base.astro"
import PremiumHero from "@components/landing/PremiumHero.astro"
import HeroProductFrame from "@components/landing/HeroProductFrame.astro"
import HomeLiteScan from "@components/landing/HomeLiteScan.astro"
import EvidenceWorld from "@components/landing/EvidenceWorld.astro"
import Faq from "@components/landing/Faq.astro"
import FinalCta from "@components/landing/FinalCta.astro"
import { CLOUD_PLANS, formatUSD } from "@lyrashield/pricing"
import { createMotionMediaManifest } from "../lib/motion-manifest"
import { agentOnboarding } from "../lib/agent-onboarding"
import {
  VIBE_SECURITY_CONTROLS,
  VIBE_SECURITY_COVERAGE_VERSION,
} from "../../../../packages/security/src/vibe-security-controls"
import { WEBMCP_CONTROLS } from "../../../../packages/security/src/webmcp/controls"
import { tools } from "../lib/tools"
import { TRIAL_LINE } from "../lib/site-copy"
import { buildDateFor } from "../lib/build-date"

const siteOrigin = Astro.site?.origin || "http://localhost:4321"
const pageUrl = new URL("/", siteOrigin).toString()
const buildDate =
  buildDateFor("src/pages/index.astro", "src/components/landing/") ?? undefined
// Explicit freshness floor: the last content change to this page. The
// git-derived buildDate wins when it resolves; the floor keeps dateModified
// honest when the page ships without .git.
const updatedDate = "2026-09-27"
const dateModified = buildDate ?? `${updatedDate}T00:00:00.000Z`
const cloudPlans = CLOUD_PLANS.filter((plan) => plan.selfServe)
const enterprisePlan = CLOUD_PLANS.find((plan) => plan.id === "ENTERPRISE")!
const renderHash = import.meta.env.PUBLIC_MOTION_RENDER_HASH as string
const mediaUrl = renderHash === "local" ? "/media-local" : import.meta.env.PUBLIC_MEDIA_URL
// Every number below is derived from the registry the scanner executes, so this
// page cannot drift from /vibe-security-50 or llms.txt. The 43/7 split is
// asserted at build time on that page, and asserted again by homepage.test.ts.
const vibeControls = VIBE_SECURITY_CONTROLS
const evidenceControlCount = vibeControls.filter((control) => control.strategy === "evidence").length
const reviewControlCount = vibeControls.length - evidenceControlCount

// The CLI line reads the pinned version from agent-onboarding, so the version
// pin lives in exactly one place.
const webmcpControlCount = WEBMCP_CONTROLS.length
const cliLoginCommand = agentOnboarding.commands[0]
const documentedClientCount = agentOnboarding.clients.length

const motionManifest = createMotionMediaManifest(mediaUrl, renderHash)

const description =
  "Review the code your agents wrote and the tools your app exposes to agents. Get one shareable launch report before you ship. Open beta, no card needed."

const faqItems = [
  {
    q: "What happens after I create an account?",
    a: "Create a workspace, add an authorized repository, public URL or API target, then choose the review depth. LyraShield keeps the resulting scope, findings, evidence states, fix proposals and fresh retest outcomes in one launch report.",
  },
  {
    q: "What does a LyraShield result actually prove?",
    a: "Only what the retained evidence supports. We keep detected findings, retest-confirmed fixes, inconclusive retests and checks that were limited or not applicable distinct. Missing proof stays visible.",
  },
  {
    q: "Does LyraShield automatically fix my code?",
    a: "No. LyraShield records fix proposals and can stage a server-generated patch. Fix PRs open only after a human approves, with a server-generated patch. A connected OAuth agent may run only the operations authorized by its browser-confirmed grant, with checks at execution. Nothing auto-merges.",
  },
  {
    q: "Is this a replacement for my other security scanners?",
    a: "No. LyraShield complements specialist scanners rather than replacing them: SCA, secrets scanning, dependency checks and repo review are coverage layers inside a wider launch-gate workflow that adds evidence states, fix proposals and retests. Specialist tools may still provide deeper coverage in their own category.",
  },
  {
    q: "What is the Operational Evidence Vault?",
    a: "It is a private workspace where you collect, review and version proof for the seven Vibe Security 50 controls that cannot be established by a repository or URL scan: audit trails, monitoring, backup tests, sandboxing, test independence, multi-agent trust and accountable review. Accepted evidence is frozen into a checksum-bound private assurance report; public shared reports do not include it.",
  },
  {
    q: "What is live today and what is on the roadmap?",
    a: `Live today: the free Lite Check, ${tools.length} browser-local tools, the full launch-gate platform in open beta, the Operational Evidence Vault, MCP and GitHub integrations, a published CLI and a GitHub Action with a diff-aware gate and SARIF output. Registration is open; product pages describe current coverage and limits. Cloud prices are listed on /pricing, while purchase availability is shown in the authenticated product.`,
  },
  {
    q: "Do you store my codebase?",
    a: "Scans run in hardened, short-lived environments. The full platform retains scope, receipts, findings and evidence states, not a copy of your source. Shared reports exclude repository coordinates, file paths and raw secrets.",
  },
  {
    q: "How is the Lite Check different from the full review?",
    a: "The Lite Check passively reads an authorized public URL for a bounded set of surface signals. The full platform can review repositories, URLs and APIs, retain control-level evidence, stage fix proposals, run fresh retests and produce a shareable launch report.",
  },
]

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${pageUrl}#webpage`,
    name: "Launch gate for AI-built apps",
    description,
    url: pageUrl,
    inLanguage: "en-US",
    dateModified,
    isPartOf: { "@id": `${siteOrigin}/#website` },
    about: { "@id": `${pageUrl}#application` },
    mainEntity: { "@id": `${pageUrl}#faq` },
  },
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "@id": `${pageUrl}#application`,
    name: "LyraShield AI",
    applicationCategory: "SecurityApplication",
    operatingSystem: "Web",
    description,
    url: pageUrl,
    provider: { "@id": `${siteOrigin}/#organization` },
    isPartOf: { "@id": `${siteOrigin}/#website` },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "@id": `${pageUrl}#faq`,
    mainEntity: faqItems.map((item) => ({
      "@type": "Question",
      name: item.q,
      acceptedAnswer: {
        "@type": "Answer",
        text: item.a,
      },
    })),
  },
]
---

<Base
  title="LyraShield AI — The launch gate for AI-built apps"
  description={description}
  canonical={pageUrl}
  jsonLd={jsonLd}
>
  <PremiumHero />

  {/* Block 2: what is different. Four claims, each provable in code, placed
      directly under the hero so the differentiator is not buried below pricing.
      The "Nothing auto-merges" sentence is a locked contract (waitlist.test.ts),
      so it stays verbatim. */}
  <section id="different" aria-labelledby="different-heading" class="border-y border-border bg-bg-raised/45 px-4 py-12 sm:px-6 sm:py-14 lg:px-8" style="scroll-margin-top: 4.5rem">
    <div class="mx-auto max-w-6xl">
      <h2 id="different-heading" class="text-2xl font-semibold tracking-tight text-text sm:text-3xl">
        A verdict that shows its work.
      </h2>
      <p class="mt-3 max-w-3xl leading-7 text-text-muted">
        Four things stay visible so you can defend the decision to ship.
      </p>
      <div class="mt-6 grid gap-4 md:grid-cols-2">
        <article class="rounded-xl border border-border bg-bg p-5">
          <h3 class="font-semibold text-text">Three evidence states, never blended</h3>
          <p class="mt-2 text-sm leading-6 text-text-muted">
            Detected, retest-confirmed and inconclusive stay separate on every finding.
          </p>
          <a href="/methodology" data-cta-id="homepage-different-methodology" class="mt-3 inline-flex min-h-11 items-center font-semibold text-accent underline underline-offset-4">Read the definitions</a>
        </article>
        <article class="rounded-xl border border-border bg-bg p-5">
          <h3 class="font-semibold text-text">Missing evidence stays visible</h3>
          <p class="mt-2 text-sm leading-6 text-text-muted">
            If a check did not run or cannot prove a fix, the verdict says insufficient evidence instead of rounding up to a pass.
          </p>
        </article>
        <article class="rounded-xl border border-border bg-bg p-5">
          <h3 class="font-semibold text-text">You approve every fix</h3>
          <p class="mt-2 text-sm leading-6 text-text-muted">
            Fixes arrive as proposals. Nothing auto-merges. A connected coding agent acts only inside a grant you confirm in the browser.
          </p>
        </article>
        <article class="rounded-xl border border-border bg-bg p-5">
          <h3 class="font-semibold text-text">A fresh run confirms the fix</h3>
          <p class="mt-2 text-sm leading-6 text-text-muted">
            A new server-owned retest checks the change. The conversation that wrote the patch never grades its own work.
          </p>
        </article>
      </div>
      <p class="mt-4 text-sm leading-6 text-text-muted">
        Works alongside the scanners you already run. LyraShield adds evidence states, fix proposals and retests.
      </p>
    </div>
  </section>

  <HomeLiteScan />
  {/* Block 4: the journey. It carries the #how-it-works anchor because the
      header, the footer and the Product menu all link to it. */}
  <div id="how-it-works" class="cinematic-threshold cinematic-threshold--to-dark" aria-hidden="true"></div>
  <EvidenceWorld manifest={motionManifest} />
  <div class="cinematic-threshold cinematic-threshold--to-light" aria-hidden="true"></div>
  <HeroProductFrame />

  {/* Block 5: surfaces. Merges the old product frame's role into tabs. The
      CLI line reads the pinned version from agent-onboarding so the pin lives in
      one place. Native radio/checkbox-free tabs: buttons with aria-selected. */}
  <section aria-labelledby="surfaces-heading" class="px-4 py-12 sm:px-6 sm:py-14 lg:px-8">
    <div class="mx-auto max-w-6xl">
      <h2 id="surfaces-heading" class="text-2xl font-semibold tracking-tight text-text sm:text-3xl">
        Use it where you already work.
      </h2>
      <div class="mt-6 flex flex-wrap gap-2" role="tablist" aria-label="Surfaces">
        {[
          { id: "web", label: "Web app" },
          { id: "cli", label: "CLI" },
          { id: "action", label: "GitHub Action" },
          { id: "agents", label: "Coding agents" },
        ].map((surface, index) => (
          <button
            type="button"
            role="tab"
            id={`surface-tab-${surface.id}`}
            aria-controls={`surface-panel-${surface.id}`}
            aria-selected={index === 0 ? "true" : "false"}
            tabindex={index === 0 ? 0 : -1}
            data-cta-id={`homepage-surface-tab-${surface.id}`}
            class="surface-tab min-h-11 rounded-xl border border-border px-4 text-sm font-semibold text-text-muted focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
          >
            {surface.label}
          </button>
        ))}
      </div>

      <div class="mt-5">
        <div role="tabpanel" id="surface-panel-web" aria-labelledby="surface-tab-web" class="surface-panel">
          <p class="leading-7 text-text-muted">
            The console keeps scope, coverage, findings and their evidence states, fix proposals and fresh retest outcomes together, so the release decision is reviewable rather than reconstructed.
          </p>
        </div>
        <div role="tabpanel" id="surface-panel-cli" aria-labelledby="surface-tab-cli" class="surface-panel" hidden>
          <p class="leading-7 text-text-muted">Start a local workspace session from the command line.</p>
          <pre class="mt-3 overflow-x-auto rounded-xl border border-border bg-bg-raised p-4 text-sm"><code>{cliLoginCommand}</code></pre>
          <p class="mt-3 leading-7 text-text-muted">
            The installer pins the client version, so the command above is the one this site is built against.
          </p>
        </div>
        <div role="tabpanel" id="surface-panel-action" aria-labelledby="surface-tab-action" class="surface-panel" hidden>
          <p class="leading-7 text-text-muted">
            Runs scan-level SARIF in GitHub repositories without a LyraShield account or API key, so a pull request gets a check before anyone signs up.
          </p>
          <a href="/docs/integrations/github-action" data-cta-id="homepage-surface-action-docs" class="mt-3 inline-flex min-h-11 items-center font-semibold text-accent underline underline-offset-4">Read the GitHub Action guide</a>
        </div>
        <div role="tabpanel" id="surface-panel-agents" aria-labelledby="surface-tab-agents" class="surface-panel" hidden>
          <p class="leading-7 text-text-muted">
            {documentedClientCount} documented client workflows. Your agent runs the checks and brings back evidence. Hosted writes still need a browser-confirmed grant.
          </p>
          <a href="/agents" data-cta-id="homepage-surface-agents-setup" class="mt-3 inline-flex min-h-11 items-center font-semibold text-accent underline underline-offset-4">Set up your coding agent</a>
        </div>
      </div>
    </div>
  </section>

  {/* Block 6: coverage and fit. The 43/7 split and the 14 WebMCP controls are
      read from their registries, not typed here. */}
  <section aria-labelledby="coverage-heading" class="border-y border-border bg-bg-raised/45 px-4 py-12 sm:px-6 sm:py-14 lg:px-8">
    <div class="mx-auto grid max-w-6xl gap-8 lg:grid-cols-[1.6fr_1fr] lg:items-start">
      <div>
        <h2 id="coverage-heading" class="text-2xl font-semibold tracking-tight text-text sm:text-3xl">
          {vibeControls.length} launch controls, {evidenceControlCount} of which need proof only you can give.
        </h2>
        <p class="mt-4 leading-7 text-text-muted">
          {reviewControlCount} are reviewed from code or a URL. The other {evidenceControlCount} describe how you operate: audit coverage, monitoring, restore proof, deployment egress, test independence, multi-agent trust and accountable review. Those live in the Operational Evidence Vault.
        </p>
        <p class="mt-3 text-sm leading-6 text-text-muted">
          Coverage version {VIBE_SECURITY_COVERAGE_VERSION}. A clean result does not prove an application has no vulnerabilities.
        </p>
        <div class="mt-6 grid gap-4 sm:grid-cols-3">
          <article class="rounded-xl border border-border bg-bg p-5">
            <h3 class="font-semibold text-text">LyraShield covers</h3>
            <p class="mt-2 text-sm leading-6 text-text-muted">Repository, URL and API reviews, agent-tool surfaces and an operational evidence record.</p>
          </article>
          <article class="rounded-xl border border-border bg-bg p-5">
            <h3 class="font-semibold text-text">Scanners you already run</h3>
            <p class="mt-2 text-sm leading-6 text-text-muted">Dependency and secrets scanning in depth. LyraShield adds evidence states, fix proposals and retests rather than replacing them.</p>
          </article>
          <article class="rounded-xl border border-border bg-bg p-5">
            <h3 class="font-semibold text-text">No tool can prove</h3>
            <p class="mt-2 text-sm leading-6 text-text-muted">That an application has no vulnerabilities.</p>
          </article>
        </div>
        <div class="mt-5 flex flex-wrap gap-x-6 gap-y-2 text-sm font-semibold">
          <a href="/vibe-security-50" data-cta-id="homepage-coverage-controls" class="inline-flex min-h-11 items-center text-accent underline underline-offset-4">Vibe Security 50</a>
          <a href="/evidence-vault" data-cta-id="homepage-coverage-vault" class="inline-flex min-h-11 items-center text-accent underline underline-offset-4">Evidence Vault</a>
        </div>
      </div>
      <aside class="rounded-xl border border-border bg-bg p-5">
        <h3 class="font-semibold text-text">WebMCP Assurance</h3>
        <p class="mt-2 text-sm leading-6 text-text-muted">
          {webmcpControlCount} WebMCP controls checked in your browser. Nothing is uploaded.
        </p>
        <a href="/webmcp" data-cta-id="homepage-coverage-webmcp" class="mt-3 inline-flex min-h-11 items-center font-semibold text-accent underline underline-offset-4">Open WebMCP Assurance</a>
      </aside>
    </div>
  </section>
  <section id="cloud-plans" aria-labelledby="home-pricing-heading" class="border-y border-border bg-bg-raised/45 px-4 py-12 sm:px-6 sm:py-14 lg:px-8">
    <div class="mx-auto max-w-6xl">
      <p class="font-mono text-xs font-semibold tracking-wider text-accent uppercase">Cloud plans</p>
      <h2 id="home-pricing-heading" class="mt-3 text-2xl font-semibold tracking-tight text-text sm:text-3xl">Choose by review depth and capacity</h2>
      <p class="mt-3 min-w-0 max-w-3xl break-words text-sm leading-6 text-text-muted">
        Start with a free trial: {TRIAL_LINE}. Paid plans bill monthly or annually; regional prices and full limits are on <a href="/pricing" class="font-semibold text-accent underline underline-offset-4">pricing</a>.
      </p>
      <div class="mt-6 grid grid-cols-1 gap-4 md:grid-cols-3">
        {cloudPlans.map((plan) => (
          <article class="min-w-0 rounded-xl border border-border bg-bg p-5">
            <h3 class="break-words font-semibold text-text">{plan.name}</h3>
            <p class="mt-2 flex min-w-0 flex-wrap items-baseline gap-x-1 text-xl font-bold text-text sm:text-2xl">
              <span>{formatUSD(plan.price.usd.monthly)}</span>
              <span class="text-sm font-normal text-text-muted">/mo</span>
            </p>
            <p class="mt-1 min-w-0 break-words text-sm text-text-muted">
              <span>{formatUSD(plan.price.usd.annual)}/yr</span>
              <span aria-hidden="true"> · </span>
              <span>{plan.agentMinutes.toLocaleString()} agent-minutes/month</span>
              <span aria-hidden="true"> · </span>
              <span>up to {plan.targetCaps} targets</span>
            </p>
            <p class="mt-3 min-w-0 break-words text-sm text-text-muted">{plan.deepAllowed ? "Deep and Custom scans included." : "Safe, Quick and Standard scans."}</p>
          </article>
        ))}
      </div>
      <p class="mt-4 min-w-0 break-words text-sm text-text-muted">
        Enterprise is contact-led from {formatUSD(enterprisePlan.price.usd.monthly)}/month. Talk to us about custom limits and a contact-led rollout.
      </p>
    </div>
  </section>
  <Faq items={faqItems} />
  <section id="demo" aria-labelledby="demo-heading" class="px-4 py-14 sm:px-6 lg:px-8" style="scroll-margin-top: 4.5rem">
    <div class="mx-auto max-w-3xl" data-reveal-group>
      <p class="font-mono text-xs font-semibold tracking-[.18em] text-accent uppercase" data-reveal>
        Talk to the founder
      </p>
      <h2 id="demo-heading" data-reveal class="mt-4 text-3xl font-semibold tracking-tight text-text sm:text-4xl">
        See how LyraShield fits your app.
      </h2>
      <p data-reveal class="mt-5 max-w-2xl text-lg leading-8 text-text-muted">
        Walk through the product with Ankit. Discuss what you are shipping, how the evidence and
        retest workflow works and where a review would fit your release process.
      </p>
      <div class="mt-8" data-reveal>
        <a
          href="/demo"
          data-cta-id="home-demo"
          class="lift inline-flex min-h-12 items-center justify-center rounded-lg border border-border bg-bg px-6 text-sm font-semibold text-text hover:border-accent focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
        >
          Book a demo
        </a>
      </div>
    </div>
  </section>
  <FinalCta />
</Base>

<script>
  // Surfaces tabs (spec section 8 block 5). Every panel is present in the
  // markup, so with JavaScript off the first panel still reads and the links
  // inside the other panels are still in the document.
  const tablist = document.querySelector('[role="tablist"]')
  if (tablist) {
    const tabs = Array.from(tablist.querySelectorAll<HTMLButtonElement>('[role="tab"]'))
    const panels = tabs
      .map((tab) => document.getElementById(tab.getAttribute("aria-controls") ?? ""))
      .filter((panel): panel is HTMLElement => Boolean(panel))

    const select = (index: number) => {
      tabs.forEach((tab, position) => {
        const active = position === index
        tab.setAttribute("aria-selected", active ? "true" : "false")
        tab.tabIndex = active ? 0 : -1
      })
      panels.forEach((panel, position) => {
        panel.hidden = position !== index
      })
    }

    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => select(index))
      tab.addEventListener("keydown", (event) => {
        const step = event.key === "ArrowRight" ? 1 : event.key === "ArrowLeft" ? -1 : 0
        if (!step) return
        event.preventDefault()
        const next = (index + step + tabs.length) % tabs.length
        select(next)
        tabs[next]?.focus()
      })
    })
  }
</script>

<style>
  .surface-tab[aria-selected="true"] {
    border-color: var(--accent);
    color: var(--text);
    background: var(--bg-raised);
  }

  .cinematic-threshold {
    min-height: clamp(3rem, 7vw, 7rem);
    pointer-events: none;
  }

  .cinematic-threshold--to-light {
    background:
      radial-gradient(ellipse at 50% 0%, color-mix(in srgb, var(--terminal-cyan) 10%, transparent), transparent 64%),
      linear-gradient(
        to bottom,
        var(--hero-void),
        color-mix(in srgb, var(--hero-void) 28%, var(--bg)) 62%,
        var(--bg)
      );
  }

  .cinematic-threshold--to-dark {
    background:
      radial-gradient(ellipse at 50% 100%, color-mix(in srgb, var(--terminal-cyan) 8%, transparent), transparent 64%),
      linear-gradient(
        to bottom,
        var(--bg),
        color-mix(in srgb, var(--hero-void) 28%, var(--bg)) 38%,
        var(--hero-void)
      );
  }

  :global(:root[data-theme="light"]) .cinematic-threshold--to-dark {
    background:
      radial-gradient(ellipse at 50% 100%, rgba(8, 127, 120, 0.08), transparent 64%),
      linear-gradient(to bottom, var(--bg), #08111c);
  }

  :global(:root[data-theme="light"]) .cinematic-threshold--to-light {
    background:
      radial-gradient(ellipse at 50% 0%, rgba(8, 127, 120, 0.08), transparent 64%),
      linear-gradient(to bottom, #08111c, var(--bg));
  }

</style>
