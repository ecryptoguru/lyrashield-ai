---
import Base from "@layouts/Base.astro"
import ScrollWorld from "@components/landing/ScrollWorld.astro"
import PremiumHero from "@components/landing/PremiumHero.astro"
import EvidenceMap from "@components/landing/EvidenceMap.astro"
import TargetGlyph from "@components/landing/TargetGlyph.astro"
import HeroProductFrame from "@components/landing/HeroProductFrame.astro"
import HomeLiteScan from "@components/landing/HomeLiteScan.astro"
import EvidenceWorld from "@components/landing/EvidenceWorld.astro"
import Faq from "@components/landing/Faq.astro"
import FinalCta from "@components/landing/FinalCta.astro"
import { CLOUD_PLANS, formatUSD } from "@lyrashield/pricing"
import { createMotionMediaManifest } from "../lib/motion-manifest"
import { agentOnboarding } from "../lib/agent-onboarding"
import { TRIAL_LINE } from "../lib/site-copy"
import { buildDateFor } from "../lib/build-date"

const siteOrigin = Astro.site?.origin || "http://localhost:4321"
const pageUrl = new URL("/", siteOrigin).toString()
const buildDate =
  buildDateFor("src/pages/index.astro", "src/components/landing/") ?? undefined
// Explicit freshness floor: the last content change to this page. The
// git-derived buildDate wins when it resolves; the floor keeps dateModified
// honest when the page ships without .git.
const updatedDate = "2026-10-29"
const dateModified = buildDate ?? `${updatedDate}T00:00:00.000Z`
const cloudPlans = CLOUD_PLANS.filter((plan) => plan.selfServe)

const enterprisePlan = CLOUD_PLANS.find((plan) => plan.id === "ENTERPRISE")!
const appSignUpUrl =
  "https://app.lyrashieldai.com/sign-up?source=landing_pricing"
const renderHash = __MARKETING_LOCAL_PREVIEW__ ? "local" : import.meta.env.PUBLIC_MOTION_RENDER_HASH as string
const mediaUrl = renderHash === "local" ? "/media-local" : import.meta.env.PUBLIC_MEDIA_URL
const cliLoginCommand = agentOnboarding.commands[0]

const motionManifest = createMotionMediaManifest(mediaUrl, renderHash)

const description =
  "Review your repo, website or API with LyraShield AI. See the evidence, approve proposed fixes and retest before sharing a launch report."

const faqItems = [
  {
    q: "What happens after I create an account?",
    a: "Create a workspace, add an authorized repository, website or API, then choose the review depth. Your findings, evidence states, fix proposals and retest outcomes stay together.",
  },
  {
    q: "What does a result prove?",
    a: "Only what retained evidence supports. Detected findings, retest-confirmed fixes and inconclusive results stay distinct. Missing coverage stays visible; no result guarantees that an application has no vulnerabilities.",
  },
  {
    q: "Do fixes need my approval?",
    a: "Yes. Fix PRs open only after a human approves, with a server-generated patch. Nothing auto-merges. Connected agents act only within a browser-confirmed grant.",
  },
  {
    q: "How is Lite Check different from a full review?",
    a: "Lite Check passively reads a bounded set of signals at an authorized public URL. A full review supports repositories, websites and APIs, retained evidence, approval-gated fix proposals, fresh retests and a shareable report.",
  },
]

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${pageUrl}#webpage`,
    name: "Launch gate for AI-built apps",
    description,
    url: pageUrl,
    inLanguage: "en-US",
    dateModified,
    isPartOf: { "@id": `${siteOrigin}/#website` },
    about: { "@id": `${pageUrl}#application` },
    mainEntity: { "@id": `${pageUrl}#faq` },
  },
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "@id": `${pageUrl}#application`,
    name: "LyraShield AI",
    applicationCategory: "SecurityApplication",
    operatingSystem: "Web",
    description,
    url: pageUrl,
    provider: { "@id": `${siteOrigin}/#organization` },
    isPartOf: { "@id": `${siteOrigin}/#website` },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "@id": `${pageUrl}#faq`,
    mainEntity: faqItems.map((item) => ({
      "@type": "Question",
      name: item.q,
      acceptedAnswer: {
        "@type": "Answer",
        text: item.a,
      },
    })),
  },
]
---

<Base
  title="LyraShield AI — The launch gate for AI-built apps"
  description={description}
  canonical={pageUrl}
  jsonLd={jsonLd}
>
  <ScrollWorld manifest={motionManifest}>
  <div class="visual-intro">
    <PremiumHero cinematic />
    <EvidenceMap />
    <HomeLiteScan />
  </div>
  {/* Block 4: the journey. It carries the #how-it-works anchor because the
      header, the footer and the Product menu all link to it. */}
  <div id="how-it-works" class="cinematic-threshold cinematic-threshold--to-dark" aria-hidden="true"></div>
  <EvidenceWorld manifest={motionManifest} />
  </ScrollWorld>
  <div class="cinematic-threshold cinematic-threshold--to-light" aria-hidden="true"></div>
  <HeroProductFrame />

  <section class="workflow-rail" aria-labelledby="surfaces-heading">
    <div class="workflow-rail__inner">
      <h2 id="surfaces-heading">Fits your workflow.</h2>
      <div class="workflow-rail__integrations">
        <a href="#product-preview"><TargetGlyph kind="web" />Web app</a>
        <details><summary><TargetGlyph kind="api" />CLI setup</summary><div class="workflow-rail__command"><pre><code data-cli-command>{cliLoginCommand}</code></pre><button type="button" data-copy-cli>Copy command</button><span data-copy-status role="status"></span></div></details>
        <a href="/docs/integrations/github-action" data-cta-id="homepage-surface-action-docs"><TargetGlyph kind="repo" />GitHub Action</a>
        <a href="/agents" data-cta-id="homepage-surface-agents-setup"><TargetGlyph kind="approval" />Coding agents</a>
      </div>
      <div id="coverage-heading" class="workflow-rail__links">
        <a href="/vibe-security-50" data-cta-id="homepage-coverage-controls">Control coverage</a>
        <a href="/evidence-vault" data-cta-id="homepage-coverage-vault">Evidence Vault</a>
        <a href="/webmcp" data-cta-id="homepage-coverage-webmcp">WebMCP</a>
        <a href="/tools/php2shell-checker" data-cta-id="homepage-coverage-php2shell">PHP2Shell checker</a>
      </div>
    </div>
  </section>
  <section id="cloud-plans" aria-labelledby="home-pricing-heading" class="border-y border-border bg-bg-raised/45 px-4 py-12 sm:px-6 sm:py-14 lg:px-8">
    <div class="mx-auto max-w-6xl">

      <h2 id="home-pricing-heading" class="mt-3 text-2xl font-semibold tracking-tight text-text sm:text-3xl">Choose your plan.</h2>
      <p class="mt-3 min-w-0 max-w-3xl break-words text-sm leading-6 text-text-muted">
        Free trial: {TRIAL_LINE}. <a href="/pricing" class="font-semibold text-accent underline underline-offset-4">All limits and regional pricing</a>.
      </p>
      <div class="mt-6 grid grid-cols-1 gap-4 md:grid-cols-3">
        {cloudPlans.map((plan) => (
          <article class="min-w-0 rounded-xl border border-border bg-bg p-5">
            <h3 class="break-words font-semibold text-text">{plan.name}</h3>
            <p class="mt-2 flex min-w-0 flex-wrap items-baseline gap-x-1 text-xl font-bold text-text sm:text-2xl">
              <span>{formatUSD(plan.price.usd.monthly)}</span>
              <span class="text-sm font-normal text-text-muted">/mo</span>
            </p>
            <p class="mt-1 min-w-0 break-words text-sm text-text-muted">
              <span>{formatUSD(plan.price.usd.annual)}/yr</span>
              <span aria-hidden="true"> · </span>
              <span>
                {plan.agentMinutes.toLocaleString()} agent-minutes/month{" "}

              </span>
              <span aria-hidden="true"> · </span>
              <span>up to {plan.targetCaps} targets</span>
            </p>
            <p class="mt-2 min-w-0 break-words text-sm text-text-muted">{plan.deepAllowed ? "Deep and Custom included." : "Safe, Quick and Standard."}</p>
            <a
              href={`${appSignUpUrl}&cta=choose_${plan.id.toLowerCase()}`}
              data-cta-id={`homepage-plan-choose-${plan.id.toLowerCase()}`}
              class="mt-4 inline-flex min-h-11 w-full items-center justify-center rounded-xl border border-accent px-4 text-sm font-semibold text-accent hover:bg-accent/10 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
            >
              Choose {plan.name}
            </a>
          </article>
        ))}
      </div>
      <p class="mt-4 min-w-0 break-words text-sm text-text-muted">
        Wall-clock server time. Deep and Custom scans count 3x.<br />Enterprise from {formatUSD(enterprisePlan.price.usd.monthly)}/month. <a href="/demo" class="underline underline-offset-4">Talk to us</a>.
      </p>
    </div>
  </section>
  <Faq items={faqItems} />
  <FinalCta />
</Base>

<script>
  const copyButton = document.querySelector<HTMLButtonElement>("[data-copy-cli]")
  const copyStatus = document.querySelector<HTMLElement>("[data-copy-status]")
  copyButton?.addEventListener("click", async () => {
    const command = document.querySelector("[data-cli-command]")?.textContent
    if (!command || !copyStatus) return
    copyButton.disabled = true
    try {
      await navigator.clipboard.writeText(command)
      copyStatus.textContent = "Copied"
    } catch {
      copyStatus.textContent = "Copy unavailable. Select the command to copy it."
    } finally { copyButton.disabled = false }
  })
</script>

<style>
  /* Keep the measured opening flight span while replacing prose with visual stages.
     These are composed scenes, not spacer elements; content can grow at enlarged text. */
  .visual-intro { display: grid; grid-template-columns: minmax(0, 1fr); grid-template-rows: repeat(3, minmax(auto, 1fr)); min-height: calc(1950px + 60svh); }
  .workflow-rail { padding: 1rem max(1rem, calc((100% - 1152px)/2)) 4rem; }
  .workflow-rail__inner { border-block: 1px solid var(--border); padding-block: 2rem; }
  .workflow-rail h2 { margin: 0 0 1.5rem; font-size: 1.5rem; letter-spacing: -.02em; }
  .workflow-rail__integrations { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 10rem), 1fr)); gap: 1rem; align-items: start; }
  .workflow-rail__integrations > * { min-width: 0; }
  .workflow-rail__integrations > a, .workflow-rail summary { display: flex; align-items: center; gap: .75rem; min-height: 44px; color: var(--text); font-weight: 600; cursor: pointer; }
  .workflow-rail__integrations :global(svg) { color: var(--accent); flex: none; width: 24px; height: 24px; }
  .workflow-rail__links { display: flex; flex-wrap: wrap; gap: .5rem 1.5rem; padding-top: 1.5rem; }
  .workflow-rail__links a { display: inline-flex; align-items: center; min-height: 44px; color: var(--accent); font-size: .875rem; text-decoration: underline; text-underline-offset: 4px; }
  .workflow-rail__command { margin-top: 1rem; padding: .75rem; background: var(--bg-raised); border-radius: .75rem; }
  .workflow-rail pre { max-width: 100%; white-space: pre-wrap; overflow-wrap: anywhere; font-size: .75rem; }
  .workflow-rail button { min-height: 44px; max-width: 100%; padding: .5rem .75rem; overflow-wrap: anywhere; border: 1px solid var(--border); border-radius: .5rem; font-size: .875rem; }
  .workflow-rail a:focus-visible, .workflow-rail summary:focus-visible, .workflow-rail button:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
  @media(max-width:1023px) { .visual-intro { min-height: calc(2607px + 60svh); } }
  @media(max-width:480px) { .visual-intro { min-height: calc(3700px + 60svh); } }
  @media(max-width:374px) { .visual-intro { min-height: calc(3920px + 60svh); } }

  .cinematic-threshold {
    min-height: clamp(3rem, 7vw, 7rem);
    pointer-events: none;
  }

  .cinematic-threshold--to-light {
    background:
      radial-gradient(ellipse at 50% 0%, color-mix(in srgb, var(--terminal-cyan) 10%, transparent), transparent 64%),
      linear-gradient(
        to bottom,
        var(--hero-void),
        color-mix(in srgb, var(--hero-void) 28%, var(--bg)) 62%,
        var(--bg)
      );
  }

  .cinematic-threshold--to-dark {
    background:
      radial-gradient(ellipse at 50% 100%, color-mix(in srgb, var(--terminal-cyan) 8%, transparent), transparent 64%),
      linear-gradient(
        to bottom,
        var(--bg),
        color-mix(in srgb, var(--hero-void) 28%, var(--bg)) 38%,
        var(--hero-void)
      );
  }

  :global(:root[data-theme="light"]) .cinematic-threshold--to-dark {
    background:
      radial-gradient(ellipse at 50% 100%, rgba(8, 127, 120, 0.08), transparent 64%),
      linear-gradient(to bottom, var(--bg), #08111c);
  }

  :global(:root[data-theme="light"]) .cinematic-threshold--to-light {
    background:
      radial-gradient(ellipse at 50% 0%, rgba(8, 127, 120, 0.08), transparent 64%),
      linear-gradient(to bottom, #08111c, var(--bg));
  }

</style>
