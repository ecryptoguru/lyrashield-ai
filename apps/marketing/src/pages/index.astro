---
import Base from "@layouts/Base.astro"
import ScrollWorld from "@components/landing/ScrollWorld.astro"
import PremiumHero from "@components/landing/PremiumHero.astro"
import HeroProductFrame from "@components/landing/HeroProductFrame.astro"
import HomeLiteScan from "@components/landing/HomeLiteScan.astro"
import EvidenceWorld from "@components/landing/EvidenceWorld.astro"
import Faq from "@components/landing/Faq.astro"
import FinalCta from "@components/landing/FinalCta.astro"
import { CLOUD_PLANS, formatUSD } from "@lyrashield/pricing"
import { createMotionMediaManifest } from "../lib/motion-manifest"
import { TRIAL_LINE } from "../lib/site-copy"

const siteOrigin = Astro.site?.origin || "http://localhost:4321"
const pageUrl = new URL("/", siteOrigin).toString()
// Editorial date shared with the sitemap; update only when this page changes.
const updatedDate = "2026-10-28"
const dateModified = updatedDate
const cloudPlans = CLOUD_PLANS.filter((plan) => plan.selfServe)

// Per-plan audience line and the Choose label, keyed by plan id so the card
// never invents a name. The label form is "Choose {name}", per the vocabulary
// lock (the retired form was "Start with {name}").
const planIntent: Record<string, string> = {
  STARTER: "For solo builders.",
  PRO: "For deeper reviews.",
  LAUNCH_ASSURANCE: "For teams of up to five.",
}
const enterprisePlan = CLOUD_PLANS.find((plan) => plan.id === "ENTERPRISE")!
const appSignUpUrl =
  "https://app.lyrashieldai.com/sign-up?source=landing_pricing"
const renderHash = __MARKETING_LOCAL_PREVIEW__ ? "local" : import.meta.env.PUBLIC_MOTION_RENDER_HASH as string
const mediaUrl = renderHash === "local" ? "/media-local" : import.meta.env.PUBLIC_MEDIA_URL
const motionManifest = createMotionMediaManifest(mediaUrl, renderHash)

const description =
  "Review AI-built repositories, websites and APIs with LyraShield AI. Inspect evidence, approve proposed fixes and retest before release. Free trial, no card."

const faqItems = [
  {
    q: "What happens after I create an account?",
    a: "Create a workspace, add a repository, website or API you are authorized to test and choose the review depth. LyraShield AI keeps findings, evidence, fix proposals and retest outcomes together for your release review.",
  },
  {
    q: "What does a LyraShield result prove?",
    a: "Only what the retained evidence supports. Detected findings, retest-confirmed fixes and inconclusive results stay distinct. Missing coverage stays visible. No scan guarantees an application has no vulnerabilities.",
  },
  {
    q: "Does LyraShield automatically fix my code?",
    a: "Fixes arrive as proposals. Fix PRs open only after a human approves, with a server-generated patch. A connected agent can act only within its browser-confirmed grant. Nothing auto-merges.",
  },
  {
    q: "How is the Lite Check different from a full review?",
    a: "The free Lite Check passively reads an authorized public URL for bounded surface signals. A full review can assess repositories, websites and APIs, retain evidence, propose fixes and run fresh retests. Complete deterministic coverage can confirm a fix; engine-only absence stays inconclusive.",
  },
]

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${pageUrl}#webpage`,
    name: "Launch gate for AI-built apps",
    description,
    url: pageUrl,
    inLanguage: "en-US",
    dateModified,
    isPartOf: { "@id": `${siteOrigin}/#website` },
    about: { "@id": `${pageUrl}#application` },
    mainEntity: { "@id": `${pageUrl}#faq` },
  },
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "@id": `${pageUrl}#application`,
    name: "LyraShield AI",
    applicationCategory: "SecurityApplication",
    operatingSystem: "Web",
    description,
    url: pageUrl,
    provider: { "@id": `${siteOrigin}/#organization` },
    isPartOf: { "@id": `${siteOrigin}/#website` },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "@id": `${pageUrl}#faq`,
    mainEntity: faqItems.map((item) => ({
      "@type": "Question",
      name: item.q,
      acceptedAnswer: {
        "@type": "Answer",
        text: item.a,
      },
    })),
  },
]
---

<Base
  title="LyraShield AI — The launch gate for AI-built apps"
  description={description}
  canonical={pageUrl}
  jsonLd={jsonLd}
>
  <div class="premium-landing">
  <ScrollWorld manifest={motionManifest}>
    <PremiumHero cinematic />
    <div id="how-it-works" class="workflow-anchor"></div>
    <EvidenceWorld manifest={motionManifest} />
  </ScrollWorld>
  <HeroProductFrame />
  <nav class="capability-links" aria-label="Explore product capabilities" id="different">
    <a id="surfaces-heading" href="/agents">Coding agents</a>
    <a id="coverage-heading" href="/vibe-security-50">Coverage &amp; limits</a>
    <a href="/methodology">Evidence methodology</a>
    <a href="/evidence-vault">Evidence Vault</a>
    <a href="/webmcp">WebMCP Assurance</a>
  </nav>
  <HomeLiteScan />

  <section id="cloud-plans" aria-labelledby="home-pricing-heading" class="border-y border-border bg-bg-raised/45 px-4 py-12 sm:px-6 sm:py-14 lg:px-8">
    <div class="mx-auto max-w-6xl">

      <h2 id="home-pricing-heading" class="mt-3 text-2xl font-semibold tracking-tight text-text sm:text-3xl">A plan for your next release.</h2>
      <p class="mt-3 min-w-0 max-w-3xl break-words text-sm leading-6 text-text-muted">
        Start with a free trial: {TRIAL_LINE}. Paid plans bill monthly or annually; regional prices and full limits are on <a href="/pricing" class="font-semibold text-accent underline underline-offset-4">pricing</a>.
      </p>
      <div class="mt-6 grid grid-cols-1 gap-4 md:grid-cols-3">
        {cloudPlans.map((plan) => (
          <article class="min-w-0 rounded-xl border border-border bg-bg p-5">
            <h3 class="break-words font-semibold text-text">{plan.name}</h3>
            <p class="mt-2 flex min-w-0 flex-wrap items-baseline gap-x-1 text-xl font-bold text-text sm:text-2xl">
              <span>{formatUSD(plan.price.usd.monthly)}</span>
              <span class="text-sm font-normal text-text-muted">/mo</span>
            </p>
            <p class="mt-1 min-w-0 break-words text-sm text-text-muted">
              <span>{formatUSD(plan.price.usd.annual)}/yr</span>
              <span aria-hidden="true"> · </span>
              <span>
                {plan.agentMinutes.toLocaleString()} agent-minutes/month{" "}
                <abbr title="Wall-clock server time. Deep and Custom scans count 3x." class="cursor-help no-underline">ⓘ</abbr>
              </span>
              <span aria-hidden="true"> · </span>
              <span>up to {plan.targetCaps} targets</span>
            </p>
            <p class="mt-3 min-w-0 break-words text-sm text-text-muted">{planIntent[plan.id]}</p>
            <p class="mt-2 min-w-0 break-words text-sm text-text-muted">{plan.deepAllowed ? "Deep and Custom scans included." : "Safe, Quick and Standard scans."}</p>
            <a
              href={`${appSignUpUrl}&cta=choose_${plan.id.toLowerCase()}`}
              data-cta-id={`homepage-plan-choose-${plan.id.toLowerCase()}`}
              class="mt-4 inline-flex min-h-11 w-full items-center justify-center rounded-xl border border-accent px-4 text-sm font-semibold text-accent hover:bg-accent/10 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
            >
              Choose {plan.name}
            </a>
          </article>
        ))}
      </div>
      <p class="mt-4 min-w-0 break-words text-sm text-text-muted">
        Enterprise is contact-led from {formatUSD(enterprisePlan.price.usd.monthly)}/month. <a href="/demo" class="text-accent underline underline-offset-4">Talk to the founder</a>.
      </p>
    </div>
  </section>
  <Faq items={faqItems} />
  <FinalCta />
  </div>
</Base>

<style>
  .workflow-anchor { scroll-margin-top: 5rem; }
  .capability-links { display: flex; flex-wrap: wrap; justify-content: center; gap: .25rem 1.75rem; max-width: 1280px; margin: 0 auto; padding: 0 1rem 2.5rem; }
  .capability-links a { display: inline-flex; align-items: center; min-height: 44px; color: var(--accent); font-size: .875rem; text-underline-offset: .3em; }
  .capability-links a:hover { text-decoration: underline; }
  .capability-links a:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
  .capability-links [id] { scroll-margin-top: 6rem; }
  :global(.premium-landing a), :global(.premium-landing button) { transition: color 150ms, background-color 160ms, border-color 160ms, transform 160ms cubic-bezier(.16,1,.3,1); }
  :global(.premium-landing a:active), :global(.premium-landing button:active) { transform: translateY(1px); }
  :global(.premium-landing ::selection) { background: var(--accent-dim); color: var(--text); }
  :global(.premium-landing input) { caret-color: var(--accent); }
  :global(.premium-landing #cloud-plans article) { display: flex; flex-direction: column; padding: clamp(1.25rem, 3vw, 2rem); }
  :global(.premium-landing #cloud-plans article > a) { margin-top: auto; transform: translateY(0); }
  :global(.premium-landing #cloud-plans article > p:last-of-type) { padding-bottom: 1.25rem; }
  :global(.premium-landing #cloud-plans h2) { font-family: "Bricolage Grotesque Variable", sans-serif; font-size: clamp(2rem, 4vw, 3rem); line-height: 1.1; }
  @media (prefers-reduced-motion: reduce) {
    :global(.premium-landing a), :global(.premium-landing button) { transition: color 100ms, background-color 100ms, border-color 100ms; transform: none; }
  }
</style>
