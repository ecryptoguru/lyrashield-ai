---
import Base from "@layouts/Base.astro"
import PremiumHero from "@components/landing/PremiumHero.astro"
import V2Launch from "@components/landing/V2Launch.astro"
import HomeLiteScan from "@components/landing/HomeLiteScan.astro"
import AssuranceRecord from "@components/landing/AssuranceRecord.astro"
import EvidenceWorld from "@components/landing/EvidenceWorld.astro"
import WhereYouWork from "@components/landing/WhereYouWork.astro"
import TwoDepths from "@components/landing/TwoDepths.astro"
import FreeToolsPreview from "@components/landing/FreeToolsPreview.astro"
import Faq from "@components/landing/Faq.astro"
import FinalCta from "@components/landing/FinalCta.astro"
import { createMotionMediaManifest } from "../lib/motion-manifest"

const siteOrigin = Astro.site?.origin || "http://localhost:4321"
const pageUrl = new URL("/", siteOrigin).toString()
const mediaUrl = import.meta.env.DEV ? "/media-local" : import.meta.env.PUBLIC_MEDIA_URL
const renderHash = import.meta.env.DEV ? "local" : import.meta.env.PUBLIC_MOTION_RENDER_HASH
const motionManifest = createMotionMediaManifest(mediaUrl, renderHash)

const description =
  "Ship AI-built apps with evidence, not hope. One reviewable record of what you checked, what you fixed, and what a fresh retest confirmed before release. Open beta."

const faqItems = [
  {
    q: "What is release assurance for an AI-built app?",
    a: "One reviewable record that states which authorized targets you checked, what coverage ran, the evidence behind each finding, and what a retest actually confirmed before release. It is a record of what was tested, not a guarantee there are no issues.",
  },
  {
    q: "What does a LyraShield result actually prove?",
    a: "Only what the retained evidence supports. We keep detected candidates, independently verified findings, validated fixes (retest-confirmed), inconclusive retests, and checks that were limited or not applicable distinct. Missing proof stays visible.",
  },
  {
    q: "Does LyraShield automatically fix my code?",
    a: "No. LyraShield creates approval-gated fix proposals that explain the issue and stage a server-generated patch. Every code change requires your explicit review and approval. Nothing auto-merges.",
  },
  {
    q: "Is this a replacement for my other security scanners?",
    a: "No. SCA, secrets scanning, dependency checks, and repo review are coverage layers inside a wider release-assurance workflow. Specialist tools may still provide deeper coverage in their own category. The value here is the combined loop and evidence record, not claiming depth parity alone.",
  },
  {
    q: "What is live today and what is on the roadmap?",
    a: "Live today: free Lite Check (passive public URL scan), five browser-local tools, the full release-assurance platform in open beta with open registration (target, review, evidence, fix proposal, retest, report), the MCP server for agent-native use, and GitHub integration. Near-term roadmap: deeper deterministic coverage, richer SARIF interop, a reusable GitHub Action with a diff-aware gate, and expanded shareable report variants. Pricing and plan limits will be announced as the beta matures.",
  },
  {
    q: "Do you store my codebase?",
    a: "No. Scans run in hardened, short-lived environments. The Lite Check is passive and read-only. The full platform retains scope, receipts, findings, and evidence states, not a copy of your source.",
  },
]

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${pageUrl}#webpage`,
    name: "Release assurance for AI-built apps",
    description,
    url: pageUrl,
    inLanguage: "en-US",
    dateModified: "2026-07-17",
    isPartOf: { "@id": `${siteOrigin}/#website` },
    about: { "@id": `${pageUrl}#application` },
    mainEntity: { "@id": `${pageUrl}#faq` },
  },
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "@id": `${pageUrl}#application`,
    name: "LyraShield AI",
    applicationCategory: "SecurityApplication",
    operatingSystem: "Web",
    description,
    url: pageUrl,
    provider: { "@id": `${siteOrigin}/#organization` },
    isPartOf: { "@id": `${siteOrigin}/#website` },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "@id": `${pageUrl}#faq`,
    mainEntity: faqItems.map((item) => ({
      "@type": "Question",
      name: item.q,
      acceptedAnswer: {
        "@type": "Answer",
        text: item.a,
      },
    })),
  },
]
---

<Base
  title="LyraShield AI — Ship AI-built apps with evidence, not hope"
  description={description}
  canonical={pageUrl}
  jsonLd={jsonLd}
>
  <PremiumHero />
  <div class="cinematic-threshold cinematic-threshold--to-light" aria-hidden="true"></div>
  <V2Launch />
  <HomeLiteScan />
  {/* Anchor for the "How it works" nav link. The Assurance World walkthrough
      below (Target → Scan → Evidence → Fix → Retest → Report) is the how-it-works
      loop; this keeps the shareable /#how-it-works URL resolving on the homepage. */}
  <div id="how-it-works" aria-hidden="true" style="scroll-margin-top: 4.5rem"></div>
  <div class="cinematic-threshold cinematic-threshold--to-dark" aria-hidden="true"></div>
  <EvidenceWorld manifest={motionManifest} />
  <div class="cinematic-threshold cinematic-threshold--to-light" aria-hidden="true"></div>
  <AssuranceRecord />
  <TwoDepths />
  <FreeToolsPreview />
  <WhereYouWork />
  <Faq items={faqItems} />
  <FinalCta />
</Base>

<style>
  .cinematic-threshold {
    min-height: clamp(1.25rem, 2.5vw, 2rem);
    pointer-events: none;
  }

  .cinematic-threshold--to-light {
    background:
      radial-gradient(ellipse at 50% 0%, color-mix(in srgb, var(--terminal-cyan) 8%, transparent), transparent 62%),
      linear-gradient(
        to bottom,
        var(--hero-void),
        color-mix(in srgb, var(--hero-void) 42%, var(--bg)) 58%,
        var(--bg)
      );
  }

  .cinematic-threshold--to-dark {
    background:
      radial-gradient(ellipse at 50% 100%, color-mix(in srgb, var(--terminal-cyan) 8%, transparent), transparent 62%),
      linear-gradient(
        to bottom,
        var(--bg),
        color-mix(in srgb, var(--hero-void) 42%, var(--bg)) 42%,
        var(--hero-void)
      );
  }
</style>
