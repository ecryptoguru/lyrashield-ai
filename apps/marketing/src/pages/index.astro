---
import Base from "@layouts/Base.astro"
import PremiumHero from "@components/landing/PremiumHero.astro"
import HeroProductFrame from "@components/landing/HeroProductFrame.astro"
import HomeLiteScan from "@components/landing/HomeLiteScan.astro"
import EvidenceWorld from "@components/landing/EvidenceWorld.astro"
import TwoDepths from "@components/landing/TwoDepths.astro"
import Faq from "@components/landing/Faq.astro"
import FinalCta from "@components/landing/FinalCta.astro"
import { createMotionMediaManifest } from "../lib/motion-manifest"

const siteOrigin = Astro.site?.origin || "http://localhost:4321"
const pageUrl = new URL("/", siteOrigin).toString()
const renderHash = import.meta.env.PUBLIC_MOTION_RENDER_HASH as string
const mediaUrl = renderHash === "local" ? "/media-local" : import.meta.env.PUBLIC_MEDIA_URL
const motionManifest = createMotionMediaManifest(mediaUrl, renderHash)

const description =
  "Ship AI-built apps with evidence, not hope. One reviewable record of what you checked, what you fixed, and what a fresh retest confirmed before release. Open beta."

const faqItems = [
  {
    q: "What happens after I create an account?",
    a: "Create a workspace, add an authorized repository, public URL, or API target, then choose the review depth. LyraShield keeps the resulting scope, findings, evidence states, fix proposals, and fresh retest outcomes in one release record.",
  },
  {
    q: "What does a LyraShield result actually prove?",
    a: "Only what the retained evidence supports. We keep detected candidates, independently verified findings, validated fixes (retest-confirmed), inconclusive retests, and checks that were limited or not applicable distinct. Missing proof stays visible.",
  },
  {
    q: "Does LyraShield automatically fix my code?",
    a: "No. LyraShield creates approval-gated fix proposals that explain the issue and stage a server-generated patch. Every code change requires your explicit review and approval. Nothing auto-merges.",
  },
  {
    q: "Do you store my codebase?",
    a: "Scans run in hardened, short-lived environments. The full platform retains scope, receipts, findings, and evidence states, not a copy of your source. Shared reports exclude repository coordinates, file paths, and raw secrets.",
  },
  {
    q: "How is the Lite Check different from the full review?",
    a: "The Lite Check passively reads an authorized public URL for a bounded set of surface signals. The full platform can review repositories, URLs, and APIs, retain control-level evidence, stage approval-gated fixes, run fresh retests, and produce a shareable release record.",
  },
]

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${pageUrl}#webpage`,
    name: "Release assurance for AI-built apps",
    description,
    url: pageUrl,
    inLanguage: "en-US",
    dateModified: "2026-08-13",
    isPartOf: { "@id": `${siteOrigin}/#website` },
    about: { "@id": `${pageUrl}#application` },
    mainEntity: { "@id": `${pageUrl}#faq` },
  },
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "@id": `${pageUrl}#application`,
    name: "LyraShield AI",
    applicationCategory: "SecurityApplication",
    operatingSystem: "Web",
    description,
    url: pageUrl,
    provider: { "@id": `${siteOrigin}/#organization` },
    isPartOf: { "@id": `${siteOrigin}/#website` },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "@id": `${pageUrl}#faq`,
    mainEntity: faqItems.map((item) => ({
      "@type": "Question",
      name: item.q,
      acceptedAnswer: {
        "@type": "Answer",
        text: item.a,
      },
    })),
  },
]
---

<Base
  title="LyraShield AI — Ship AI-built apps with evidence, not hope"
  description={description}
  canonical={pageUrl}
  jsonLd={jsonLd}
>
  <PremiumHero />
  <HeroProductFrame />
  <div id="how-it-works" aria-hidden="true" style="scroll-margin-top: 4.5rem"></div>
  <EvidenceWorld manifest={motionManifest} />
  <div class="cinematic-threshold cinematic-threshold--to-light" aria-hidden="true"></div>
  <HomeLiteScan />
  <TwoDepths />
  <Faq items={faqItems} />
  <FinalCta />
</Base>

<style>
  .cinematic-threshold {
    min-height: clamp(3rem, 7vw, 7rem);
    pointer-events: none;
  }

  .cinematic-threshold--to-light {
    background:
      radial-gradient(ellipse at 50% 0%, color-mix(in srgb, var(--terminal-cyan) 10%, transparent), transparent 64%),
      linear-gradient(
        to bottom,
        var(--hero-void),
        color-mix(in srgb, var(--hero-void) 28%, var(--bg)) 62%,
        var(--bg)
      );
  }

</style>
