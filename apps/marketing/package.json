{
  "name": "@lyrashield/marketing",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "scripts": {
    "predev": "wrangler types && pnpm exec tsx scripts/generate-openapi.ts",
    "dev": "astro dev",
    "prebuild": "wrangler types && pnpm exec tsx scripts/generate-openapi.ts",
    "build": "astro build",
    "prepreview": "wrangler types && pnpm exec tsx scripts/generate-openapi.ts",
    "preview": "astro build && CI=1 wrangler d1 migrations apply lyrashield-marketing-waitlist --local --config dist/server/wrangler.json && wrangler dev --local --config dist/server/wrangler.json",
    "pretypecheck": "wrangler types && pnpm exec tsx scripts/generate-openapi.ts",
    "typecheck": "astro check",
    "lint": "eslint src --max-warnings 0",
    "deploy": "astro build && wrangler deploy --config dist/server/wrangler.json",
    "deploy:preview": "astro build && wrangler versions upload --config dist/server/wrangler.json",
    "blog:validate": "node scripts/validate-blog-content.mjs",
    "blog:validate:images": "node scripts/validate-blog-images.mjs",
    "blog:validate:mdx": "node scripts/validate-blog-mdx.mjs",
    "blog:validate:offline": "node scripts/validate-blog-offline-gates.mjs",
    "compare:validate": "node scripts/validate-compare-content.mjs",
    "blog:check-links": "node scripts/check-external-blog-links.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.1.7",
    "@lyrashield/agent-registry": "workspace:*",
    "@lyrashield/agent-rules": "workspace:*",
    "@lyrashield/logger": "workspace:*",
    "@lyrashield/types": "workspace:*",
    "@astrojs/markdown-satteri": "^0.3.5",
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.1.6",
    "posthog-js": "^1.413.2",
    "tailwindcss": "^4.3.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^5.20260804.1",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^24.0.0",
    "tsx": "^4.23.8",
    "typescript": "^6.0.0",
    "wrangler": "^4.120.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
