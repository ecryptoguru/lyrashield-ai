# Dependencies
node_modules/
.pnpm-store/
.worktrees/

# Build outputs
dist/
.next/
.turbo/
out/
build/

# Environment
.env
.env.local
.env.*.local
.dev.vars

# IDE
.idea/
.vscode/
.worktrees/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Testing
coverage/
.nyc_output/
test-results/
playwright-report/
apps/marketing-motion/renders/
apps/marketing-motion/renders/blog-masters/
apps/marketing-motion/renders/blog-image-previews/
apps/marketing/public/media-local/
artifacts/devpost-video/
.playwright-cli/
output/playwright/

# Local build/runtime scratch (regenerate on build/test)
apps/agent/
tmp-*-test/
lyrashield_runs/
.lyrashield-worker-tmp/

# Prisma generated (tracked via migrations)
packages/db/src/generated/

# Docker
docker-data/
.devin/

# Rust build artifacts (also in apps/desktop/.gitignore, repeated here
# so IDE source-control views don't surface 10k+ target/ files)
target/

# Tauri generated files
gen/schemas/

# Secrets / keys (deploy doc has you download GitHub App .pem)
*.pem
*.key
*.crt
!packages/db/prisma/certs/supabase-root-2021-ca.crt
# Desktop license verification uses a bundled PUBLIC key (not a secret)
!apps/desktop/src-tauri/resources/license-signing-public-key.pem
*.p12

# Vercel
.vercel

# TypeScript build info
*.tsbuildinfo
artifacts/
/scripts/

# Generated documentation build outputs (keep source .md; ignore rendered PDFs/images)
docs/papers/

# DevPost video recording notes, not the canonical script/storyboard/design .md files
docs/devpost/video/RECORDING*.md
docs/devpost/video/TEST_RECORDING*.md

# Engine source belongs in the sibling ../lyrashield-engine repo; never commit an extracted copy here.
extracted-engine/

.playwright-mcp/
.playwright-cli/
.planning/
.superpowers/
docs/superpowers/

# Local Devpost plugin/session state; submission evidence belongs in docs.
.devpost-hackathon-state.json

# agent helper files (never ship)
PR_BODY.md
ciwait.py
verify-*.mts
*-stubs-loader.mjs
