{
  "name": "lyrashield-root",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,yml,yaml}\"",
    "format:check": "git ls-files -z -- '*.ts' '*.tsx' '*.md' '*.json' '*.yml' '*.yaml' | xargs -0 prettier --check",
    "db:generate": "pnpm --filter @lyrashield/db generate",
    "db:migrate": "pnpm --filter @lyrashield/db migrate",
    "prisma:migrate:check": "pnpm --filter @lyrashield/db exec prisma migrate diff --from-migrations ./prisma/migrations --to-schema ./prisma/schema.prisma --exit-code",
    "db:push": "pnpm --filter @lyrashield/db push",
    "db:seed": "pnpm --filter @lyrashield/db seed",
    "db:studio": "pnpm --filter @lyrashield/db studio",
    "test:core": "vitest run --exclude '**/dist/**'",
    "test:marketing": "pnpm --filter @lyrashield/marketing exec vitest run",
    "test:motion": "node --test apps/marketing-motion/tests/*.test.mjs",
    "test": "node run-all-tests.mjs",
    "test:e2e": "playwright test --grep-invert '@visual'",
    "test:watch": "vitest --exclude '**/dist/**'",
    "verify:worker-image": "sh apps/worker/scripts/verify-worker-image.sh"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.1",
    "eslint-plugin-security": "^3.0.1",
    "prettier": "^3.9.6",
    "turbo": "^2.10.11",
    "vitest": "^4.1.9"
  },
  "packageManager": "pnpm@11.6.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@prisma/client-runtime-utils": "7.9.1"
  }
}
