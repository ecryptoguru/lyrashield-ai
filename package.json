{
  "name": "lyrashield-root",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "lint:size": "eslint --config eslint.size.config.mjs \"apps/**/src/**/*.{ts,tsx,mts,cts}\" \"packages/**/src/**/*.{ts,tsx,mts,cts}\"",
    "lint:md": "markdownlint-cli2",
    "typecheck": "turbo typecheck",
    "typecheck:web-tests": "pnpm --filter @lyrashield/web exec tsc --noEmit -p tsconfig.tests.json",
    "typecheck:e2e": "pnpm --filter @lyrashield/db exec tsc --noEmit -p ../../e2e/tsconfig.json",
    "typecheck:browser-harness": "pnpm --filter @lyrashield/web exec tsc --noEmit -p ../../e2e/browser/tsconfig.json",
    "lint:browser-harness": "pnpm exec eslint e2e/browser --max-warnings 0",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,yml,yaml}\"",
    "format:check": "git ls-files -z -- '*.ts' '*.tsx' '*.md' '*.json' '*.yml' '*.yaml' | xargs -0 prettier --check",
    "db:generate": "pnpm --filter @lyrashield/db generate",
    "db:migrate": "pnpm --filter @lyrashield/db migrate",
    "prisma:migrate:check": "pnpm --filter @lyrashield/db exec prisma migrate diff --from-migrations ./prisma/migrations --to-schema ./prisma/schema.prisma --exit-code",
    "db:push": "pnpm --filter @lyrashield/db push",
    "db:seed": "pnpm --filter @lyrashield/db seed",
    "db:studio": "pnpm --filter @lyrashield/db studio",
    "test:core": "vitest run --exclude '**/dist/**'",
    "test:marketing": "pnpm --filter @lyrashield/marketing exec vitest run",
    "test:motion": "node --test apps/marketing-motion/tests/*.test.mjs",
    "test": "node run-all-tests.mjs",
    "test:e2e": "playwright test",
    "test:browser-harness": "playwright test -c e2e/browser/playwright.config.ts",
    "test:watch": "vitest --exclude '**/dist/**'",
    "verify:worker-image": "sh apps/worker/scripts/verify-worker-image.sh",
    "admin:provision": "pnpm --filter @lyrashield/db exec tsx scripts/provision-platform-admins.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "eslint": "catalog:",
    "eslint-config-next": "^16.3.3",
    "eslint-plugin-security": "^4.0.1",
    "knip": "6.37.0",
    "markdownlint-cli2": "0.23.2",
    "prettier": "^3.9.6",
    "turbo": "^2.10.11",
    "@vitest/coverage-v8": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@12.2.0",
  "engines": {
    "node": ">=24.0.0"
  }
}
