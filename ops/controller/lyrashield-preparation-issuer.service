[Unit]
Description=LyraShield protected preparation issuer
Requires=lyrashield-preparation-issuer.socket
After=docker.service

[Service]
ExecStart=/usr/bin/python3 -I /opt/lyrashield/runtime-control/preparation-issuer.py
User=root
Group=root
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
MemoryMax=1G
MemorySwapMax=0
ReadWritePaths=/var/lib/lyrashield/preparation /var/lib/lyrashield/control/inputs /etc/lyrashield/control/resources
UMask=0077
