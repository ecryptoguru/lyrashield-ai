[Unit]
Description=LyraShield read-only worker authority observer
Requires=lyrashield-worker-authority-observer.socket
After=docker.service

[Service]
ExecStart=/usr/bin/python3 -I /opt/lyrashield/runtime-control/authority-observer.py --worker-read-only
User=root
Group=root
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
