[Unit]
Description=LyraShield read-only runtime authority observer
Requires=lyrashield-authority-observer.socket
After=docker.service

[Service]
ExecStart=/usr/bin/python3 -I /opt/lyrashield/runtime-control/authority-observer.py
User=root
Group=root
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
