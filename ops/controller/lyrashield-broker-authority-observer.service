[Unit]
Description=LyraShield broker read-only runtime authority observer
Requires=lyrashield-broker-authority-observer.socket
After=docker.service

[Service]
ExecStart=/usr/bin/python3 -I /opt/lyrashield/runtime-control/authority-observer.py --broker-read-only
User=root
Group=root
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
