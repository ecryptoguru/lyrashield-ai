generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Better Auth Base Tables ────────────────────────────────────────────────
// These are managed by Better Auth. Do not manually modify.
// Reference user.id from application models.

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  twoFactorEnabled Boolean @default(false)

  // Platform-level authority, independent of any workspace/tenant role.
  // Only value is "PLATFORM_OPERATOR"; null means an ordinary tenant user.
  platformRole String?

  sessions           Session[]
  accounts           Account[]
  verifications      Verification[]
  twoFactors         TwoFactor[]
  oauthclients       OauthClient[]
  oauthrefreshtokens OauthRefreshToken[]
  oauthaccesstokens  OauthAccessToken[]
  oauthconsents      OauthConsent[]
  deviceCodes        DeviceCode[]
  affiliate          Affiliate?
  platformAdminElevations PlatformAdminElevation[]

  @@map("users")
}

model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String
  userId                  String
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([secret])
  @@index([userId])
  @@map("two_factors")
}

model Session {
  id                String   @id
  expiresAt         DateTime
  token             String   @unique
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  ipAddress         String?
  userAgent         String?
  userId            String
  activeWorkspaceId String?
  twoFactorVerifiedAt DateTime?

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  oauthrefreshtokens OauthRefreshToken[]
  oauthaccesstokens  OauthAccessToken[]
  platformAdminElevations PlatformAdminElevation[]

  @@index([userId])
  @@unique([id, userId])
  @@map("sessions")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  issuer                String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([issuer, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([identifier])
  @@map("verifications")
}

model DeviceCode {
  id              String    @id
  deviceCode      String    @unique
  userCode        String    @unique
  userId          String?
  user            User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt       DateTime
  status          String
  lastPolledAt    DateTime?
  pollingInterval Int?
  clientId        String?
  scope           String?

  @@index([userId])
  @@map("device_codes")
}

// ─── Better Auth OAuth provider tables ─────────────────────────────────────
// Generated from @better-auth/oauth-provider. The plural table names preserve
// the existing Better Auth naming convention in this schema.

model Jwks {
  id         String    @id
  publicKey  String
  privateKey String
  createdAt  DateTime
  expiresAt  DateTime?
  alg        String?
  crv        String?

  @@map("jwks")
}

model OauthClient {
  id                               String                @id
  clientId                         String
  clientSecret                     String?
  disabled                         Boolean?              @default(false)
  skipConsent                      Boolean?
  enableEndSession                 Boolean?
  subjectType                      String?
  scopes                           String[]
  userId                           String?
  user                             User?                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt                        DateTime?
  updatedAt                        DateTime?
  name                             String?
  uri                              String?
  icon                             String?
  contacts                         String[]
  tos                              String?
  policy                           String?
  softwareId                       String?
  softwareVersion                  String?
  softwareStatement                String?
  redirectUris                     String[]
  postLogoutRedirectUris           String[]
  backchannelLogoutUri             String?
  backchannelLogoutSessionRequired Boolean?
  tokenEndpointAuthMethod          String?
  jwks                             String?
  jwksUri                          String?
  grantTypes                       String[]
  responseTypes                    String[]
  public                           Boolean?
  type                             String?
  requirePKCE                      Boolean?
  dpopBoundAccessTokens            Boolean?              @default(false)
  referenceId                      String?
  metadata                         Json?
  oauthrefreshtokens               OauthRefreshToken[]
  oauthaccesstokens                OauthAccessToken[]
  oauthconsents                    OauthConsent[]
  oauthclientresources             OauthClientResource[]

  @@unique([clientId])
  @@index([userId])
  @@map("oauth_clients")
}

model OauthRefreshToken {
  id                      String             @id
  token                   String
  clientId                String
  oauthclient             OauthClient        @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  sessionId               String?
  session                 Session?           @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  userId                  String
  user                    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId             String?
  authorizationCodeId     String?
  resources               String[]           @default([])
  requestedUserInfoClaims String[]           @default([])
  expiresAt               DateTime?
  createdAt               DateTime?
  revoked                 DateTime?
  rotatedAt               DateTime?
  rotationReplayResponse  String?
  rotationReplayExpiresAt DateTime?
  authTime                DateTime?
  confirmation            Json?
  scopes                  String[]
  oauthaccesstokens       OauthAccessToken[]

  @@unique([token])
  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([authorizationCodeId])
  @@map("oauth_refresh_tokens")
}

model OauthAccessToken {
  id                      String             @id
  token                   String?
  clientId                String
  oauthclient             OauthClient        @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  sessionId               String?
  session                 Session?           @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  userId                  String?
  user                    User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId             String?
  authorizationCodeId     String?
  resources               String[]           @default([])
  requestedUserInfoClaims String[]           @default([])
  refreshId               String?
  oauthrefreshtoken       OauthRefreshToken? @relation(fields: [refreshId], references: [id], onDelete: Cascade)
  expiresAt               DateTime?
  createdAt               DateTime?
  revoked                 DateTime?
  confirmation            Json?
  scopes                  String[]

  @@unique([token])
  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([authorizationCodeId])
  @@index([refreshId])
  @@map("oauth_access_tokens")
}

model OauthConsent {
  id                      String      @id
  clientId                String
  oauthclient             OauthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  userId                  String?
  user                    User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId             String?
  resources               String[]    @default([])
  requestedUserInfoClaims String[]    @default([])
  scopes                  String[]
  createdAt               DateTime?
  updatedAt               DateTime?

  @@index([clientId])
  @@index([userId])
  @@map("oauth_consents")
}

model OauthResource {
  id                            String                @id
  identifier                    String                @unique
  name                          String
  accessTokenTtl                Int?
  refreshTokenTtl               Int?
  signingAlgorithm              String?
  signingKeyId                  String?
  allowedScopes                 String[]              @default([])
  customClaims                  Json?
  dpopBoundAccessTokensRequired Boolean?              @default(false)
  disabled                      Boolean?              @default(false)
  createdAt                     DateTime?
  updatedAt                     DateTime?
  policyVersion                 Int?                  @default(1)
  metadata                      Json?
  oauthclientresources          OauthClientResource[]

  @@map("oauth_resources")
}

model OauthClientResource {
  id            String        @id
  clientId      String
  oauthclient   OauthClient   @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  resourceId    String
  oauthresource OauthResource @relation(fields: [resourceId], references: [identifier], onDelete: Cascade)
  metadata      Json?
  createdAt     DateTime?

  @@unique([clientId, resourceId])
  @@index([clientId])
  @@index([resourceId])
  @@map("oauth_client_resources")
}

model OauthClientAssertion {
  id        String   @id
  expiresAt DateTime

  @@map("oauth_client_assertions")
}

// ─── Application Models ─────────────────────────────────────────────────────
// These are owned by the application. Reference Better Auth user.id.

enum WorkspaceMode {
  VIBE
  TEAM
  ENTERPRISE
}

enum WorkspacePlan {
  FREE
  STARTER
  PRO
  TEAM
  LAUNCH_ASSURANCE
  AGENCY
  BUSINESS
  ENTERPRISE
}

enum MemberRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
  SECURITY_ADMIN
  APPSEC_MANAGER
  DEVELOPER
  AUDITOR
  BILLING_ADMIN
  EXTERNAL_PENTESTER
}

enum TargetType {
  REPO
  WEB_APP
  API
  CLOUD_ACCOUNT
  CONTAINER
  IAC
}

enum TargetEnvironment {
  LOCAL
  PREVIEW
  STAGING
  PRODUCTION
}

enum DomainVerificationMethod {
  DNS_TXT
  GOOGLE_SEARCH_CONSOLE
}

enum DomainVerificationStatus {
  PENDING
  VERIFIED
  EXPIRED
}

enum LiveAiSafetyPlanStatus {
  DRAFT
  READY
  PENDING_APPROVAL
  RUNNING
  STOPPED
  COMPLETED
  FAILED
}

enum LiveAiSafetyRunStatus {
  QUEUED
  RUNNING
  STOPPED
  COMPLETED
  FAILED
}

enum ScanGoal {
  CHECK_PR
  TEST_APP
  LAUNCH_REVIEW
  WEEKLY_MONITOR
  FULL_PENTEST
  COMPLIANCE_REVIEW
}

enum ScanMode {
  SAFE
  QUICK
  STANDARD
  DEEP
  CUSTOM
}

enum ScanStatus {
  QUEUED
  PREFLIGHT
  RUNNING
  VERIFYING
  COMPLETED
  PARTIAL
  FAILED
  CANCELLED
  REQUIRES_APPROVAL
  STOPPED_BUDGET
  TIMED_OUT
}

enum FindingSeverity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum FindingStatus {
  OPEN
  FIX_READY
  PR_OPENED
  TICKET_CREATED
  FIXED_PENDING_RETEST
  FIXED
  ACCEPTED_RISK
  FALSE_POSITIVE
  DUPLICATE
}

enum FindingCandidateStatus {
  DETECTED
  PROMOTED
  SUPPRESSED
}

enum FindingVerificationStatus {
  DETECTED
  VALIDATED
  VERIFIED
  BLOCKED
  INCONCLUSIVE
}

enum FindingVerificationMethod {
  ENGINE_CLAIM
  SCANNER_DETECTION
  SOURCE_RULE
  DEPENDENCY_ADVISORY
  URL_CHECK
  RETEST
  HUMAN_REVIEW
}

enum ScanCoverageStatus {
  COMPLETED
  PARTIAL
  NOT_APPLICABLE
  BLOCKED
  TIMED_OUT
  FAILED
}

enum ScoreGrade {
  A_PLUS
  A
  B
  C
  D
  F
}

enum ReferralStatus {
  PENDING
  QUALIFIED
  REWARDED
  REJECTED
}

enum IntegrationType {
  GITHUB
  GITLAB
  AZURE_DEVOPS
  SLACK
  DISCORD
  JIRA
  LINEAR
  TEAMS
  SERVICENOW
  SPLUNK
  DATADOG
  SENTINEL
  VANTA
  DRATA
}

model Workspace {
  id               String        @id @default(cuid())
  name             String
  slug             String        @unique
  mode             WorkspaceMode @default(VIBE)
  plan             WorkspacePlan @default(FREE)
  billingStatus    String?
  deploymentType   String        @default("saas")
  retentionDays    Int           @default(30)
  telemetryEnabled Boolean       @default(true)
  deletedAt        DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  graceUsedMs        Int       @default(0)
  graceCycleStart    DateTime?
  deepAllowed        Boolean   @default(false)
  trialStartedAt     DateTime?

  members              WorkspaceMember[]
  projects             Project[]
  targets              Target[]
  scans                Scan[]
  findings             Finding[]
  policies             Policy[]
  integrations         Integration[]
  auditLogs            AuditLog[]
  usageRecords         UsageRecord[]
  reports              Report[]
  notifications        Notification[]
  schedules            Schedule[]
  billingAccount       BillingAccount?
  invitations          Invitation[]
  webhookEvents        WebhookEvent[]
  apiKeys              ApiKey[]
  retests              Retest[]
  agentApprovals       AgentApproval[]
  scoreSnapshots       ScoreSnapshot[]
  aiSecurityScoreSnapshots AiSecurityScoreSnapshot[]
  gateVerdicts         GateVerdict[]
  findingCandidates    FindingCandidate[]
  findingVerifications FindingVerification[]
  aiSystemProfile      AiSystemProfile[]
  threatModels         ThreatModel[]
  controlEvidence      ControlEvidence[]
  domainVerifications  TargetDomainVerification[]
  liveAiSafetySettings LiveAiSafetySettings?
  liveAiSafetyPlans    LiveAiSafetyPlan[]
  liveAiSafetyRuns     LiveAiSafetyRun[]
  minutePacks          MinutePack[]
  licenses             License[]
  licenseActivations   LicenseActivation[]
  licenseKeys          LicenseKey[]
  syncCursors          SyncCursor[]
}

model WorkspaceMember {
  id           String     @id @default(cuid())
  workspaceId  String
  userId       String
  role         MemberRole @default(MEMBER)
  status       String     @default("active")
  invitedEmail String?
  invitedById  String?
  idpSubject   String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([workspaceId])
  @@index([invitedEmail])
}

model Project {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  description String?
  ownerUserId String?
  ownerTeam   String?
  riskScore   Int       @default(100)
  trustPlan   Json?     @db.JsonB
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  targets   Target[]
  scans     Scan[]
  findings  Finding[]

  @@index([workspaceId])
}

model Target {
  id             String            @id @default(cuid())
  workspaceId    String
  projectId      String?
  type           TargetType
  name           String
  url            String?
  apiSpecUrl     String?
  repoProvider   String?
  repoOwner      String?
  repoName       String?
  repoFullName   String?
  installationId String?
  branch         String?
  environment    TargetEnvironment @default(STAGING)
  status         String            @default("active")
  lastScanAt     DateTime?
  deletedAt      DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  workspace         Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project           Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  scans             Scan[]
  findings          Finding[]
  credentials       CredentialSet[]
  schedules         Schedule[]
  scoreSnapshots    ScoreSnapshot[]
  aiSecurityScoreSnapshots AiSecurityScoreSnapshot[]
  gateVerdicts      GateVerdict[]
  findingCandidates FindingCandidate[]
  aiSystemProfile   AiSystemProfile?
  threatModels      ThreatModel[]
  controlEvidence   ControlEvidence[]
  liveAiSafetyPlans LiveAiSafetyPlan[]

  @@unique([workspaceId, repoFullName])
  @@unique([workspaceId, url])
  @@index([workspaceId])
  @@index([projectId])
  @@index([installationId])
  @@index([workspaceId, repoProvider, installationId])
}

model CredentialSet {
  id          String    @id @default(cuid())
  workspaceId String
  targetId    String?
  kind        String
  name        String
  vaultRef    String
  scope       Json?
  expiresAt   DateTime?
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  target Target? @relation(fields: [targetId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([targetId])
}

model TargetDomainVerification {
  id             String                   @id @default(cuid())
  workspaceId    String
  domain         String
  method         DomainVerificationMethod
  status         DomainVerificationStatus @default(PENDING)
  challengeToken String?
  challengeId    String?
  expiresAt      DateTime
  verifiedAt     DateTime?
  lastCheckedAt  DateTime?
  createdById    String
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  workspace Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  plans     LiveAiSafetyPlan[]

  @@unique([workspaceId, domain])
  @@index([workspaceId, status, expiresAt])
}

model LiveAiSafetySettings {
  id              String   @id @default(cuid())
  workspaceId     String   @unique
  incidentContact String?
  createdById     String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model LiveAiSafetyPlan {
  id                   String                 @id @default(cuid())
  workspaceId          String
  targetId             String
  domainVerificationId String
  endpointUrl          String
  approvedHost         String
  authMode             String
  credentialId         String?
  incidentContact      String
  maxRequests          Int
  maxDurationSeconds   Int
  maxResponseBytes     Int
  rawSampleStorage     String
  cases                Json                   @db.JsonB
  status               LiveAiSafetyPlanStatus @default(DRAFT)
  approvalId           String?
  approvedById         String?
  approvedAt           DateTime?
  startedAt            DateTime?
  terminalReason       String?
  createdById          String
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  workspace          Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  target             Target                   @relation(fields: [targetId], references: [id], onDelete: Cascade)
  domainVerification TargetDomainVerification @relation(fields: [domainVerificationId], references: [id], onDelete: Restrict)
  runs               LiveAiSafetyRun[]

  @@index([workspaceId, targetId, createdAt])
  @@index([workspaceId, status])
  @@index([domainVerificationId])
}

model LiveAiSafetyRun {
  id             String                @id @default(cuid())
  workspaceId    String
  targetId       String
  planId         String
  status         LiveAiSafetyRunStatus @default(QUEUED)
  requestCount   Int                   @default(0)
  terminalReason String?
  receipts       Json?                 @db.JsonB
  startedAt      DateTime?
  endedAt        DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  plan      LiveAiSafetyPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([workspaceId, targetId, createdAt])
  @@index([workspaceId, status])
  @@index([planId])
}

model Policy {
  id                      String    @id @default(cuid())
  workspaceId             String
  name                    String
  description             String?
  scanWindow              Json?
  blockedPaths            String[]
  allowedDomains          String[]
  rateLimit               Json?
  networkEgressPolicy     String    @default("target_only")
  destructiveTestsAllowed Boolean   @default(false)
  approvalRequired        Boolean   @default(false)
  maxBudgetUsd            Decimal?  @db.Decimal(10, 2)
  maxDurationMinutes      Int       @default(60)
  piiRedactionEnabled     Boolean   @default(true)
  evidenceRetentionDays   Int       @default(30)
  deletedAt               DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  scans     Scan[]

  @@index([workspaceId])
}

model Scan {
  id                   String     @id @default(cuid())
  workspaceId          String
  projectId            String?
  targetId             String?
  policyId             String?
  goal                 ScanGoal
  mode                 ScanMode   @default(SAFE)
  status               ScanStatus @default(QUEUED)
  triggerType          String     @default("manual")
  startedAt            DateTime?
  endedAt              DateTime?
  summary              String?
  errorCategory        String?
  errorMessage         String?
  riskScoreBefore      Int?
  riskScoreAfter       Int?
  estimatedCostCents   Int?
  actualCostCents      Int?
  providerCostUsd      Decimal?   @db.Decimal(12, 6)
  billedCostUsd        Decimal?   @db.Decimal(12, 6)
  llmRequestCount      Int?
  llmInputTokens       Int?
  llmCachedInputTokens Int?
  llmOutputTokens      Int?
  determinismMode      String?    @default("default")
  durationMs           Int?
  finalizationStartedAt DateTime?
  sarifUri             String?
  createdById          String
  deletedAt            DateTime?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  workspace            Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project              Project?              @relation(fields: [projectId], references: [id], onDelete: SetNull)
  target               Target?               @relation(fields: [targetId], references: [id], onDelete: SetNull)
  policy               Policy?               @relation(fields: [policyId], references: [id], onDelete: SetNull)
  events               ScanEvent[]
  findings             Finding[]
  retests              Retest[]
  reports              Report[]
  scoreSnapshot        ScoreSnapshot?
  aiSecurityScoreSnapshot AiSecurityScoreSnapshot?
  gateVerdicts         GateVerdict[]
  resultManifest       ScanResultManifest?
  coverageReceipts     ScanCoverageReceipt[]
  findingCandidates    FindingCandidate[]
  findingVerifications FindingVerification[]

  @@index([workspaceId])
  @@index([projectId])
  @@index([targetId])
  @@index([status])
  @@index([createdAt])
  @@index([workspaceId, createdAt])
  // Covers the active-scan poll (workspaceId + status IN (...) ORDER BY
  // createdAt DESC) — the most frequent automated query in the app.
  @@index([workspaceId, status, createdAt])
}

model ScanEvent {
  id        String    @id @default(cuid())
  scanId    String
  stage     String
  level     String    @default("info")
  message   String
  metadata  Json?
  deletedAt DateTime?
  createdAt DateTime  @default(now())

  scan Scan @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@index([scanId])
  @@index([stage])
}

model ApiKey {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  hashedKey   String    @unique
  prefix      String
  scopes      String[]
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdById String
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([prefix])
}

model Finding {
  id                 String                     @id @default(cuid())
  workspaceId        String
  projectId          String?
  targetId           String?
  scanId             String
  title              String
  summary            String
  category           String?
  cwe                String?
  owaspCategory      String?
  severity           FindingSeverity
  confidence         String                     @default("medium")
  cvssScore          Float?
  cvssVector         String?
  cvss3Score         Float?
  cvss3Vector        String?
  sarifRuleId        String?
  verified           Boolean                    @default(false)
  verificationStatus FindingVerificationStatus  @default(DETECTED)
  verificationMethod FindingVerificationMethod?
  verificationReason String?
  exploitability     String?
  businessImpact     String?
  technicalDetail    String?
  recommendedFix     String?
  /** WP3: repo-relative file paths this finding implicates (drives fix-PR patch
   * scope). Null until a fix proposal supplies them. */
  implicatedFiles    Json?
  /** WP3: the commit SHA the implicated scan ran on — the base a fix patch must
   * apply cleanly against. Null for non-repo targets or pre-WP3 findings. */
  baseCommit         String?
  status             FindingStatus              @default(OPEN)
  statusReason       String?
  dedupeKey          String
  ownerUserId        String?
  ownerTeam          String?
  slaDueAt           DateTime?
  firstSeenAt        DateTime                   @default(now())
  lastSeenAt         DateTime                   @default(now())
  fixedAt            DateTime?
  deletedAt          DateTime?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

