  },
  "devDependencies": {
    "prisma": "7.9.1",
    "tsx": "^4.23.12",
    "typescript": "^6.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.21.0",
    "dotenv": "16.4.7"
