{
  "name": "lyrashield",
  "version": "0.2.0",
  "description": "LyraShield AI CLI — install, scan, and gate your AI coding agents.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "bin": {
    "lyrashield": "./bin/lyrashield.mjs"
  },
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "security",
    "appsec",
    "ai-coding",
    "mcp",
    "lyrashield",
    "cli"
  ],
  "engines": {
    "node": ">=22.0.0 <25.0.0"
  },
  "scripts": {
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "build": "tsup",
    "prepublishOnly": "tsup",
    "test": "vitest run"
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "jsonc-parser": "^3.3.1",
    "minimist": "^1.2.8",
    "yaml": "^2.7.1"
  },
  "devDependencies": {
    "@lyrashield/agent-plugin": "workspace:*",
    "@lyrashield/agent-registry": "workspace:*",
    "@lyrashield/agent-rules": "workspace:*",
    "@lyrashield/credentials": "workspace:*",
    "@lyrashield/sdk": "workspace:*",
    "@types/iarna__toml": "^2.0.5",
    "@types/minimist": "^1.2.5",
    "@types/node": "^24.0.0",
    "tsup": "^8.5.1",
    "typescript": "6.0.3",
    "vitest": "^4.1.11"
  }
}
