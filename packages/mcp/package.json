{
  "name": "@lyrashield/mcp",
  "version": "0.2.0",
  "description": "LyraShield AI MCP server — run verified security scans, review findings, and drive the fix/verify loop from your AI coding tool.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "lyrashield-mcp": "./dist/stdio-transport.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "security",
    "appsec",
    "lyrashield",
    "ai-coding"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "build": "tsup",
    "prepublishOnly": "tsup",
    "test": "vitest run"
  },
  "dependencies": {
    "@lyrashield/sdk": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@lyrashield/logger": "workspace:*",
    "@lyrashield/types": "workspace:*",
    "@types/node": "^22.20.1",
    "tsup": "^8.5.1",
    "typescript": "6.0.3",
    "vitest": "^3.2.7"
  }
}
