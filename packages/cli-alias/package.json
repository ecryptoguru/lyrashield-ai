{
  "name": "@lyrashield/cli",
  "version": "0.1.0",
  "description": "Alias package for the LyraShield AI CLI. Install via npm as @lyrashield/cli or as the unscoped lyrashield package.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "bin": {
    "lyrashield-cli": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "security",
    "appsec",
    "ai-coding",
