{
  "name": "@lyrashield/agent-plugin",
  "version": "0.1.18",
  "description": "LyraShield Agent Plugin package",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "plugin",
    "schemas",
    "README.md"
  ],
  "scripts": {
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "build": "tsup",
    "build:plugin": "tsx src/build.ts",
    "export:marketplace": "tsx src/export.ts",
    "prepublishOnly": "tsup",
    "test": "vitest run"
  },
  "dependencies": {
    "@lyrashield/agent-rules": "workspace:*",
    "@lyrashield/mcp": "workspace:*",
    "ajv": "^8.17.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "typescript": "^6.0.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
