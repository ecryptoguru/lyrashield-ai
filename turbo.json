{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env"],
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "DATABASE_DIRECT_URL",
    "REDIS_URL",
    "UPSTASH_REDIS_REST_URL",
    "UPSTASH_REDIS_REST_TOKEN",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "ADDITIONAL_TRUSTED_ORIGINS",
    "GITHUB_CLIENT_ID",
    "GITHUB_CLIENT_SECRET",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET",
    "AZURE_AD_CLIENT_ID",
    "AZURE_AD_CLIENT_SECRET",
    "AZURE_AD_TENANT_ID",
    "GITHUB_APP_ID",
    "GITHUB_APP_SLUG",
    "GITHUB_APP_PRIVATE_KEY",
    "GITHUB_WEBHOOK_SECRET",
    "GITHUB_APP_CLIENT_ID",
    "GITHUB_APP_CLIENT_SECRET",
    "NEXT_PUBLIC_APP_URL",
    "NEXT_PUBLIC_MARKETING_URL",
    "NEXT_PUBLIC_POSTHOG_KEY",
    "NEXT_PUBLIC_POSTHOG_HOST",
    "TRUSTED_PROXY_IP_HEADER",
    "BETTER_AUTH_COOKIE_DOMAIN",
    "LYRASHIELD_LLM",
    "LYRASHIELD_LUNA_LLM",
    "LYRASHIELD_TERRA_LLM",
    "LLM_API_KEY",
    "LYRASHIELD_IMAGE",
    "LYRASHIELD_ENGINE_PATH",
    "LYRASHIELD_WORKER_CONCURRENCY",
    "PLATFORM_MAX_SCAN_BUDGET_USD",
    "SCANNER_PHASE_TIMEOUT_MS",
    "LYRASHIELD_WEB_SEARCH_ENABLED",
    "LYRASHIELD_WEB_SEARCH_API_KEY",
    "LYRASHIELD_WEB_SEARCH_PROVIDER",
    "LYRASHIELD_WEB_SEARCH_MODE",
    "LYRASHIELD_WEB_SEARCH_MAX_RESULTS",
    "LYRASHIELD_WEB_SEARCH_MAX_CHARS_TOTAL",
    "LYRASHIELD_WEB_SEARCH_MAX_CALLS_PER_SCAN",
    "LYRASHIELD_WEB_SEARCH_BUDGET_USD",
    "LYRASHIELD_EGRESS_PROXY_URL",
    "LYRASHIELD_EGRESS_PROXY_SECRET",
    "S3_ENDPOINT",
    "S3_ACCESS_KEY",
    "S3_SECRET_KEY",
    "S3_BUCKET",
    "S3_REGION",
    "BREVO_API_KEY",
    "EMAIL_FROM",
    "NOTIFICATION_FROM_EMAIL",
    "LYRASHIELD_REQUIRE_EMAIL_VERIFICATION",
    "SLACK_WEBHOOK_URL",
    "DISCORD_WEBHOOK_URL",
    "POLAR_ACCESS_TOKEN",
    "POLAR_ORG_ID",
    "POLAR_WEBHOOK_SECRET",
    "POLAR_WEBHOOK_TOLERANCE_MS",
    "POLAR_PRODUCT_IDS",
    "POLAR_BILLING_ADMISSION",
    "POLAR_LOCAL_BILLING_ADMISSION",
    "RAZORPAY_KEY_ID",
    "RAZORPAY_KEY_SECRET",
    "RAZORPAY_WEBHOOK_SECRET",
    "RAZORPAY_PLAN_IDS",
    "RAZORPAY_BILLING_ADMISSION",
    "RAZORPAY_LOCAL_BILLING_ADMISSION",
    "BILLING_CANARY_WORKSPACE_IDS",
    "BILLING_GEO_IP_HEADER",
    "BILLING_USD_INR_RATE",
    "LICENSE_SIGNING_PRIVATE_KEY",
    "LICENSE_SIGNING_KEY_ID",
    "LICENSE_SIGNING_PUBLIC_KEY",
    "LYRASHIELD_KEY_VAULT_NAME",
    "LICENSE_SIGNING_PRIVATE_KEY_SECRET_NAME",
    "LICENSE_SIGNING_PUBLIC_KEY_SECRET_NAME",
    "LICENSE_PUBLISHED_BUILD",
    "POLAR_LOCAL_PRODUCT_IDS",
    "LYRASHIELD_SYNC_MAX_FINDINGS_PER_BATCH",
    "LYRASHIELD_INTERNAL_API_KEY",
    "RAZORPAYX_API_KEY",
    "RAZORPAYX_API_SECRET",
    "RAZORPAYX_ACCOUNT_NUMBER",
    "RAZORPAYX_PAYOUT_ADMISSION",
    "PAYONEER_API_KEY",
    "PAYONEER_API_SECRET",
    "PAYONEER_PARTNER_ID",
    "PAYONEER_PAYOUT_ADMISSION",
    "AFFILIATE_DEFAULT_PROGRAM_SLUG",
    "AFFILIATE_COOKIE_DOMAIN",
    "AFFILIATE_ATTRIBUTION_WINDOW_DAYS",
    "AFFILIATE_PAYOUT_MIN_CENTS",
    "SENTRY_DSN",
    "NEXT_PUBLIC_SENTRY_DSN",
    "PUBLIC_SITE_URL",
    "PUBLIC_APP_URL",
    "PUBLIC_SCANNER_URL",
    "PUBLIC_MEDIA_URL",
    "PUBLIC_X_URL",
    "PUBLIC_INDEXABLE",
    "PUBLIC_TURNSTILE_SITE_KEY",
    "PUBLIC_ABUSE_EMAIL",
    "PUBLIC_POSTHOG_KEY",
    "PUBLIC_POSTHOG_HOST"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build", "generate"],
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["^build", "pretypecheck", "generate"]
    },
    "pretypecheck": {
      "cache": false,
      "outputs": ["worker-configuration.d.ts"]
    },
    "generate": {
      "cache": false,
      "outputs": ["node_modules/.prisma/**", "src/generated/**"]
    },
    "migrate": {
      "cache": false
    },
    "push": {
      "cache": false
    },
    "seed": {
      "cache": false
    },
    "studio": {
      "cache": false,
      "persistent": true
    }
  }
}
