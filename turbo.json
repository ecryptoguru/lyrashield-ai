{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "NODE_ENV",
    "UPSTASH_REDIS_REST_URL",
    "BETTER_AUTH_URL",
    "ADDITIONAL_TRUSTED_ORIGINS",
    "GITHUB_CLIENT_ID",
    "GOOGLE_CLIENT_ID",
    "AZURE_AD_CLIENT_ID",
    "AZURE_AD_TENANT_ID",
    "GITHUB_APP_ID",
    "GITHUB_APP_SLUG",
    "GITHUB_APP_CLIENT_ID",
    "TRUSTED_PROXY_IP_HEADER",
    "BETTER_AUTH_COOKIE_DOMAIN",
    "LYRASHIELD_LLM",
    "LYRASHIELD_LUNA_LLM",
    "LYRASHIELD_SOL_LLM",
    "LYRASHIELD_IMAGE",
    "LYRASHIELD_ENGINE_PATH",
    "LYRASHIELD_WORKER_CONCURRENCY",
    "PLATFORM_MAX_SCAN_BUDGET_USD",
    "SCANNER_PHASE_TIMEOUT_MS",
    "LYRASHIELD_WEB_SEARCH_ENABLED",
    "LYRASHIELD_WEB_SEARCH_PROVIDER",
    "LYRASHIELD_WEB_SEARCH_MODE",
    "LYRASHIELD_WEB_SEARCH_MAX_RESULTS",
    "LYRASHIELD_WEB_SEARCH_MAX_CHARS_TOTAL",
    "LYRASHIELD_WEB_SEARCH_MAX_CALLS_PER_SCAN",
    "LYRASHIELD_WEB_SEARCH_BUDGET_USD",
    "LYRASHIELD_EGRESS_PROXY_URL",
    "LYRASHIELD_TARGET_RELAY_URL",
    "S3_ENDPOINT",
    "S3_BUCKET",
    "S3_REGION",
    "EMAIL_FROM",
    "NOTIFICATION_FROM_EMAIL",
    "LYRASHIELD_REQUIRE_EMAIL_VERIFICATION",
    "POLAR_ENVIRONMENT",
    "POLAR_WEBHOOK_TOLERANCE_MS",
    "POLAR_PRODUCT_IDS",
    "POLAR_BILLING_ADMISSION",
    "POLAR_LOCAL_BILLING_ADMISSION",
    "RAZORPAY_KEY_ID",
    "RAZORPAY_PLAN_IDS",
    "RAZORPAY_BILLING_ADMISSION",
    "RAZORPAY_LOCAL_BILLING_ADMISSION",
    "BILLING_CANARY_WORKSPACE_IDS",
    "BILLING_GEO_IP_HEADER",
    "BILLING_USD_INR_RATE",
    "LICENSE_SIGNING_KEY_ID",
    "LICENSE_SIGNING_PUBLIC_KEY",
    "LYRASHIELD_KEY_VAULT_NAME",
    "LICENSE_SIGNING_PRIVATE_KEY_SECRET_NAME",
    "LICENSE_SIGNING_PUBLIC_KEY_SECRET_NAME",
    "LICENSE_PUBLISHED_BUILD",
    "POLAR_LOCAL_PRODUCT_IDS",
    "LYRASHIELD_SYNC_MAX_FINDINGS_PER_BATCH",
    "RAZORPAYX_ACCOUNT_NUMBER",
    "RAZORPAYX_PAYOUT_ADMISSION",
    "PAYONEER_PARTNER_ID",
    "AFFILIATE_DEFAULT_PROGRAM_SLUG",
    "AFFILIATE_COOKIE_DOMAIN",
    "AFFILIATE_ATTRIBUTION_WINDOW_DAYS",
    "AFFILIATE_PAYOUT_MIN_CENTS"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build", "^generate"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {
      "dependsOn": []
    },
    "typecheck": {
      "dependsOn": ["^generate", "generate"]
    },
    "@lyrashield/web#build": {
      "dependsOn": ["^build", "^generate"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": [
        "NEXT_PUBLIC_APP_URL",
        "NEXT_PUBLIC_MARKETING_URL",
        "NEXT_PUBLIC_POSTHOG_KEY",
        "NEXT_PUBLIC_POSTHOG_HOST",
        "NEXT_PUBLIC_SENTRY_DSN",
        "NEXT_PUBLIC_SENTRY_RELEASE",
        "MYRA_WRITES_ENABLED"
      ],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "passThroughEnv": ["DATABASE_URL", "BETTER_AUTH_SECRET", "SENTRY_DSN"]
    },
    "@lyrashield/mcp#typecheck": {
      "dependsOn": ["@lyrashield/sdk#build", "^generate", "generate"]
    },
    "@lyrashield/agent-plugin#typecheck": {
      "dependsOn": ["@lyrashield/mcp#build", "^generate", "generate"]
    },
    "lyrashield#typecheck": {
      "dependsOn": [
        "@lyrashield/agent-plugin#build",
        "@lyrashield/sdk#build",
        "^generate",
        "generate"
      ]
    },
    "generate": {
      "cache": false
    },
    "@lyrashield/marketing#build": {
      "env": [
        "PUBLIC_SITE_URL",
        "PUBLIC_INDEXABLE",
        "PUBLIC_X_URL",
        "PUBLIC_APP_URL",
        "PUBLIC_SCANNER_URL",
        "PUBLIC_TURNSTILE_SITE_KEY",
        "PUBLIC_ABUSE_EMAIL",
        "PUBLIC_MYRA_MARKETING_ENABLED",
        "LYRASHIELD_LOCAL_PREVIEW",
        "LYRASHIELD_MARKETING_REVISION",
        "GITHUB_SHA",
        "PUBLIC_GOOGLE_SITE_VERIFICATION",
        "PUBLIC_BING_SITE_VERIFICATION",
        "PUBLIC_MEDIA_URL",
        "PUBLIC_POSTHOG_KEY",
        "PUBLIC_POSTHOG_HOST",
        "PUBLIC_SUPPORT_EMAIL",
        "PUBLIC_SECURITY_EMAIL",
        "PUBLIC_MOTION_RENDER_HASH"
      ],
      "inputs": ["$TURBO_DEFAULT$", ".env*"]
    },
    "@lyrashield/marketing-motion#build": {
      "env": [
        "VITE_OUTPUT_VARIANT",
        "VITE_COMP_ID",
        "VITE_COMP_WIDTH",
        "VITE_COMP_HEIGHT",
        "VITE_SHOW_COPY"
      ],
      "inputs": ["$TURBO_DEFAULT$", ".env*"]
    },
    "@lyrashield/web#dev": {
      "passThroughEnv": [
        "DATABASE_URL",
        "REDIS_URL",
        "BETTER_AUTH_SECRET",
        "GITHUB_CLIENT_SECRET",
        "GOOGLE_CLIENT_SECRET",
        "AZURE_AD_CLIENT_SECRET",
        "GITHUB_APP_PRIVATE_KEY",
        "GITHUB_WEBHOOK_SECRET",
        "GITHUB_APP_CLIENT_SECRET",
        "UPSTASH_REDIS_REST_TOKEN",
        "BREVO_API_KEY",
        "POLAR_ACCESS_TOKEN",
        "POLAR_WEBHOOK_SECRET",
        "RAZORPAY_KEY_SECRET",
        "RAZORPAY_WEBHOOK_SECRET",
        "LICENSE_SIGNING_PRIVATE_KEY",
        "LYRASHIELD_INTERNAL_API_KEY",
        "S3_ACCESS_KEY",
        "S3_SECRET_KEY",
        "SENTRY_DSN",
        "SLACK_WEBHOOK_URL",
        "DISCORD_WEBHOOK_URL"
      ],
      "env": [
        "NEXT_PUBLIC_APP_URL",
        "NEXT_PUBLIC_MARKETING_URL",
        "NEXT_PUBLIC_POSTHOG_KEY",
        "NEXT_PUBLIC_POSTHOG_HOST",
        "NEXT_PUBLIC_SENTRY_DSN",
        "NEXT_PUBLIC_SENTRY_RELEASE",
        "MYRA_WRITES_ENABLED",
        "MYRA_WRITES_ENABLED"
      ]
    },
    "@lyrashield/worker#dev": {
      "passThroughEnv": [
        "DATABASE_URL",
        "REDIS_URL",
        "BETTER_AUTH_SECRET",
        "GITHUB_APP_PRIVATE_KEY",
        "LLM_API_KEY",
        "LYRASHIELD_WEB_SEARCH_API_KEY",
        "LYRASHIELD_EGRESS_PROXY_SECRET",
        "LYRASHIELD_RELAY_SIGNING_SECRET",
        "S3_ACCESS_KEY",
        "S3_SECRET_KEY",
        "BREVO_API_KEY",
        "SLACK_WEBHOOK_URL",
        "DISCORD_WEBHOOK_URL",
        "POLAR_ACCESS_TOKEN",
        "RAZORPAY_KEY_SECRET",
        "RAZORPAYX_API_KEY",
        "RAZORPAYX_API_SECRET",
        "PAYONEER_API_KEY",
        "PAYONEER_API_SECRET",
        "SENTRY_DSN"
      ]
    },
    "@lyrashield/web#start": {
      "passThroughEnv": [
        "DATABASE_URL",
        "REDIS_URL",
        "BETTER_AUTH_SECRET",
        "GITHUB_CLIENT_SECRET",
        "GOOGLE_CLIENT_SECRET",
        "AZURE_AD_CLIENT_SECRET",
        "GITHUB_APP_PRIVATE_KEY",
        "GITHUB_WEBHOOK_SECRET",
        "GITHUB_APP_CLIENT_SECRET",
        "UPSTASH_REDIS_REST_TOKEN",
        "BREVO_API_KEY",
        "POLAR_ACCESS_TOKEN",
        "POLAR_WEBHOOK_SECRET",
        "RAZORPAY_KEY_SECRET",
        "RAZORPAY_WEBHOOK_SECRET",
        "LICENSE_SIGNING_PRIVATE_KEY",
        "LYRASHIELD_INTERNAL_API_KEY",
        "S3_ACCESS_KEY",
        "S3_SECRET_KEY",
        "SENTRY_DSN",
        "SLACK_WEBHOOK_URL",
        "DISCORD_WEBHOOK_URL"
      ],
      "env": [
        "NEXT_PUBLIC_APP_URL",
        "NEXT_PUBLIC_MARKETING_URL",
        "NEXT_PUBLIC_POSTHOG_KEY",
        "NEXT_PUBLIC_POSTHOG_HOST",
        "NEXT_PUBLIC_SENTRY_DSN",
        "NEXT_PUBLIC_SENTRY_RELEASE",
        "MYRA_WRITES_ENABLED",
        "MYRA_WRITES_ENABLED"
      ]
    },
    "@lyrashield/worker#start": {
      "passThroughEnv": [
        "DATABASE_URL",
        "REDIS_URL",
        "BETTER_AUTH_SECRET",
        "GITHUB_APP_PRIVATE_KEY",
        "LLM_API_KEY",
        "LYRASHIELD_WEB_SEARCH_API_KEY",
        "LYRASHIELD_EGRESS_PROXY_SECRET",
        "LYRASHIELD_RELAY_SIGNING_SECRET",
        "S3_ACCESS_KEY",
        "S3_SECRET_KEY",
        "BREVO_API_KEY",
        "SLACK_WEBHOOK_URL",
        "DISCORD_WEBHOOK_URL",
        "POLAR_ACCESS_TOKEN",
        "RAZORPAY_KEY_SECRET",
        "RAZORPAYX_API_KEY",
        "RAZORPAYX_API_SECRET",
        "PAYONEER_API_KEY",
        "PAYONEER_API_SECRET",
        "SENTRY_DSN"
      ]
    },
    "@lyrashield/egress-proxy#start": {
      "passThroughEnv": ["LYRASHIELD_EGRESS_PROXY_SECRET", "LYRASHIELD_RELAY_SIGNING_SECRET"]
    },
    "@lyrashield/marketing#dev": {
      "env": [
        "PUBLIC_SITE_URL",
        "PUBLIC_INDEXABLE",
        "PUBLIC_X_URL",
        "PUBLIC_APP_URL",
        "PUBLIC_SCANNER_URL",
        "PUBLIC_TURNSTILE_SITE_KEY",
        "PUBLIC_ABUSE_EMAIL",
        "PUBLIC_MYRA_MARKETING_ENABLED",
        "LYRASHIELD_LOCAL_PREVIEW",
        "LYRASHIELD_MARKETING_REVISION",
        "GITHUB_SHA",
        "PUBLIC_GOOGLE_SITE_VERIFICATION",
        "PUBLIC_BING_SITE_VERIFICATION",
        "PUBLIC_MEDIA_URL",
        "PUBLIC_POSTHOG_KEY",
        "PUBLIC_POSTHOG_HOST",
        "PUBLIC_SUPPORT_EMAIL",
        "PUBLIC_SECURITY_EMAIL",
        "PUBLIC_MOTION_RENDER_HASH"
      ]
    },
    "@lyrashield/marketing-motion#dev": {
      "env": [
        "VITE_OUTPUT_VARIANT",
        "VITE_COMP_ID",
        "VITE_COMP_WIDTH",
        "VITE_COMP_HEIGHT",
        "VITE_SHOW_COPY"
      ]
    }
  }
}
