# NOTE: `pnpm build` (Next.js page-data collection) reads env from process.env — a
# root .env alone is not loaded for the build. For a local production build either
# export DATABASE_URL/BETTER_AUTH_SECRET/BETTER_AUTH_URL/NEXT_PUBLIC_APP_URL, or place
# an .env in apps/web/. `pnpm dev` and the test suite load this root .env fine.

# Database
DATABASE_URL="postgresql://lyrashield:lyrashield@localhost:5432/lyrashield?schema=public"
# Direct URL for migrations (bypasses PgBouncer pooler). Defaults to DATABASE_URL if not set.
DATABASE_DIRECT_URL="postgresql://lyrashield:lyrashield@localhost:5432/lyrashield?schema=public"
# Production only: privileged connection for the small, explicitly reviewed
# cross-workspace boundary. Never use this client for ordinary request queries.
DATABASE_SYSTEM_URL=""
SHADOW_DATABASE_URL=""

# Redis (redis:// — reserved for the BullMQ job queue, Sprint 4+)
REDIS_URL="redis://:lyrashield-dev-redis@localhost:6379"

# Upstash Redis REST — distributed rate limiting in production.
# HTTPS REST endpoint + token (NOT the redis:// URL above). Leave blank in dev
# to use the in-memory limiter. If the URL is set, the token is required.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Better Auth
BETTER_AUTH_SECRET="replace-with-a-strong-secret-key-min-32-chars"
BETTER_AUTH_URL="http://localhost:3001"
# Comma-separated extra application origins trusted for auth/CSRF (staging or
# an intentional preview). Do not add the marketing site merely because it
# shares the parent domain; Lite Check has its own route-scoped CORS policy.
# BETTER_AUTH_URL is always trusted.
ADDITIONAL_TRUSTED_ORIGINS=""
# Leave unset for a host-only application session. Set only when a reviewed
# product flow genuinely requires credential sharing across subdomains.
# BETTER_AUTH_COOKIE_DOMAIN=".example.com"

# Social OAuth. Register each callback exactly as
# https://<app-origin>/api/auth/callback/<provider> (GitHub/Google) or
# https://<app-origin>/api/auth/callback/microsoft (Microsoft Entra ID).
# OAuth sign-up is open when the provider is configured; existing accounts can also link it.
# GitHub OAuth (https://github.com/settings/developers)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Microsoft Entra ID OAuth (https://entra.microsoft.com/)
AZURE_AD_CLIENT_ID=""
AZURE_AD_CLIENT_SECRET=""
# Use `common` for work/school and personal Microsoft accounts, or the exact
# tenant ID only when beta access is intentionally tenant-restricted.
AZURE_AD_TENANT_ID="common"

# GitHub App (for repo scanning — Sprint 3)
GITHUB_APP_ID=""
# App slug from the GitHub App settings URL (github.com/apps/<slug>) —
# used to build the public install URL. NOT the numeric app id.
GITHUB_APP_SLUG=""
GITHUB_APP_PRIVATE_KEY=""
GITHUB_WEBHOOK_SECRET=""
# The GitHub App's OWN OAuth client credentials (App settings → General).
# NOT the same as GITHUB_CLIENT_ID/SECRET, which drive social sign-in.
# Required for first-time installs: the callback exchanges the `code` GitHub
# appends for a user token and checks GET /user/installations to prove the
# installer can actually administer that installation before binding it.
# The App must also have "Request user authorization (OAuth) during
# installation" enabled, and its visibility must be Public for anyone outside
# the owning account to install it.
GITHUB_APP_CLIENT_ID=""
GITHUB_APP_CLIENT_SECRET=""

# MCP / Agent Action Layer (used by packages/mcp when not passed an explicit tool context)
LYRASHIELD_API_URL="http://localhost:3000"
LYRASHIELD_API_KEY=""
# Optional short-lived bearer for an interactive MCP host. Never commit a real token.
LYRASHIELD_OAUTH_ACCESS_TOKEN=""
# Fail-closed opt-outs for the MCP human-approval gate. Only enable in trusted CI contexts.
LYRASHIELD_MCP_ALLOW_MUTATIONS="false"
LYRASHIELD_MCP_ALLOW_REMOTE_MUTATIONS="false"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3001"
NEXT_PUBLIC_MARKETING_URL="http://localhost:4321"
PORT=3001
# Product analytics (PostHog). Keys are public; use only the project key and host.
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
# Cloudflare Turnstile secret key (server-side). The public site key is set in apps/marketing/.env.example.
TURNSTILE_SECRET_KEY=""
# Set only behind a proxy with a documented authoritative-header contract. Azure
# Container Apps appends its hop to X-Forwarded-For; the app selects the rightmost
# value. Other ingress products may require stripping incoming copies instead.
TRUSTED_PROXY_IP_HEADER=""

# Scan Engine (Sprint 5+)
# Repository scans accept GPT-5.6 Terra or Luna deployments only. Leave this
# unset until one of the routed values below is configured; the worker fails
# closed before sandbox setup when model configuration is missing or unsupported.
LYRASHIELD_LLM=""
LYRASHIELD_RUNTIME_BACKEND="docker"
# Required by repository-scan workers. Use a dedicated internal Docker network.
LYRASHIELD_ENGINE_SANDBOX_NETWORK="lyrashield-sandbox"
SCANNER_PHASE_TIMEOUT_MS="600000"
# Optional authenticated egress proxy for URL scanning.
LYRASHIELD_EGRESS_PROXY_URL=""
LYRASHIELD_EGRESS_PROXY_SECRET=""
# Egress proxy round-trip timeouts (ms). Prevents a hung upstream from stalling
# the scan indefinitely. Connect default 10s, read default 30s.
LYRASHIELD_EGRESS_PROXY_CONNECT_TIMEOUT_MS="10000"
LYRASHIELD_EGRESS_PROXY_READ_TIMEOUT_MS="30000"
# Safe/Quick/Standard use Luna/medium. Deep/Custom use Terra/medium for the
# coordinator and Luna/medium for focused child specialists.
# Empty routed values fall back to LYRASHIELD_LLM.
LYRASHIELD_LUNA_LLM=""
LYRASHIELD_TERRA_LLM=""
LYRASHIELD_WORKER_CONCURRENCY="1"
PLATFORM_MAX_SCAN_BUDGET_USD="50"
# Docker sandbox resource limits passed to the Strix engine.
STRIX_SANDBOX_MEM_LIMIT="4g"
STRIX_SANDBOX_CPUS="2"
STRIX_SANDBOX_PIDS_LIMIT="512"
LLM_API_KEY=""
LLM_API_BASE=""
LLM_API_VERSION=""
# Optional per-request engine limits. Leave unset to use engine defaults.
# MAX_OUTPUT_TOKENS is a hard cap on tokens generated per request; it replaces the
# engine's per-scan-mode default and also tightens the pre-request budget
# reservation. MAX_INPUT_TOKENS is the ceiling history compaction keeps requests
# under -- NOT a hard reject: crossing it compacts older history rather than
# failing the scan. Values above the GPT-5.6 long-context boundary (272k, where
# input bills at 2x) are clamped down by the engine with a logged warning.
# Requires an engine build with token-cap enforcement; older engines ignore both.
# LYRASHIELD_MAX_OUTPUT_TOKENS="4096"
# LYRASHIELD_MAX_INPUT_TOKENS="200000"
# Production: use only the immutable digest emitted by the engine's
# publish-sandbox workflow after its non-root smoke tests and attestations.
# Never use the development `lyrashieldai-sandbox:local` tag or an upstream image.
# LYRASHIELD_IMAGE="ghcr.io/ecryptoguru/lyrashield-sandbox@sha256:<published-digest>"
LYRASHIELD_TELEMETRY="0"
# Enable GPT-5.6 explicit prompt-cache reads/writes. The engine only emits
# cache-specific request fields for supported GPT-5.6 models.
LYRASHIELD_PROMPT_CACHE_EXPLICIT="1"
LYRASHIELD_PROMPT_CACHE="1"
LYRASHIELD_ENGINE_PATH=""
# Optional paid-scan overlay. Keep disabled until the pinned engine revision
# includes `lyrashield ai-security-triage` and its CI/provenance gates are green.
LYRASHIELD_AI_TRIAGE_ENABLED="0"
LYRASHIELD_AI_TRIAGE_MAX_BUDGET_USD="0.20"
# Crash-recovery reaper. It skips all database-active scans and every running
# container, and only removes worker-owned paths older than the threshold.
LYRASHIELD_STALE_RESOURCE_REAPER_ENABLED="1"
LYRASHIELD_STALE_RESOURCE_MIN_AGE_MINUTES="1440"
LYRASHIELD_STALE_RESOURCE_REAPER_INTERVAL_MS="900000"
# Production workers must point Docker at a dedicated isolated scan host; the
# worker rejects a shared local socket in production. Use SSH or TLS Docker API.
# DOCKER_HOST="ssh://scanner@isolated-docker-host"
# DOCKER_TLS_VERIFY="1" # required when DOCKER_HOST uses tcp://
# DOCKER_CERT_PATH="/run/secrets/isolated-docker-client"

# Web Search (Parallel Search)
# Requires a Parallel Search API key. Set to 1 only when the key is configured.
LYRASHIELD_WEB_SEARCH_ENABLED="0"
LYRASHIELD_WEB_SEARCH_API_KEY=""
LYRASHIELD_WEB_SEARCH_PROVIDER="parallel"
LYRASHIELD_WEB_SEARCH_MODE="turbo"
LYRASHIELD_WEB_SEARCH_MAX_RESULTS="5"
LYRASHIELD_WEB_SEARCH_MAX_CHARS_TOTAL="4000"
LYRASHIELD_WEB_SEARCH_MAX_CALLS_PER_SCAN="50"
LYRASHIELD_WEB_SEARCH_BUDGET_USD="1.0"

# Azure OpenAI (optional — use these OR the generic LLM_API_KEY/LLM_API_BASE)
# LYRASHIELD_LLM="azure/gpt-5.6-terra" # fallback
# LYRASHIELD_LUNA_LLM="azure/gpt-5.6-luna"
# LYRASHIELD_TERRA_LLM="azure/gpt-5.6-terra"
AZURE_OPENAI_API_KEY=""
AZURE_OPENAI_ENDPOINT=""
# AZURE_OPENAI_API_BASE=""
AZURE_API_VERSION="v1"
# AZURE_OPENAI_API_VERSION=""

# Azure AI Foundry project / serverless (optional).
# Keep the route coherent: deployment names, credential, and endpoint must
# belong to the same Foundry resource/project. The normal Azure path uses
# direct JSON function tools; do not set LYRASHIELD_PROGRAMMATIC_TOOL_CALLING
# unless the engine provider-contract gate confirms that the deployment accepts it.
# LYRASHIELD_LLM="azure_ai/gpt-5.6-terra" # fallback
# LYRASHIELD_LUNA_LLM="azure_ai/gpt-5.6-luna"
# LYRASHIELD_TERRA_LLM="azure_ai/gpt-5.6-terra"
AZURE_AI_API_KEY=""
AZURE_AI_API_BASE=""

# Evidence Storage (Cloudflare R2 — 10GB free, zero egress)
S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_BUCKET="lyrashield-evidence"
S3_REGION="auto"

# Docker Compose stores localhost evidence in an encrypted local volume automatically.
# For a direct host-worker run only, opt in explicitly (never enable this in production).
# Base64-encoded 32-byte key-encryption key for evidence envelope encryption.
# Generate with: openssl rand -base64 32
# Required when S3 evidence storage is configured (fail-closed).
LYRASHIELD_EVIDENCE_KEK=""
LYRASHIELD_LOCAL_EVIDENCE_STORAGE=""
LYRASHIELD_LOCAL_EVIDENCE_DIR=""

# Email (Brevo — email verification enabled locally, production secrets pending)
# Enforce email verification before an account can use the app.
# The schema default is "1"; production config validation rejects "verification
# required but undeliverable", so enabling it requires BREVO_API_KEY.
#
# A Brevo API key is provisioned and verified locally (2026-08-08). Brevo IP
# security is disabled at the account level because Azure Container Apps
# Consumption has 180+ dynamic outbound NAT IPs that cannot be statically
# allowlisted. The production Container App does not yet have BREVO_API_KEY,
# EMAIL_FROM, or NOTIFICATION_FROM_EMAIL secrets set, so production still runs
# with LYRASHIELD_REQUIRE_EMAIL_VERIFICATION=0. See
# docs/deployment/PRODUCTION_DEPLOYMENT.md "Known production blockers" §1.
LYRASHIELD_REQUIRE_EMAIL_VERIFICATION="0"
BREVO_API_KEY=""
# Use a verified Brevo sender address only (display names are configured by Brevo).
EMAIL_FROM="noreply@localhost"
NOTIFICATION_FROM_EMAIL=""

# Notifications (Sprint 9)
SLACK_WEBHOOK_URL=""
DISCORD_WEBHOOK_URL=""

# Billing (Sprint 10)
# ─── Billing (Sprint 10) ───────────────────────────────────────────────────
# Polar (USD, global) — https://polar.sh
POLAR_ACCESS_TOKEN=""
POLAR_ORG_ID=""
POLAR_WEBHOOK_SECRET=""
# Webhook timestamp tolerance in milliseconds (default: 300000 = 5 minutes)
POLAR_WEBHOOK_TOLERANCE_MS=300000

# Razorpay (INR, India) — https://razorpay.com
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Separate webhook secret (falls back to RAZORPAY_KEY_SECRET if not set)
RAZORPAY_WEBHOOK_SECRET=""

# GeoIP routing: header used to extract the client IP for provider routing
# (default: cf-connecting-ip)
BILLING_GEO_IP_HEADER="cf-connecting-ip"

# Monitoring
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# Runtime
LOG_LEVEL="info"
